Функция ПолучитьДанныеДляОтправки()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	НоменклатураДополнительныеРеквизиты.Ссылка КАК Номенклатура,
	               |	ЕСТЬNULL(НоменклатураДополнительныеРеквизиты.Значение, """") КАК КодДР,
	               |	ВЫБОР
	               |		КОГДА НоменклатураДополнительныеРеквизиты.Ссылка.ВидНоменклатуры.Наименование = ""Продукция Роболабс""
	               |			ТОГДА ""2""
	               |		ИНАЧЕ ""1""
	               |	КОНЕЦ КАК Поставщик,
	               |	НоменклатураДополнительныеРеквизиты.Ссылка.КодДляПоиска КАК КодТТМ
	               |ПОМЕСТИТЬ КодыДР
	               |ИЗ
	               |	Справочник.Номенклатура.ДополнительныеРеквизиты КАК НоменклатураДополнительныеРеквизиты
	               |ГДЕ
	               |	НоменклатураДополнительныеРеквизиты.Свойство = &СвойствоАртикулДР
	               |	И НЕ НоменклатураДополнительныеРеквизиты.Ссылка.ПометкаУдаления
	               |	И НЕ НоменклатураДополнительныеРеквизиты.Ссылка.ЭтоГруппа
	               |	И НоменклатураДополнительныеРеквизиты.Ссылка.ВидНоменклатуры В ИЕРАРХИИ(&ГруппаПродукции)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВерсииОбъектов.Объект КАК Номенклатура,
	               |	МАКСИМУМ(ВерсииОбъектов.НомерВерсии) КАК НомерВерсии,
	               |	КодыДР.КодДР КАК codedr,
	               |	КодыДР.Поставщик КАК supplyer,
	               |	КодыДР.КодТТМ КАК codettm
	               |ИЗ
	               |	КодыДР КАК КодыДР
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ВерсииОбъектов КАК ВерсииОбъектов
	               |		ПО ((ВЫРАЗИТЬ(ВерсииОбъектов.Объект КАК Справочник.Номенклатура)) = ЕСТЬNULL(КодыДР.Номенклатура, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)))
	               |ГДЕ
	               |	ВерсииОбъектов.Объект ССЫЛКА Справочник.Номенклатура
	               |	И ВерсииОбъектов.ДатаВерсии >= &ДатаВерсии
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВерсииОбъектов.Объект,
	               |	КодыДР.КодДР,
	               |	КодыДР.Поставщик,
	               |	КодыДР.КодТТМ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	КодыДР.КодДР";
	
	ГруппаНоваяИерархия = Справочники.ВидыНоменклатуры.НайтиПоНаименованию("Новая иерархия", Истина);
	ГруппаПродукция = Справочники.ВидыНоменклатуры.НайтиПоНаименованию("Продукция", Истина, ГруппаНоваяИерархия);
	ГруппаПродукцияРобо = Справочники.ВидыНоменклатуры.НайтиПоНаименованию("Продукция Робо", Истина, ГруппаПродукция);
	ГруппаПродукцияТТМ = Справочники.ВидыНоменклатуры.НайтиПоНаименованию("Продукция ТТМ", Истина, ГруппаПродукция);
	
	Продукция = Справочники.ВидыНоменклатуры.НайтиПоНаименованию("Продукция (б/х б/с)", Истина, ГруппаПродукцияТТМ);
	НейтральноеОборудование = Справочники.ВидыНоменклатуры.НайтиПоНаименованию("Нейтральное оборудование новое", Истина, ГруппаПродукцияТТМ);
	ПродукцииРоболабс = Справочники.ВидыНоменклатуры.НайтиПоНаименованию("Продукция Роболабс", Истина, ГруппаПродукцияРобо);
	//ЗИП = Справочники.ВидыНоменклатуры.НайтиПоНаименованию("ЗИП", Истина, ГруппаПродукцияТТМ);   
	//ЗИП нельзя так синхронизировать, так как у нас нет КодовДР для ЗИП и не понятно как их загрузить, 
	//!!!нужно вручную выполнить сопоставление!!!
	
	ВидыДляОтправки = Новый Массив;
	ВидыДляОтправки.Добавить(Продукция);
	ВидыДляОтправки.Добавить(НейтральноеОборудование);
	//ВидыДляОтправки.Добавить(ЗИП);
	ВидыДляОтправки.Добавить(ПродукцииРоболабс);
	
	Запрос.УстановитьПараметр("ГруппаПродукции", ВидыДляОтправки); 
	Запрос.УстановитьПараметр("ДатаВерсии",НачалоДня(ТекущаяДата())-24*24*60*60);
	//Запрос.УстановитьПараметр("ДатаВерсии",НачалоДня(ТекущаяДатаСеанса())-24*24*60*60); //Дата(2025,12,1)); 
	Запрос.УстановитьПараметр("СвойствоАртикулДР",ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("Имя","АртикулДР_547609cb63294018b4f565c6953c99e0")); 

	Возврат Запрос.Выполнить().Выгрузить();
	
	//ТабИзменения = ПолучитьДанныеИзмененныхОбъектов();
	//МассивНоменклатуры  = ТабИзменения.ВыгрузитьКолонку("Номенклатура");
	//	
	//Для Каждого Стр из ТабИзменения Цикл 
	//	
	//	//ТабДопРеквизиты = ВерсионированиеОбъектов.МетаданныеТабличнойЧасти(Стр.Номенклатура.Метаданные(),"ДополнительныеРеквизиты");
	//	
	//	//ВерсионированиеОбъектов.НомерПоследнейВерсии(Стр.СсылкаНаНоменклатуру,Истина);
	//	
	//	Двоичныеданные = ВерсионированиеОбъектов.СведенияОВерсииОбъекта(Стр.Номенклатура.Ссылка,Стр.НомерВерсии).Версияобъекта;
	//	Результат = ВерсионированиеОбъектов.РазборПредставленияОбъектаXML(ДвоичныеДанные, Стр.Номенклатура.Ссылка);
	//	ОтборСтрок = Новый Структура("НаименованиеРеквизита", "Артикул ДР (н/о) (СП) (Стол Standart //Т-С/S)");
	//	МассивНайденныхСтрок = Результат.Реквизиты.НайтиСтроки(ОтборСтрок);
	//	ЗначениеКодДР = МассивНайденныхСтрок[0].ЗначениеРеквизита;
