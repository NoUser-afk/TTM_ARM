	//Формула = СтрШаблон("ХранилищеОбщихНастроек.Загрузить(%2%1%2,%2%3%2,%2%1%2)",КлючОбъекта,"""",КлючНастроек);
	УстановитьПривилегированныйРежим(Истина);
