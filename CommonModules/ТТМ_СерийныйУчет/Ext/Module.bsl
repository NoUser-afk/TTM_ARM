//Формирует корректный новый серийный номер по формату: КодТМ-ПериодЗапускаЭтапаВПроизводство-НовыйНомер
//КодТМ - 4-5 символов
//ПериодЗапускаЭтапаВПроизводство - Год (без "0") - 3 символа + месяц (с ведущим "0") - 2 символа
//НовыйНомер - порядковый номер изделия в пределах года - 4 символа
Функция ПроверитьКорректностьСерийногоНомера(СтрНовыйНомер, СтрокаДанных) Экспорт
	
	////Состав текущегоСерийного номера
	//МассивЧастейТекущийСН = СтрРазделить(СтрокаДанных.СерийныйНомер,"-");
	////Часть1 = МассивЧастейСН[0];
	////Часть2 = МассивЧастейСН[1];
	//НомерТекущий = МассивЧастейТекущийСН[2];  
	//
	//МассивЧастейСтарыйСН = СтрРазделить(СтрокаДанных.СтарыйСерийныйНомер,"-");
	//НомерНовый = МассивЧастейСтарыйСН[2];
	
	ТМНоменклатуры = ПолучитьТМНоменклатуры(СтрокаДанных.Номенклатура);
	Если ТМНоменклатуры = Неопределено Тогда 
		Возврат Ложь;
	КонецЕсли; 
	КодТМ = СтрРазделить(ТМНоменклатуры," -+._/(),:;*№#$@!^&`~");
	
	ДатаНачала = СтрокаДанных.ЭтапПроизводства.ФактическоеНачалоЭтапа;
	
	ДатаЗапуска = Формат(Год(ДатаНачала),"ЧРГ=' '; ЧН=Отсутствует") + Формат(Месяц(ДатаНачала),"");
	ДатаЗапуска = СтрЗаменить(Формат(ДатаНачала,"ДФ=yyyy"),"0","") + Формат(ДатаНачала,"ДФ=ММ");
	
	НовыйСерийныйНомер = ДополнитьНомерТМВедущимиНулями(КодТМ[0]) + "-" + ДатаЗапуска + "-" + СтрНовыйНомер;
	
	НомерСвободен = ПроверитьНомерНеЗанят(СтрокаДанных, НовыйСерийныйНомер);
	
	Если НомерСвободен Тогда                                              	
		Возврат НовыйСерийныйНомер;
	Иначе 
		Возврат Неопределено;
	КонецЕсли;
		
КонецФункции   

Функция ДополнитьНомерТМВедущимиНулями(КодТМ)
	
	Если СтрДлина(КодТМ) = 5 Тогда Возврат КодТМ; КонецЕсли;
	
	Пока не СтрДлина(КодТМ) = 5 Цикл 
		КодТМ = "0" + КодТМ;
	КонецЦикла;    
	
	Возврат КодТМ;
	
КонецФункции

Функция ПроверитьНомерНеЗанят(СтрокаДанных, НовыйСерийныйНомер) Экспорт    
	
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТТМ_УчетСерийныхНомеровПродукции.Номенклатура КАК Номенклатура,
	               |	ТТМ_УчетСерийныхНомеровПродукции.Регистратор КАК ЭтапПроизводства,
	               |	ТТМ_УчетСерийныхНомеровПродукции.СерийныйНомер КАК СерийныйНомер
	               |ИЗ
	               |	РегистрНакопления.ТТМ_УчетСерийныхНомеровПродукции КАК ТТМ_УчетСерийныхНомеровПродукции
	               |ГДЕ
	               //|	ТТМ_УчетСерийныхНомеровПродукции.Регистратор = &ЭтапПроизводства
	               |	ТТМ_УчетСерийныхНомеровПродукции.Номенклатура = &Номенклатура
	               |	И ТТМ_УчетСерийныхНомеровПродукции.СерийныйНомер = &СерийныйНомер";
    //Запрос.УстановитьПараметр("ЭтапПроизводства", СтрокаДанных.ЭтапПроизводства);
	Запрос.УстановитьПараметр("Номенклатура", СтрокаДанных.Номенклатура);
	Запрос.УстановитьПараметр("СерийныйНомер", НовыйСерийныйНомер);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		Сообщить("Номер "+ НовыйСерийныйНомер +" уже занят: " + Выборка.Номенклатура + ", " + Выборка.ЭтапПроизводства);
		Возврат Ложь;
	Иначе 
		Возврат Истина;
	КонецЕсли;
	
	Возврат Выборка.Значение;
	
КонецФункции

Функция ПолучитьТМНоменклатуры(Номенклатура) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДополнительныеСведения.Значение КАК Значение
	               |ИЗ
	               |	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
	               |ГДЕ
	               |	ДополнительныеСведения.Объект ССЫЛКА Справочник.Номенклатура
	               |	И ДополнительныеСведения.Объект = &Номенклатура
	               |	И ДополнительныеСведения.Свойство = &СвойствоТМ";
	Запрос.УстановитьПараметр("номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("СвойствоТМ",ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("Имя","КодТМ_ТТМ"));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если не Выборка.Следующий() Тогда 
		Сообщить("Не удалось овпределить код ТМ для номенклатуры " + Номенклатура);
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Выборка.Значение;
	
КонецФункции

//Функция записывает конкретный Серийный номер, указанный пользователем
//Параметры:
//СтрНовыйНомер - который нужно записать
//ДанныеТекСтроки - данные текущей строки Таблицы этапов, содержат поля:
//	СтарыйНомер
//	Номенкатура
//	ЭтапПроизводства   
Функция ЗаписатьНовыйСерийныйНомер(СтрНовыйНомер, ДанныеТекСтроки, МассивЭтапов, ПересчитатьВсеВыделенныеНомера = Ложь) Экспорт
	
	УчетСерийныхНомеров = ПроверитьУстановитьУчетСерийныхНомеров(ДанныеТекСтроки.Номенклатура);
	Если не УчетСерийныхНомеров Тогда 
		Сообщить("Учет серийных номеров не включен для номенклатуры " + ДанныеТекСтроки.Номенклатуры);
		Возврат Ложь;
	КонецЕсли;
	//ПараметрыПоиска = Новый Структура("Отметка", Истина); 
	//ТабВыбранныеЭтапы = Объект.ТабЭтапы.Выгрузить(ПараметрыПоиска,);
	НЗ = РегистрыНакопления.ТТМ_УчетСерийныхНомеровПродукции.СоздатьНаборЗаписей();
	Если МассивЭтапов.Количество() > 1 Тогда 
		
		Для Каждого Этап из МассивЭтапов Цикл 
			НЗ.Отбор.Регистратор.Установить(ДанныеТекСтроки.ЭтапПроизводства);
			НЗ.Прочитать();
			Для Каждого СтрНЗ из НЗ Цикл 
				Если СтрНЗ.Номенклатура = ДанныеТекСтроки.Номенклатура и СтрНЗ.СерийныйНомер = ДанныеТекСтроки.СтарыйСерийныйНомер Тогда 
					СтрНЗ.СерийныйНомер = СтрНовыйНомер;
					Попытка
						НЗ.Записать();
						Возврат Истина;
					Исключение
						Сообщить(СтрШаблон("Ошибка записи Серийного номера %1, %2, %3", СтрНовыйНомер,ДанныеТекСтроки.Номенклатура, ДанныеТекСтроки.ЭтапПроизводства));
						Возврат Ложь;
					КонецПопытки;
			
					Прервать;
				Иначе 
					Продолжить;
				КонецЕсли;
			КонецЦикла;   
			
		КонецЦикла;
		
	ИначеЕсли МассивЭтапов.Количество() = 1 Тогда 
		
		НЗ.Отбор.Регистратор.Установить(ДанныеТекСтроки.ЭтапПроизводства);
		НЗ.Прочитать(); 
		Если НЗ.Количество() = 0 Тогда 
			//Сгенерировать серийный номер если требуется для Вида номенклатуры
			Если ДанныеТекСтроки.ЭтапПроизводства.Статус = Перечисления.СтатусыЭтаповПроизводства2_2.Начат Тогда 
				НомерПроверенИЗаписан = ЗаписатьСерийныйНомерПродукцииПослеПроверки(ДанныеТекСтроки.ЭтапПроизводства);
				Если НомерПроверенИЗаписан Тогда 
					Возврат Истина;
				КонецЕсли;
				Возврат Ложь;
			КонецЕсли; 
			Возврат Ложь;
		КонецЕсли;	
		Для Каждого СтрНЗ из НЗ Цикл 
			Если СтрНЗ.Номенклатура = ДанныеТекСтроки.Номенклатура и СокрЛП(СтрНЗ.СерийныйНомер) = СокрЛП(ДанныеТекСтроки.СерийныйНомер) Тогда 
				СтрНЗ.СерийныйНомер = СтрНовыйНомер;
				Попытка
					НЗ.Записать();
					Возврат Истина;
				Исключение
					Сообщить("Ошибка записи Серийного номера");
					Возврат Ложь;
				КонецПопытки;
				
				Прервать;		
			Иначе 
				Продолжить;
			КонецЕсли;
		КонецЦикла;
		
		Возврат Ложь;
		
	Иначе //МассивЭтапов.Количество() = 0
		
		Возврат Ложь;
		
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура СформироватьЗадачуОповещенияОЗапущенныхЭтапах() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "";
	МассивЭтапов = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ЭтапПроизводства");
	Если МассивЭтапов.Количество() = 0 Тогда 
		Возврат;
	КонецЕсли;
		
	ТекстСообщения = "";
	Для Каждого Этап из МассивЭтапов Цикл 
		ТекстСообщения = ?(ТекстСообщения = "", "", Символы.ПС) + Этап;
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Истина);
	Задача = Задачи.ЗадачаИсполнителя.СоздатьЗадачу();
	ДатаЗадачи = ТекущаяДатаСеанса();
	//ПериодОповещения = Дата(Год(ТекущаяДата(),)
	Задача.Дата = ДатаЗадачи;    
	Задача.Наименование = "Запущенные этапы за " + ДатаЗадачи;
	//Задача.Предмет = СсылкаНаЗаказКлиента;
	Задача.Автор = ПараметрыСеанса.ТекущийПользователь; 
	ИсполнительЗадачи = Справочники.Пользователи.НайтиПоНаименованию("Абрамова");
	Задача.Исполнитель = ИсполнительЗадачи;
	Задача.Важность = Перечисления.ВариантыВажностиЗадачи.Высокая;  
	Задача.СрокИсполнения = Дата(Год(ТекущаяДатаСеанса()),Месяц(ТекущаяДатаСеанса()),День(ТекущаяДатаСеанса()+1));
	Задача.Описание = ТекстСообщения;   
	Попытка
		Задача.Записать();                  
	Исключение
		Сообщить("Ошибка при формировании задачи оповещения о запущенных заказах");
	КонецПопытки;
	
	Процесс = БизнесПроцессы.Задание.СоздатьБизнесПроцесс();
	Процесс.ЗадачаИсточник = Задача;
	ЗаполнитьЗначенияСвойств(Процесс,Задача,,"Номер");
	Попытка
		Процесс.Записать();
	Исключение
		
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь); 
	
КонецПроцедуры


