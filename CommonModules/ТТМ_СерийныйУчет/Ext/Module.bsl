Функция ПроверитьНайтиСерийныйНомерПродукцииПриПродаже(ИсточникРТУ, ЕстьВсеСерии = Истина) Экспорт
	// Код написан для случая когда результатом этапа является одна номенклатурная позиция
	// количество может быть больше одного
	
	ТЗТовары = ИсточникРТУ.Товары.Выгрузить(,"Номенклатура,Количество");
	ТЗТовары.Свернуть("Номенклатура","Количество");
	
	Заказ = ИсточникРТУ.ЗаказКлиента;
		
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВсеТоварыРеализации.Номенклатура КАК Номенклатура,
	               |	ВсеТоварыРеализации.КоличествоУпаковок КАК КоличествоУпаковок
	               |ПОМЕСТИТЬ ВсеТоварыРеализации
	               |ИЗ
	               |	&ТоварыРеализации КАК ВсеТоварыРеализации
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВсеТоварыРеализации.Номенклатура КАК Номенклатура,
	               |	СУММА(ВсеТоварыРеализации.КоличествоУпаковок) КАК КоличествоУпаковок
	               |ПОМЕСТИТЬ СерийныеТоварыРеализации
	               |ИЗ
	               |	ВсеТоварыРеализации КАК ВсеТоварыРеализации
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура.ДополнительныеРеквизиты КАК НоменклатураДополнительныеРеквизиты
	               |		ПО ВсеТоварыРеализации.Номенклатура = НоменклатураДополнительныеРеквизиты.Ссылка
	               |ГДЕ
	               |	НоменклатураДополнительныеРеквизиты.Свойство = &ДопРеквизитУчетСерий
	               |	И НоменклатураДополнительныеРеквизиты.Значение = ИСТИНА
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВсеТоварыРеализации.Номенклатура
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТТМ_УчетСерийныхНомеровПродукции.Регистратор КАК ЭтапПроизводства,
	               |	ТТМ_УчетСерийныхНомеровПродукции.Склад КАК Склад,
	               |	ТТМ_УчетСерийныхНомеровПродукции.Номенклатура КАК Номенклатура,
	               |	ТТМ_УчетСерийныхНомеровПродукции.Назначение КАК Назначение,
	               |	ТТМ_УчетСерийныхНомеровПродукции.ШильдЗаказан КАК ШильдЗаказан,
	               |	ТТМ_УчетСерийныхНомеровПродукции.Произведено КАК Произведено,
	               |	ТТМ_УчетСерийныхНомеровПродукции.Регистратор.ДатаПроизводства КАК ДатаПроизводства,
	               |	ТТМ_УчетСерийныхНомеровПродукции.СерийныйНомер КАК СерийныйНомер,
	               |	СУММА(ТТМ_УчетСерийныхНомеровПродукции.Количество) КАК Количество,
	               |	ТТМ_УчетСерийныхНомеровПродукции.ДокументРеализации КАК ДокументРеализации,
	               |	СерийныеТоварыРеализации.КоличествоУпаковок КАК КоличествоРеализации,
	               |	ТТМ_УчетСерийныхНомеровПродукции.Реализовано КАК Реализовано,
	               |	ТТМ_УчетСерийныхНомеровПродукции.Назначение.Заказ КАК НазначениеЗаказ
	               |ИЗ
	               |	РегистрНакопления.ТТМ_УчетСерийныхНомеровПродукции КАК ТТМ_УчетСерийныхНомеровПродукции
	               |		ЛЕВОЕ СОЕДИНЕНИЕ СерийныеТоварыРеализации КАК СерийныеТоварыРеализации
	               |		ПО ТТМ_УчетСерийныхНомеровПродукции.Номенклатура = СерийныеТоварыРеализации.Номенклатура
	               |ГДЕ
	               |	ТТМ_УчетСерийныхНомеровПродукции.ДокументРеализации = &Реализация
	               |	И ТТМ_УчетСерийныхНомеровПродукции.ДатаПроизводства <= &ДатаРеализации
	               |	И НЕ ТТМ_УчетСерийныхНомеровПродукции.Регистратор = &Реализация
	               |	И ТТМ_УчетСерийныхНомеровПродукции.Произведено
	               |	И ТТМ_УчетСерийныхНомеровПродукции.ШильдЗаказан
	               |	И ТТМ_УчетСерийныхНомеровПродукции.Регистратор ССЫЛКА Документ.ЭтапПроизводства2_2
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ТТМ_УчетСерийныхНомеровПродукции.Склад,
	               |	ТТМ_УчетСерийныхНомеровПродукции.Номенклатура,
	               |	ТТМ_УчетСерийныхНомеровПродукции.Назначение,
	               |	ТТМ_УчетСерийныхНомеровПродукции.ШильдЗаказан,
	               |	ТТМ_УчетСерийныхНомеровПродукции.Произведено,
	               |	ТТМ_УчетСерийныхНомеровПродукции.Регистратор,
	               |	ТТМ_УчетСерийныхНомеровПродукции.СерийныйНомер,
	               |	ТТМ_УчетСерийныхНомеровПродукции.ДокументРеализации,
	               |	СерийныеТоварыРеализации.КоличествоУпаковок,
	               |	ТТМ_УчетСерийныхНомеровПродукции.Реализовано,
	               |	ТТМ_УчетСерийныхНомеровПродукции.Назначение.Заказ,
	               |	ТТМ_УчетСерийныхНомеровПродукции.Регистратор.ДатаПроизводства
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ТТМ_УчетСерийныхНомеровПродукции.Регистратор,
	               |	ТТМ_УчетСерийныхНомеровПродукции.Склад,
	               |	ТТМ_УчетСерийныхНомеровПродукции.Номенклатура,
	               |	ТТМ_УчетСерийныхНомеровПродукции.Назначение,
	               |	ТТМ_УчетСерийныхНомеровПродукции.ШильдЗаказан,
	               |	ТТМ_УчетСерийныхНомеровПродукции.Произведено,
	               |	ТТМ_УчетСерийныхНомеровПродукции.Регистратор.ДатаПроизводства,
	               |	ТТМ_УчетСерийныхНомеровПродукции.СерийныйНомер,
	               |	СУММА(ТТМ_УчетСерийныхНомеровПродукции.Количество),
	               |	ТТМ_УчетСерийныхНомеровПродукции.ДокументРеализации,
	               |	СерийныеТоварыРеализации.КоличествоУпаковок,
	               |	ЛОЖЬ,
	               |	ТТМ_УчетСерийныхНомеровПродукции.Назначение.Заказ
	               |ИЗ
	               |	РегистрНакопления.ТТМ_УчетСерийныхНомеровПродукции КАК ТТМ_УчетСерийныхНомеровПродукции
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СерийныеТоварыРеализации КАК СерийныеТоварыРеализации
	               |		ПО ТТМ_УчетСерийныхНомеровПродукции.Номенклатура = СерийныеТоварыРеализации.Номенклатура
	               |ГДЕ
	               |	ТТМ_УчетСерийныхНомеровПродукции.Назначение.Заказ = &Заказ
	               |	И ТТМ_УчетСерийныхНомеровПродукции.Произведено
	               |	И ТТМ_УчетСерийныхНомеровПродукции.ДатаПроизводства <= &ДатаРеализации
	               |	И ЕСТЬNULL(ТТМ_УчетСерийныхНомеровПродукции.ДокументРеализации, ЗНАЧЕНИЕ(Документ.РеализацияТоваровУслуг.ПустаяСсылка)) = ЗНАЧЕНИЕ(Документ.РеализацияТоваровУслуг.ПустаяСсылка)
	               |	И НЕ ТТМ_УчетСерийныхНомеровПродукции.Реализовано
	               |	И ТТМ_УчетСерийныхНомеровПродукции.Регистратор ССЫЛКА Документ.ЭтапПроизводства2_2
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ТТМ_УчетСерийныхНомеровПродукции.Склад,
	               |	ТТМ_УчетСерийныхНомеровПродукции.Регистратор,
	               |	ТТМ_УчетСерийныхНомеровПродукции.Номенклатура,
	               |	ТТМ_УчетСерийныхНомеровПродукции.Назначение,
	               |	ТТМ_УчетСерийныхНомеровПродукции.ШильдЗаказан,
	               |	ТТМ_УчетСерийныхНомеровПродукции.Произведено,
	               |	ТТМ_УчетСерийныхНомеровПродукции.СерийныйНомер,
	               |	ТТМ_УчетСерийныхНомеровПродукции.ДокументРеализации,
	               |	СерийныеТоварыРеализации.КоличествоУпаковок,
	               |	ТТМ_УчетСерийныхНомеровПродукции.Назначение.Заказ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	СерийныйНомер
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СерийныеТоварыРеализации.Номенклатура КАК Номенклатура,
	               |	СерийныеТоварыРеализации.КоличествоУпаковок КАК КоличествоУпаковок
	               |ИЗ
	               |	СерийныеТоварыРеализации КАК СерийныеТоварыРеализации";     

	Запрос.УстановитьПараметр("Заказ", ИсточникРТУ.ЗаказКлиента);
	Запрос.УстановитьПараметр("Номенклатура", ТЗТовары.ВыгрузитьКолонку("Номенклатура"));
