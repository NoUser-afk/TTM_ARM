
Функция УдалитьЗаписиРегистраПоРегистратору(СсылкаНаЭтап) Экспорт
	
	НЗ = РегистрыНакопления.ТТМ_УчетСерийныхНомеровПродукции.СоздатьНаборЗаписей();
	НЗ.Отбор.Регистратор.Установить(СсылканаЭтап.Ссылка);
	НЗ.Прочитать();
	НЗ.Очистить();  
	Попытка
		НЗ.Записать();
		Возврат Истина;
	Исключение  
		Сообщить(ОписаниеОшибки());
		Возврат Ложь;  
	КонецПопытки;
	
КонецФункции

//01.07.2025
//Функция выполняет проверку необходимости ведения серийных номеров
//генерирует серийные номера по количеству изделий в этапе (если задано начальное значение серийного номера, то начинает нумерацию с указанного номера
//На данный момент серийные номера устанавливаются при заказе шильдов из обработки, поэтому устанавливается отметка ШильдЗаказан в значение ИСТИНА в регистре ТТМ_УчетСерийныхНомеров 
Функция ЗаписатьСерийныйНомерПродукцииПослеПроверки(СсылкаНаЭтап, НачальныйНомер = 0) Экспорт 
	// Код написан для случая когда результатом этапа является одна номенклатурная позиция
	// количество может быть больше одного
	
	ДанныеЭтапа = ПолучитьДанныеЭтапа(СсылкаНаЭтап);  
	Номенклатура = СсылкаНаЭтап.Выходныеизделия[0].Номенклатура;	
	
	//УчетСерий = ТТМНеобходимостьИспользованияСерий(); //ДанныеЭтапа.ВидНоменклатуры, ДанныеЭтапа.ДатаЗапуска
	УчетСерий = ПроверитьУстановитьУчетСерийныхНомеров(Номенклатура);
	
	Если не УчетСерий Тогда 
		Возврат Ложь;
	КонецЕсли;
	
	СерииЗаписаны = Ложь;
	
	НЗ = РегистрыНакопления.ТТМ_УчетСерийныхНомеровПродукции.СоздатьНаборЗаписей();
	НЗ.Отбор.Регистратор.Значение = СсылкаНаЭтап.Ссылка;
	НЗ.Отбор.Регистратор.Использование = Истина;
	НЗ.Прочитать();
	
	тз = НЗ.Выгрузить();
	
	Если НЗ.Количество() = СсылкаНаЭтап.КоличествоУпаковокПлан  //КоличествоИзделий	!!!!! Только для теста - исправить после обратно на КоличествоУпаковокПлан!!!! //
		и НЗ[0].Номенклатура = Номенклатура Тогда 		//СсылкаНаЭтап.ВыходныеИзделия[0].Номенклатура Тогда 
		
		Если не НЗ[0].ШильдЗаказан Тогда 
			НЗ[0].ШильдЗаказан = Истина;
		КонецЕсли;
		
		НЗ.Записать();
		
		СерииЗаписаны = Истина;
		
	Иначе             
		
		НЗ.Очистить();
		Для й = 1 по ДанныеЭтапа.Количество Цикл 
			СерийныйНомер = СгененироватьСерийныйНомер(ДанныеЭтапа.Номенклатура, ДанныеЭтапа.ДатаЗапуска, й, НачальныйНомер + й - 1);
			СтрНЗ = НЗ.Добавить(); 
			ЗаполнитьЗначенияСвойств(СтрНЗ,ДанныеЭтапа);
			СтрНЗ.Регистратор = СсылкаНаЭтап.Ссылка;
			СтрНЗ.Период = ДанныеЭтапа.ДатаЗапуска;
			СтрНЗ.ВидДвижения = ВидДвиженияНакопления.Приход;
			СтрНЗ.Количество = 1;
			СтрНЗ.СерийныйНомер = СерийныйНомер;
			СтрНЗ.ШильдЗаказан = Истина;
		КонецЦикла;
		Попытка
			НЗ.Записать();
			СерииЗаписаны = Истина;
		Исключение
			СерииЗаписаны = Ложь;
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат СерииЗаписаны;
		
КонецФункции  

Функция ПолучитьДанныеЭтапа(СсылкаНаЭтап) Экспорт
	
	ДанныеЭтапа = Новый Структура("СсылкаНаЭтап, Склад, Номенклатура, Назначение, ДатаЗапуска, Количество"); //ВидНоменклатуры
	ТЗВыходныеИзделия = СсылкаНаЭтап.ВыходныеИзделия.Выгрузить(,"Получатель, Номенклатура, Назначение, Количество");
	ТЗВыходныеИзделия.Свернуть("Получатель, Номенклатура, Назначение", "Количество");
	ЗаполнитьЗначенияСвойств(ДанныеЭтапа,ТЗВыходныеИзделия[0]); 
	ДанныеЭтапа.Склад = ТЗВыходныеИзделия[0].Получатель;
	//ДанныеЭтапа.ВидНоменклатуры = ДанныеЭтапа.Номенклатура.ВидНоменклатуры;        
	ДанныеЭтапа.ДатаЗапуска = СсылкаНаЭтап.ФактическоеНачалоЭтапа;
	ДанныеЭтапа.Количество = СсылкаНаЭтап.КоличествоУпаковокПлан;
	
	Возврат ДанныеЭтапа;
	
КонецФункции

//Старый вариант по видам номенклатуры
Функция ТТМНеобходимостьИспользованияСерий(ВидНоменклатуры, ДатаЗапуска) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВидыНоменклатуры.Ссылка КАК ВидНоменклатуры
	               |ПОМЕСТИТЬ ВТ_ВидНоменклатуры
	               |ИЗ
	               |	Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
	               |ГДЕ
	               |	ВидыНоменклатуры.Ссылка = &Видноменклатуры
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ДополнительныеСведения.Значение КАК Значение,
	               |	ДополнительныеСведения.Свойство.Имя КАК ИмяСвойства,
	               |	ДополнительныеСведения.Свойство КАК Свойство
	               |ИЗ
	               |	ВТ_ВидНоменклатуры КАК ВТ_ВидНоменклатуры
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
	               |		ПО (ДополнительныеСведения.Объект ССЫЛКА Справочник.ВидыНоменклатуры)
	               |			И ВТ_ВидНоменклатуры.ВидНоменклатуры = ДополнительныеСведения.Объект
	               |ГДЕ
	               |	ДополнительныеСведения.Свойство = &СвойствоИспользоватьСерии
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ДополнительныеСведения.Значение КАК Значение,
	               |	ДополнительныеСведения.Свойство.Имя КАК ИмяСвойства,
	               |	ДополнительныеСведения.Свойство КАК Свойство
	               |ИЗ
	               |	ВТ_ВидНоменклатуры КАК ВТ_ВидНоменклатуры
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
	               |		ПО (ДополнительныеСведения.Объект ССЫЛКА Справочник.ВидыНоменклатуры)
	               |			И ВТ_ВидНоменклатуры.ВидНоменклатуры = ДополнительныеСведения.Объект
	               |ГДЕ
	               |	ДополнительныеСведения.Свойство = &СвойствоДатаНачалаУчетаСерий";
	
	Запрос.УстановитьПараметр("СвойствоИспользоватьСерии", ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("имя","ИспользоватьСерииТТМ_ТТМ"));
	Запрос.УстановитьПараметр("СвойствоДатаНачалаУчетаСерий", ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("имя","ДатаНачалаВеденияСерийныхНомеров_ТТМ"));
	Запрос.УстановитьПараметр("Видноменклатуры", ВидНоменклатуры);
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	ИспользоватьСерии = МассивРезультатов[1].Выбрать();
	ДатаНачалаИспользованияСерий = МассивРезультатов[2].Выбрать();
	
	Если ИспользоватьСерии.Следующий() и ИспользоватьСерии.Значение 
		и ДатаНачалаИспользованияСерий.Следующий() и ДатаНачалаИспользованияСерий.Значение <= ДатаЗапуска Тогда 
		Возврат Истина;
	Иначе
		Возврат Ложь;	
	КонецЕсли;
	
КонецФункции

//&НаСервереБезКонтекста
Функция ПроверитьУстановитьУчетСерийныхНомеров(Номенклатура, ВключитьУчетСерийныхНомеров = Ложь) Экспорт
	
	ДополнительныйРеквизит = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("Имя","УчитываатьСерийныеНомераНоменклатуры_ТТМ");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	НоменклатураДополнительныеРеквизиты.Ссылка КАК Ссылка,
	               |	НоменклатураДополнительныеРеквизиты.Свойство КАК Свойство,
	               |	НоменклатураДополнительныеРеквизиты.Значение КАК Значение
	               |ИЗ
	               |	Справочник.Номенклатура.ДополнительныеРеквизиты КАК НоменклатураДополнительныеРеквизиты
	               |ГДЕ
	               |	НоменклатураДополнительныеРеквизиты.Ссылка = &Номенклатура
	               |	И НоменклатураДополнительныеРеквизиты.Свойство = &ДопРеквизитУчетСерий";
	
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("ДопРеквизитУчетСерий",ДополнительныйРеквизит);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() и Выборка.Значение Тогда
		Если ВключитьУчетСерийныхНомеров Тогда 
			Сообщить("Учет серий уже включен для данной номенклатуры " + Выборка.Ссылка + "!");
			Возврат Истина;
		Иначе 
			Возврат Истина;
		КонецЕсли;
	Иначе  
		Если ВключитьУчетСерийныхНомеров Тогда 
			//Номенклатура = Справочники.Номенклатура.СоздатьЭлемент();    
			УстановитьПривилегированныйРежим(Истина);
			НоменклатураОбъект = Номенклатура.ПолучитьОбъект();
			НоваяСтрока = НоменклатураОбъект.ДополнительныеРеквизиты.Добавить();
			НоваяСтрока.Свойство = ДополнительныйРеквизит;
			НоваяСтрока.Значение = Истина;
			Попытка
				НоменклатураОбъект.Записать();         
				УстановитьПривилегированныйРежим(Ложь);
				Возврат Истина;
			Исключение
				Сообщить("Ошибка при записи номенклатуры" + ОписаниеОшибки());
				УстановитьПривилегированныйРежим(Ложь);
				Возврат Ложь;
			КонецПопытки;
		Иначе 
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

Функция СгененироватьСерийныйНомер(Номенклатура, Дата, ПорядковыйНомерЕдиницыИзделия, НачальныйНомер = 0) Экспорт
		
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДополнительныеСведения.Значение КАК КодТМ
	               |ИЗ
	               |	Справочник.Номенклатура КАК Номенклатура
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
	               |		ПО (Номенклатура.Ссылка = (ВЫРАЗИТЬ(ДополнительныеСведения.Объект КАК Справочник.Номенклатура)))
	               |ГДЕ
	               |	Номенклатура.Ссылка = &Номенклатура
	               |	И ДополнительныеСведения.Свойство = &ТТМСвойствоНомерТМ";               
	ТТМСвойствоНомерТМ = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("Имя","КодТМ_ТТМ");
	Запрос.УстановитьПараметр("ТТМСвойствоНомерТМ",ТТМСвойствоНомерТМ);
	Запрос.УстановитьПараметр("Номенклатура",Номенклатура);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		КодТМ0 = Выборка.КодТМ;
		мКодТМ = СтрРазделить(КодТМ0,"TM -+.ТМ",Ложь);
		ЧастьНомера1 = ДополнитьНомерТМВедущимиНулями(мКодТМ[0]);
		ЧастьНомера2 = СтрЗаменить(Формат(Дата,"ДФ=yyyy"),"0","") + Формат(Дата,"ДФ=ММ");
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ТТМ_УчетСерийныхНомеровПродукции.Номенклатура КАК Номенклатура,
		               |	МАКСИМУМ(ТТМ_УчетСерийныхНомеровПродукции.СерийныйНомер) КАК ПоследнийСерийныйНомер
		               |ИЗ
		               |	РегистрНакопления.ТТМ_УчетСерийныхНомеровПродукции КАК ТТМ_УчетСерийныхНомеровПродукции
		               |ГДЕ
		               |	ТТМ_УчетСерийныхНомеровПродукции.СерийныйНомер ПОДОБНО &НачалоСН
		               |	И ТТМ_УчетСерийныхНомеровПродукции.Номенклатура = &Номенклатура
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	ТТМ_УчетСерийныхНомеровПродукции.Номенклатура";
		
		Запрос.УстановитьПараметр("НачалоСН", СтрШаблон("%1-%2",ЧастьНомера1,Лев(ЧастьНомера2,СтрДлина(ЧастьНомера2)-2)+"%"));  
		Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		
		Если не ЗначениеЗаполнено(НачальныйНомер) Тогда 
			ПредыдущйНомер = 100;
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл                                                        
				Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ПоследнийСерийныйНомер) Тогда 
					МассивСтрокНомера = СтрРазделить(ВыборкаДетальныеЗаписи.ПоследнийСерийныйНомер,"-");
					ПредыдущйНомер = Число(МассивСтрокНомера[2]);
				Иначе   
					ПредыдущйНомер = ПредыдущйНомер;
					//ПредыдущйНомер = ?(ВыборкаДетальныеЗаписи.ПоследнийСерийныйНомер=NUll,ПредыдущйНомер,Число(Прав(ВыборкаДетальныеЗаписи.ПоследнийСерийныйНомер,5)));
				КонецЕсли;
			КонецЦикла;
		Иначе 
			ПредыдущйНомер = Число(НачальныйНомер) - 1;
		КонецЕсли;     

		ЧастьНомера3 = Формат(ПредыдущйНомер + 1, "ЧЦ=4; ЧВН=; ЧГ=0");  //ПорядковыйНомерЕдиницыИзделия
		//ЧастьНомера3 = Формат(ПредыдущйНомер+1,"ЧЦ=4; ЧВН=; ЧГ=0");

		Возврат СтрШаблон("%1-%2-%3",ЧастьНомера1,ЧастьНомера2,ЧастьНомера3);
	Иначе     
		Сообщить("КодТМ для продукции не установлен!",СтатусСообщения.Важное);
		ПустаяСтр = "";
		Возврат ПустаяСтр;
	КонецЕсли;
	
КонецФункции

