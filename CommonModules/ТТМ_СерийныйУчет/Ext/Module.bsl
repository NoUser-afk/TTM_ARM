	РезультатУчетСерий = МассивРезультатов[3];       //[0]
	РезультатЗапроса = МассивРезультатов[2];         //[1]
		
	Если РезультатУчетСерий.Пустой() Тогда 
		ЕстьВсеСерии = Истина;        
		Возврат Неопределено
	КонецЕсли;
	
	Если РезультатЗапроса.Пустой() и не РезультатУчетСерий.пустой() Тогда 
		Сообщить("Отсутствуют остатки серийных номеров для реализации продукции!"); 
		ЕстьВсеСерии = Ложь;
		Возврат Неопределено;
	КонецЕсли;    
	
