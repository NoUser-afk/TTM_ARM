	ПараметрыПоиска = Новый Структура("ДокументРеализации", ИсточникРТУ.Ссылка); 
	//ТабДоступныеСерии = Новый ТаблицаЗначений;    
	ТабСтрокиПривязанныеКРеализации = ТабДоступныеСерии.Скопировать(ПараметрыПоиска,); 
	ЕстьПривязанныеСтроки = ТабСтрокиПривязанныеКРеализации.Количество() > 0;  //* не используется пока *//
		
	ЕстьВсеСН = Истина;
	СообщениеНЕдостаточноСерийныхНомеров = "";
	ТЗРезультат = ТабДоступныеСерии.Скопировать();
	ТЗРезультат.Очистить();
	  
	Подобрано = 0;
	Для Каждого СтрокаРеализации Из ТабДоступныеСерии Цикл   
		
		СтруктураОтбора = Новый Структура("Номенклатура",СтрокаРеализации.Номенклатура);
		ДоступныеСерийныеНомера = ТабДоступныеСерии.НайтиСтроки(СтруктураОтбора);
		ПодобранныеСерийныеНомера = ТЗРезультат.НайтиСтроки(СтруктураОтбора);
		Если ПодобранныеСерийныеНомера.Количество() = СтрокаРеализации.КоличествоРеализации Тогда 
