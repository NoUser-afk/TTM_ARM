#Область ПечатьQR 

&НаСервере
Функция СформироватьТабличныйДокументQRПакет(МассивСтрокЭтапов, ОдинQRНаУпаковку = Ложь) Экспорт

	Если МассивСтрокЭтапов = Неопределено Или МассивСтрокЭтапов.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	ТабДок = Новый ТабличныйДокумент;
	Макет = ПолучитьОбщийМакет("ДР_QR_ЭтикеткаНоменклатуры");

	МаксЭтикеток = 500;
	СчетчикЭтикеток = 0;
	ПервыйВывод = Истина;

	Для каждого СтрЭтапа Из МассивСтрокЭтапов Цикл

		Если ТипЗнч(СтрЭтапа) <> Тип("Структура")
		   Или НЕ СтрЭтапа.Свойство("Номенклатура")
		   Или СтрЭтапа.Номенклатура = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		// 1) Базовые данные (Количество по строке пока внутри ДанныеQR)
		ДанныеQR = ДР_ПолучитьДанныеQR(СтрЭтапа);

		// 2) Разделяем "сколько печатать" и "что кодировать"
		ПарамПечати = ДР_РассчитатьПараметрыПечати(СтрЭтапа, ОдинQRНаУпаковку);
		КоличествоЭтикеток = ПарамПечати.КоличествоЭтикеток;

		// ВАЖНО: количество, которое попадет в QR и в текст на этикетке
		ДанныеQR.Количество = ПарамПечати.КоличествоВQR;

		// 3) Генерим QR под "КоличествоВQR"
		СтрокаQR = ДР_СформироватьСтрокуQR(ДанныеQR);
		QRКартинка = ДР_СгенерироватьКартинкуQR(СтрокаQR);

		Для Счетчик = 1 По КоличествоЭтикеток Цикл

			СчетчикЭтикеток = СчетчикЭтикеток + 1;
			Если СчетчикЭтикеток > МаксЭтикеток Тогда
				ВызватьИсключение "Превышен лимит печати этикеток (" + Строка(МаксЭтикеток) + ").";
			КонецЕсли;

			Обл = Макет.ПолучитьОбласть("Этикетка");
			Обл.Рисунки.QR.Картинка = QRКартинка;
			Обл.Рисунки.QR.РазмерКартинки = РазмерКартинки.Пропорционально;

			Обл.Параметры.Наименование    = ДанныеQR.Наименование;
			Обл.Параметры.СерийныйНомер   = ДанныеQR.СерийныйНомер;
			Обл.Параметры.НомерЗаказаДР   = ДанныеQR.НомерЗаказаДР;
			Обл.Параметры.ДатаЗаказа      = ДанныеQR.ДатаЗаказа;
			Обл.Параметры.Количество      = ДанныеQR.Количество;

			Если НЕ ПервыйВывод Тогда
				ТабДок.ВывестиГоризонтальныйРазделительСтраниц();
			Иначе
				ПервыйВывод = Ложь;
			КонецЕсли;

			ТабДок.Вывести(Обл);

		КонецЦикла;

	КонецЦикла;

	Возврат ТабДок;

КонецФункции

&НаСервере
Функция СформироватьТабличныйДокументQR(ДанныеСтрокиЭтапа) Экспорт
	М = Новый Массив;
	М.Добавить(ДанныеСтрокиЭтапа);
	Возврат СформироватьТабличныйДокументQRПакет(М);
КонецФункции

&НаСервере
Функция ДР_ПолучитьДанныеQR(ДанныеСтрокиЭтапа) Экспорт

	НоменклатураСсылка = ДанныеСтрокиЭтапа.Номенклатура;
	Назначение = ДанныеСтрокиЭтапа.Назначение;
	Дата = ДанныеСтрокиЭтапа.ДатаНазначения;
	Количество = ДанныеСтрокиЭтапа.Количество;

	Рез = Новый Структура;

	Рез.Вставить("КодИзделияДР",  ДР_ПолучитьКодИзделияДР(НоменклатураСсылка));
	Рез.Вставить("НомерЗаказаДР", Назначение);
	Рез.Вставить("ДатаЗаказа", Дата); 
	Рез.Вставить("СерийныйНомер", "");
	Рез.Вставить("Наименование", ДР_ПолучитьНаименование(НоменклатураСсылка));
	Рез.Вставить("Количество", Количество);

	Если ДанныеСтрокиЭтапа.Свойство("СерийныйНомер") И ДанныеСтрокиЭтапа.СерийныйНомер <> Неопределено Тогда
		Рез.СерийныйНомер = Строка(ДанныеСтрокиЭтапа.СерийныйНомер);
	КонецЕсли;

	Возврат Рез;

КонецФункции

&НаСервере
Функция ДР_ПолучитьКодИзделияДР(НоменклатураСсылка) Экспорт

	Если НоменклатураСсылка = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	ИмяДопРеквизита = "АртикулДР_547609cb63294018b4f565c6953c99e0";

	Значение = УправлениеСвойствами.ЗначениеСвойства(НоменклатураСсылка, ИмяДопРеквизита);
	// ЗначениеСвойства принимает вторым параметром также строку-имя доп. свойства. 

	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат Строка(Значение);

КонецФункции

&НаСервере
Функция ДР_ПолучитьНаименование(НоменклатураСсылка) Экспорт

	Значение = НоменклатураСсылка.Наименование;
	Возврат Строка(Значение);
	
КонецФункции

&НаСервере
Функция ДР_СформироватьСтрокуQR(ДанныеQR) Экспорт  // ТУТ СОСТАВЛЯЕТСЯ СТРОКА, КОТОРАЯ БУДЕТ ЗАШИТА В QR КОД
	Возврат
		ДР_ЭкранироватьЗначениеQR(ДанныеQR.КодИзделияДР)
		+ ";" + ДР_ЭкранироватьЗначениеQR(ДанныеQR.НомерЗаказаДР) + "," + ДР_ЭкранироватьЗначениеQR(ДанныеQR.ДатаЗаказа)
		+ ";" + ДР_ЭкранироватьЗначениеQR(ДанныеQR.СерийныйНомер)
		+ ";" + ДР_ЭкранироватьЗначениеQR(ДанныеQR.Количество)
		+ ";" + "0194" ;
КонецФункции

&НаСервере
Функция ДР_ЭкранироватьЗначениеQR(Значение) Экспорт
	С = Строка(Значение);
	С = СтрЗаменить(С, Символы.ПС, " ");
	С = СтрЗаменить(С, Символы.ВК, " ");
	С = СтрЗаменить(С, ";", ",");
	Возврат С;
КонецФункции

&НаСервере
Функция ДР_СгенерироватьКартинкуQR(СтрокаQR) Экспорт

	Парам = ГенерацияШтрихкода.ПараметрыГенерацииШтрихкода();

	// ТипКода: 16 - QR 
	Парам.ТипКода  = 16;
	Парам.Штрихкод = СтрокаQR;

	// Размер 
	Парам.Ширина = 300;
	Парам.Высота = 300;

	// Не печатаем текст значения под QR
	Если Парам.Свойство("ОтображатьТекст") Тогда
		Парам.ОтображатьТекст = Ложь;
	КонецЕсли;

	// Коррекция QR (0-L,1-M,2-Q,3-H) 
	Если Парам.Свойство("УровеньКоррекцииQR") Тогда
		Парам.УровеньКоррекцииQR = 1; // M
	КонецЕсли;

	Если Парам.Свойство("ПрозрачныйФон") Тогда
		Парам.ПрозрачныйФон = Ложь;
	КонецЕсли;

	Если Парам.Свойство("Масштабировать") Тогда
		Парам.Масштабировать = Истина;
	КонецЕсли;

	Если Парам.Свойство("СохранятьПропорции") Тогда
		Парам.СохранятьПропорции = Истина;
	КонецЕсли;

	Рез = ГенерацияШтрихкода.ИзображениеШтрихкода(Парам);

	Если ТипЗнч(Рез) = Тип("Структура") Тогда
		Если Рез.Свойство("Результат") И НЕ Рез.Результат Тогда
			ВызватьИсключение "Не удалось сгенерировать QR-код (ГенерацияШтрихкода.ИзображениеШтрихкода).";
		КонецЕсли;

		Если Рез.Свойство("Картинка") Тогда
			Возврат Рез.Картинка;
		КонецЕсли;
	КонецЕсли;

	Возврат Рез;

КонецФункции

&НаСервере
Функция ДР_ОпределитьКоличествоЭтикеток(ДанныеСтрокиЭтапа) Экспорт
	Колво = 1;

	Если ДанныеСтрокиЭтапа.Свойство("Количество") И ЗначениеЗаполнено(ДанныеСтрокиЭтапа.Количество) Тогда
		Попытка
			Колво = Цел(ДанныеСтрокиЭтапа.Количество);
		Исключение
			Колво = 1;
		КонецПопытки;
	КонецЕсли;

	Если Колво < 1 Тогда
		Колво = 1;
	КонецЕсли;

	// Защита от случайной печати “100500” этикеток
	Если Колво > 200 Тогда
		Колво = 200;
	КонецЕсли;

	Возврат Колво;
КонецФункции

&НаСервере
Функция ДР_РассчитатьПараметрыПечати(СтрЭтапа, ОдинQRНаУпаковку)

	КоличествоПоСтроке = 1;
	Если ТипЗнч(СтрЭтапа) = Тип("Структура") Тогда
		Если НЕ СтрЭтапа.Свойство("Количество", КоличествоПоСтроке) Или КоличествоПоСтроке = Неопределено Тогда
			КоличествоПоСтроке = 1;
		КонецЕсли;
	КонецЕсли;

	Если КоличествоПоСтроке <= 0 Тогда
		КоличествоПоСтроке = 1;
	КонецЕсли;

	Серия = "";
	ЕстьСерия = Ложь;
	Если ТипЗнч(СтрЭтапа) = Тип("Структура") И СтрЭтапа.Свойство("СерийныйНомер", Серия) Тогда
		ЕстьСерия = ЗначениеЗаполнено(Серия);
	КонецЕсли;

	Если ЕстьСерия Тогда
		// Серийная продукция: всегда 1 этикетка и количество в QR = 1
		КоличествоЭтикеток = 1;
		КоличествоВQR = 1;

	Иначе

		Если ОдинQRНаУпаковку Тогда
			// 1 этикетка, в QR количество = количество строки
			КоличествоЭтикеток = 1;
			КоличествоВQR = КоличествоПоСтроке;
		Иначе
			// Поштучно: N этикеток, в QR количество = 1
			// Если количество не целое — поштучно не печатаем, ведем себя как "упаковка"
			Если КоличествоПоСтроке = Цел(КоличествоПоСтроке) Тогда
				КоличествоЭтикеток = Цел(КоличествоПоСтроке);
				КоличествоВQR = 1;
			Иначе
				КоличествоЭтикеток = 1;
				КоличествоВQR = КоличествоПоСтроке;
			КонецЕсли;
		КонецЕсли;

	КонецЕсли;

	Возврат Новый Структура("КоличествоЭтикеток,КоличествоВQR", КоличествоЭтикеток, КоличествоВQR);

КонецФункции

#КонецОбласти
