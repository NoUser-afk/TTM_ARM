//Выполняет действие по заполнению обеспечения в заказе из списка заказов после задания вопроса об отгрузке одной датой.
//
// Параметры:
//  Параметры - Структура - структура параметров:
//   * КодДействия - Строка - условное обозначение команды "ДЕЙСТВИЕ_КОБЕСПЕЧЕНИЮ" или "ДЕЙСТВИЕ_ОТГРУЗИТЬ"
//                   или "ДЕЙСТВИЕ_РЕЗЕРВИРОВАТЬ" или "ДЕЙСТВИЕ_НЕОБЕСПЕЧИВАТЬ"
//   * ПараметрыЗаполнения - Структура - структура параметров:
//     ** СнятьФлагОтгружатьОднойДатой - Булево - результат ответа на вопрос об отгрузке одной датой.
//     ** ЗаполнитьДатуОтгрузкиОднойДатой - Булево - результат ответа на вопрос об отгрузке одной датой.
//   * Заказы - Массив из ЛюбаяСсылка - заказы для установки действия.
//   * ПараметрыВстраивания - см. ДоступныеОстаткиПараметрыВстраивания
//   * МассивСтрок - Массив отобранных строк - при отсутствии будут обработаны все строки объекта
//
// Возвращаемое значение:
//  Структура - структура с полями:
//   * СписокОшибок - Массив - массив содержащий тексты ошибок обработки документов.
//   * КоличествоОбработано - Число - количество обработанных документов.
//
Функция ВыполнитьДействиеДляЗаказовПослеВопроса(Параметры, Знач МассивСтрок = Неопределено) Экспорт
	
	Заказы = Параметры.Заказы;
	ПараметрыВстраивания = Параметры.ПараметрыВстраивания;
	Если ПараметрыВстраивания = Неопределено И Заказы.Количество() > 0 Тогда
		
		МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Заказы[0]);
		ПараметрыВстраивания = МенеджерОбъекта.ДоступныеОстаткиПараметрыВстраивания();
		
	КонецЕсли;
	
	КодДействия = Параметры.КодДействия;
	ПараметрыЗаполнения = Параметры.ПараметрыЗаполнения;
	Результат = Новый Структура("СписокОшибок,КоличествоОбработано", Новый Массив);
		
	Для Каждого Ссылка Из Заказы Цикл
		
		ТекстОшибки = "";
		
		НачатьТранзакцию();
		Попытка
			
			ТекстОшибки = НСтр("ru = 'Не удалось заблокировать объект, возможно он редактируется. Для %1 установка действия не выполнена.';
								|en = 'Cannot lock the object, it may be being edited. Cannot set action for %1.'");
			
			ЗаблокироватьДанныеДляРедактирования(Ссылка);
			
			Блокировка = Новый БлокировкаДанных();
			
			ЭлементБлокировки = Блокировка.Добавить(Ссылка.Метаданные().ПолноеИмя());
			ЭлементБлокировки.УстановитьЗначение("Ссылка", Ссылка);
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			
			ТекстОшибки = НСтр("ru = 'Не удалось установить блокировку объекта. Для %1 установка действия не выполнена.';
								|en = 'Cannot set object lock. Cannot set action for %1.'");
			
			Блокировка.Заблокировать();
			
			ТекстОшибки = НСтр("ru = 'Не удалось обработать объект. Для %1 установка действия не выполнена.';
								|en = 'Cannot process object. Cannot set action for %1.'");
			
			ДокументОбъект = Ссылка.ПолучитьОбъект();
			
			Если ДокументОбъект.Проведен Тогда			
				Если МассивСтрок = Неопределено Тогда
					ТаблицаИзменений = ОбеспечениеВДокументахСервер.ЗаполнитьВариантОбеспеченияПоОстаткамДляВыделенныхСтрокОбъекта(
						ДокументОбъект,
						КодДействия,
						ПараметрыЗаполнения,
						Неопределено,
						ПараметрыВстраивания);
				Иначе
					ТаблицаИзменений = ОбеспечениеВДокументахСервер.ЗаполнитьВариантОбеспеченияПоОстаткамДляВыделенныхСтрокОбъекта(
						ДокументОбъект,
						КодДействия,
						ПараметрыЗаполнения, 
						МассивСтрок,
						ПараметрыВстраивания);
				КонецЕсли;
					
				Если КодДействия = "ДЕЙСТВИЕ_ОТГРУЗИТЬ" И ТаблицаИзменений.Количество() > 0 Тогда
					
					ВопросБылЗадан = ПараметрыЗаполнения <> Неопределено;
					НуженВопрос = ПараметрыВстраивания.ВыражениеДляВопросаПриВыполненииДействияВСпискеЗаказов <> "НЕОПРЕДЕЛЕНО"
						И НуженВопросОбОтгрузкеОднойДатой(ПараметрыВстраивания, Ссылка);
					
					Если ВопросБылЗадан <> НуженВопрос Тогда
						Текст = НСтр("ru = 'Ошибка заполнения действия в списке документов. Изменились данные документов.';
									|en = 'Action population error in the documents list. The documents data has been changed.'");
						ВызватьИсключение Текст;
					КонецЕсли;
						
				КонецЕсли;
				
				РежимЗаписи = РежимЗаписиДокумента.Проведение;
				
				ТекстОшибки = НСтр("ru = 'Не удалось записать/провести объект. Для %1 установка действия не выполнена.';
									|en = 'Cannot save/post object. Cannot set action for %1.'");
				
				Если ДокументОбъект.ПроверитьЗаполнение() Тогда
					ДокументОбъект.Записать(РежимЗаписи);
				Иначе
					
					Результат.СписокОшибок.Добавить(Новый Структура("Текст,Ссылка", СтрШаблон(ТекстОшибки, Ссылка), Ссылка));
					
					Для Каждого ТекОшибка Из ПолучитьСообщенияПользователю(Истина) Цикл
						
						Ошибка = Новый Структура;
						Ошибка.Вставить("Ссылка", Ссылка);
						Ошибка.Вставить("Текст",  ТекОшибка.Текст);
						Ошибка.Вставить("Поле",   ТекОшибка.Поле);
						Ошибка.Вставить("ПутьКДанным", ТекОшибка.ПутьКДанным);
						
						Результат.СписокОшибок.Добавить(Ошибка);
						
					КонецЦикла;
					
				КонецЕсли;
				
			Иначе
				ТекстОшибки = НСтр("ru = 'Документ %1 не проведен и не будет обработан.';
									|en = 'Document %1 has not been posted and will not be processed.'");
				Результат.СписокОшибок.Добавить(Новый Структура("Текст,Ссылка", СтрШаблон(ТекстОшибки, Ссылка), Ссылка));
			КонецЕсли;
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			ОтменитьТранзакцию();
			
			ПараметрыЖурнала = Новый Структура("ГруппаСобытий, Метаданные, Данные");
			ПараметрыЖурнала.ГруппаСобытий = НСтр("ru = 'Заполнение действий в заказе';
													|en = 'Action population in order'");
			ПараметрыЖурнала.Метаданные    = Ссылка.Метаданные();
			ПараметрыЖурнала.Данные        = Ссылка;
			ОбщегоНазначенияУТ.ЗаписатьВЖурналСообщитьПользователю(
				ПараметрыЖурнала,
				УровеньЖурналаРегистрации.Информация,
				НСтр("ru = 'Заполнение действий в заказе';
					|en = 'Action population in order'"),
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			Результат.СписокОшибок.Добавить(Новый Структура("Текст,Ссылка", СтрШаблон(ТекстОшибки, Ссылка), Ссылка));
			
		КонецПопытки;
		
	КонецЦикла;
	Результат.КоличествоОбработано = Заказы.Количество() - Результат.СписокОшибок.Количество();
	
	Возврат Результат;
	
КонецФункции

Функция НуженВопросОбОтгрузкеОднойДатой(ПараметрыВстраивания, Заказы)
	
			Текст =
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	Заказы.Номенклатура КАК Номенклатура,
				|	Заказы.Характеристика КАК Характеристика,
				|	Заказы.Склад КАК Склад,
				|	Заказы.Назначение КАК Назначение
				|ПОМЕСТИТЬ Товары
				|ИЗ
				|	РегистрНакопления.ЗапасыИПотребности.Остатки(, Заказ В(&Заказы)) КАК Заказы
				|ГДЕ
				|	Заказы.РезервироватьНаСкладеОстаток > 0
				|		ИЛИ Заказы.РезервироватьПоМереПоступленияОстаток > 0
				|		ИЛИ Заказы.КОбеспечениюОстаток > 0
				|		ИЛИ Заказы.НеОбеспечиватьОстаток > 0";
	
	Если РаспределениеЗапасов.ЭтоПроизводительныйРежим() Тогда
		Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	ИСТИНА КАК НуженВопрос
			|ИЗ
			|	РегистрНакопления.ЗапасыИПотребности.Остатки(,
			|		Заказ В(
			|			ВЫБРАТЬ
			|				Таблица.Ссылка КАК Заказ
			|			ИЗ
			|				&Таблица КАК Таблица
			|			ГДЕ
			|				Таблица.Ссылка В(&Заказы)
			|					И Таблица.Проведен
			|					И (&Выражение) <> НЕОПРЕДЕЛЕНО
			|					И (&Выражение) < &ДатаОтгрузкиНовыхСтрок)) КАК Заказы
			|ГДЕ
			|	Заказы.РезервироватьНаСкладеОстаток > 0
			|		ИЛИ Заказы.РезервироватьПоМереПоступленияОстаток > 0
			|		ИЛИ Заказы.КОбеспечениюОстаток > 0
			|		ИЛИ Заказы.НеОбеспечиватьОстаток > 0";
	Иначе
		Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	ИСТИНА КАК НуженВопрос
			|ИЗ
			|	&Таблица КАК Таблица
			|ГДЕ
			|	Таблица.Ссылка В(&Заказы)
			|		И Таблица.Проведен
			|		И (&Выражение) <> НЕОПРЕДЕЛЕНО
			|		И (&Выражение) < &ДатаОтгрузкиНовыхСтрок
			|		И ИСТИНА В(
			|			ВЫБРАТЬ ПЕРВЫЕ 1
			|				ИСТИНА КАК ЕстьЗаписи
			|			ИЗ
			|				РегистрСведений.РаспределениеЗапасов КАК ЗаписиЗаказа
			|			ГДЕ
			|				ЗаписиЗаказа.Состояние = ЗНАЧЕНИЕ(Перечисление.РаспределениеЗапасовСостояния.ОжидаемаяОтгрузка)
			|					И ЗаписиЗаказа.ЗаказНаОтгрузку = Таблица.Ссылка)";
	КонецЕсли;
	Текст = СтрЗаменить(Текст, "&Таблица", ПараметрыВстраивания.ИмяОбъекта);
	Текст = СтрЗаменить(Текст, "&Выражение", ПараметрыВстраивания.ВыражениеДляВопросаПриВыполненииДействияВСпискеЗаказов);
	
	Запрос = Новый Запрос(Текст);
	
	ДатаОтгрузкиНовыхСтрок = НачалоДня(ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("ДатаОтгрузкиНовыхСтрок", ДатаОтгрузкиНовыхСтрок);
	Запрос.УстановитьПараметр("Заказы", Заказы);
	НуженВопрос = Не Запрос.Выполнить().Пустой();
	
	Возврат НуженВопрос;
	
КонецФункции

//Изменение даты отгрузки в документе Заказ клиента
//
// Параметры:
//   * МассивСтрокКИзменению - Массив структур:
//		- Назначение - СправочникСсылка.Назначения
//		- ЗаказКлиента - ДокументСсылка.ЗаказКлиента
//		- ПлановаяДатаОтгрузки - Дата
//		- НоваяДатаОтгрузки - Дата
//		- ИдентификаторСтроки - Строка(36)
//		- Номенклатура - СправочникСсылка.Номенклатура
//		- Количество - Число(15, 3)
//		- КоличествоУпаковок - Число(15, 3)
//
// Возвращаемое значение:
//	Результат выполнения операции - Булево
Функция ОбработатьСтрокиТабличногоДокументаВЗаказеКлиента(МассивСтрокКИзменению, Знач РедактироватьСтрокиТЧ = Ложь) Экспорт
	
	ИерархияЗаказов = ПолучитьИерархиюЗаказовПередИзменением(МассивСтрокКИзменению);
	ВсегоОбъектов = ИерархияЗаказов.Строки.Количество();
	ОбработанныйОбъект = 1;
	
	НачалоЗамера = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	Для Каждого СтрокаВерхнегоУровня Из ИерархияЗаказов.Строки Цикл
		
		СтруктураПересчетаСуммы = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(СтрокаВерхнегоУровня.ЗаказКлиента);
		ЗаполнитьСтавкуНДС = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПараметрыЗаполненияСтавкиНДС(СтрокаВерхнегоУровня.ЗаказКлиента, Истина);
		КэшированныеЗначения = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
		
		СтруктураДействий = Новый Структура;
		СтруктураДействий.Вставить("ПересчитатьСумму");
		СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомАвтоматическойСкидки", Новый Структура("Очищать", Ложь));
		СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомРучнойСкидки", Новый Структура("Очищать, ПересчитыватьСуммуРучнойСкидки", Ложь, Ложь));
		СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомСкидкиБонуснымиБаллами");
		СтруктураДействий.Вставить("ПересчитатьСуммуНДС", СтруктураПересчетаСуммы);
		СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураПересчетаСуммы);
		
		ДокОбъект = СтрокаВерхнегоУровня.ЗаказКлиента.ПолучитьОбъект();
		РежимЗаписи = РежимЗаписиДокумента.Проведение;
		СтрокиОбработаны = Ложь;
		
		Для Каждого СтрокаТЧ Из ДокОбъект.Товары Цикл
			СтрокаТЧНайдена = Ложь;
			
			Для Каждого СтрокаНижнегоУровня Из СтрокаВерхнегоУровня.Строки Цикл
				Если СтрокаТЧ.Номенклатура = СтрокаНижнегоУровня.Номенклатура И СтрокаТЧ.ИдентификаторСтроки = СтрокаНижнегоУровня.ИдентификаторСтроки Тогда
					СтрокаТЧНайдена = Истина;
					ЗначениеКИзменению = СтрокаНижнегоУровня.НоваяДатаОтгрузки; 
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если СтрокаТЧНайдена Тогда
				СтрокаТЧ.ДатаОтгрузки = ЗначениеКИзменению;					
				ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(СтрокаТЧ, СтруктураДействий, КэшированныеЗначения);
				СтрокиОбработаны = Истина;	
			КонецЕсли; 
		КонецЦикла;
			
		Если РедактироватьСтрокиТЧ И СтрокиОбработаны Тогда
			Попытка
				НачатьТранзакцию();	
				ВзаиморасчетыСервер.ПередЗаписью(ДокОбъект, Ложь, РежимЗаписи);
				ДокОбъект.Записать(РежимЗаписи);
				ЗафиксироватьТранзакцию();
				СтатусВыполнения = Истина; 
			Исключение
				ОтменитьТранзакцию();
				ДлительныеОперации.СообщитьПрогресс(-1, "Ошибка при записи документа");
				СтатусВыполнения = Ложь;
				ВызватьИсключение ОписаниеОшибки();
				
				ЗаписьЖурналаРегистрации(НСтр("ru = 'Выполнение операции'"), 
					УровеньЖурналаРегистрации.Ошибка,,, 
					ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
		КонецЕсли;
		
		ВремяЗаписиОбъекта = ТекущаяУниверсальнаяДатаВМиллисекундах();
		СообщениеОбОставшемсяВремени = ПодсчетОставшегосяВремени(НачалоЗамера, ВремяЗаписиОбъекта, ВсегоОбъектов, ОбработанныйОбъект);
						
		Если Не (ОбработанныйОбъект % 10) Тогда
			ДлительныеОперации.СообщитьПрогресс(
				Формат(ОбработанныйОбъект / ВсегоОбъектов * 100, "ЧЦ=3; ЧДЦ="), 
				СообщениеОбОставшемсяВремени);
		КонецЕсли;
			
		ОбработанныйОбъект = ОбработанныйОбъект + 1;
	КонецЦикла;
								
	Возврат СтатусВыполнения;
	
КонецФункции

функция ПолучитьИерархиюЗаказовПередИзменением(МассивСтрокКИзменению)
	
	ТаблицаВыгрузки = Новый ТаблицаЗначений;
	ТаблицаВыгрузки.Колонки.Добавить("Назначение", Новый ОписаниеТипов("СправочникСсылка.Назначения"));
	ТаблицаВыгрузки.Колонки.Добавить("ЗаказКлиента", Новый ОписаниеТипов("ДокументСсылка.ЗаказКлиента"));
	ТаблицаВыгрузки.Колонки.Добавить("ПлановаяДатаОтгрузки", Новый ОписаниеТипов("Дата"));
    ТаблицаВыгрузки.Колонки.Добавить("НоваяДатаОтгрузки", Новый ОписаниеТипов("Дата"));
	ТаблицаВыгрузки.Колонки.Добавить("ИдентификаторСтроки", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(36)));
