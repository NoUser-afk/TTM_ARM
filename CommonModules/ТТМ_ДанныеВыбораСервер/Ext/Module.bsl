//ВариантПечати = 1 - печать ШК товара
//ВариантПечати = 2 - печать Серийного номера товара
Функция ЗаполнитьТоварыНаСервере(ДанныеДляПечати, Знач КоличествоДляПечати = Неопределено, МассивСерийныхНомеров = Неопределено, ВариантПечати = 1)
	
	ТипЧисло = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Неотрицательный));
	
	Товары = Новый ТаблицаЗначений;
	Товары.Колонки.Добавить("Порядок",                ТипЧисло);
	Товары.Колонки.Добавить("Номенклатура",           Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Товары.Колонки.Добавить("Упаковка",               Новый ОписаниеТипов("СправочникСсылка.УпаковкиЕдиницыИзмерения"));
	Товары.Колонки.Добавить("Характеристика",         Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	Товары.Колонки.Добавить("Штрихкод",               Новый ОписаниеТипов("Строка"));
	Товары.Колонки.Добавить("ШаблонЭтикетки",         Новый ОписаниеТипов("СправочникСсылка.ШаблоныЭтикетокИЦенников"));
	Товары.Колонки.Добавить("КоличествоЭтикеток",     ТипЧисло);
	Товары.Колонки.Добавить("ШаблонЦенника",          Новый ОписаниеТипов("СправочникСсылка.ШаблоныЭтикетокИЦенников"));
	Товары.Колонки.Добавить("КоличествоЦенников",     ТипЧисло);
	
	//Если ЗначениеЗаполнено(НоменклатураСсылка) Тогда 
	//Если ТипЗнч(ДанныеДляПечати) = Тип("СправочникСсылка.Номенклатура") и ЗначениеЗаполнено(ДанныеДляПечати) Тогда 
	
	Если ВариантПечати = 1 Тогда 	
		
		//Печать ШК из АРМ Выпуск и Реализация
		
		ШаблонЭтикеткиТТМ = Справочники.ШаблоныЭтикетокИЦенников.НайтиПоНаименованию("Этикетка ТТМ", Истина);
	
		Если ШаблонЭтикеткиТТМ.Пустая() Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найден шаблон этикетки для печати");
			Возврат Неопределено;
		КонецЕсли;
		
		НоваяСтрока = Товары.Добавить();
		НоваяСтрока.Порядок = 1;
		НоваяСтрока.Номенклатура = ДанныеДляПечати;
		НоваяСтрока.КоличествоЭтикеток = ?(КоличествоДляПечати = Неопределено, 1, КоличествоДляПечати);
		НоваяСтрока.Штрихкод  = ПолучитьШтрихкод(ДанныеДляПечати);
		НоваяСтрока.ШаблонЭтикетки  = ШаблонЭтикеткиТТМ;
		
	//ИначеЕсли ТипЗнч(ДанныеДляПечати) = Тип("Массив") Тогда 
	ИначеЕсли ВариантПечати = 2 Тогда  
		
		//Печать серийных номеров   
		
		ШаблонЭтикеткиСН = Справочники.ШаблоныЭтикетокИЦенников.НайтиПоНаименованию("Этикетка СН", Истина);
	
		Если ШаблонЭтикеткиСН.Пустая() Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найден шаблон этикетки для печати");
			Возврат Неопределено;
		КонецЕсли;
		
		Т =1;
		Для Каждого СерийныйНомер из МассивСерийныхНомеров Цикл 
			
			НоваяСтрока = Товары.Добавить();
			НоваяСтрока.Порядок = Т;
			НоваяСтрока.Номенклатура = ДанныеДляПечати;
			НоваяСтрока.КоличествоЭтикеток = ?(ЗначениеЗаполнено(КоличествоДляПечати), КоличествоДляПечати, 1);
			НоваяСтрока.Штрихкод  = СтрЗаменить(СерийныйНомер,"-","");
			//ПолучитьСерийныйНомер(ДанныеДляПечати, ЭтапПроизводства);
			НоваяСтрока.ШаблонЭтикетки  = ШаблонЭтикеткиСН;
			Т = Т+1;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ПоместитьВоВременноеХранилище(Товары);
	
КонецФункции

Функция ПолучитьШтрихкод(НоменклатураСсылка) Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.Текст =  "ВЫБРАТЬ ПЕРВЫЕ 1
	                |	ШтрихкодыНоменклатуры.Штрихкод КАК Штрихкод
	                |ИЗ
	                |	РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
	                |ГДЕ
	                |	ШтрихкодыНоменклатуры.Номенклатура = &Номенклатура ";
	
	Запрос.УстановитьПараметр("Номенклатура", НоменклатураСсылка);
	Результат = Запрос.Выполнить().Выгрузить();
    
    ШК = "";
    Если Результат.Количество() > 0 Тогда
        ШК = Результат[0].Штрихкод;
    КонецЕсли;
    
    Возврат ШК; 
	
КонецФункции

Функция ПолучитьСерийныйНомер(ДанныеСтроки, ЭтапПроизводства) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "";
	Запрос.УстановитьПараметр("Номенклатура",ДанныеСтроки.Номенклатура);
	Запрос.УстановитьПараметр("ЭтапПроизводства",ДанныеСтроки.ЭтапПроизводства);
	Запрос.УстановитьПараметр("СерийныйНомер",ДанныеСтроки.СерийныйНомер);
	РезультатЗапроса = Запрос.Выполнить();
	Если не РезультатЗапроса.Пустой() Тогда 
		Выборка = РезультатЗапроса.Выбрать();
	КонецЕсли;
	Возврат СтрЗаменить(Выборка.СерийныйНомер,"-","");
	
КонецФункции

#КонецОбласти

//Проверка прав на редактирование полей у справочника "Номенклатура"
#Область РаботаСНоменклатуройПроверкаПравДоступа

функция ПроверкаРолиДоступа(Знач ДоступНаРаботуСФайлами = Ложь, Знач ТекущаяРольДоступна = Ложь) Экспорт
		
	Если ДоступНаРаботуСФайлами Тогда		
		
		Если РольДоступна("ДобавлениеИзменениеНоменклатуры") ИЛИ РольДоступна("ПолныеПрава") Тогда
			ТекущаяРольДоступна = Истина;
		КонецЕсли;
	Иначе
		Если РольДоступна("ПолныеПрава") Тогда 
			ТекущаяРольДоступна = Истина;
		КонецЕсли;	
	КонецЕсли;
			
	Возврат ТекущаяРольДоступна;  
	
КонецФункции

