функция ПолучитьСписокЗаказовДляОтгрузки(Знач ЗагрузитьВоВременноеХранилище = Ложь) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗаказКлиентаТовары.Ссылка КАК ЗаказКлиента,
	               |	ЗаказКлиентаТовары.Номенклатура КАК Номенклатура,
	               |	СУММА(ЗаказКлиентаТовары.Количество) КАК Количество,
	               |	Назначения.Ссылка КАК Назначение,
	               |	ЗаказКлиентаТовары.Ссылка.Склад КАК Склад
	               |ПОМЕСТИТЬ ТоварыОткрытыхЗаказов
	               |ИЗ
	               |	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Назначения КАК Назначения
	               |		ПО (ЗаказКлиентаТовары.Ссылка = (ВЫРАЗИТЬ(Назначения.Заказ КАК Документ.ЗаказКлиента)))
	               |ГДЕ
	               |	ЗаказКлиентаТовары.Ссылка.Проведен
	               |	И (ЗаказКлиентаТовары.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовКлиентов.КОбеспечению)
	               |			ИЛИ ЗаказКлиентаТовары.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовКлиентов.КОтгрузке))
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЗаказКлиентаТовары.Ссылка,
	               |	ЗаказКлиентаТовары.Номенклатура,
	               |	Назначения.Ссылка,
	               |	ЗаказКлиентаТовары.Ссылка.Склад
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	РеализацияТоваровУслугТовары.Номенклатура КАК Номенклатура,
	               |	СУММА(РеализацияТоваровУслугТовары.Количество) КАК Количество,
	               |	Назначения.Ссылка КАК Назначение,
	               |	РеализацияТоваровУслугТовары.Склад КАК Склад
	               |ПОМЕСТИТЬ ОтгруженоПоНазначениям
	               |ИЗ
	               |	Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Назначения КАК Назначения
	               |		ПО (РеализацияТоваровУслугТовары.Ссылка.ЗаказКлиента = (ВЫРАЗИТЬ(Назначения.Заказ КАК Документ.ЗаказКлиента)))
	               |ГДЕ
	               |	РеализацияТоваровУслугТовары.Ссылка.Проведен
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	РеализацияТоваровУслугТовары.Номенклатура,
	               |	Назначения.Ссылка,
	               |	РеализацияТоваровУслугТовары.Склад
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЕСТЬNULL(ТоварыОткрытыхЗаказов.Номенклатура, ДвижениеПродукцииИМатериаловТовары.Номенклатура) КАК Номенклатура,
	               |	СУММА(ЕСТЬNULL(ДвижениеПродукцииИМатериаловТовары.Количество, 0)) КАК Количество,
	               |	ЕСТЬNULL(ТоварыОткрытыхЗаказов.Назначение, ДвижениеПродукцииИМатериаловТовары.Назначение) КАК Назначение,
	               |	ЕСТЬNULL(ТоварыОткрытыхЗаказов.Склад, ДвижениеПродукцииИМатериаловТовары.Ссылка.Получатель) КАК Склад
	               |ПОМЕСТИТЬ ВыпущенныеТоварыПоНазначениям
	               |ИЗ
	               |	ТоварыОткрытыхЗаказов КАК ТоварыОткрытыхЗаказов
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ДвижениеПродукцииИМатериалов.Товары КАК ДвижениеПродукцииИМатериаловТовары
	               |		ПО (ДвижениеПродукцииИМатериаловТовары.Номенклатура = ТоварыОткрытыхЗаказов.Номенклатура)
	               |			И (ДвижениеПродукцииИМатериаловТовары.Назначение = ТоварыОткрытыхЗаказов.Назначение)
	               |			И (ТоварыОткрытыхЗаказов.Склад = (ВЫРАЗИТЬ(ДвижениеПродукцииИМатериаловТовары.Ссылка.Получатель КАК Справочник.Склады)))
	               |ГДЕ
	               |	ДвижениеПродукцииИМатериаловТовары.Ссылка.Проведен
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЕСТЬNULL(ТоварыОткрытыхЗаказов.Назначение, ДвижениеПродукцииИМатериаловТовары.Назначение),
	               |	ЕСТЬNULL(ТоварыОткрытыхЗаказов.Склад, ДвижениеПродукцииИМатериаловТовары.Ссылка.Получатель),
	               |	ЕСТЬNULL(ТоварыОткрытыхЗаказов.Номенклатура, ДвижениеПродукцииИМатериаловТовары.Номенклатура)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ИСТИНА КАК Отметка,
	               |	ТоварыОткрытыхЗаказов.Номенклатура КАК Номенклатура,
	               |	ТоварыОткрытыхЗаказов.Назначение КАК Назначение,
	               |	ТоварыОткрытыхЗаказов.ЗаказКлиента КАК ДокументОтгрузки,
	               |	ЕСТЬNULL(ВыпущенныеТоварыПоНазначениям.Количество, 0) - ЕСТЬNULL(ОтгруженоПоНазначениям.Количество, 0) КАК КОтгрузке,
	               |	ТоварыОткрытыхЗаказов.Склад КАК Склад
	               |ИЗ
	               |	ТоварыОткрытыхЗаказов КАК ТоварыОткрытыхЗаказов
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ОтгруженоПоНазначениям КАК ОтгруженоПоНазначениям
	               |		ПО ТоварыОткрытыхЗаказов.Номенклатура = ОтгруженоПоНазначениям.Номенклатура
	               |			И ТоварыОткрытыхЗаказов.Назначение = ОтгруженоПоНазначениям.Назначение
	               |			И ТоварыОткрытыхЗаказов.Склад = ОтгруженоПоНазначениям.Склад
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВыпущенныеТоварыПоНазначениям КАК ВыпущенныеТоварыПоНазначениям
	               |		ПО ТоварыОткрытыхЗаказов.Номенклатура = ВыпущенныеТоварыПоНазначениям.Номенклатура
	               |			И ТоварыОткрытыхЗаказов.Назначение = ВыпущенныеТоварыПоНазначениям.Назначение
	               |			И ТоварыОткрытыхЗаказов.Склад = ВыпущенныеТоварыПоНазначениям.Склад
	               |ГДЕ
	               |	ОтгруженоПоНазначениям.Количество < ВыпущенныеТоварыПоНазначениям.Количество";
	
	Выборка = Запрос.Выполнить().Выгрузить();
	РезультатВыгрузки = ?(ЗагрузитьВоВременноеХранилище, ПоместитьВоВременноеХранилище(Выборка), Выборка); 
	
	Возврат РезультатВыгрузки;	
	
КонецФункции

Функция СформироватьРеализациюПоЗаказу(ЗаказКлиента, ДатаРеализации) Экспорт
	
	//Изменим статус обеспечения
	ЗаказОбъект = ЗаказКлиента;
	
	ПереченьВариантов = Новый Массив();
	ПереченьВариантов.Добавить(ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.Отгрузить"));  
	
	Результат = Новый Структура("ПереченьВариантов, ЗаполнятьЦелымиУпаковками");
	Результат.ПереченьВариантов = ПереченьВариантов;
	Результат.ЗаполнятьЦелымиУпаковками = Ложь;
	
	ЗаказИзменен = Ложь; 
	
	ПараметрыВстраивания = Документы.ЗаказКлиента.ДоступныеОстаткиПараметрыВстраивания();
	
	МассивДок = Новый Массив();
	МассивДок.Добавить(ЗаказОбъект);
	
	ПараметрыПроцедуры = Новый Структура();
	
	ПараметрыПроцедуры.Вставить("КодДействия", "ДЕЙСТВИЕ_ОТГРУЗИТЬ");
	ПараметрыЗаполнения = Новый Структура();
	ПараметрыЗаполнения.Вставить("СнятьФлагОтгружатьОднойДатой", Истина);
	ПараметрыЗаполнения.Вставить("ЗаполнитьДатуОтгрузкиОднойДатой", Ложь );
	ПараметрыПроцедуры.Вставить("ПараметрыЗаполнения", ПараметрыЗаполнения);        
	
	ПараметрыПроцедуры.Вставить("Заказы", МассивДок);
	ПараметрыПроцедуры.Вставить("ПараметрыВстраивания", ПараметрыВстраивания);
	
	ДокументРеализации = Документы.РеализацияТоваровУслуг.ПустаяСсылка();
	РезультатВыполненияДействий = ОбеспечениеВДокументахСервер.ВыполнитьДействиеДляЗаказовПослеВопроса(ПараметрыПроцедуры);
	Если РезультатВыполненияДействий.СписокОшибок.Количество() = 0 Тогда  
		ДокументРеализации = СоздатьРеализациюПоЗаказу(ЗаказКлиента, ДатаРеализации);  
	Иначе 
		Сообщить("Не удалось проставить действике ""Отгрузить"" в строках Заказа клиента: " + ЗаказОбъект);
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Выполнение операции'"), УровеньЖурналаРегистрации.Ошибка,,, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецЕсли;
	
	Возврат ДокументРеализации
	
КонецФункции

Функция СоздатьРеализациюПоЗаказу(Основание, ДатаРеализации)
	
	МассивСсылок = Новый Массив();
	МассивСсылок.Добавить(Основание);
	ПараметрыОткрытия = СозданиеНаОснованииУТВызовСервера.РеализацияТоваровУслугПараметрыОткрытияФормы(МассивСсылок);
	ДанныеЗаполнения = ПараметрыОткрытия.Основание;
	
	Документ = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
	Документ.Заполнить(ДанныеЗаполнения);
	Документ.Дата = ?(ДатаРеализации = НачалоДня(ТекущаяДата()), ТекущаяДата(), ДатаРеализации + 60*60*17);
	
	//***************************************  
	//Если заполнено поле продукция, 
	//удалим из ТЧ Товары строки не соответствующие отбору	
	//Если ЗначениеЗаполнено(Объект.Изделие) и ЗначениеЗаполнено(Объект.Количество) Тогда 
	//	ТЗ_Товары = Документ.Товары.Выгрузить();
	//	КоличествоРеализовано = 0;
	//	
	//	Для Каждого СтрТовары из ТЗ_Товары Цикл 
	//		Если СтрТовары.Номенклатура <> Объект.Изделие Тогда 
	//			ТЗ_Товары.Удалить(СтрТовары);
	//		Иначе  
	//			//уточнить количество и выполнить обработку строки
	//			//Если СтрТовары.Количество < КоличествоРеализовано Тогда 
	//		КонецЕсли;
	//	КонецЦикла;
	//	
	//	Документ.Товары.Загрузить(ТЗ_Товары);
	//КонецЕсли;
	//**************************
	
	Реализация = Документы.РеализацияТоваровУслуг.ПустаяСсылка();
	СоздатьСчетФактуру = Ложь;
	Если Документ.Товары.Количество() > 0 Тогда
		Попытка
			
			НачатьТранзакцию();      
			
			НовыйНомер = ПолучитьСледующийНомерРеализации(Документ.Организация, ДатаРеализации);  
			Если НовыйНомер = 0 Тогда 
				Документ.УстановитьНовыйНомер();                
			Иначе 
				Документ.Номер = НовыйНомер;
			КонецЕсли;
			Документ.Записать(РежимЗаписиДокумента.Проведение);
			
			ЗафиксироватьТранзакцию();
			
			СоздатьСчетФактуру = Истина;
			
		Исключение
			ОтменитьТранзакцию();
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Выполнение операции'"), УровеньЖурналаРегистрации.Ошибка,,, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
    		ВызватьИсключение;
		КонецПопытки;
		
		Если СоздатьСчетФактуру Тогда
			НовыйСчетФактура = Документы.СчетФактураВыданный.СоздатьДокумент();
			ЗаполнитьЗначенияСвойств(НовыйСчетФактура, Документ.Ссылка);
			
			НовыйСчетФактура.ДокументОснование 	= Документ.Ссылка;
			СтрокаОснований = НовыйСчетФактура.ДокументыОснования.Добавить();  
			СтрокаОснований.ДокументОснование 	= Документ.Ссылка;   
			
			НовыйСчетФактура.ЗаполнитьПараметрыСчетаФактурыПоОснованию(Документ.Ссылка);
			// <+ Вахненко 15.04.2026
			ДанныеЗаполнения = Новый Структура("ДокументОснование,Корректировочный,Исправление",Документ.Ссылка,Ложь,Ложь);
			НовыйСчетФактура.АРМ1_ЗаполнитьПоДокументуОснованию(ДанныеЗаполнения);
			// +>

						
			НовыйСчетФактура.КодВидаОперацииНаУменьшение = "18";
			НовыйСчетФактура.Дата 				= ДатаРеализации;
			НовыйСчетФактура.ДатаВыставления 	= ДатаРеализации;
			
			НовыйСчетФактура.Записать(РежимЗаписиДокумента.Проведение);
		КонецЕсли;
		Реализация = Документ.Ссылка;
	Иначе
		Реализация = Документы.РеализацияТоваровУслуг.ПустаяСсылка();
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не удалось сформировать реализацию по заказу " + Основание + ". Табличная часть товары пустая.'"));
	КонецЕсли;  
	
	Возврат Реализация;
		
КонецФункции

Функция ПолучитьСледующийНомерРеализации(Организация, ДатаРеализации)
	
	НовыйНомер = 0;
	Запрос= Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ВЫБОР
	               |		КОГДА ПОДСТРОКА(СчетФактураВыданный.Номер, 0, 2) = ""ЦБ""
	               |			ТОГДА ПОДСТРОКА(СчетФактураВыданный.Номер, 4, 6)
	               |		КОГДА ПОДСТРОКА(СчетФактураВыданный.Номер, 0, 4) = ""00ЦБ""
	               |			ТОГДА ПОДСТРОКА(СчетФактураВыданный.Номер, 6, 7)
	               |		КОГДА ПОДСТРОКА(СчетФактураВыданный.Номер, 0, 4) = ""РБЦБ""
	               |			ТОГДА ПОДСТРОКА(СчетФактураВыданный.Номер, 6, 7)
				   |		КОГДА ПОДСТРОКА(СчетФактураВыданный.Номер, 0, 4) = ""0РЦБ""
	               |			ТОГДА ПОДСТРОКА(СчетФактураВыданный.Номер, 6, 7)
	               |		ИНАЧЕ ""0""
	               |	КОНЕЦ КАК НомерЧисловой,
	               |	СчетФактураВыданный.Номер КАК Номер
	               |ИЗ
	               |	Документ.СчетФактураВыданный КАК СчетФактураВыданный
	               |ГДЕ
	               |	СчетФактураВыданный.Организация = &Организация
	               |	И СчетФактураВыданный.Дата >= НАЧАЛОПЕРИОДА(&ДатаОтгрузки, ГОД)
	               |	И СчетФактураВыданный.Дата <= КОНЕЦПЕРИОДА(&ДатаОтгрузки, ГОД)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	НомерЧисловой УБЫВ
	               |АВТОУПОРЯДОЧИВАНИЕ";    
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ДатаОтгрузки", ДатаРеализации);
	
	//Попытка
	Выборка = Запрос.Выполнить().Выбрать(); 
	//исключение 
	//	сообщить("" + ОписаниеОшибки());
	//КонецПопытки;
	
	Если Выборка.Следующий() Тогда 
		МаксНомер = Выборка.Номер;  
		НомерЧисловой = Выборка.НомерЧисловой;
	Иначе 
		МаксНомер = "0";                       
		НомерЧисловой = "0";
	КонецЕсли;
	
	Если МаксНомер = "0" Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Максимальный номер не определён! Нумерация начнётся сначала!'"),,,,);
		Возврат Число(МаксНомер);
	КонецЕсли;
	
	НовыйНомерЧисло = Формат(Число(НомерЧисловой) + 1,"ЧГ=0");
	НовыйНомерСтрока = Строка(НовыйНомерЧисло);
	НовыйНомер = Лев(МаксНомер,СтрДлина(МаксНомер) - СтрДлина(НовыйНомерСтрока)-1) + НовыйНомерСтрока;
	
	Возврат НовыйНомер; 
КонецФункции

