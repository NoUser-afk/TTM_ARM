	               |	И ТТМ_АРМ_РезервированиеСписаниеМатериалов.ЭтоСписание = &ЭтоСписание
	               |	И ТТМ_АРМ_РезервированиеСписаниеМатериалов.Номенклатура В(&Номенклатура)
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	СсылкаНаНоменклатуру
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               |	РесурсныеСпецификацииМатериалыИУслуги.Номенклатура КАК Номенклатура,
	               |	СУММА(РесурсныеСпецификацииМатериалыИУслуги.КоличествоУпаковок) КАК Норматив,
	               |	ВЫБОР
	               |		КОГДА ЕСТЬNULL(РесурсныеСпецификацииМатериалыИУслуги.Упаковка, ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
	               |			ТОГДА РесурсныеСпецификацииМатериалыИУслуги.Номенклатура.ЕдиницаИзмерения
	               |		ИНАЧЕ РесурсныеСпецификацииМатериалыИУслуги.Упаковка
	               |	КОНЕЦ КАК Упаковка,
	               |	РесурсныеСпецификацииМатериалыИУслуги.Ссылка КАК Спецификация,
	               |	РесурсныеСпецификацииМатериалыИУслуги.СтатьяКалькуляции КАК СтатьяКалькуляции,
	               |	РесурсныеСпецификацииВыходныеИзделия.Номенклатура КАК ВыходноеИзделие,
	               |	РесурсныеСпецификацииМатериалыИУслуги.КлючСвязи КАК КлючСвязи
	               |ПОМЕСТИТЬ НормативыпоСпецификации
	               |ИЗ
	               |	Справочник.РесурсныеСпецификации.ВыходныеИзделия КАК РесурсныеСпецификацииВыходныеИзделия
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.РесурсныеСпецификации.МатериалыИУслуги КАК РесурсныеСпецификацииМатериалыИУслуги
	               |		ПО РесурсныеСпецификацииВыходныеИзделия.Ссылка = РесурсныеСпецификацииМатериалыИУслуги.Ссылка
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СпецификацииЭтапов КАК СпецификацииЭтапов
	               |		ПО РесурсныеСпецификацииВыходныеИзделия.Ссылка = СпецификацииЭтапов.Спецификация
	               |ГДЕ
	               |	РесурсныеСпецификацииМатериалыИУслуги.Номенклатура В(&Номенклатура)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	РесурсныеСпецификацииМатериалыИУслуги.Номенклатура,
	               |	ВЫБОР
	               |		КОГДА ЕСТЬNULL(РесурсныеСпецификацииМатериалыИУслуги.Упаковка, ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
	               |			ТОГДА РесурсныеСпецификацииМатериалыИУслуги.Номенклатура.ЕдиницаИзмерения
	               |		ИНАЧЕ РесурсныеСпецификацииМатериалыИУслуги.Упаковка
	               |	КОНЕЦ,
	               |	РесурсныеСпецификацииМатериалыИУслуги.Ссылка,
	               |	РесурсныеСпецификацииМатериалыИУслуги.СтатьяКалькуляции,
	               |	РесурсныеСпецификацииВыходныеИзделия.Номенклатура,
	               |	РесурсныеСпецификацииМатериалыИУслуги.КлючСвязи
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЕСТЬNULL(ЕСТЬNULL(ТоварыНаСкладахОстатки.Склад, ЗапасыИПотребностиОстатки.Склад), ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)) КАК Склад,
	               |	&Номенклатура КАК Номенклатура,
	               |	ЕСТЬNULL(ЕСТЬNULL(ТоварыНаСкладахОстатки.Характеристика, ЗапасыИПотребностиОстатки.Характеристика), ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) КАК Характеристика,
	               |	СУММА(ЕСТЬNULL(ТоварыНаСкладахОстатки.ВНаличииОстаток, 0)) КАК ВНаличии,
	               |	СУММА(ЕСТЬNULL(ЗапасыИПотребностиОстатки.РезервироватьНаСкладеОстаток, 0)) КАК Резерв,
	               |	СУММА(ЕСТЬNULL(ТоварыКОтгрузкеОстатки.КОтгрузкеОстаток, 0)) КАК Отгружается
	               |ПОМЕСТИТЬ ВТ_НовыеОстаткиИзЗапасов_v1
	               |ИЗ
	               |	РегистрНакопления.ТоварыНаСкладах.Остатки(
	               |			,
	               |			Номенклатура В (&Номенклатура)
	               |				И Склад В (&Склад)) КАК ТоварыНаСкладахОстатки
	               |		ПОЛНОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗапасыИПотребности.Остатки(
	               |				,
	               |				Номенклатура В (&Номенклатура)
	               |					И Склад В (&Склад)) КАК ЗапасыИПотребностиОстатки
	               |		ПО ТоварыНаСкладахОстатки.Номенклатура = ЗапасыИПотребностиОстатки.Номенклатура
	               |		ПОЛНОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыКОтгрузке.Остатки(
	               |				,
	               |				Номенклатура В (&Номенклатура)
	               |					И Склад В (&Склад)) КАК ТоварыКОтгрузкеОстатки
	               |		ПО ТоварыНаСкладахОстатки.Номенклатура = ТоварыКОтгрузкеОстатки.Номенклатура
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЕСТЬNULL(ЕСТЬNULL(ТоварыНаСкладахОстатки.Склад, ЗапасыИПотребностиОстатки.Склад), ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)),
	               |	ЕСТЬNULL(ЕСТЬNULL(ТоварыНаСкладахОстатки.Характеристика, ЗапасыИПотребностиОстатки.Характеристика), ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка))
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Номенклатура КАК Номенклатура,
	               |	СУММА(ВЫБОР
	               |			КОГДА ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.ВариантОбеспечения = ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.СоСклада)
