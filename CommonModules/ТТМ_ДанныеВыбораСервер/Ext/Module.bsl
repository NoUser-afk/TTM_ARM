//Резервирование и списание материалов по этапам
Функция ЗафиксироватьКорректировкиВЭтапахСписаниеИРезервированиеВФоне(ПараметрыДляОбработки) Экспорт
		
	ВсегоОбъектов = ПараметрыДляОбработки.МассивЭтаповКИзменению.Количество();
	ОбработанныйОбъект = 1;
	НачалоЗамера = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Для Каждого Этап Из ПараметрыДляОбработки.МассивЭтаповКИзменению Цикл
		ПереченьКолонок = ПолучитьПереченьКолонокТЧМатериалыЭтапа();
		ВыгрузитьПодготовленныеМатериалыИзРегистра(ПараметрыДляОбработки, Этап, ПереченьКолонок);
		
		ОбъектЭтапа = Этап.ПолучитьОбъект();
		ТЧОбеспечение = ОбъектЭтапа.ОбеспечениеМатериаламиИРаботами;
		ТЧОбеспечение.Очистить();
		
		ЕстьРезервИлиМягкийРезерв = Ложь;
		
		Для Каждого СтрокаМатериала из ПараметрыДляОбработки.ВыгруженнаяТаблицаМатериалов Цикл //МатериалыСпецификации Цикл 
			НоваяСтрока = ТЧОбеспечение.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаМатериала);   
			НоваяСтрока.ДатаОтгрузки = ПараметрыДляОбработки.ПериодОтгрузки;
			НоваяСтрока.Назначение = СтрокаМатериала.НазначениеОбеспечения;
			НоваяСтрока.НазначениеОбеспечения = СтрокаМатериала.НазначениеОбеспечения;
			
			Если НоваяСтрока.ВариантОбеспечения = ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.СоСклада")
				ИЛИ НоваяСтрока.ВариантОбеспечения = ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.РезервироватьПоМереПоступления") 
				ИЛИ НоваяСтрока.ВариантОбеспечения = ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.Отгрузить") Тогда 
				ЕстьРезервИлиМягкийРезерв = Истина;
			КонецЕсли;
		КонецЦикла;  
		
		ОбъектЭтапа.НеОтгружатьЧастями = Истина;
		ОбъектЭтапа.ДатаОтгрузки = ПараметрыДляОбработки.ПериодОтгрузки;
		
		Если ОбъектЭтапа.КоличествоУпаковокФакт < ПараметрыДляОбработки.ПроцентВыполнения Тогда	
			Если ЕстьРезервИлиМягкийРезерв Тогда
				ОбъектЭтапа.КоличествоУпаковокФакт = ПараметрыДляОбработки.ПроцентВыполнения;
			КонецЕсли;
		КонецЕсли;
	
		Попытка
			НачатьТранзакцию();
			ОбъектЭтапа.Записать(РежимЗаписиДокумента.Проведение);
			ЗафиксироватьТранзакцию();
			ЭтапыОбработаны = Истина;
		Исключение
			ОтменитьТранзакцию();
			ЭтапыОбработаны = Ложь;
			
			ДлительныеОперации.СообщитьПрогресс(-1, "Ошибка при записи объекта: " + ОбъектЭтапа);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru ='Ошибка при изменении этапа: '") + ОписаниеОшибки());
			
			Если Не ПараметрыДляОбработки.ЭтоСписание Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru ='Проверьте остатки материалов'"));
			КонецЕсли;
			
			ВызватьИсключение ОписаниеОшибки();
		КонецПопытки;
		
		//ОбработатьСтрокиЭтапаИспользуяПараметрыВстраивания(Этап, ПараметрыДляОбработки.ЭтоСписание);
		
		Если ПараметрыДляОбработки.ЭтоСписание Тогда
			СформировалиПередачуМатериалов = СформироватьПередачуМатериаловНаСервере(Этап, ПараметрыДляОбработки.ПериодОтгрузки);;
			
			Если Не СформировалиПередачуМатериалов Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru ='Ошибка при формировании передачи: '") + ОписаниеОшибки());
				ВызватьИсключение ОписаниеОшибки();		
			КонецЕсли;
			
		КонецЕсли;	
					
		ВремяЗаписиОбъекта = ТекущаяУниверсальнаяДатаВМиллисекундах();
		СообщениеОбОставшемсяВремени = ПодсчетОставшегосяВремени(НачалоЗамера, ВремяЗаписиОбъекта, ВсегоОбъектов, ОбработанныйОбъект);
		
		Если Не (ОбработанныйОбъект % 10) Тогда
			ДлительныеОперации.СообщитьПрогресс(
				Формат(ОбработанныйОбъект / ВсегоОбъектов * 100, "ЧЦ=3; ЧДЦ="), 
				СообщениеОбОставшемсяВремени);
		КонецЕсли;
		
		ОбработанныйОбъект = ОбработанныйОбъект + 1;
	КонецЦикла;

	Возврат ЭтапыОбработаны;  
	
КонецФункции

Функция СформироватьПередачуМатериаловНаСервере(Этап, ПериодОтгрузки)
	
	МассивСсылок = Новый Массив();
	МассивСсылок.Добавить(Этап);
	ПараметрыОткрытия = СозданиеНаОснованииУТВызовСервера.ПараметрыОткрытияФормыНакладнойНаОснованииЗаказа(МассивСсылок,
		"ДвижениеПродукцииИМатериалов", ПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.ПередачаМатериаловВПроизводство"));
	ДанныеЗаполнения = ПараметрыОткрытия.ПараметрыФормы.Основание;
	
	Документ = Документы.ДвижениеПродукцииИМатериалов.СоздатьДокумент();
	Документ.Заполнить(ДанныеЗаполнения);
	Документ.Дата = ПериодОтгрузки;
	
	Попытка
		Документ.Записать(РежимЗаписиДокумента.Проведение);
		Возврат Истина;
	Исключение
		Сообщить("Ошибка формирования Передачи материалов " + Этап + " " + ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

Функция ПодсчетОставшегосяВремени(НачалоЗамера, ВремяЗаписиОбъекта, ВсегоОбъектов, ОбработанныйОбъект) Экспорт
	
	ПодсчетМиллисекундСекундНаЗаписьОбъекта = (ВремяЗаписиОбъекта - НачалоЗамера);
   	СреднеВремяНаЗаписьОбъекта = ПодсчетМиллисекундСекундНаЗаписьОбъекта / ОбработанныйОбъект;
   	ОставшееВремя = СреднеВремяНаЗаписьОбъекта * (ВсегоОбъектов - ОбработанныйОбъект);
   	ОставшееВремяВМинутах = ОставшееВремя / (1000 * 60);
	ИтоговоеОставшеесяВремяВМинутах = Цел(ОставшееВремяВМинутах);
	
	Если ИтоговоеОставшеесяВремяВМинутах = 1 Или ИтоговоеОставшеесяВремяВМинутах = 21 
		Или ИтоговоеОставшеесяВремяВМинутах = 31 Или ИтоговоеОставшеесяВремяВМинутах = 41 Или ИтоговоеОставшеесяВремяВМинутах = 51 Тогда
		КонтекстОВремени = " минута!";
	ИначеЕсли (ИтоговоеОставшеесяВремяВМинутах >= 2 И ИтоговоеОставшеесяВремяВМинутах <= 4) 
		Или (ИтоговоеОставшеесяВремяВМинутах >= 22 И  ИтоговоеОставшеесяВремяВМинутах <= 24)
		Или (ИтоговоеОставшеесяВремяВМинутах >= 32 И  ИтоговоеОставшеесяВремяВМинутах <= 34) 
		Или (ИтоговоеОставшеесяВремяВМинутах >= 42 И  ИтоговоеОставшеесяВремяВМинутах <= 44)
		Или (ИтоговоеОставшеесяВремяВМинутах >= 52 И  ИтоговоеОставшеесяВремяВМинутах <= 54) Тогда
		КонтекстОВремени = " минуты!";
	Иначе
		КонтекстОВремени = " минут!";	
	КонецЕсли;
		
	Если ИтоговоеОставшеесяВремяВМинутах >= 0 И ИтоговоеОставшеесяВремяВМинутах <= 1 Тогда
		ИтоговоеОставшеесяВремяВМинутах = 1;
		СообщениеОбОставшемсяВремени = "Примерное время выполнения: менее " + ИтоговоеОставшеесяВремяВМинутах + " минуты!";
	ИначеЕсли ИтоговоеОставшеесяВремяВМинутах >= 60 Тогда
		СообщениеОбОставшемсяВремени = "Примерное время выполнения: более часа!";
	Иначе
		СообщениеОбОставшемсяВремени = "Примерное время выполнения: " + ИтоговоеОставшеесяВремяВМинутах + КонтекстОВремени;
	КонецЕсли;

	Возврат СообщениеОбОставшемсяВремени;
	
КонецФункции

