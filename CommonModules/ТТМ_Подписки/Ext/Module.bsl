// 05.02.2026

Процедура ТТМ_ЗаказКлиентаПриПроведении(Источник, Отказ, РежимПроведения) Экспорт
	
	СоздаватьПД = Ложь;
	НастройкиПДок = Обработки.ТТМ_НастройкиУчетаТТМ.Создать().СтруктураНастроекПДок();
	КлючОбъекта = НастройкиПДок.КлючОбъекта;
	КлючНастроек = "";
	НастройкиТТМ = ТТМ_ОбщегоНазначения.ДанныеИзХОН(НастройкиПДок.КлючОбъекта);
	Если НастройкиТТМ<>Неопределено
		И НастройкиТТМ.Свойство("ПриСогласованииЗК_СоздаватьПД") Тогда
		СоздаватьПД = НастройкиТТМ.ПриСогласованииЗК_СоздаватьПД;
	КонецЕсли;
	Если Не СоздаватьПД Тогда
		Возврат;
	КонецЕсли;
	
	Если не Отказ Тогда
		Если Источник.Проведен 
			И (Источник.Статус = Перечисления.СтатусыЗаказовКлиентов.КОбеспечению 
			Или Источник.Статус = Перечисления.СтатусыЗаказовКлиентов.Закрыт) Тогда
			
			//Если заказ клиента - на РБ (ИНН 9731060160) согласован,
			//то нужно выставить согласование на соотв. ТТМ (ИНН 6901066336) и сформировать документы
			//{{КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
			// Данный фрагмент построен конструктором.
			// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	Организации.Ссылка КАК Робо,
			|	NULL КАК ТТМ
			|ПОМЕСТИТЬ вт_Организации
			|ИЗ
			|	Справочник.Организации КАК Организации
			|ГДЕ
			|	Организации.ИНН = &ИНН_РБ
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	NULL,
			|	Организации.Ссылка
			|ИЗ
			|	Справочник.Организации КАК Организации
			|ГДЕ
			|	Организации.ИНН = &ИНН_ТТМ
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	МАКСИМУМ(вт_Организации.Робо) КАК Робо,
			|	МАКСИМУМ(вт_Организации.ТТМ) КАК ТТМ
			|ИЗ
			|	вт_Организации КАК вт_Организации
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	Контрагенты.Ссылка КАК Ссылка,
			|	Контрагенты.ИНН КАК ИНН
			|ПОМЕСТИТЬ вт_Трапеза
			|ИЗ
			|	Справочник.Контрагенты КАК Контрагенты
			|ГДЕ
			|	Контрагенты.ИНН В(&ИНН_ПроизводствоПоЗаказу)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ЗаказКлиента.Ссылка КАК Заказ,
			|	ЗаказКлиента.НомерПоДаннымКлиента КАК НомерПоДаннымКлиента,
			|	ЗаказКлиента.ДатаПоДаннымКлиента КАК ДатаПоДаннымКлиента,
			|	ЗаказКлиента.Организация КАК Организация
			|ИЗ
			|	Документ.ЗаказКлиента КАК ЗаказКлиента
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ вт_Трапеза КАК вт_Трапеза
			|		ПО ЗаказКлиента.Контрагент = вт_Трапеза.Ссылка
			|ГДЕ
			|	ЗаказКлиента.НомерПоДаннымКлиента = &НомерПоДаннымКлиента
			|	И ЗаказКлиента.ДатаПоДаннымКлиента = &ДатаПоДаннымКлиента
			|	И ЗаказКлиента.Проведен
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ вт_Организации
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ вт_Трапеза";
			
			Запрос.УстановитьПараметр("ИНН_РБ", "9731060160");
			Запрос.УстановитьПараметр("ИНН_ТТМ", "6901066336");
			Запрос.УстановитьПараметр("ИНН_ПроизводствоПоЗаказу", СтрРазделить("7714931745,9731060160",",",Ложь));
			Запрос.УстановитьПараметр("НомерПоДаннымКлиента", Источник.НомерПоДаннымКлиента);
			Запрос.УстановитьПараметр("ДатаПоДаннымКлиента", Источник.ДатаПоДаннымКлиента);
			
			РезультатЗапроса = Запрос.ВыполнитьПакет();
			
			// Для установки условий нужны ссылки на организации ТТМ и Роболабс
			//Берём из результата запроса
			ВыборкаДетальныеЗаписи = РезультатЗапроса[1].Выбрать();
			Организации = Новый Структура("Робо,ТТМ");

			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				ЗаполнитьЗначенияСвойств(Организации,ВыборкаДетальныеЗаписи);
			КонецЦикла;
			
			// Запрос возвращает заказы клиента с входящим номером и датой из источника
			//от клиентов Трапеза или Роболабс
			//только для них оформляется производство через этапы
			// По документу источнику если он есть в результате, формируются производственные документы
			// Если источник - Робо, то связанный заказ ТТМ тоже отмечается в том же статусе и проводится
			// проведение заказа ТТМ тоже пройдёт через эту подписку и будут созданы производственные документы
			ВыборкаДетальныеЗаписи = РезультатЗапроса[3].Выбрать();
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				Если Источник.Ссылка = ВыборкаДетальныеЗаписи.Заказ Тогда
					СвойстваОбъекта = Новый Структура("Ссылка,Проведен,Статус,Товары");
					ЗаполнитьЗначенияСвойств(СвойстваОбъекта,Источник);
					СвойстваОбъекта.Товары = Источник.Товары.Выгрузить();
					ФормироватьЭтапы = ТТМ_ОбщегоНазначения.ДанныеИзХОН("ТТМ_ПДок").СразуФормироватьЭтапы;
					Если ФормироватьЭтапы = Неопределено Тогда
						ФормироватьЭтапы = Истина;
					КонецЕсли;
					ТТМ_Производство.СформироватьЗаказыНаПроизводство(Источник.Ссылка,СвойстваОбъекта,ФормироватьЭтапы);
				КонецЕсли;
				Если Источник.Организация = Организации.Робо
					И ВыборкаДетальныеЗаписи.Организация = Организации.ТТМ Тогда
						ЗаказТТМ = ВыборкаДетальныеЗаписи.Заказ.ПолучитьОбъект();
						ЗаказТТМ.Статус = Источник.Статус;
						ЗаказТТМ.Записать(РежимЗаписиДокумента.Проведение);
				КонецЕсли;
			КонецЦикла;
			
			
			//}}КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
			
		КонецЕсли;
	КонецЕсли;	
	//Источник.Статус Источник.ЭтоНовый()
КонецПроцедуры
