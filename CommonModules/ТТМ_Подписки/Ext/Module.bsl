Процедура ТТМ_ПередачаПродукцииПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	
	Если не Источник.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПередачаПродукцииИзПроизводства Тогда 
		Возврат;                                                   
	КонецЕсли;    
	
	ТабТовары = Источник.Товары.Выгрузить();
	УчетСерий = ТТМ_СерийныйУчет.ПроверитьУстановитьУчетСерийныхНомеров(ТабТовары[0].Номенклатура);
	
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда 

		НЗ = РегистрыНакопления.ТТМ_УчетСерийныхНомеровПродукции.СоздатьНаборЗаписей();
		НЗ.Отбор.Регистратор.Установить(Источник.Распоряжение);
		НЗ.Прочитать();
		
		Если НЗ.Количество() = 0 Тогда 
			//Отсутствуют зарегистрированые серийные номера для этапа производства
			Возврат;
		КонецЕсли;
		
		ТабСерийныеНомера = НЗ.Выгрузить();
		ТабСерийныеНомера.Сортировать("СерийныйНомер возр");
		ПараметрыПодбора = Новый Структура("Произведено", Ложь);
		МассивНайденныхСтрок = ТабСерийныеНомера.НайтиСтроки(ПараметрыПодбора);  
		
		КоличествоВыпускаемыхИзделий = ТабТовары.Итог("Количество");
		Если МассивНайденныхСтрок.Количество() < КоличествоВыпускаемыхИзделий = ТабТовары.Итог("Количество") Тогда 
			Сообщить("НЕдостаточно зарегистрированных серийных номеров для выпуска продукции");
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
		Для н = 1 по КоличествоВыпускаемыхИзделий Цикл 
			МассивНайденныхСтрок[н-1].Произведено = Истина;
			МассивНайденныхСтрок[н-1].ДатаПроизводства = Источник.Дата;
		КонецЦикла;  
		НЗ.Загрузить(ТабСерийныеНомера);
		Попытка
			НЗ.Записать()
		Исключение
			Сообщить("Ошибка при записи данных о производстве в регистр Учет серийных номеров " + ОписаниеОшибки());
			Отказ = Истина;
		КонецПопытки;
		
	КонецЕсли;
	
	Если РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда 
		
		НЗ = РегистрыНакопления.ТТМ_УчетСерийныхНомеровПродукции.СоздатьНаборЗаписей();
		НЗ.Отбор.Регистратор.Установить(Источник.Распоряжение);  
		НЗ.Прочитать();                                                           
		
		Если НЗ.Количество() = 0 Тогда 
			//Отсутствуют зарегистрированые серийные номера для этапа производства
			Возврат;                                                              
		КонецЕсли;
		
		ТабСерийныеНомера = НЗ.Выгрузить();
		ТабСерийныеНомера.Сортировать("СерийныйНомер убыв");
		ПараметрыПодбора = Новый Структура("Произведено, ДатаПроизводства", Истина, НачалоДня(Источник.Дата));
		МассивНайденныхСтрок = ТабСерийныеНомера.НайтиСтроки(ПараметрыПодбора);
		
		КоличествоОтменяемыхИзделий = ТабТовары.Итог("Количество");
		Если МассивНайденныхСтрок.Количество() < КоличествоОтменяемыхИзделий Тогда                   
			Сообщить("Недостаточно зарегистрировано выпущенных серийных номеров для отмены выпуска продукции");
			Отказ = Истина;
			Возврат;
		КонецЕсли;   
		
		Для н = 1 по КоличествоОтменяемыхИзделий Цикл 
			МассивНайденныхСтрок[н-1].Произведено = Ложь;
			МассивНайденныхСтрок[н-1].ДатаПроизводства = Дата(1,1,1);
		КонецЦикла;  
		НЗ.Загрузить(ТабСерийныеНомера);
		Попытка
			НЗ.Записать()
		Исключение
			Сообщить("Ошибка при отмене производства продукции в регистр Учет серийных номеров " + ОписаниеОшибки());
			Отказ = Истина;
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры

