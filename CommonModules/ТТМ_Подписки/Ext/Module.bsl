 
#Область СерийныеНомера
 
Процедура ТТМ_РТУ_ПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	
	Если Отказ Тогда 
		Возврат;
	КонецЕсли;
	
	Если Источник.Проведен Тогда 
		
		Если РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда 
		    //Удалим сведения о реализации в регистре ТТМ_УчетСерийныхНомеров
			УчетСерийныхНомеров_Удалить_Привязку_Признак_Реализации_для_СН(Источник, Источник.ПометкаУдаления);
		КонецЕсли;	
		
	Иначе  
		Если Источник.этоновый() тогда
			Возврат;
		КонецЕсли;
		//Удалм признак реализации для привязанных серийных номеров 
		//Если ПометкаУдаления Тогда удалим и связь серийнфых номеров с документом реализации в регистре ТТМ_учетСерийныхНомеров
		УчетСерийныхНомеров_Удалить_Привязку_Признак_Реализации_для_СН(Источник, Источник.ПометкаУдаления);
		
	КонецЕсли;  
	
	
		
КонецПроцедуры

#Область ТТМ_ОтгрузкаТоваровСХранения

Процедура ТТМ_УстановитьПризнакРеализованоПоОтгрузкеСХранения(Источник, ЗначениеРеализовано) Экспорт
	Если Источник = Неопределено Тогда
		Возврат;
	КонецЕсли;

	КэшПриемок = Новый Соответствие;
	Для Каждого СтрТов Из Источник.Товары Цикл
		Если Не ЗначениеЗаполнено(СтрТов.ДокументПоступления)
			Или Не ЗначениеЗаполнено(СтрТов.Номенклатура)
			Или Не ЗначениеЗаполнено(СтрТов.СерийныйНомер) Тогда
			Продолжить;
		КонецЕсли;

		Набор = КэшПриемок.Получить(СтрТов.ДокументПоступления);
		Если Набор = Неопределено Тогда
			Набор = РегистрыНакопления.ТТМ_УчетСерийныхНомеровПродукции.СоздатьНаборЗаписей();
			Набор.Отбор.Регистратор.Установить(СтрТов.ДокументПоступления);
			Набор.Прочитать();
			КэшПриемок.Вставить(СтрТов.ДокументПоступления, Набор);
		КонецЕсли;

		Для Каждого СтрНЗ Из Набор Цикл
			Если СтрНЗ.ВидДвижения = ВидДвиженияНакопления.Приход
				И СтрНЗ.Номенклатура = СтрТов.Номенклатура
				И СтрНЗ.СерийныйНомер = СтрТов.СерийныйНомер Тогда
				Если Не ЗначениеЗаполнено(СтрТов.Назначение)
					Или СтрНЗ.Назначение = СтрТов.Назначение Тогда
					СтрНЗ.Реализовано = ЗначениеРеализовано;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Для Каждого Пара Из КэшПриемок Цикл
		Попытка
			Пара.Значение.Записать();
		Исключение
			ВызватьИсключение "Ошибка при обновлении признака 'Реализовано' по сериям приемки: " + ОписаниеОшибки();
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

Процедура ТТМ_ОтгрузкаСХраненияПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Если РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения
		Или Источник.ПометкаУдаления Тогда
		Попытка
			ТТМ_УстановитьПризнакРеализованоПоОтгрузкеСХранения(Источник, Ложь);
		Исключение
			Отказ = Истина;
			Сообщить(ОписаниеОшибки());
			Возврат;
		КонецПопытки;

		НЗ = РегистрыНакопления.ТТМ_УчетСерийныхНомеровПродукции.СоздатьНаборЗаписей();
		НЗ.Отбор.Регистратор.Установить(Источник.Ссылка);
		НЗ.Прочитать();
		НЗ.Очистить();
		Попытка
			НЗ.Записать();
		Исключение
			Отказ = Истина;
			Сообщить("Ошибка при очистке серийных номеров отгрузки с хранения: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

Процедура ТТМ_ОтгрузкаСХраненияОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	НЗ = РегистрыНакопления.ТТМ_УчетСерийныхНомеровПродукции.СоздатьНаборЗаписей();
	НЗ.Отбор.Регистратор.Установить(Источник.Ссылка);
	НЗ.Прочитать();
	НЗ.Очистить();

	Для Каждого СтрТов Из Источник.Товары Цикл
		Если Не ЗначениеЗаполнено(СтрТов.Номенклатура)
			Или Не ЗначениеЗаполнено(СтрТов.СерийныйНомер) Тогда
			Продолжить;
		КонецЕсли;

		НоваяЗапись = НЗ.Добавить();
		НоваяЗапись.Период = Источник.Дата;
		НоваяЗапись.ВидДвижения = ВидДвиженияНакопления.Расход;
		НоваяЗапись.Регистратор = Источник.Ссылка;
		НоваяЗапись.Склад = ?(ЗначениеЗаполнено(СтрТов.Склад), СтрТов.Склад, Источник.Склад);
		НоваяЗапись.Номенклатура = СтрТов.Номенклатура;
		НоваяЗапись.Назначение = ?(ЗначениеЗаполнено(СтрТов.Назначение), СтрТов.Назначение, Справочники.Назначения.ПустаяСсылка());
		НоваяЗапись.СерийныйНомер = СтрТов.СерийныйНомер;
		НоваяЗапись.ШильдЗаказан = Ложь;
		НоваяЗапись.Произведено = Ложь;
		НоваяЗапись.ДатаПроизводства = Дата(1, 1, 1);
		НоваяЗапись.ДокументРеализации = Документы.РеализацияТоваровУслуг.ПустаяСсылка();
		НоваяЗапись.Реализовано = Ложь;
		НоваяЗапись.Количество = ?(ЗначениеЗаполнено(СтрТов.КоличествоУпаковок) И СтрТов.КоличествоУпаковок > 0, СтрТов.КоличествоУпаковок, 1);
	КонецЦикла;

	Попытка
		НЗ.Записать(Истина);
		ТТМ_УстановитьПризнакРеализованоПоОтгрузкеСХранения(Источник, Истина);
	Исключение
		Отказ = Истина;
		Сообщить("Ошибка при записи расхода серийных номеров по отгрузке с хранения: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

#КонецОбласти

Процедура УчетСерийныхНомеров_Удалить_Привязку_Признак_Реализации_для_СН(Источник, ПометкаУдаления)
	
	//НачатьТранзакцию();
	//1. Исправим в строках по выпуску признак Реализовано 
	//1.1 Если Пометка на удаление, то удалим привязку СН к документу реадизации
	//2. Очистим строки по регистратору Истичник
	
	//1.
	//НайтиСтроки выпуска, привязанные к данной реализации и установить "Реализовано" = Ложь
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТТМ_УчетСерийныхНомеровПродукции.Регистратор КАК ЭтапПроизводства,
	               |	ТТМ_УчетСерийныхНомеровПродукции.Склад КАК Склад,
	               |	ТТМ_УчетСерийныхНомеровПродукции.Номенклатура КАК Номенклатура,
	               |	ТТМ_УчетСерийныхНомеровПродукции.Назначение.Заказ КАК НазначениеЗаказ,
	               |	ТТМ_УчетСерийныхНомеровПродукции.Назначение КАК Назначение,
	               |	ТТМ_УчетСерийныхНомеровПродукции.СерийныйНомер КАК СерийныйНомер,
	               |	ТТМ_УчетСерийныхНомеровПродукции.ШильдЗаказан КАК ШильдЗаказан,
	               |	ТТМ_УчетСерийныхНомеровПродукции.Произведено КАК Произведено,
	               |	ТТМ_УчетСерийныхНомеровПродукции.ДатаПроизводства КАК ДатаПроизводства,
	               |	ТТМ_УчетСерийныхНомеровПродукции.ДокументРеализации КАК ДокументРеализации,
	               |	ЕСТЬNULL(ТТМ_УчетСерийныхНомеровПродукции.Реализовано, ЛОЖЬ) КАК Реализовано,
	               |	ТТМ_УчетСерийныхНомеровПродукции.Количество КАК Количество
	               |ИЗ
	               |	РегистрНакопления.ТТМ_УчетСерийныхНомеровПродукции КАК ТТМ_УчетСерийныхНомеровПродукции
	               |ГДЕ
	               |	ТТМ_УчетСерийныхНомеровПродукции.ДокументРеализации = &ДокументРеализации
	               |	И ТТМ_УчетСерийныхНомеровПродукции.Регистратор ССЫЛКА Документ.ЭтапПроизводства2_2";
	Запрос.УстановитьПараметр("ДокументРеализации",Источник.Ссылка);
	РезультатЗапроса = Запрос.Выполнить(); 
	Если РезультатЗапроса.Пустой() Тогда 
		Возврат;
	КонецЕсли;
	ТЗ = РезультатЗапроса.Выгрузить();
	МассивЭтапов = ТЗ.ВыгрузитьКолонку("ЭтапПроизводства");
	НачатьТранзакцию();
	НЗ = РегистрыНакопления.ТТМ_УчетСерийныхНомеровПродукции.СоздатьНаборЗаписей();
	Для Каждого ЭтапПроизводства из МассивЭтапов Цикл 
		НЗ.Отбор.Регистратор.Установить(ЭтапПроизводства);
		НЗ.Прочитать();
		Для Каждого СтрСН из НЗ Цикл   
			//СтрСН.ДокументРеализации = Документы.РеализацияТоваровУслуг.ПустаяСсылка();  //!!!!!!!!! Удалить позже эту строку - Только для теста !!!!!!!!
			СтрСН.Реализовано = Ложь; 
			//1.1 Удалим привязку СН к реализации, если документ помечается на удаление
			Если ПометкаУдаления Тогда 
				СтрСН.ДокументРеализации = Документы.РеализацияТоваровУслуг.ПустаяСсылка();
			КонецЕсли;
		КонецЦикла;   
		Попытка
			НЗ.Записать();
		Исключение               
			Сообщить("Ошибка при записи изменения признака Реализовано для Этапа " + ЭтапПроизводства);
			Отказ = Истина;
			ОтменитьТранзакцию();
		КонецПопытки;
	КонецЦикла;
	
	//2.
	НЗ_Реализации = РегистрыНакопления.ТТМ_УчетСерийныхНомеровПродукции.СоздатьНаборЗаписей();
	НЗ_Реализации.Отбор.Регистратор.Установить(Источник.Ссылка);
	НЗ_Реализации.Прочитать();
	НЗ_Реализации.Очистить();
	Попытка
		НЗ_Реализации.Записать(); 
		ЗафиксироватьТранзакцию();
	Исключение
		Сообщить("Ошибка при удалении записей по регистратору " + Источник.Ссылка);
		Отказ = Истина;
		ОтменитьТранзакцию();
	КонецПопытки;
	
	//ЗафиксироватьТранзакцию();
	
КонецПроцедуры

Процедура ТТМ1_РТУ_ОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт		//РТУ обработка проведения
	
	//1.Если проведённый, проверить необходимость(признак учета СН и дата начала СН позволяет) и наличие записи о серии
	//2.Если нужно - создать записи для соотв номенклатуры
	Если не Отказ Тогда
		ЕстьВсеСерии = Истина;	
		ТЗ_Серии = ТТМ_СерийныйУчет.ПроверитьНайтиСерийныйНомерПродукцииПриПродаже(Источник, ЕстьВсеСерии);
		Если ТЗ_Серии = Неопределено Тогда  
			//Учет серийных номеров не ведется ни для одной номенклатуры из Реализации 
			//или есть не все серии //сообщение при возврате из процедуры подбора СН на реализацию
			Если не ЕстьВсеСерии Тогда  //03.03.2026
				Отказ = Истина;  		//03.03.2026  
				Возврат;
			Иначе                       //03.03.2026
				Возврат;
			КонецЕсли;                 //03.03.2026
		КонецЕсли;
		Если ЕстьВсеСерии Тогда
			
			//Запишем сведения о реализации в текущий набор данных 
			НачатьТранзакцию();
			
			НЗЭтапы = РегистрыНакопления.ТТМ_УчетСерийныхНомеровПродукции.СоздатьНаборЗаписей();
			КоличествоРеализации = 0;
			Для Каждого СтрСН Из ТЗ_Серии Цикл   
				НЗЭтапы.Отбор.Регистратор.Установить(СтрСН.ЭтапПроизводства);
				НЗЭтапы.Прочитать();
				Для Каждого СтрНЗ из НЗЭтапы Цикл     
					ЗаполнитьЗначенияСвойств(СтрНЗ,СтрСН);
					Если не ЗначениеЗаполнено(СтрНЗ.ДокументРеализации) Тогда //или СтрСН.ДокументРеализации <> Источник.Ссылка 
						СтрНЗ.ДокументРеализации = Источник.Ссылка;
						СтрСН.Реализовано = Истина;
					Иначе
						Если СтрСН.ДокументРеализации = Источник.Ссылка Тогда 
							СтрСН.Реализовано = Истина;
						Иначе 
							Сообщить("Операция не выполнена! Для " + СтрСн.Номенклатура + " серийный номер " + СтрСН.СерийныйНомер + " уже привязан к реализации " + СтрСН.ДокументРеализации);
							Отказ = Истина;
							ОтменитьТранзакцию();
							Возврат;
						КонецЕсли;
					КонецЕсли; 
				КонецЦикла;       
				Попытка
					НЗЭтапы.Записать();
				Исключение 
					Сообщить("Ошибка записи регистра при дополнении информации об отгрузке! " + СтрСН.ЭтапПроизводства);
					Отказ = Истина;
					ОтменитьТранзакцию();
				КонецПопытки;
			КонецЦикла;   
						
			//Создадим записи регистра РТУ по сериям     
			НЗ = РегистрыНакопления.ТТМ_УчетСерийныхНомеровПродукции.СоздатьНаборЗаписей();
			НЗ.Отбор.Регистратор.Значение = Источник.Ссылка;
			НЗ.Загрузить(ТЗ_Серии);
			Для каждого стр из НЗ Цикл 
				стр.Период = Источник.Дата;
				стр.ВидДвижения = ВидДвиженияНакопления.Расход;
				стр.Регистратор = Источник.Ссылка;
				стр.ДокументРеализации = Источник.Ссылка;
				стр.Реализовано = Истина;
			КонецЦикла;           
			
			Попытка            
				НЗ.Записать(Истина);
				ЗафиксироватьТранзакцию();
			Исключение  
				Сообщить("Ошибка записи в регистр информации о резализации!");
				Отказ = Истина;
				ОтменитьТранзакцию();
			КонецПопытки;
		Иначе                               
			ОбщегоНазначения.СообщитьПользователю("Готовы не все серийные номера для реализации товаров!");
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры   

