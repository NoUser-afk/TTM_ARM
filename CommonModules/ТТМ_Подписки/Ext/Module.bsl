			Для н = 1 по СтрокаРеализации.Количество Цикл
				НоваяСтрока = ТЗРезультат.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрокаРеализации);
				НоваяСтрока.ДокументРеализации = ИсточникРТУ.Ссылка;
				Если не ЗначениеЗаполнено(НоваяСтрока.ДокументРеализации) Тогда 
					НоваяСтрока.ДокументРеализации = ИсточникРТУ.Ссылка;
				КонецЕсли;
				НоваяСтрока.Реализовано = Истина;  
				Подобрано = Подобрано + 1;
			КонецЦикла;
			
			Если Подобрано = СтрокаРеализации.КоличествоРеализации Тогда 
				Прервать;
			КонецЕсли;   
			
		КонецЕсли;
		
	КонецЦикла;       
	
	Если ЗначениеЗаполнено(СообщениеНЕдостаточноСерийныхНомеров) Тогда 
		ОбщегоНазначения.СообщитьПользователю("Не удалось подобрать достаточно серийных номеров для реализации продукции:" + Символы.ПС + СтрокаРеализации.Номенклатура);
	КонецЕсли;
	ЕстьВсеСерии = ЕстьВсеСН;
	
	//Если Не ЕстьВсеСН Тогда
	//	ТЗРезультат = ТЗРезультат.Скопировать();
	//КонецЕсли;
	
	Возврат ТЗРезультат;
	
КонецФункции  

#КонецОбласти



