&НаКлиенте
Процедура УстановитьСерийныеНомера(Команда)

	// Элемент табличного поля "Товары" берём из коллекции элементов формы
	ЭлТовары = Элементы.Товары.ТекущиеДанные;
	Если ЭлТовары = Неопределено Тогда
		Предупреждение("На форме не найден элемент табличного поля 'Товары'.");
		Возврат;
	КонецЕсли;

	// Текущая строка табличной части
	ТекСтрока = ЭлТовары;

	// Если строка не выбрана — возьмём первую из Объект.Товары (ПутьКДанным = Объект.Товары)
	Если ТекСтрока = Неопределено Тогда
		Если Объект.Товары.Количество() = 0 Тогда
			Предупреждение("В документе нет строк табличной части 'Товары'.");
			Возврат;
		КонецЕсли;
		ТекСтрока = Объект.Товары[0];
	КонецЕсли;

	// Проверки
	Если Не ЗначениеЗаполнено(ТекСтрока.Номенклатура) Тогда
		Предупреждение("В строке не заполнена Номенклатура.");
		Возврат;
	КонецЕсли;

	Если ТекСтрока.Количество <= 0 Тогда
		Предупреждение("Количество должно быть больше нуля.");
		Возврат;
	КонецЕсли;

	ТТМ_ОбеспечитьЗаписьНовогоДокумента();

	// Пакуем параметры только те, что пойдут в РН + служебные
	Парам = Новый Структура;
	Парам.Вставить("ДокОснование",         Объект.Ссылка);
	Парам.Вставить("Количество",           ТекСтрока.Количество);

	// Измерения регистра (серийник вводится в форме)
	Парам.Вставить("Склад",                ?(ЗначениеЗаполнено(ТекСтрока.Склад), ТекСтрока.Склад, Объект.Склад));
	Парам.Вставить("Номенклатура",         ТекСтрока.Номенклатура);
	Парам.Вставить("Назначение",           ТекСтрока.Назначение);

	// Прочие измерения регистра с дефолтами (пользователь может поменять в форме)
	Парам.Вставить("ШильдЗаказан",         Ложь);
	Парам.Вставить("Произведено",          Ложь);
	Парам.Вставить("ДатаПроизводства",     Неопределено);
	Парам.Вставить("ДокументРеализации",   Неопределено);
	Парам.Вставить("Реализовано",          Ложь);   
	
	НайденныйРеквизит = РеквизитСуществует("ТабСерииТоваров");
	Если НайденныйРеквизит = Неопределено Тогда 
		Попытка
			СоздатьТабСерииТоваров();  
		Исключение
			Сообщить("Ошибка создания реквизита ТабСерииТоваров. " + ОписаниеОшибки());
			Возврат;
		КонецПопытки;
	КонецЕсли;
	АдресТаблицыСерийныхНомеров = ЗаполнитьТабСерииТоваров();
	Парам.Вставить("АдресТабСерииТоваров",АдресТаблицыСерийныхНомеров);
	
	ОповещениеЗакрытия = Новый ОписаниеОповещения("ТТМ_ПослеЗакрытияФормыСерий", ЭтотОбъект);
	
	// Открываем форму ввода серийников
	ОткрытьФорму(
		"ОбщаяФорма.ТТМ_ВводСерийныхНомеровСДаннымиИзТЧ",
		Парам,
		ЭтаФорма,
		, , ,
		ОповещениеЗакрытия,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

	КонецПроцедуры 
	
&НаКлиенте
Процедура ТТМ_ОбеспечитьЗаписьНовогоДокумента()

// <validation>

	Если Не ЗначениеЗаполнено(Объект.Товары) Тогда
		Возврат;
	КонецЕсли;

// <condition_check>

	Если Объект.Ссылка.Пустая() Тогда
		ПараметрыЗаписи = Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Запись);
		ЭтаФорма.Записать(ПараметрыЗаписи);
	КонецЕсли;

КонецПроцедуры	
	
&НаСервере
Функция ЗаполнитьТабСерииТоваров()    
	
	ТЗ = ЭтаФорма.ТабСерииТоваров.Выгрузить();
	АдресТабСерийныеНомера = ПоместитьВоВременноеХранилище(ТЗ);
	
	Возврат АдресТабСерийныеНомера;
	
КонецФункции

&НаСервере
Функция СоздатьТабСерииТоваров()
	
	ДобавляемыеРеквизиты = Новый Массив;

	Если РеквизитСуществует("ТабСерииТоваров") = Неопределено Тогда
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ТабСерииТоваров",Новый ОписаниеТипов("ТаблицаЗначений"),"","ТабСерииТоваров",Ложь));
	КонецЕсли;

	Если РеквизитСуществует("Номенклатура") = Неопределено Тогда
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("Номенклатура",Новый ОписаниеТипов("СправочникСсылка.Номенклатура"),"ТабСерииТоваров","Номенклатура",Ложь));
	КонецЕсли;
	Если РеквизитСуществует("КодТМ") = Неопределено Тогда
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("КодТМ",Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(50,ДопустимаяДлина.Переменная)),"ТабСерииТоваров","Код ТМ",Ложь));
