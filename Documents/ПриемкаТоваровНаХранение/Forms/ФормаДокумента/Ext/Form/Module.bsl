	КонецЕсли;
	
	//ТипРеквизита = Новый ОписаниеТипов("ТаблицаЗначений");
	//РеквизитФормы = Новый РеквизитФормы(
	//		"ТабСерииТоваров", 	  //Имя реквизита формы
	//		ТипРеквизита,   	  //Тип
	//		"",             	  //Путь  (Пусто, "Объект", ИмяТЧ) // например "Объект.Товары"	
	//		"ТабСерииТоваров");	  //Заголовок
		
	//ТипРеквизита = Новый ОписаниеТипов("КолонкаТаблицыЗначений");
	//РеквизитФормы = Новый РеквизитФормы(
	//	"ТабСерииТоваров.Номенклатура",
	//	ТипРеквизита,
	//	"",
	//	"Номенклатура"); 
	//ДобавляемыеРеквизиты.Добавить(РеквизитФормы);
	//
	//ТипРеквизита = Новый ОписаниеТипов("Буелво");
	//РеквизитФормы = Новый РеквизитФормы(
	//	"ТабСерииТоваров.УчитыватьСерийныеномера",
	//	ТипРеквизита,
	//	"",
	//	"Номенклатура"); 
	//ДобавляемыеРеквизиты.Добавить(РеквизитФормы);
			
	//Заставляем форму создать новые реквизиты
