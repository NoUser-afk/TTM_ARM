&НаКлиенте
Функция ТТМ_ТекущаяСтрокаСпискаДляОтладки()

	Попытка
		Возврат Строка(Элементы.Список.ТекущаяСтрока);
	Исключение
		Возврат "<ошибка: " + ОписаниеОшибки() + ">";
	КонецПопытки;

КонецФункции
