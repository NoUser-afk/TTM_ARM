&НаСервере
Процедура ТТМ_ПередСозданиемНаСервере(Отказ, СтандартнаяОбработка)

	Если Не Объект.Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;

	ОснованиеПриемка = ТТМ_ОпределитьОснованиеПриемки();
	Если ОснованиеПриемка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ТТМ_ПриемкаСодержитТоварыСУчетомСерий(ОснованиеПриемка) Тогда
		Отказ = Истина;
		ОбщегоНазначения.СообщитьПользователю(
			"Создание документа 'Отгрузка товаров с хранения' на основании приемки запрещено."
			+ Символы.ПС
			+ "Для товаров с учетом серий используйте АРМ 'Выпуск и реализация'.");
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ТТМ_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)

	Если Не Объект.Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;

	ОснованиеПриемка = ТТМ_ОпределитьОснованиеПриемки();
	Если ОснованиеПриемка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ТТМ_ЗаполнитьОтгрузкуПоПриемке(ОснованиеПриемка);

КонецПроцедуры

&НаСервере
Функция ТТМ_ОпределитьОснованиеПриемки()

	Если ЗначениеЗаполнено(Объект.ДокументОснование)
		И ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ПриемкаТоваровНаХранение") Тогда
		Возврат Объект.ДокументОснование;
	КонецЕсли;

	Если Параметры.Свойство("ЗначенияЗаполнения")
		И ТипЗнч(Параметры.ЗначенияЗаполнения) = Тип("Структура")
		И Параметры.ЗначенияЗаполнения.Свойство("ДокументОснование")
		И ТипЗнч(Параметры.ЗначенияЗаполнения.ДокументОснование) = Тип("ДокументСсылка.ПриемкаТоваровНаХранение") Тогда
		Возврат Параметры.ЗначенияЗаполнения.ДокументОснование;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

&НаСервере
Функция ТТМ_ПриемкаСодержитТоварыСУчетомСерий(ОснованиеПриемка)

	ДокументПриемки = ОснованиеПриемка.ПолучитьОбъект();
	Если ДокументПриемки = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого СтрокаПриемки Из ДокументПриемки.Товары Цикл
		Если ЗначениеЗаполнено(СтрокаПриемки.Номенклатура)
			И ТТМ_СерийныйУчет.ПроверитьУстановитьУчетСерийныхНомеров(СтрокаПриемки.Номенклатура) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

&НаСервере
Процедура ТТМ_ЗаполнитьОтгрузкуПоПриемке(ОснованиеПриемка)

	ДокументПриемки = ОснованиеПриемка.ПолучитьОбъект();
	Если ДокументПриемки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Объект.Основание = ОснованиеПриемка;
	Объект.ПоЗаказу = Ложь;
	Объект.ХозяйственнаяОперация = ПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.ОтгрузкаПринятыхСПравомПродажиТоваровСХранения");

	ЗаполнитьЗначенияСвойств(
		Объект,
		ДокументПриемки,
		"Организация,Партнер,Контрагент,Подразделение,Склад,Договор,НаправлениеДеятельности,Комментарий");

	Объект.Товары.Очистить();
	Для Каждого СтрокаПриемки Из ДокументПриемки.Товары Цикл
		Если Не ЗначениеЗаполнено(СтрокаПриемки.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;

		НоваяСтрока = Объект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(
			НоваяСтрока,
			СтрокаПриемки,
			"Номенклатура,Характеристика,Назначение,Склад,Упаковка,Количество,КоличествоУпаковок,Цена,Сумма,КодСтроки,Серия");
		НоваяСтрока.ДокументПоступления = ОснованиеПриемка;
	КонецЦикла;

КонецПроцедуры
