&НаСервере
Процедура ТТМ_ПередСозданиемНаСервере(Отказ, СтандартнаяОбработка)

	//++ Панин + Codex 02.07.2026
	ТТМ_ОбеспечитьРеквизитПодтвержденияОтвязкиСерий();
	//-- Панин + Codex 02.07.2026

	Если Не Объект.Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;

	ОснованиеПриемка = ТТМ_ОпределитьОснованиеПриемки();
	Если ОснованиеПриемка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ТТМ_ПриемкаСодержитТоварыСУчетомСерий(ОснованиеПриемка) Тогда
		Отказ = Истина;
		ОбщегоНазначения.СообщитьПользователю(
			"Создание документа 'Отгрузка товаров с хранения' на основании приемки запрещено."
			+ Символы.ПС
			+ "Для товаров с учетом серий используйте АРМ 'Выпуск и реализация'.");
	КонецЕсли;

КонецПроцедуры

//++ Панин + Codex 02.07.2026
&НаСервере
Процедура ТТМ_ОбеспечитьРеквизитПодтвержденияОтвязкиСерий()

	ДобавляемыеРеквизиты = Новый Массив;
	ДобавляемыеРеквизиты.Добавить(
		Новый РеквизитФормы(
			"ТТМ_ПодтвержденаОтвязкаСерий",
			Новый ОписаниеТипов("Булево"),
			"",
			"Подтверждена отвязка серий",
			Ложь));

	ИзменитьРеквизиты(ДобавляемыеРеквизиты);

КонецПроцедуры

&НаКлиенте
Процедура ТТМ_ПередЗаписью(Отказ, ПараметрыЗаписи)

	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Если ЭтаФорма.ТТМ_ПодтвержденаОтвязкаСерий Тогда
		ЭтаФорма.ТТМ_ПодтвержденаОтвязкаСерий = Ложь;
		Возврат;
	КонецЕсли;

	РежимЗаписи = Неопределено;
	ПараметрыЗаписи.Свойство("РежимЗаписи", РежимЗаписи);

	ОтменаПроведения = РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения;
	ПометкаНаУдаление = Объект.ПометкаУдаления;
	Если Не ОтменаПроведения
		И Не ПометкаНаУдаление Тогда
		Возврат;
	КонецЕсли;

	Если Объект.Ссылка.Пустая()
		Или Не ТТМ_ЕстьСвязанныеСерийныеНомераОтгрузкиНаСервере(Объект.Ссылка) Тогда
		Возврат;
	КонецЕсли;

	ТекстВопроса = "Серийные номера будут отвязаны от документа отгрузки."
		+ Символы.ПС
		+ "Повторную отгрузку нужно будет провести из АРМ ""Выпуск и реализация"" заново."
		+ Символы.ПС
		+ "Продолжить?";

	Отказ = Истина;
	Оповещение = Новый ОписаниеОповещения("ТТМ_ПередЗаписьюПослеВопроса", ЭтотОбъект, ПараметрыЗаписи);
	ПоказатьВопрос(
		Оповещение,
		ТекстВопроса,
		РежимДиалогаВопрос.ДаНет,
		0,
		КодВозвратаДиалога.Нет,
		"Отгрузка товаров с хранения");

КонецПроцедуры

&НаКлиенте
Процедура ТТМ_ПередЗаписьюПослеВопроса(Результат, ПараметрыЗаписи) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	ЭтаФорма.ТТМ_ПодтвержденаОтвязкаСерий = Истина;
	ЭтаФорма.Записать(ПараметрыЗаписи);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ТТМ_ЕстьСвязанныеСерийныеНомераОтгрузкиНаСервере(СсылкаНаОтгрузку)

	Если Не ЗначениеЗаполнено(СсылкаНаОтгрузку) Тогда
		Возврат Ложь;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ТТМ_УчетСерийныхНомеровПродукции.Регистратор КАК Регистратор
	               |ИЗ
	               |	РегистрНакопления.ТТМ_УчетСерийныхНомеровПродукции КАК ТТМ_УчетСерийныхНомеровПродукции
	               |ГДЕ
	               |	ТТМ_УчетСерийныхНомеровПродукции.Регистратор = &СсылкаНаОтгрузку
	               |	ИЛИ ТТМ_УчетСерийныхНомеровПродукции.ДокументРеализации = &СсылкаНаОтгрузку";
	Запрос.УстановитьПараметр("СсылкаНаОтгрузку", СсылкаНаОтгрузку);

	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции
