&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	тдПерваяСтрока = 2;
	тдКолонкаНоменклатуры = 1;
	тдКолонкаКоличества = 2;
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФайл(Команда)
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбораФайла.Заголовок = "Выберите файл с данными";
	ДиалогВыбораФайла.Фильтр = "Файл xlsx (*.xlsx)|*.xlsx|Файл xls (*.xls)|*.xls|Все Файлы (*.*)|*.*|";
	Если Не ДиалогВыбораФайла.Выбрать() Тогда
		Возврат;
	КонецЕсли;
	
	ИмяФайлаЗагрузки = ДиалогВыбораФайла.ПолноеИмяФайла;
	Если ПустаяСтрока(ИмяФайлаЗагрузки) Тогда
		Возврат;
	КонецЕсли;
	
	РасширениеФайла = Прав(ИмяФайлаЗагрузки, СтрДлина(ИмяФайлаЗагрузки) - СтрНайти(ИмяФайлаЗагрузки, ".") + 1);
	АдресФайла = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ИмяФайлаЗагрузки));
	ЗагрузитьТабличныйДокументИзФайлаНаСервере(АдресФайла, РасширениеФайла);
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьТабличныйДокументИзФайлаНаСервере(АдресФайла, РасширениеФайла)
	ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(АдресФайла);
	Если ДвоичныеДанныеФайла = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла(РасширениеФайла);
	ДвоичныеДанныеФайла.Записать(ИмяВременногоФайла);
	
	ТабДок = Новый ТабличныйДокумент;
	Попытка
		ТабДок.Прочитать(ИмяВременногоФайла);
	Исключение
		УдалитьФайлы(ИмяВременногоФайла);
		ВызватьИсключение ОписаниеОшибки();
	КонецПопытки;
	УдалитьФайлы(ИмяВременногоФайла);
КонецПроцедуры

&НаКлиенте
Процедура СформироватьСписокНоменклатуры(Команда)
	СформироватьСписокНоменклатурыНаСервере();
	Элементы.Группа7.ТекущаяСтраница = Элементы.НоменклатураКСписанию;
КонецПроцедуры

&НаСервере
Процедура СформироватьСписокНоменклатурыНаСервере()
	Товары.Очистить();
	Если ТабДок = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для НомерСтроки = тдПерваяСтрока По ТабДок.ВысотаТаблицы Цикл
		Попытка
			ТекстНоменклатуры = СокрЛП(ТабДок.Область(НомерСтроки, тдКолонкаНоменклатуры).Текст);
			Количество = ТТМ_ПреобразоватьТекстВЧисло(ТабДок.Область(НомерСтроки, тдКолонкаКоличества).Текст);
		Исключение
			Продолжить;
		КонецПопытки;
		
		Если ПустаяСтрока(ТекстНоменклатуры) И Количество = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаТовара = Товары.Добавить();
		СтрокаТовара.КодНоменклатуры = ТекстНоменклатуры;
		СтрокаТовара.НоменклатураТекст = ТекстНоменклатуры;
		СтрокаТовара.КоличествоУпаковок = Количество;
	КонецЦикла;
	
	ЗаполнитьНоменклатуруВСписке();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНоменклатуруВСписке()
	Если Товары.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Ссылка,
		|	Номенклатура.Код КАК Код,
		|	Номенклатура.Наименование КАК Наименование,
		|	Номенклатура.КодДляПоиска КАК КодДляПоиска
		|ПОМЕСТИТЬ вт_Номенклатура
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	(Номенклатура.Код В(&НоменклатураТекст)
		|		ИЛИ Номенклатура.КодДляПоиска В(&НоменклатураТекст))
		|	И Номенклатура.Код <> """"
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Номенклатура.Ссылка,
		|	Номенклатура.Код,
		|	Номенклатура.Наименование,
		|	Номенклатура.КодДляПоиска
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Наименование В(&НоменклатураТекст)
		|	И Номенклатура.Наименование <> """"
		|
		|;
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	вт_Номенклатура.Ссылка КАК Ссылка,
		|	вт_Номенклатура.Код КАК Код,
		|	вт_Номенклатура.Наименование КАК Наименование,
		|	вт_Номенклатура.КодДляПоиска КАК КодДляПоиска
		|ИЗ
		|	вт_Номенклатура КАК вт_Номенклатура";
	Запрос.УстановитьПараметр("НоменклатураТекст", Товары.Выгрузить().ВыгрузитьКолонку("НоменклатураТекст"));
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	ПоляПоиска = СтрРазделить("Наименование,КодДляПоиска,Код", ",", Ложь);
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Для Каждого ПолеПоиска Из ПоляПоиска Цикл
			СтрокиСТекстом = Товары.НайтиСтроки(Новый Структура("НоменклатураТекст", ВыборкаДетальныеЗаписи[ПолеПоиска]));
			Если СтрокиСТекстом.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			Для Каждого СтрТЗ Из СтрокиСТекстом Цикл
				СтрТЗ.Номенклатура = ВыборкаДетальныеЗаписи.Ссылка;
				СтрТЗ.КодНоменклатуры = ВыборкаДетальныеЗаписи.Код;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ТТМ_ПреобразоватьТекстВЧисло(ТекстЧисла)
	ЛокальныйТекст = СокрЛП(Строка(ТекстЧисла));
	ЛокальныйТекст = СтрЗаменить(ЛокальныйТекст, Символы.НПП, "");
	ЛокальныйТекст = СтрЗаменить(ЛокальныйТекст, " ", "");
	ЛокальныйТекст = СтрЗаменить(ЛокальныйТекст, ",", ".");
	Попытка
		Возврат Число(ЛокальныйТекст);
	Исключение
		Возврат 0;
	КонецПопытки;
КонецФункции

&НаКлиенте
Процедура ПеренестиВДокумент(Команда)
	Если Товары.Количество() = 0 Тогда
		Сообщить("Список номенклатуры пуст.");
		Возврат;
	КонецЕсли;

	АдресРезультата = СформироватьРезультатДляЗакрытияНаСервере();
	Если АдресРезультата = Неопределено Тогда
		Сообщить("Нет строк для переноса.");
		Возврат;
	КонецЕсли;

	Закрыть(АдресРезультата);
КонецПроцедуры

&НаСервере
Функция СформироватьРезультатДляЗакрытияНаСервере()
	ТаблицаРезультат = Новый ТаблицаЗначений;
	ТаблицаРезультат.Колонки.Добавить("КодНоменклатуры");
	ТаблицаРезультат.Колонки.Добавить("Номенклатура");
	ТаблицаРезультат.Колонки.Добавить("НоменклатураТекст");
	ТаблицаРезультат.Колонки.Добавить("КоличествоУпаковок", Новый ОписаниеТипов("Число"));

	Для Каждого СтрокаТовара Из Товары Цикл
		Если Не ЗначениеЗаполнено(СтрокаТовара.КоличествоУпаковок) Или СтрокаТовара.КоличествоУпаковок = 0 Тогда
			Продолжить;
		КонецЕсли;

		НоваяСтрока = ТаблицаРезультат.Добавить();
		НоваяСтрока.КодНоменклатуры = СтрокаТовара.КодНоменклатуры;
		НоваяСтрока.Номенклатура = ?(ЗначениеЗаполнено(СтрокаТовара.Номенклатура), СтрокаТовара.Номенклатура, Справочники.Номенклатура.ПустаяСсылка());
		НоваяСтрока.НоменклатураТекст = СтрокаТовара.НоменклатураТекст;
		НоваяСтрока.КоличествоУпаковок = СтрокаТовара.КоличествоУпаковок;
	КонецЦикла;

	Если ТаблицаРезультат.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ПоместитьВоВременноеХранилище(ТаблицаРезультат);
КонецФункции
