#Область ЗаписьДвиженияВРН
&НаСервереБезКонтекста
Процедура ОтменитьПриходПоРегистраторуСервер(ДокОснование, Номенклатура = Неопределено) Экспорт

	НЗ = РегистрыНакопления.ТТМ_УчетСерийныхНомеровПродукции.СоздатьНаборЗаписей();
	НЗ.Отбор.Регистратор.Установить(ДокОснование);
	НЗ.Прочитать();

	Если Номенклатура = Неопределено Тогда
		// Полная очистка по регистратору (как раньше)
		НЗ.Очистить();
		НЗ.Записать(Истина);
		Возврат;
	КонецЕсли;

	// Частичная очистка: удаляем только НЕ реализованные по номенклатуре,
	// реализованные серии сохраняем.
	Инд = НЗ.Количество() - 1;
	Пока Инд >= 0 Цикл
		Стр = НЗ[Инд];
		Если Стр.Номенклатура = Номенклатура
			И НЕ Стр.Реализовано Тогда
			НЗ.Удалить(Инд);
		КонецЕсли;
		Инд = Инд - 1;
	КонецЦикла;

	НЗ.Записать(Истина);

КонецПроцедуры


&НаСервереБезКонтекста
Процедура ЗаписатьПриходИзФормыСервер(
	ДокОснование,
	Склад,
	Номенклатура,
	Назначение,
	ШильдЗаказан,
	Произведено,
	ДатаПроизводства,
	ДокументРеализации,
	Реализовано,
	ТЗСерий // строки с СерийныйНомер (raw14 или уже формат)
) Экспорт

	
	// 0) очищаем ТЕКУЩИЕ движения по регистратору
	НЗ = РегистрыНакопления.ТТМ_УчетСерийныхНомеровПродукции.СоздатьНаборЗаписей();
	НЗ.Отбор.Регистратор.Установить(ДокОснование);
	НЗ.Прочитать(); 

	// Сохраняем реализованные серии (их не перезаписываем)
	СохранитьРеализованные = Новый Массив;
	Для Каждого СтрНЗ Из НЗ Цикл
		Если СтрНЗ.Номенклатура = Номенклатура
			И СтрНЗ.Реализовано Тогда
			СохранитьРеализованные.Добавить(СтрНЗ);
		КонецЕсли;
	КонецЦикла;

	// Очищаем все движения регистратора по этой номенклатуре (нереализованные удалятся)
	Инд = НЗ.Количество() - 1;
	Пока Инд >= 0 Цикл
		Стр = НЗ[Инд];
		Если Стр.Номенклатура = Номенклатура Тогда
			НЗ.Удалить(Инд);
		КонецЕсли;
		Инд = Инд - 1;
	КонецЦикла;

	// Вернем сохраненные реализованные строки
	Для Каждого СтрСохр Из СохранитьРеализованные Цикл
		Новая = НЗ.Добавить();
		Новая.Период             = СтрСохр.Период;
		Новая.ВидДвижения        = СтрСохр.ВидДвижения;
		Новая.Регистратор        = ДокОснование;
		Новая.Склад              = СтрСохр.Склад;
		Новая.Номенклатура       = СтрСохр.Номенклатура;
		Новая.Назначение         = СтрСохр.Назначение;
		Новая.СерийныйНомер      = СтрСохр.СерийныйНомер;
		Новая.ШильдЗаказан       = СтрСохр.ШильдЗаказан;
		Новая.Произведено        = СтрСохр.Произведено;
		Новая.ДатаПроизводства   = СтрСохр.ДатаПроизводства;
		Новая.ДокументРеализации = СтрСохр.ДокументРеализации;
		Новая.Реализовано        = Истина;
		Новая.Количество         = СтрСохр.Количество;
	КонецЦикла;

	// Добавляем новые приходы по ТЗ (нереализованные)
	УжеЕстьСерии = Новый Соответствие; // ключ = СерийныйНомер
	Для Каждого СтрСохр Из СохранитьРеализованные Цикл
		Если УжеЕстьСерии.Получить(СтрСохр.СерийныйНомер) = Неопределено Тогда
			УжеЕстьСерии.Вставить(СтрСохр.СерийныйНомер, Истина);
		КонецЕсли;
	КонецЦикла;

	ПериодЗаписи = ТекущаяДата();
	Для Каждого СтрФ Из ТЗСерий Цикл
		Если НЕ ЗначениеЗаполнено(СтрФ.СерийныйНомер) Тогда
			Продолжить;
		КонецЕсли;

		Норм = НормализоватьВоВход14(СтрФ.СерийныйНомер);
		Если НЕ Норм.Успех Тогда
			ВызватьИсключение Норм.Сообщение;
		КонецЕсли;
		ФорматСН = ФорматДляРН(Норм.Raw14);

		Если УжеЕстьСерии.Получить(ФорматСН) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		УжеЕстьСерии.Вставить(ФорматСН, Истина);

		Зап = НЗ.Добавить();
		Зап.Период             = ПериодЗаписи;
		Зап.ВидДвижения        = ВидДвиженияНакопления.Приход;
		Зап.Регистратор        = ДокОснование;
		Зап.Склад              = Склад;
		Зап.Номенклатура       = Номенклатура;
		Зап.Назначение         = Назначение;
		Зап.СерийныйНомер      = ФорматСН;
		Зап.ШильдЗаказан       = ?(ТипЗнч(ШильдЗаказан)=Тип("Булево"), ШильдЗаказан, Ложь);
		Зап.Произведено        = Произведено;
		Зап.ДатаПроизводства   = ДатаПроизводства;
		Зап.ДокументРеализации = ДокументРеализации;
		Зап.Реализовано        = Ложь;
		Зап.Количество         = 1;
	КонецЦикла;

	НЗ.Записать(Истина);
		
	
	//// 1) построим множество "уже есть" для защиты от дублей в ЭТОМ регистраторе
	//УжеЕсть = Новый Соответствие; // ключ = Номенклатура|СерийныйНомер|Приход
	//Для Инд = 0 По НЗ.Количество()-1 Цикл
	//	СтрНЗ = НЗ[Инд];
	//	Если СтрНЗ.ВидДвижения = ВидДвиженияНакопления.Приход Тогда
	//		Ключ = Строка(СтрНЗ.Номенклатура) + "|" + СтрНЗ.СерийныйНомер + "|Приход";
	//		Если УжеЕсть.Получить(Ключ) = Неопределено Тогда
	//			УжеЕсть.Вставить(Ключ, Истина);
	//		КонецЕсли;
	//	КонецЕсли;
	//КонецЦикла;

	//// 2) добавляем ТОЛЬКО новые записи по текущей номенклатуре
	//Для Каждого СтрФ Из ТЗСерий Цикл
	//	// нормализуем/форматируем (пользуемся твоими функциями)
	//	РезНорм = НормализоватьВоВход14(СтрФ.СерийныйНомер);
	//	Если Не РезНорм.Успех Тогда
	//		Продолжить; // или ВызватьИсключение(РезНорм.Сообщение);
	//	КонецЕсли;
	//	ФорматСН = ФорматДляРН(РезНорм.Raw14);

	//	Ключ = Строка(Номенклатура) + "|" + ФорматСН + "|Приход";
	//	Если УжеЕсть.Получить(Ключ) <> Неопределено Тогда
	//		Продолжить; // такой приход уже записан этим регистратором — не дублируем
	//	КонецЕсли;

	//	Зап = НЗ.Добавить();
	//	Зап.Период             = ТекущаяДата();
	//	Зап.ВидДвижения        = ВидДвиженияНакопления.Приход;
	//	Зап.Регистратор        = ДокОснование;

	//	Зап.Склад              = Склад;
	//	Зап.Номенклатура       = Номенклатура;
	//	Зап.Назначение         = Назначение;
	//	Зап.СерийныйНомер      = ФорматСН;

	//	Зап.ШильдЗаказан       = ?(ТипЗнч(ШильдЗаказан)=Тип("Булево"), ШильдЗаказан, Ложь);
	//	Зап.Произведено        = Произведено;
	//	Зап.ДатаПроизводства   = ДатаПроизводства;

	//	Зап.ДокументРеализации = ДокументРеализации; // как правило пусто на приходе
	//	Зап.Реализовано        = Реализовано;        // как правило Ложь
	//	Зап.Количество         = 1;
	//КонецЦикла;

	//// 3) пишем набор ЦЕЛИКОМ — теперь это "старые + новые"
	//НЗ.Записать(Истина);

КонецПроцедуры    

&НаСервереБезКонтекста
Функция ПолучитьОстаткиСерийНоменклатуры(Номенклатура, ДокОснование, ТЗСерий);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПринятыеТовары.Номенклатура КАК Номенклатура,
	               |	СУММА(ПринятыеТовары.Количество) КАК Количество,
	               |	ПринятыеТовары.ДокументПриемки КАК ДокументПриемки
	               |ПОМЕСТИТЬ Вт_ПринятаяНоменклатура
	               |ИЗ
	               |	&ПринятыеТовары КАК ПринятыеТовары
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ПринятыеТовары.Номенклатура,
	               |	ПринятыеТовары.ДокументПриемки
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТТМ_УчетСерийныхНомеровПродукции.Период КАК Период,
	               |	ТТМ_УчетСерийныхНомеровПродукции.Регистратор КАК Регистратор,
	               |	ТТМ_УчетСерийныхНомеровПродукции.НомерСтроки КАК НомерСтроки,
	               |	ТТМ_УчетСерийныхНомеровПродукции.Активность КАК Активность,
	               |	ТТМ_УчетСерийныхНомеровПродукции.ВидДвижения КАК ВидДвижения,
	               |	ТТМ_УчетСерийныхНомеровПродукции.Склад КАК Склад,
	               |	ТТМ_УчетСерийныхНомеровПродукции.Номенклатура КАК Номенклатура,
	               |	ТТМ_УчетСерийныхНомеровПродукции.Назначение КАК Назначение,
	               |	ТТМ_УчетСерийныхНомеровПродукции.СерийныйНомер КАК СерийныйНомер,
	               |	ТТМ_УчетСерийныхНомеровПродукции.ШильдЗаказан КАК ШильдЗаказан,
	               |	ТТМ_УчетСерийныхНомеровПродукции.Произведено КАК Произведено,
	               |	ТТМ_УчетСерийныхНомеровПродукции.ДатаПроизводства КАК ДатаПроизводства,
	               |	ТТМ_УчетСерийныхНомеровПродукции.ДокументРеализации КАК ДокументРеализации,
	               |	ТТМ_УчетСерийныхНомеровПродукции.Реализовано КАК Реализовано,
	               |	ТТМ_УчетСерийныхНомеровПродукции.Количество КАК Количество,
	               |	ТТМ_УчетСерийныхНомеровПродукции.МоментВремени КАК МоментВремени
	               |ИЗ
	               |	РегистрНакопления.ТТМ_УчетСерийныхНомеровПродукции КАК ТТМ_УчетСерийныхНомеровПродукции
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Вт_ПринятаяНоменклатура КАК Вт_Номенклатура
	               |		ПО ТТМ_УчетСерийныхНомеровПродукции.Регистратор = Вт_Номенклатура.ДокументПриемки
	               |			И ТТМ_УчетСерийныхНомеровПродукции.Номенклатура = Вт_Номенклатура.Номенклатура
	               |ГДЕ
	               |	ТТМ_УчетСерийныхНомеровПродукции.Регистратор ССЫЛКА Документ.ПриемкаТоваровНаХранение";    
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Скопировать(,"");
	//ТабТовары = ТЗСерий.Скопировать()
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Регистратор", ДокОснование);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

//
//Процедура ЗаписатьПриходИзФормыСервер(
//	ДокОснование,
//	Склад,
//	Номенклатура,
//	Назначение,
//	ШильдЗаказан,
//	Произведено,
//	ДатаПроизводства,
//	ДокументРеализации,
//	Реализовано,
