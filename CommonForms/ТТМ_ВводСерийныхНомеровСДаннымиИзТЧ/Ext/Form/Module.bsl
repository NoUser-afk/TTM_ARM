#Область ОбработчикиСобытийФормы
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	
	//// Гарантируем таблицу и колонки
	//Если ТЧСерийныеНомера = Неопределено Тогда
	//	ТЧСерийныеНомера = Новый("ТаблицаЗначений");
	//	Попытка
	//		ТЧСерийныеНомера.Колонки.Добавить("Номенклатура");
	//		ТЧСерийныеНомера.Колонки.Добавить("СерийныйНомер");
	//	Исключение
	//		// если колонки уже есть - ничего не делаем
	//	КонецПопытки;
	//КонецЕсли; 
	
	
	
	// Принимаем параметры как есть
	ДокОснование       = Параметры.ДокОснование;
	Склад              = Параметры.Склад;
	Номенклатура       = Параметры.Номенклатура;
	Назначение         = Справочники.Назначения.ПустаяСсылка();
	Параметры.Свойство("Назначение", Назначение);
	Количество         = Параметры.Количество;
	ШильдЗаказан       = Ложь;
	Произведено        = Ложь;
	ДатаПроизводства   = Дата(1,1,1);
	ДокументРеализации = Документы.РеализацияТоваровУслуг.ПустаяСсылка();
	Реализовано        = Ложь;      
	
	ТаблицаСерийныхНомеров = Неопределено;
	АдресТабСерииТоваров = Неопределено;
	Если Параметры.Свойство("АдресТабСерииТоваров", АдресТабСерииТоваров)
		И ЗначениеЗаполнено(АдресТабСерииТоваров) Тогда
		ТаблицаСерийныхНомеров = ПолучитьИзВременногоХранилища(АдресТабСерииТоваров);
	КонецЕсли;
	
	// Заполняем табличную часть на нужное количество строк
	Попытка
		ТЧСерийныеНомера.Очистить();
	Исключение
		// на всякий случай
	КонецПопытки;
	
	Если ТипЗнч(ТаблицаСерийныхНомеров) = Тип("ТаблицаЗначений") Тогда
		Для Каждого СтрСерий Из ТаблицаСерийныхНомеров Цикл
			Если СтрСерий.Номенклатура = Номенклатура Тогда
				Стр = ТЧСерийныеНомера.Добавить();
				Стр.Номенклатура = Номенклатура;
				Стр.СерийныйНомер = ОставитьЦифры(Строка(СтрСерий.СерийныйНомер));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Если ТЧСерийныеНомера.Количество() < Цел(Количество) Тогда
		Для Н = ТЧСерийныеНомера.Количество() + 1 По Цел(Количество) Цикл
			Стр = ТЧСерийныеНомера.Добавить();
			Стр.Номенклатура  = Номенклатура;
			Стр.СерийныйНомер = "";
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТЧСерийныеНомераСерийныйНомерОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, Парам, СтандартнаяОбработка)
	Рез = НормализоватьВоВход14(Текст); // функция, возвращает .Успех и .Raw14
	Если Не Рез.Успех Тогда
		СообщитьПользователюНемодально(Рез.Сообщение); // вместо Предупреждение()
		// Сбрасываем ввод
		ТекСтрока = Элементы.ТЧСерийныеНомера.ТекущиеДанные;
		Если ТекСтрока <> Неопределено Тогда
			ТекСтрока.СерийныйНомер = ""; 
		КонецЕсли;
		СтандартнаяОбработка = Ложь;
		Возврат;
	КонецЕсли;

	ТекСтрока = Элементы.ТЧСерийныеНомера.ТекущиеДанные;
	Если ТекСтрока <> Неопределено Тогда
		ТекСтрока.СерийныйНомер = Рез.Raw14; // в ТЧ храним 14 цифр БЕЗ дефисов
	КонецЕсли;

	СтандартнаяОбработка = Ложь;
КонецПроцедуры

#КонецОбласти

