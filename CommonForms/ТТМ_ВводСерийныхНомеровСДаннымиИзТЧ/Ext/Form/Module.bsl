#Область ОбработчикиКомандФормы
&НаКлиенте

Процедура ЗаписатьНомера()
	
	
	Если ЕстьДублиСерийВТЧ(ТЧСерийныеНомера) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Найдены дубли серийных номеров в таблице. Запись отменена.";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	
	
	// 1) Снимем движения, что бы не дублировать записи
	ОтменитьПриходПоРегистраторуСервер(ДокОснование, Номенклатура);
	
	// 2) Сформируем "отвязанные" данные (ничего из формы напрямую не передаём)
	ТЗСерий = ТЧСерийныеНомера; 
	
	ЛДокОснование       = ДокОснование;
	ЛСклад              = Склад;
	ЛНоменклатура       = Номенклатура;
	ЛНазначение         = Назначение;
	
	ЛШильдЗаказан       = ?(ТипЗнч(ШильдЗаказан)=Тип("Булево"), ШильдЗаказан, Ложь);
	ЛПроизведено        = Ложь; 											//Неопределено;
	ЛДатаПроизводства   = Дата(1,1,1);										//Неопределено;
	ЛДокументРеализации = ПредопределенноеЗначение("Документ.РеализацияТоваровУслуг.ПустаяСсылка"); 
	ЛРеализовано        = Ложь;         									// на приходе Ложь
	
		
	
	
	// 3) Серверный вызов - только простые значения и наша ТЗ-копия
	ЗаписатьПриходИзФормыСервер(
	ЛДокОснование,
	ЛСклад,
	ЛНоменклатура,
	ЛНазначение,
	ЛШильдЗаказан,
	ЛПроизведено,
	ЛДатаПроизводства,
	ЛДокументРеализации,
	ЛРеализовано,
	ТЗСерий
	);
	
	Закрыть(Истина);
	Сообщить("Серийные номера успешно записаны");
	
	КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьМассово(Команда) ////// Процедура делает массовое заполнение серийниками по указанным ТМ - Дата и добавляет по +1 от начального порядкового номера

	// простые проверки
	Если ПустаяСтрока(КодТМ5) Тогда
		Сообщить("Укажите Код ТМ (5 цифр).");
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(ДатаКод5) Тогда
		Сообщить("Укажите Дата-код (5 цифр).");
		Возврат;
	КонецЕсли;
	Если НачальныйНомер = Неопределено Тогда
		Сообщить("Укажите начальный порядковый номер.");
		Возврат;
	КонецЕсли;

	// посчитаем отмеченные строки
	КолОтмеченных = 0;
	Для Каждого Стр Из ТЧСерийныеНомера Цикл
		Если Истина = Стр.Массово Тогда
			КолОтмеченных = КолОтмеченных + 1;
		КонецЕсли;
	КонецЦикла;

	Если КолОтмеченных = 0 Тогда
		Сообщить("Не отмечено ни одной строки для массового заполнения.");
		Возврат;
	КонецЕсли;

	// заполняем только отмеченные; при флаге - только пустые серийники
	ТекНомер = НачальныйНомер;
	Заполнено = 0;

	Для Каждого Стр Из ТЧСерийныеНомера Цикл
		Если Не Истина = Стр.Массово Тогда Продолжить; КонецЕсли;
		Если ЗначениеЗаполнено(ТолькоПустые) И ТолькоПустые И Не ПустаяСтрока(Стр.СерийныйНомер) Тогда Продолжить; КонецЕсли;

		Стр.СерийныйНомер = СформироватьRaw14(КодТМ5, ДатаКод5, ТекНомер); // 14 цифр без дефисов
		ТекНомер = ТекНомер + 1;
		Заполнено = Заполнено + 1;
	КонецЦикла;

	Попытка Элементы.ТЧСерийныеНомера.Обновить(); Исключение КонецПопытки;

	Последний = ТекНомер - 1;
	Сообщить("Заполнено строк: " + Заполнено + ". Диапазон: " + НачальныйНомер + "…" + Последний);
КонецПроцедуры

&НаКлиенте
Процедура СнятьВыделение(Команда)
	
	Если ТЧСерийныеНомера = Неопределено Тогда Возврат; КонецЕсли;

	Для Каждого Стр Из ТЧСерийныеНомера Цикл
		// снимаем флажок "Массово" у всех строк
		Стр.Массово = Ложь;
	КонецЦикла;

	Попытка Элементы.ТЧСерийныеНомера.Обновить(); Исключение КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьВсе(Команда)
	
	Если ТЧСерийныеНомера = Неопределено Тогда Возврат; КонецЕсли;

	Для Каждого Стр Из ТЧСерийныеНомера Цикл
		// проставляем флажок "Массово" всем строкам
		Стр.Массово = Истина;
	КонецЦикла;

	// обновим грид табличной части (если элемент присутствует)
	Попытка Элементы.ТЧСерийныеНомера.Обновить(); Исключение КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ДиалогСВопросом(Команда)
 
    Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопроса",
      ЭтотОбъект);	
 
    ПоказатьВопрос(Оповещение,
        "Вы уверены, что хотите записать указанные серии?",
        РежимДиалогаВопрос.ДаНет,
        0, // таймаут в секундах
        КодВозвратаДиалога.Нет, // (необ.) кнопка по умолчанию
        "Продолжить?" // (необ.) заголовок
    );    
 
КонецПроцедуры

#КонецОбласти

