&НаКлиенте
Процедура СообщитьПользователюНемодально(Текст)
	Сооб = Новый СообщениеПользователю;
	Сооб.Текст = Текст;
	Сооб.Сообщить();
КонецПроцедуры

 
&НаКлиенте
Процедура ПослеЗакрытияВопроса(Результат, Параметры) Экспорт
 
    Если Результат = КодВозвратаДиалога.Да Тогда
        ЗаписатьНомера();
	ИначеЕсли Результат = КодВозвратаДиалога.Нет Тогда
		Сообщить("Запись серийных номеров отменена пользователем");
    КонецЕсли;	
 
КонецПроцедуры


// ===== ХЕЛПЕРЫ: функции для обработки поступающих строк ===== //

&НаКлиентеНаСервереБезКонтекста 
Функция ЕстьДублиСерийВТЧ(ТЧ) Экспорт /////////////////////////////////////////// Ищет дубли в табличной части
	Если ТЧ = Неопределено Тогда Возврат Ложь; КонецЕсли;

	Видены = Новый Соответствие; // ключ = точное значение в колонке СерийныйНомер
	Для Каждого Стр Из ТЧ Цикл
		Значение = Стр.СерийныйНомер;
		Если ПустаяСтрока(Значение) Тогда Продолжить; КонецЕсли;

		// если ключ уже вставляли — Получить() вернёт не Неопределено
		Если Видены.Получить(Значение) <> Неопределено Тогда
			Возврат Истина; // дубль найден
		КонецЕсли;

		Видены.Вставить(Значение, Истина);
	КонецЦикла;

	Возврат Ложь;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПовторСимвола(Символ, Количество) Экспорт /////////////////////////////// Повторяет в строке указанный символ указанное количество раз, возвращает строку
	Если Количество <= 0 Тогда Возврат ""; КонецЕсли;
	Рез = "";
	Для Сч = 1 По Количество Цикл
		Рез = Рез + Символ;
	КонецЦикла;
	Возврат Рез;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ОставитьЦифры(Текст) Экспорт //////////////////////////////////////////// Убирает все "Левые" символы из серийного номера
	
	Если Текст = Неопределено Тогда Возврат ""; КонецЕсли;
	Рез = "";
	Для Сч = 1 По СтрДлина(Текст) Цикл
		Сим = Сред(Текст, Сч, 1);
		Если Сим >= "0" И Сим <= "9" Тогда Рез = Рез + Сим; КонецЕсли;
	КонецЦикла;
	Возврат Рез;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция НормализоватьВоВход14(СыройТекст) Экспорт /////////////////////////////// Контролирует длинну серийного номера, дополняет нулями, еслил длина меньше 14
	
	Лок = ОставитьЦифры(СыройТекст);
	Дл = СтрДлина(Лок);
	Если Дл < 12 Тогда
		Возврат Новый Структура("Успех,Сообщение", Ложь, "Серийный номер должен содержать минимум 12 цифр.");
	КонецЕсли;
	Если Дл > 14 Тогда
		Лок = Лев(Лок, 14);
		Дл = 14;
	КонецЕсли;
	Если Дл < 14 Тогда
		Лок = ПовторСимвола("0", 14 - Дл) + Лок; // дополняем слева
	КонецЕсли;
	Возврат Новый Структура("Успех,Raw14", Истина, Лок);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ФорматДляРН(Raw14) Экспорт ////////////////////////////////////////////// Собирает строку формата " ххххх-ххххх-хххх " и добавляет нули, если СН не 5-5-4
	Raw14 = ОставитьЦифры(Raw14);
	Если СтрДлина(Raw14) < 14 Тогда Raw14 = ПовторСимвола("0", 14 - СтрДлина(Raw14)) + Raw14; КонецЕсли;
	Если СтрДлина(Raw14) > 14 Тогда Raw14 = Лев(Raw14, 14); КонецЕсли;
	Возврат Сред(Raw14,1,5) + "-" + Сред(Raw14,6,5) + "-" + Сред(Raw14,11,4);
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СформироватьRaw14(КодТМ5, ДатаКод5, Порядковый) Экспорт ///////////////// Получает на вход 5-5-4 и собирает из этого СН формата " хххххххххххххх "
	Код  = ОставитьЦифры(КодТМ5);
	Дата = ОставитьЦифры(ДатаКод5);
	Если СтрДлина(Код)  > 5 Тогда Код  = Лев(Код,5);  КонецЕсли;
	Если СтрДлина(Дата) > 5 Тогда Дата = Лев(Дата,5); КонецЕсли;
	Если СтрДлина(Код)  < 5 Тогда Код  = ПовторСимвола("0", 5-СтрДлина(Код))  + Код;  КонецЕсли;
	Если СтрДлина(Дата) < 5 Тогда Дата = ПовторСимвола("0", 5-СтрДлина(Дата)) + Дата; КонецЕсли;

	Пор = ОставитьЦифры(Строка(Порядковый));
	Если СтрДлина(Пор) > 4 Тогда Пор = Прав(Пор,4); КонецЕсли;
	Если СтрДлина(Пор) < 4 Тогда Пор = ПовторСимвола("0", 4-СтрДлина(Пор)) + Пор; КонецЕсли;

	Возврат Код + Дата + Пор; // 14 цифр без дефисов
КонецФункции
#КонецОбласти

