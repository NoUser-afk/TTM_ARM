&НаСервере
Перем ПроверкаДоступна;

&НаСервере     
//Создание РЕквизитов Формы
//
Процедура АРМ1_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	//Создадим реквизиты формы для хранения данных о проверке спецификации 
	//ТТМ_Проверена    
	//Создаем Элементы для отображения данных о проверке спецификации
	//ТТМ_Проверена (Поле флажка)
	//ТТМ_Проверил (Поле надписи)
	//ТТМ_ДатаПроверки (Поле надписи)  
	ПроверкаДоступна = РольДоступна("ПолныеПрава") или РольДоступна("ТТМ_ПроверкаСпецификаций");
		
	//1. Добавим реквизитФормы
	ДобавляемыеРеквизиты = Новый Массив; 
	
	Если Не ТТМ_ОбщегоНазначения.ЕстьРеквизит("ТТМ_Проверена",ЭтотОбъект) Тогда
		ТипРеквизита = Новый ОписаниеТипов("Булево");//"Строка");
		РеквизитФормы = Новый РеквизитФормы(
			"ТТМ_Проверена",  //Имя реквизита формы
			ТипРеквизита,     //Тип
			"",               //Путь  (Пусто, "Объект", ИмяТЧ) // например "Объект.Товары"
			"Спецификация проверена");	  //Заголовок
		ДобавляемыеРеквизиты.Добавить(РеквизитФормы);		
		//Непосредственно создаем новые реквизиты формы
		ИзменитьРеквизиты(ДобавляемыеРеквизиты);
		
		Группа = Элементы.Найти("ГруппаДополнительноЛево");
		ПолеПроверена = Элементы.Добавить("ТТМ_Проверена", Тип("ПолеФормы"),Группа);
		ПолеПроверена.Вид = ВидПоляФормы.ПолеФлажка;
		ПолеПроверена.ПутьКДанным = "ТТМ_Проверена";  
		ПолеПроверена.УстановитьДействие("ПриИзменении","ТТМ_ПолеПроверенаПриИзменении");
		
		ПолеПроверил = ЭтаФорма.Элементы.Добавить("ТТМ_Проверил", Тип("ДекорацияФормы"),Группа);    
		ПолеПроверил.ЦветТекста = ЦветаСтиля.ЦветРамкиКнопки;
		
		ПолеДатаПроверки = Элементы.Добавить("ТТМ_ДатаПроверки", Тип("ДекорацияФормы"), Группа); 
		ПолеДатаПроверки.ЦветТекста = ЦветаСтиля.ЦветРамкиКнопки;   
		ПолеПроверил.Доступность = Ложь;
		ПолеДатаПроверки.Доступность = Ложь;
	КонецЕсли;
	
	Если не ПроверкаДоступна Тогда 
		ПолеПроверена.Доступность = Ложь;
	КонецЕсли;
	
	ТаблицаМатериалов = Элементы.Найти("МатериалыИУслуги");
	Если Не ТаблицаМатериалов = Неопределено Тогда
		КоманднаяПанельМатериалов = ТаблицаМатериалов.КоманднаяПанель;
		
		КомандаЗагрузки = Команды.Найти("ТТМ_ЗагрузитьМатериалыПоДаннымТаблицы");
		Если КомандаЗагрузки = Неопределено Тогда
			КомандаЗагрузки = Команды.Добавить("ТТМ_ЗагрузитьМатериалыПоДаннымТаблицы");
			КомандаЗагрузки.Заголовок = "Загрузить по данным таблицы";
			КомандаЗагрузки.Действие = "ТТМ_ЗагрузитьМатериалыПоДаннымТаблицы";
			КомандаЗагрузки.Подсказка = "Заполнить материалы спецификации по колонкам Код номенклатуры и Количество";
			КомандаЗагрузки.Отображение = ОтображениеКнопки.Текст;
		КонецЕсли;
		
		Если Элементы.Найти("ТТМ_ЗагрузитьМатериалыПоДаннымТаблицы") = Неопределено Тогда
			КнопкаЗагрузки = Элементы.Добавить("ТТМ_ЗагрузитьМатериалыПоДаннымТаблицы", Тип("КнопкаФормы"), КоманднаяПанельМатериалов);
			КнопкаЗагрузки.ИмяКоманды = "ТТМ_ЗагрузитьМатериалыПоДаннымТаблицы";
		КонецЕсли;
		
		Если Элементы.Найти("ТТМ_ОткрытьНоменклатуру") = Неопределено Тогда
			КомандаОткрытьНоменклатуру = Команды.Добавить("ТТМ_ОткрытьНоменклатуру");
			КомандаОткрытьНоменклатуру.Заголовок = "Материал";
			КомандаОткрытьНоменклатуру.Действие = "ТТМ_ОткрытьНоменклатуру";
			КомандаОткрытьНоменклатуру.Подсказка = "Открыть материал";
			КомандаОткрытьНоменклатуру.Отображение = ОтображениеКнопки.Текст;

			КнопкаОткрытьНоменклатуру= Элементы.Добавить("ТТМ_ОткрытьНоменклатуру", Тип("КнопкаФормы"), КоманднаяПанельМатериалов);
			КнопкаОткрытьНоменклатуру.ИмяКоманды = "ТТМ_ОткрытьНоменклатуру";
		КонецЕсли;

	КонецЕсли;
	
	//2. Заполним сведения о проверке    
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ТТМ_ПроверенныеСпецификацииСрезПоследних.Период КАК ДатаПроверки,
	               |	ТТМ_ПроверенныеСпецификацииСрезПоследних.Спецификация КАК Спецификация,
	               |	ТТМ_ПроверенныеСпецификацииСрезПоследних.СпецификацияПроверена КАК СпецификацияПроверена,
	               |	ТТМ_ПроверенныеСпецификацииСрезПоследних.Проверил КАК Проверил
	               |ИЗ
	               |	РегистрСведений.ТТМ_ПроверенныеСпецификации.СрезПоследних(&МоментВремени, Спецификация = &Спецификация) КАК ТТМ_ПроверенныеСпецификацииСрезПоследних";
	Запрос.УстановитьПараметр("МоментВремени", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("Спецификация", Этаформа.Объект.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать(); 
	Выборка.Следующий();    
	Если не ПроверкаДоступна Тогда      
		УстановитьЗначенияДанныхПроверки(Выборка.СпецификацияПроверена, Выборка.Проверил, Выборка.ДатаПроверки);
	Иначе
		Если Выборка.Количество() = 0 Тогда 
			УстановитьЗначенияДанныхПроверки(Ложь,Пользователи.АвторизованныйПользователь(),Формат(ТекущаяДатаСеанса(),"ДФ=dd.MM.yyyy"));
		Иначе 
			Если не Выборка.СпецификацияПроверена Тогда
				УстановитьЗначенияДанныхПроверки(Ложь,Пользователи.АвторизованныйПользователь(),Формат(ТекущаяДатаСеанса(),"ДФ=dd.MM.yyyy"));
			Иначе        
				УстановитьЗначенияДанныхПроверки(Выборка.СпецификацияПроверена, Выборка.Проверил, Выборка.ДатаПроверки);
			КонецЕсли;  
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры    

 &НаСервере
 Процедура УстановитьЗначенияДанныхПроверки(Проверена, Проверил, Датапроверки)
	ЭтаФорма.ТТМ_Проверена = Проверена;
	Элементы.ТТМ_Проверил.Заголовок = Проверил;
	Элементы.ТТМ_ДатаПроверки.Заголовок = ДатаПроверки;
 КонецПроцедуры
	 
&НаКлиенте
Процедура ТТМ_ПолеПроверенаПриИзменении() 
	
	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере                   
//Расширение данной процедуры решает 2 задачи:
//1. Запись данных о проверке спецификации
//2. Прописать Спецификацию в Заказах на производство, где она отсутствует
//
Процедура АРМ1_ПослеЗаписиНаСервереПосле(ТекущийОбъект, ПараметрыЗаписи)
	
	//1. Записать данные о ПРОВЕРКЕ СПЕЦИФИКАЦИИ в регистр, если необходимо 
	ПроверкаДоступна = РольДоступна("ПолныеПрава") или РольДоступна("ТТМ_ПроверкаСпецификаций");
	Если ПроверкаДоступна Тогда 
		ЗаписатьДанныеПроверкиВРегистр(ЭтаФорма.ТТМ_Проверена);
	КонецЕсли;
	
	//2. пропишем спецификацию в Заказак на производство, где Спецификация не указана  
	Если не ТекущийОбъект.Статус = Перечисления.СтатусыСпецификаций.Действует Тогда 
		Возврат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	РесурсныеСпецификацииВыходныеИзделия.Номенклатура КАК Номенклатура,
	               |	РесурсныеСпецификацииВыходныеИзделия.Ссылка КАК Спецификация,
	               |	РесурсныеСпецификацииВыходныеИзделия.Ссылка.ОсновноеИзделиеВидНоменклатуры КАК ОсновноеИзделиеВидНоменклатуры,
	               |	РесурсныеСпецификацииВыходныеИзделия.Ссылка.ОсновноеИзделиеНоменклатура КАК ОсновноеИзделиеНоменклатура,
	               |	ЗаказНаПроизводство2_2Продукция.Номенклатура КАК ЗаказНаПроизводствоНоменклатура,
	               |	ЗаказНаПроизводство2_2Продукция.Спецификация КАК ЗаказНаПроизводствоСпецификация,
	               |	ЗаказНаПроизводство2_2Продукция.Ссылка КАК ЗаказНаПроизводство
	               |ИЗ
	               |	Документ.ЗаказНаПроизводство2_2.Продукция КАК ЗаказНаПроизводство2_2Продукция
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.РесурсныеСпецификации.ВыходныеИзделия КАК РесурсныеСпецификацииВыходныеИзделия
	               |		ПО (ВЫБОР
	               |				КОГДА ЕСТЬNULL(РесурсныеСпецификацииВыходныеИзделия.Ссылка.ОсновноеИзделиеНоменклатура, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	               |						И ЕСТЬNULL(ЗаказНаПроизводство2_2Продукция.Спецификация, ЗНАЧЕНИЕ(Справочник.РесурсныеСпецификации.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.РесурсныеСпецификации.ПустаяСсылка)
	               |					ТОГДА ЗаказНаПроизводство2_2Продукция.Номенклатура = РесурсныеСпецификацииВыходныеИзделия.Ссылка.ОсновноеИзделиеНоменклатура
	               |				КОГДА ЕСТЬNULL(РесурсныеСпецификацииВыходныеИзделия.Ссылка.ОсновноеИзделиеВидНоменклатуры, ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.ПустаяСсылка)
	               |						И ЕСТЬNULL(ЗаказНаПроизводство2_2Продукция.Спецификация, ЗНАЧЕНИЕ(Справочник.РесурсныеСпецификации.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.РесурсныеСпецификации.ПустаяСсылка)
	               |					ТОГДА ЗаказНаПроизводство2_2Продукция.Номенклатура.ВидНоменклатуры = РесурсныеСпецификацииВыходныеИзделия.Ссылка.ОсновноеИзделиеВидНоменклатуры
	               |			КОНЕЦ)
	               |ГДЕ
	               |	РесурсныеСпецификацииВыходныеИзделия.Ссылка = &Ссылка
	               |	И ЗаказНаПроизводство2_2Продукция.Ссылка.Проведен
	               |ИТОГИ ПО
	               |	ЗаказНаПроизводство";  
	Запрос.УстановитьПараметр("Ссылка",ТекущийОбъект.Ссылка);
	ВыборкаЗаказыНаПроизводство = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); //Выгрузить();
	
	Пока ВыборкаЗаказыНаПроизводство.Следующий() Цикл  
		ОбъектЗаказ = ВыборкаЗаказыНаПроизводство.ЗаказНаПроизводство.ПолучитьОбъект();   
		СтрИзделие = ВыборкаЗаказыНаПроизводство.Выбрать(); 
		Пока СтрИзделие.Следующий() Цикл 
			Если ЗначениеЗаполнено(СтрИзделие.Номенклатура) или ЗначениеЗаполнено(СтрИзделие.ОсновноеИзделиеНоменклатура) Тогда 
				КолонкаНоменклатура = "Номенклатура";   
				КолонкаВидНоменклатуры = "";   
				ОбъектПоиска = СтрИзделие.Номенклатура;
			ИначеЕсли ЗначениеЗаполнено(СтрИзделие.ОсновноеИзделиеВидНоменклатуры) Тогда 
				КолонкаНоменклатура = "Номенклатура";   
				КолонкаВидНоменклатуры = "ВидНоменклатуры";   
				ОбъектПоиска = СтрИзделие.ОсновноеИзделиеВидНоменклатуры;
			Иначе 
				Сообщить("В спеццификации не заполнено ни Основное изделиеНоменклатура, ни ОсновноеИзделиеВидНоменклатуры");
			КонецЕсли;                                                 
			Для Каждого СтрПродукция из ОбъектЗаказ.Продукция Цикл  //МассивСтрокПродукции Цикл                      
				ИскомоеЗначение = ?(ЗначениеЗаполнено(КолонкаВидНоменклатуры),СтрПродукция[КолонкаНоменклатура][КолонкаВидНоменклатуры],СтрПродукция[КолонкаНоменклатура]);
				Если ИскомоеЗначение = ОбъектПоиска Тогда
					Если не ЗначениеЗаполнено(СтрПродукция.Спецификация) Тогда 
						СтрПродукция.Спецификация = ТекущийОбъект.Ссылка;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;            
		КонецЦикла;
		
		Попытка
			ОбъектЗаказ.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
		Исключение
			Сообщить("Ошибка при записи Заказа на производство " + СтрИзделие.ЗаказНаПроизводство);
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьДанныеПроверкиВРегистр(СпецификацияПроверена)
	
	СсылкаНаСпецификацию = ЭтаФорма.Объект.Ссылка;
	НЗ = РегистрыСведений.ТТМ_ПроверенныеСпецификации.СоздатьНаборЗаписей();
	НЗ.Отбор.Спецификация.Установить(ЭтаФорма.Объект.Ссылка); 
	НЗ.Отбор.Период.Установить(НачалоДня(ТекущаяДатаСеанса()));
	НЗ.Прочитать();
	
	Если НЗ.Количество() > 0 Тогда 
		НЗ.Очистить();
	КонецЕсли;
	
	НоваяСтрока = НЗ.Добавить();
	НоваяСтрока.Спецификация = СсылкаНаСпецификацию;
	НоваяСтрока.Период = НачалоДня(ТекущаяДатаСеанса());
	НоваяСтрока.Проверил = Пользователи.АвторизованныйПользователь();
	НоваяСтрока.СпецификацияПроверена = СпецификацияПроверена;
	
	Попытка
		НЗ.Записать();
	Исключение
		Сообщить("Ошибка записи данных о проверке в регистр сведений " + ОписаниеОшибки());
	КонецПопытки; 
	
	//Запишем данные о проверке в дополнительное сведение
	
	ДопСвойство = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("Имя","СпецификацияПроверена_2bcff13b79a24cb18fbf92882ce31c4b");
	//СпецификацияПроверена_94e87fffe3214c02839da712f364a57a");
	МЗ = РегистрыСведений.ДополнительныеСведения.СоздатьМенеджерЗаписи();
	МЗ.Объект = СсылкаНаСпецификацию;
	МЗ.Свойство = ДопСвойство;
	МЗ.Прочитать();
	
	Если не МЗ.Выбран() Тогда 
		МЗ.Объект = СсылкаНаСпецификацию;
		МЗ.Свойство = ДопСвойство;
		МЗ.Значение = СпецификацияПроверена;
		МЗ.Записать();
	Иначе 
		МЗ.Значение = СпецификацияПроверена;
		МЗ.Записать();
	КонецЕсли;
			
КонецПроцедуры


&НаКлиенте
Процедура ТТМ_ОткрытьНоменклатуру(Команда)
	
	ТекДанные = Элементы.МатериалыИУслуги.ТекущиеДанные;
	Если ТекДанные<>Неопределено Тогда
		ОткрытьФорму("Справочник.Номенклатура.Форма.ФормаЭлемента",Новый Структура("Ключ",ТекДанные.Номенклатура));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТТМ_ЗагрузитьМатериалыПоДаннымТаблицы(Команда)
	
	Если Объект.МатериалыИУслуги.Количество() <> 0 Тогда
		ТекстВопроса = "Таблица материалов и работ будет перезаполнена. Продолжить?";
		Оповещение = Новый ОписаниеОповещения("ТТМ_ЗагрузитьМатериалыПоДаннымТаблицыЗавершение", ЭтаФорма);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ТТМ_ПоказатьФормуЗагрузкиМатериаловПоДаннымТаблицы();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТТМ_ЗагрузитьМатериалыПоДаннымТаблицыЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Не Результат = КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ТТМ_ПоказатьФормуЗагрузкиМатериаловПоДаннымТаблицы();
	
КонецПроцедуры

&НаКлиенте
Процедура ТТМ_ПоказатьФормуЗагрузкиМатериаловПоДаннымТаблицы()

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("РесурснаяСпецификация", Объект.Ссылка);

	Оповещение = Новый ОписаниеОповещения("ТТМ_ПоказатьФормуЗагрузкиМатериаловПоДаннымТаблицыЗавершение", ЭтаФорма);
	ФормаЗагрузки = ПолучитьФорму("ОбщаяФорма.ТТМ_ЗагрузкаМатериаловСпецификацииИзТаблицы", ПараметрыФормы, ЭтаФорма);
	ФормаЗагрузки.ОписаниеОповещенияОЗакрытии = Оповещение;
	ФормаЗагрузки.Открыть();

КонецПроцедуры

&НаКлиенте
Процедура ТТМ_ПоказатьФормуЗагрузкиМатериаловПоДаннымТаблицыЗавершение(АдресЗагруженныхДанных, ДополнительныеПараметры) Экспорт
	
	Если АдресЗагруженныхДанных = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТТМ_ЗагрузитьМатериалыПоДаннымТаблицыНаСервере(АдресЗагруженныхДанных);
	
