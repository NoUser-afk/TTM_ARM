&НаСервере
Процедура ТТМ_ЗагрузитьМатериалыПоДаннымТаблицыНаСервере(АдресЗагруженныхДанных)
	
	ЗагруженныеДанные = ПолучитьИзВременногоХранилища(АдресЗагруженныхДанных);
	Если ЗагруженныеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаМатериалов = Новый ТаблицаЗначений;
	ТаблицаМатериалов.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаМатериалов.Колонки.Добавить("КоличествоУпаковок", Новый ОписаниеТипов("Число"));
	
	НеНайденныеКоды = Новый Массив;
	
	Для Каждого СтрокаДанных Из ЗагруженныеДанные Цикл
		
		КодНоменклатуры = "";
		Попытка
			КодНоменклатуры = СокрЛП(СтрокаДанных.КодНоменклатуры);
		Исключение
			КодНоменклатуры = "";
		КонецПопытки;
		Количество = ?(ЗначениеЗаполнено(СтрокаДанных.КоличествоУпаковок), СтрокаДанных.КоличествоУпаковок, 0);
		
		Номенклатура = Справочники.Номенклатура.ПустаяСсылка();
		Попытка
			Если ЗначениеЗаполнено(СтрокаДанных.Номенклатура) Тогда
				Номенклатура = СтрокаДанных.Номенклатура;
			КонецЕсли;
		Исключение
			Номенклатура = Справочники.Номенклатура.ПустаяСсылка();
		КонецПопытки;
		
		Если Не ЗначениеЗаполнено(Номенклатура) И ПустаяСтрока(КодНоменклатуры) Тогда
			Продолжить;
		КонецЕсли;
		
		Если Количество = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Номенклатура) Тогда
			Номенклатура = ТТМ_НайтиНоменклатуруПоКодуДляЗагрузкиВСпецификацию(КодНоменклатуры);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Номенклатура) Тогда
			НоменклатураТекст = "";
			Попытка
				Если ЗначениеЗаполнено(СтрокаДанных.НоменклатураТекст) Тогда
					НоменклатураТекст = СокрЛП(Строка(СтрокаДанных.НоменклатураТекст));
				Иначе
					НоменклатураТекст = СокрЛП(Строка(СтрокаДанных.Номенклатура));
				КонецЕсли;
			Исключение
				НоменклатураТекст = "";
			КонецПопытки;
			
			Если Не ПустаяСтрока(НоменклатураТекст) Тогда
				Номенклатура = ТТМ_НайтиНоменклатуруПоТекстуДляЗагрузкиВСпецификацию(НоменклатураТекст);
			КонецЕсли;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Номенклатура) Тогда
			Если НеНайденныеКоды.Найти(КодНоменклатуры) = Неопределено Тогда
				НеНайденныеКоды.Добавить(?(ПустаяСтрока(КодНоменклатуры), "<пустой код>", КодНоменклатуры));
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		
		НайденныеСтроки = ТаблицаМатериалов.НайтиСтроки(Новый Структура("Номенклатура", Номенклатура));
		Если НайденныеСтроки.Количество() = 0 Тогда
			НоваяСтрока = ТаблицаМатериалов.Добавить();
			НоваяСтрока.Номенклатура = Номенклатура;
			НоваяСтрока.КоличествоУпаковок = Количество;
		Иначе
			НайденныеСтроки[0].КоличествоУпаковок = НайденныеСтроки[0].КоличествоУпаковок + Количество;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ТаблицаМатериалов.Количество() = 0 Тогда
		Если НеНайденныеКоды.Количество() > 0 Тогда
			Сообщить("Не найдена номенклатура по кодам: " + СтрСоединить(НеНайденныеКоды, ", "));
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Объект.МатериалыИУслуги.Очистить();
	
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ЗаполнитьПризнакАртикул", Новый Структура("Номенклатура", "Артикул"));
	СтруктураДействий.Вставить("ЗаполнитьПризнакСерииИспользуются", Новый Структура("Номенклатура", "СерииИспользуются"));
	СтруктураДействий.Вставить("ЗаполнитьПризнакТипНоменклатуры", Новый Структура("Номенклатура", "ТипНоменклатуры"));
	СтруктураДействий.Вставить("ПроверитьХарактеристикуПоВладельцу");
	СтруктураДействий.Вставить("ПроверитьЗаполнитьУпаковкуПоВладельцу");
	
	ОбрабатываемыеСтроки = Новый Массив;
	Для Каждого СтрокаМатериала Из ТаблицаМатериалов Цикл
		ТекущаяСтрока = Объект.МатериалыИУслуги.Добавить();
		ТекущаяСтрока.Номенклатура = СтрокаМатериала.Номенклатура;
		ТекущаяСтрока.КоличествоУпаковок = СтрокаМатериала.КоличествоУпаковок;
		ПриВводеНовойСтрокиСпецификации(ЭтаФорма, "МатериалыИУслуги", ТекущаяСтрока);
		ОбрабатываемыеСтроки.Добавить(ТекущаяСтрока);
	КонецЦикла;
	
	ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьСтрокиТЧ(ОбрабатываемыеСтроки, СтруктураДействий, Объект.МатериалыИУслуги);
	ЗаполнитьСлужебныеРеквизитыМатериалыИУслуги();
	
	Если НеНайденныеКоды.Количество() > 0 Тогда
		Сообщить("Не найдена номенклатура по кодам: " + СтрСоединить(НеНайденныеКоды, ", "));
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ТТМ_НайтиНоменклатуруПоКодуДляЗагрузкиВСпецификацию(КодНоменклатуры)
	
	Если ПустаяСтрока(СокрЛП(КодНоменклатуры)) Тогда
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	Номенклатура.Ссылка КАК Номенклатура
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	НЕ Номенклатура.ПометкаУдаления
	|	И (Номенклатура.КодДляПоиска = &КодНоменклатуры
	|		ИЛИ Номенклатура.Код = &КодНоменклатуры)";
	Запрос.УстановитьПараметр("КодНоменклатуры", СокрЛП(КодНоменклатуры));
	
	Результат = Запрос.Выполнить().Выгрузить();
	Если Результат.Количество() = 0 Тогда
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;
	
	Возврат Результат[0].Номенклатура;
	
КонецФункции

&НаСервереБезКонтекста
Функция ТТМ_НайтиНоменклатуруПоТекстуДляЗагрузкиВСпецификацию(ТекстПоиска)

	ТекстПоиска = СокрЛП(ТекстПоиска);
	Если ПустаяСтрока(ТекстПоиска) Тогда
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	Номенклатура.Ссылка КАК Номенклатура
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	НЕ Номенклатура.ПометкаУдаления
	|	И (Номенклатура.Код = &ТекстПоиска
	|		ИЛИ Номенклатура.Наименование = &ТекстПоиска
	|		ИЛИ Номенклатура.КодДляПоиска = &ТекстПоиска)";
	Запрос.УстановитьПараметр("ТекстПоиска", ТекстПоиска);

	Результат = Запрос.Выполнить().Выгрузить();
	Если Результат.Количество() = 0 Тогда
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;

	Возврат Результат[0].Номенклатура;

КонецФункции
