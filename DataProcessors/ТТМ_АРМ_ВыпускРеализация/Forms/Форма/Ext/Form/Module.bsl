&НаКлиенте
Процедура ВопросПользователюПередВыполнениемОперации(Команда)
	
	Если Команда.Действие = "Выпуск" Тогда
		ТекстВопроса = НСтр("ru = 'Сформировать выпуск для выбранных изделий?'");
		ЗаголовокВопроса = НСтр("ru = 'Формирование выпуска'");
	КонецЕсли;
	
	Если Команда.Действие = "Реализация" Тогда
		ТекстВопроса = НСтр("ru = 'Сформировать реализацию по заказу: '") + Объект.ЗаказКлиента;
		ЗаголовокВопроса = НСтр("ru = 'Формирование реализации'");
	КонецЕсли;
	
	Если Команда.Действие = "РеализацияВсехЗаказов" Тогда
		ТекстВопроса = НСтр("ru = 'Сформировать реализацию по всем заказам?'");
		ЗаголовокВопроса = НСтр("ru = 'Формирование реализации'");
	КонецЕсли;
	
	Если Команда.Действие = "ЗаполнитьДокументОтгрузка" Тогда
		ТекстВопроса = НСтр("ru = 'Сформировать документ для ТСД?'");
		ЗаголовокВопроса = НСтр("ru = 'Документ отгрузки товаров'");
	КонецЕсли;
	
	Если Команда.Действие = "СохранитьТекущиеНастройки" Тогда
		ТекстВопроса = НСтр("ru = 'Сохранить текущие настройки?'");
		ЗаголовокВопроса = НСтр("ru = 'Настройка отбора и проверки цен'");
	КонецЕсли;
	
	Если Команда.Действие = "ВосстановитьНастройки" Тогда
		ТекстВопроса = НСтр("ru = 'Восстановить сохраненные настройки?'");
		ЗаголовокВопроса = НСтр("ru = 'Настройка отбора и проверки цен'");
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопроса", ЭтотОбъект, Команда);     
    ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 0,, ЗаголовокВопроса);
	
КонецПроцедуры

&НаКлиенте 
Процедура ПослеЗакрытияВопроса(ОтветПользователя, ДополнительныеПараметры) Экспорт
	Если ОтветПользователя = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	ТекущееДействиеКоманды = ДополнительныеПараметры.Действие;
	РезультатВыполнения = Ложь;
	
	///////////////////////////////////////////////////////////////////////////////////////
	Если ТекущееДействиеКоманды = "Выпуск" Тогда
		ВыпускСформирован = ОформитьВыпускНаСервере();
		
		Если ВыпускСформирован Тогда
			ОповеститьПользователя(ТекущееДействиеКоманды);
		КонецЕсли;
	КонецЕсли;
	
	Если ТекущееДействиеКоманды = "Реализация" Тогда
		
		Попытка
			СформироватьРеализациюПоЗаказу(Объект.ЗаказКлиента);
			РезультатВыполнения = Истина;
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("'Ошибка при формировании реализации: '") + ОписаниеОшибки());
		КонецПопытки;
			
		Если РезультатВыполнения Тогда
			Если ПечатьУПД Тогда		
				НапечататьУПД();		
			КонецЕсли;
	
			ОповеститьПользователя(ТекущееДействиеКоманды);
		КонецЕсли;		
		
		//НачатьПроверкуЦенВРеализации();    - Временно отключено, по требованию менеджера
	КонецЕсли;
	
	///////////////////////////////////////////////////////////////////////////////////////
	Если ТекущееДействиеКоманды = "РеализацияВсехЗаказов" Тогда 
		
		
		ПроверкаВыполнена = ПроверкаЗаполненияКлючевыхПолей(ДополнительныеПараметры);  
		
		//*****
		СозданиеРеализацияПродолжение(ОтветПользователя,ДополнительныеПараметры);
		
		//*****
		
		//МассивЗаказов = ПолучитьМассивЗаказов();
		//
		//Если МассивЗаказов.Количество() = 0 Тогда
		//	ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Нет заказов с выпуском'"));
		//	Возврат;
		//КонецЕсли;
		//
		//Для Каждого Заказ Из МассивЗаказов Цикл	
		//	
		//	Попытка
		//		СформироватьРеализациюПоЗаказу(Заказ.ЗаказКлиента);
		//		
		//		Если ПроверкаВыполнена Тогда
		//			НапечататьУПД();
		//		КонецЕсли;
		//	
		//		РезультатВыполнения = Истина;
		//	Исключение
		//		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("'Ошибка при формировании реализации: '") + ОписаниеОшибки());
		//	КонецПопытки;
		//	
		//КонецЦикла;
		
		//НачатьПроверкуЦенВРеализации();    - Временно отключено, по требованию менеджера
	КонецЕсли;
	
	
	///////////////////////////////////////////////////////////////////////////////////////
	Если ТекущееДействиеКоманды = "ЗаполнитьДокументОтгрузка" Тогда
		Попытка
			СформироватьДокументТекущаяОтгрузка();
			РезультатВыполнения = Истина;
		Исключение
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("'Ошибка при заполнении документа отгрузки товаров: '") + ОписаниеОшибки());
		КонецПопытки;	
	КонецЕсли;
	
	///////////////////////////////////////////////////////////////////////////////////////
	Если ТекущееДействиеКоманды = "СохранитьТекущиеНастройки" Тогда
		Попытка
			СохранитьНастройки();
			РезультатВыполнения = Истина;
		Исключение
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("'Ошибка при попытке сохранения настроек: '") + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
	
	///////////////////////////////////////////////////////////////////////////////////////
	Если ТекущееДействиеКоманды = "ВосстановитьНастройки" Тогда
		Попытка
			ПолучитьНастройкиИзХранилища();
			РезультатВыполнения = Истина;
		Исключение
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("'Ошибка при попытке выгрузки настроек: '") + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
	
	Если РезультатВыполнения Тогда
		ОповеститьПользователя(ТекущееДействиеКоманды);
	КонецЕсли;	
КонецПроцедуры

