Процедура ТЧТоварыРеализацииПриАктивизацииСтроки(Элемент)
	
	Если Элементы.ТЧТоварыРеализации.ОтборСтрок.Свойство("Реализация") Тогда
		Реализация = Элементы.ТЧТоварыРеализации.ОтборСтрок.Реализация;
		Номенклатура = ?(Элемент.ТекущиеДанные <> Неопределено,Элемент.ТекущиеДанные.Номенклатура,ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка"));
		СтруктураОтбораСН = Новый Структура();
		Если ЗначениеЗаполнено(Реализация) Тогда 
			СтруктураОтбораСН.Вставить("Реализация", Реализация);
		КонецЕсли;
		Если ЗначениеЗаполнено(Номенклатура) Тогда 
			СтруктураОтбораСН.Вставить("Номенклатура",Номенклатура);
		КонецЕсли;
		СтруктураОтбора = Новый ФиксированнаяСтруктура(СтруктураОтбораСН);
		Элементы.ТЧТоварыРеализацииССН.ОтборСтрок = СтруктураОтбора;
