    Диалог.Период 						= Новый СтандартныйПериод(Объект.НачалоПериода, Объект.ОкончаниеПериода);        
    ОписаниеОповещенияОЗакрытииФормы 	= Новый ОписаниеОповещения("ПослеВыбораПериода", ЭтотОбъект);
	
	Диалог.Показать(ОписаниеОповещенияОЗакрытииФормы);  
	
	
	
