			Стр.Отметка = Ложь;
		КонецЦикла;
	КонецПопытки;

	Попытка
		Эл = ЭтаФорма.ЭлементыФормы.Найти("ТЧОстаткиСерий");
		Если Эл <> Неопределено Тогда Эл.Обновить(); КонецЕсли;
	Исключение
		ОписаниеОшибкиСнятияВыделения = ОписаниеОшибки();
	КонецПопытки;

КонецПроцедуры


&НаКлиенте
ПРоцедура ОбновитьОстаткиТоварыНаХранении(Команда) ///////////////////////////////// Обновление таблицы по кнопочке
	ОбновитьОстаткиСерий();
КонецПроцедуры


&НаСервереБезКонтекста
Функция ПолучитьУпаковкуНоменклатуры(Ном) ////////////////////////////////// Получение "ШТ" 
	Если Ном = Неопределено Тогда Возврат Неопределено; КонецЕсли;

	// ERP может хранить упаковку по-разному - пробуем несколько вариантов
	// приоритет: упаковка (каталог УпаковкиЕдиницыИзмерения), базовая единица, единица хранения
	Попытка
		Если ЗначениеЗаполнено(Ном.ЕдиницаИзмерения) Тогда
			Возврат Ном.ЕдиницаИзмерения; // подойдет, если в ТЧ стоит реквизит Упаковка
		КонецЕсли;
	Исключение
		ОписаниеОшибкиУпаковкиНоменклатуры = ОписаниеОшибки();
	КонецПопытки;

	Возврат Неопределено;
КонецФункции

&НаСервереБезКонтекста
Функция КлючСтрокиХранения(ДокументПоступления, Номенклатура, Характеристика, Назначение)
	Возврат Строка(ДокументПоступления) + "|" + Строка(Номенклатура) + "|" + Строка(Характеристика) + "|" + Строка(Назначение);
КонецФункции

&НаСервереБезКонтекста
Функция КлючСтрокиХраненияБезРазрезов(ДокументПоступления, Номенклатура)
	Возврат Строка(ДокументПоступления) + "|" + Строка(Номенклатура);
КонецФункции


&НаСервереБезКонтекста
Процедура ЗаписатьРасходСерийВРегистр(ДокСсылка, ДокОбъект, Строки) //////// Запись расхода в регистр "ТТМ_УчетСерийныхНомеровПродукции"

	// 0) удалим предыдущие движения этого регистратора (повторное проведение и т.п.)
	НЗ = РегистрыНакопления.ТТМ_УчетСерийныхНомеровПродукции.СоздатьНаборЗаписей();
	НЗ.Отбор.Регистратор.Установить(ДокСсылка);
	НЗ.Прочитать(); НЗ.Очистить(); НЗ.Записать(Истина);

	// 1) подготовим ТЗ под загрузку
	// 1) подготовим ТЗ под загрузку
	ТЗ = Новый ТаблицаЗначений;
	
	Колонки = Новый Массив;
	Колонки.Добавить("Склад");
	Колонки.Добавить("Номенклатура");
	Колонки.Добавить("Назначение");
	Колонки.Добавить("СерийныйНомер");
	Колонки.Добавить("ШильдЗаказан");
	Колонки.Добавить("Произведено");
	Колонки.Добавить("ДатаПроизводства");
	Колонки.Добавить("ДокументРеализации");
	Колонки.Добавить("Реализовано");
	Колонки.Добавить("Количество");
	
	Для Каждого ИмяКолонки Из Колонки Цикл
		ТЗ.Колонки.Добавить(ИмяКолонки);
	КонецЦикла;

	СкладОтгр = Неопределено;
	СкладОтгр = ДокОбъект.Склад;

	Для Каждого Э Из Строки Цикл
		Новая = ТЗ.Добавить();
		Новая.Склад              = СкладОтгр;
		Новая.Номенклатура       = Э.Номенклатура;
		Новая.Назначение         = Справочники.Назначения.ПустаяСсылка(); // если не ведете назначение
		Новая.СерийныйНомер      = Э.СерийныйНомер; // уже в «реестровом» формате с дефисами
		Новая.ШильдЗаказан       = Ложь;
		Новая.Произведено        = Ложь;
		Новая.ДатаПроизводства   = Неопределено;
		Новая.ДокументРеализации = Документы.РеализацияТоваровУслуг.ПустаяСсылка();
		Новая.Реализовано        = Ложь;
		Новая.Количество         = 1; // один серийный экземпляр
	КонецЦикла;

	// 2) набор записей РН
	Набор = РегистрыНакопления.ТТМ_УчетСерийныхНомеровПродукции.СоздатьНаборЗаписей();
	Набор.Отбор.Регистратор.Значение = ДокСсылка;
	Набор.Загрузить(ТЗ);

	Для Каждого Зап Из Набор Цикл
		Зап.Период       = ТекущаяДатаСеанса();
		Зап.ВидДвижения  = ВидДвиженияНакопления.Расход;
		Зап.Регистратор  = ДокСсылка;
	КонецЦикла;

	Набор.Записать(Истина);

КонецПроцедуры


&НаСервереБезКонтекста
Функция СоздатьИПровестиОтгрузкуСХраненияСервер(ВыбранныеМС) /////////////// Создание непроведенного "ОтгрузкаТоваровСХранения"
	
	Созданные = Новый Массив;
	Если ВыбранныеМС = Неопределено Или ВыбранныеМС.Количество() = 0 Тогда
		Возврат Созданные;
	КонецЕсли;

	ГруппыДокументов = Новый Соответствие;
	Для Каждого Э Из ВыбранныеМС Цикл
		ДокументПриемкиСтроки = Э.ДокументРегистратор;

		Если Не ЗначениеЗаполнено(ДокументПриемкиСтроки) Тогда
			ВызватьИсключение "Не удалось определить документ приемки по отмеченной строке.";
		КонецЕсли;

		СтрокиДокумента = ГруппыДокументов.Получить(ДокументПриемкиСтроки);
		Если СтрокиДокумента = Неопределено Тогда
			СтрокиДокумента = Новый Массив;
			ГруппыДокументов.Вставить(ДокументПриемкиСтроки, СтрокиДокумента);
		КонецЕсли;
		СтрокиДокумента.Добавить(Э);
	КонецЦикла;

	Для Каждого ПараДокумента Из ГруппыДокументов Цикл
		ДокументПриемкиСтроки = ПараДокумента.Ключ;
		СтрокиДокумента = ПараДокумента.Значение;

		ЦенаПоСтрокеПриемки = Новый Соответствие;
		КэшПриемок = Новый Соответствие;
		ПерваяПриемка = Неопределено;

		Для Каждого Э Из СтрокиДокумента Цикл
			Если Не ЗначениеЗаполнено(Э.ДокументРегистратор) Тогда
				Продолжить;
			КонецЕсли;

			Если ПерваяПриемка = Неопределено Тогда
				ПерваяПриемка = Э.ДокументРегистратор;
			КонецЕсли;

			Если КэшПриемок.Получить(Э.ДокументРегистратор) = Неопределено Тогда
				Попытка
					КэшПриемок.Вставить(Э.ДокументРегистратор, Э.ДокументРегистратор.ПолучитьОбъект());
				Исключение
					КэшПриемок.Вставить(Э.ДокументРегистратор, Неопределено);
				КонецПопытки;
			КонецЕсли;
		КонецЦикла;

		Для Каждого ПараПриемки Из КэшПриемок Цикл
			ОбъектПриемки = ПараПриемки.Значение;
			Если ОбъектПриемки = Неопределено Тогда
				Продолжить;
			КонецЕсли;

			Для Каждого СтрОсн Из ОбъектПриемки.Товары Цикл
				КлючЦены = КлючСтрокиХранения(ПараПриемки.Ключ, СтрОсн.Номенклатура, СтрОсн.Характеристика, СтрОсн.Назначение);
				Если ЦенаПоСтрокеПриемки.Получить(КлючЦены) = Неопределено Тогда
					ЦенаПоСтрокеПриемки.Вставить(КлючЦены, Новый Структура("Цена,НоменклатураПартнера", СтрОсн.Цена, СтрОсн.НоменклатураПартнера));
				КонецЕсли;
				КлючЦеныБезРазрезов = КлючСтрокиХраненияБезРазрезов(ПараПриемки.Ключ, СтрОсн.Номенклатура);
				Если ЦенаПоСтрокеПриемки.Получить(КлючЦеныБезРазрезов) = Неопределено Тогда
					ЦенаПоСтрокеПриемки.Вставить(КлючЦеныБезРазрезов, Новый Структура("Цена,НоменклатураПартнера", СтрОсн.Цена, СтрОсн.НоменклатураПартнера));
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;

		СозданнаяСсылка = Неопределено;
		НачатьТранзакцию();
		Попытка
			Док = Документы.ОтгрузкаТоваровСХранения.СоздатьДокумент();

			Попытка
				Док.Заполнить(ДокументПриемкиСтроки);
			Исключение
				ОписаниеОшибкиЗаполнения = ОписаниеОшибки();
			КонецПопытки;

			Попытка
				Док.Основание = ДокументПриемкиСтроки;
			Исключение
				ОписаниеОшибкиОснования = ОписаниеОшибки();
			КонецПопытки;

			Если ЗначениеЗаполнено(ПерваяПриемка) Тогда
				ОбъектПервойПриемки = КэшПриемок.Получить(ПерваяПриемка);
				Если ОбъектПервойПриемки <> Неопределено Тогда
					Попытка
						Если Не ЗначениеЗаполнено(Док.Организация) Тогда
							Док.Организация = ОбъектПервойПриемки.Организация;
						КонецЕсли;
					Исключение
						ОписаниеОшибкиОрганизации = ОписаниеОшибки();
					КонецПопытки;
					Попытка
						Если Не ЗначениеЗаполнено(Док.Склад) Тогда
							Док.Склад = ОбъектПервойПриемки.Склад;
						КонецЕсли;
					Исключение
						ОписаниеОшибкиСклада = ОписаниеОшибки();
					КонецПопытки;
					Попытка
						Если Не ЗначениеЗаполнено(Док.Партнер) Тогда
							Док.Партнер = ОбъектПервойПриемки.Партнер;
						КонецЕсли;
					Исключение
						ОписаниеОшибкиПартнера = ОписаниеОшибки();
					КонецПопытки;
					Попытка
						Если Не ЗначениеЗаполнено(Док.Договор) Тогда
							Док.Договор = ОбъектПервойПриемки.Договор;
						КонецЕсли;
					Исключение
						ОписаниеОшибкиДоговора = ОписаниеОшибки();
					КонецПопытки;
				КонецЕсли;
			КонецЕсли;

			Попытка
				Док.Товары.Очистить();
			Исключение
				ОписаниеОшибкиОчистки = ОписаниеОшибки();
			КонецПопытки;

			Для Каждого Э Из СтрокиДокумента Цикл
				СтрДок = Док.Товары.Добавить();
				СтрДок.Номенклатура = Э.Номенклатура;
				Попытка
					СтрДок.Характеристика = Э.Характеристика;
				Исключение
					ОписаниеОшибкиСтрокиХарактеристики = ОписаниеОшибки();
				КонецПопытки;

				Попытка
					СтрДок.Назначение = Э.Назначение;
				Исключение
					ОписаниеОшибкиНазначения = ОписаниеОшибки();
				КонецПопытки;

				Попытка
					СтрДок.Склад = Э.Склад;
				Исключение
					ОписаниеОшибкиСтрокиСклад = ОписаниеОшибки();
				КонецПопытки;

				Попытка
					ЗаказКлиентаСтроки = Э.Назначение.Заказ;
				Исключение
					ЗаказКлиентаСтроки = Неопределено;
				КонецПопытки;
				Если ЗначениеЗаполнено(ЗаказКлиентаСтроки) Тогда
					Попытка
						СтрДок.ЗаказКлиента = ЗаказКлиентаСтроки;
					Исключение
						ОписаниеОшибкиСтрокиЗаказа = ОписаниеОшибки();
					КонецПопытки;
				КонецЕсли;

				Упаковка = ПолучитьУпаковкуНоменклатуры(Э.Номенклатура);
				Если ЗначениеЗаполнено(Упаковка) Тогда
					Попытка
						СтрДок.Упаковка = Упаковка;
					Исключение
						ОписаниеОшибкиУпаковки = ОписаниеОшибки();
					КонецПопытки;
				КонецЕсли;

				Кол = ?(ЗначениеЗаполнено(Э.Количество) И Э.Количество > 0, Э.Количество, 1);
				Попытка
					СтрДок.КоличествоУпаковок = Кол;
				Исключение
					ОписаниеОшибкиКоличестваУпаковок = ОписаниеОшибки();
				КонецПопытки;

				Попытка
					СтрДок.Количество = Кол;
				Исключение
					ОписаниеОшибкиКоличества = ОписаниеОшибки();
				КонецПопытки;

				КлючЦены = КлючСтрокиХранения(Э.ДокументРегистратор, Э.Номенклатура, Э.Характеристика, Э.Назначение);
				СтрЦены = ЦенаПоСтрокеПриемки.Получить(КлючЦены);
				Если СтрЦены = Неопределено Тогда
					СтрЦены = ЦенаПоСтрокеПриемки.Получить(КлючСтрокиХраненияБезРазрезов(Э.ДокументРегистратор, Э.Номенклатура));
				КонецЕсли;
				Если СтрЦены <> Неопределено Тогда
					Попытка
						СтрДок.Цена = СтрЦены.Цена;
					Исключение
						ОписаниеОшибкиЦены = ОписаниеОшибки();
					КонецПопытки;

					Попытка
						СтрДок.Сумма = СтрЦены.Цена * Кол;
					Исключение
						ОписаниеОшибкиСуммы = ОписаниеОшибки();
					КонецПопытки;

					Попытка
						СтрДок.НоменклатураПартнера = СтрЦены.НоменклатураПартнера;
					Исключение
						ОписаниеОшибкиНоменклатурыПартнера = ОписаниеОшибки();
					КонецПопытки;
				КонецЕсли;

				Попытка
					СтрДок.ДокументПоступления = Э.ДокументРегистратор;
				Исключение
					ОписаниеОшибкиДокументаПоступления = ОписаниеОшибки();
				КонецПопытки;

				Если ЗначениеЗаполнено(Э.СерийныйНомер) Тогда
					Попытка
						СтрДок.СерийныйНомер = Э.СерийныйНомер;
					Исключение
						ОписаниеОшибкиСерийногоНомера = ОписаниеОшибки();
					КонецПопытки;
				КонецЕсли;
			КонецЦикла;

			Док.Дата = ТекущаяДатаСеанса();
			Док.Записать();
			СозданнаяСсылка = Док.Ссылка;
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение ОписаниеОшибки();
		КонецПопытки;

		Если ЗначениеЗаполнено(СозданнаяСсылка) Тогда
			Созданные.Добавить(СозданнаяСсылка);
		КонецЕсли;
	КонецЦикла;

	Возврат Созданные;
КонецФункции


#КонецОбласти

