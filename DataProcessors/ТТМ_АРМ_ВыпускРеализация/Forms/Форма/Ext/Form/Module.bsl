функция ПолучитьМассивЗаказов()
	СписокЗаказовКОтгрузке = ПолучитьСписокЗаказовДляОтгрузки();
		
	Если СписокЗаказовКОтгрузке.Количество() = 0 Тогда
		МассивЗаказов = ОбщегоНазначения.ТаблицаЗначенийВМассив(СписокЗаказовКОтгрузке);
		Возврат МассивЗаказов;
	КонецЕсли;
	
	//Вызов серверной функции из модуля объекта
	ТекущийОбъект = РеквизитФормыВЗначение("Объект");
	СгруппированныеЗаказы = ТекущийОбъект.ГруппировкаЗаказовСВыпуском(СписокЗаказовКОтгрузке);	
	МассивЗаказов = ОбщегоНазначения.ТаблицаЗначенийВМассив(СгруппированныеЗаказы);
		
	Возврат МассивЗаказов;
