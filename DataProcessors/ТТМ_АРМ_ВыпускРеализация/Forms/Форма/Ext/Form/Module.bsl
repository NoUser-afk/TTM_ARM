&НаКлиенте
Процедура ТаблицаЭтаповОтметкаПриИзменении(Элемент)     
	
	ТекСтрока = Элемент.Родитель.ТекущиеДанные;   // Элементы[Элемент.Родитель.Имя].ТекущиеДанные
	ПараметрыПоиска = Новый Структура("Ссылка",ТекСтрока.Ссылка);
	МассивСтрокПоЭтапу = ТаблицаЭтапов.НайтиСтроки(ПараметрыПоиска);
	Если МассивСтрокПоЭтапу.Количество() > 1 Тогда
		Для Каждого Стр из МассивСтрокПоЭтапу Цикл 
			Стр.Отметка = Истина;
		КонецЦикла;
	КонецЕсли;
	
	КоличествоОтмеченныхЭтапов = ПолучитьКоличествоНоменклатуры();
	Объект.Количество = КоличествоОтмеченныхЭтапов;  
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ИзделиеПриИзмененииНаСервере(Номенклатура)
	Организация = Неопределено;
	
	Если СтрНайти("(RB)",Номенклатура.Наименование) <> 0 Тогда 
		Организация = Справочники.Организации.НайтиПоНаименованию("Роболабс");
	Иначе 
		Организация = Справочники.Организации.НайтиПоНаименованию("Тверьторгмаш");
	КонецЕсли;
	
	Возврат Организация;	
КонецФункции

