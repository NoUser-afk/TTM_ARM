&НаСервере
Процедура ИзменитьСтатусОбеспечения()	
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("Номенклатура", Объект.Изделие);
	СтруктураПоиска.Вставить("ВариантОбеспечения", Перечисления.ВариантыОбеспечения.КОбеспечению);	
	
	ДокОбъект = Объект.ЗаказКлиента.ПолучитьОбъект();
	НайденныеСтроки = ДокОбъект.Товары.НайтиСтроки(СтруктураПоиска);
	
	ПараметрыЗаполнения = Новый Структура();
	ПараметрыЗаполнения.Вставить("ЗаполнитьДатуОтгрузкиОднойДатой", Ложь);
	ПараметрыЗаполнения.Вставить("СнятьФлагОтгружатьОднойДатой", Ложь);
	
	КэшированныеЗначения = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	
	Для Каждого НайденныйТовар Из НайденныеСтроки Цикл
		НайденныйТовар.Количество = НайденныйТовар.Количество - Объект.Количество;
		НайденныйТовар.КоличествоУпаковок = НайденныйТовар.КоличествоУпаковок - Объект.Количество;
		
		НоваяСтрока = ДокОбъект.Товары.Добавить();
		ИндексСтроки = НоваяСтрока.КодСтроки;
		ЗаполнитьЗначенияСвойств(НоваяСтрока, НайденныйТовар);
		НоваяСтрока.КодСтроки = ИндексСтроки;
		НоваяСтрока.ДатаОтгрузки = ТекущаяДата();
		НоваяСтрока.Количество = Объект.Количество;
		НоваяСтрока.КоличествоУпаковок = Объект.Количество;
		НоваяСтрока.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Отгрузить;		
		
		НоваяСтрока = ПересчитатьИтоговыеПоказатели(НоваяСтрока);
		ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(НоваяСтрока, ПараметрыЗаполнения, КэшированныеЗначения);
		
        НайденныйТовар = ПересчитатьИтоговыеПоказатели(НайденныйТовар);		
		ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(НайденныйТовар, ПараметрыЗаполнения, КэшированныеЗначения);
	КонецЦикла;
				
	Попытка
		НачатьТранзакцию();
		ДокОбъект.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
		ЗафиксироватьТранзакцию();
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Ошибка во время записи документа: '") + ДокОбъект + " " + ОписаниеОшибки(),,,); 
		ОтменитьТранзакцию();
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Функция ПересчитатьИтоговыеПоказатели(СтрокаТЧ)
	РазбитьСтроку = СтрЗаменить(СтрокаТЧ.СтавкаНДС, "%", "");
	ПолученныйНДС = Число(РазбитьСтроку); 
	
	СтрокаТЧ.Сумма = СтрокаТЧ.Цена * СтрокаТЧ.Количество;
	СтрокаТЧ.СуммаСНДС = СтрокаТЧ.Цена * СтрокаТЧ.Количество;
	СтрокаТЧ.СуммаНДС = (СтрокаТЧ.Цена * ПолученныйНДС / 120) * СтрокаТЧ.Количество;
	
	Возврат СтрокаТЧ;
КонецФункции

&НаСервереБезКонтекста
Функция ПоискЗаказаКлиентаЧерезНазначение(ПараметрыДанных)
	
	МассивОтбора = Новый Массив;
	ВводПользователя = "%" + ПараметрыДанных.СтрокаПоиска + "%";
		
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Назначения.Заказ КАК Заказ,
		|	Назначения.Наименование КАК Наименование
		|ИЗ
		|	Справочник.Назначения КАК Назначения
		|ГДЕ
		|	Назначения.Наименование ПОДОБНО &Наименование
		|	И НЕ Назначения.ПометкаУдаления
		|	И НЕ Назначения.Заказ.ПометкаУдаления
		|	И НЕ Назначения.Заказ.Статус = &СтатусЗаказа"
	);
	
	Запрос.УстановитьПараметр("Наименование", ВводПользователя);
	Запрос.УстановитьПараметр("СтатусЗаказа", Перечисления.СтатусыЗаказовКлиентов.Закрыт);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Количество() > 0 Тогда
		Пока Выборка.Следующий() Цикл
			МассивОтбора.Добавить(Выборка.Заказ);
		КонецЦикла;
	КонецЕсли;
	
	Возврат МассивОтбора;
КонецФункции

