&НаСервере
Процедура ИзделиеОчисткаНаСервере()
	Объект.Изделие = Справочники.Номенклатура.ПустаяСсылка();
	ОбновитьТаблицуЭтапов();
КонецПроцедуры

&НаСервере
Процедура ОбновитьТаблицуЭтапов()
	
	Если ЗначениеЗаполнено(Объект.ЗаказКлиента) Тогда
		НомерПоДанныеКлиента = Объект.ЗаказКлиента.НомерПоДаннымКлиента;
		ДатаПоДаннымКлиента  = Объект.ЗаказКлиента.ДатаПоДаннымКлиента;
	Иначе
		НомерПоДанныеКлиента = "";
		ДатаПоДаннымКлиента = Дата('00010101');
	КонецЕсли;    
	
    //Заполнить таблицу Этапов 
	ТабЭтапы = РеквизитФормыВЗначение("ТаблицаЭтапов", Тип("ТаблицаЗначений"));
	
	Запрос = новый Запрос; 
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТТМ_УчетСерийныхНомеровПродукции.Регистратор КАК Регистратор,
	               |	ТТМ_УчетСерийныхНомеровПродукции.Номенклатура КАК Номенклатура,
	               |	ТТМ_УчетСерийныхНомеровПродукции.СерийныйНомер КАК СерийныйНомер,
	               |	ТТМ_УчетСерийныхНомеровПродукции.Количество КАК Количество
	               |ПОМЕСТИТЬ ВТ_ЗарегистрированныеСерийныеНомера
	               |ИЗ
	               |	РегистрНакопления.ТТМ_УчетСерийныхНомеровПродукции КАК ТТМ_УчетСерийныхНомеровПродукции
	               |ГДЕ
	               |	ТТМ_УчетСерийныхНомеровПродукции.Регистратор ССЫЛКА Документ.ЭтапПроизводства2_2
	               |	&УсловиеУчетСН
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ЭтапПроизводства2_2ВыходныеИзделия.Ссылка КАК Ссылка,
	               |	ЭтапПроизводства2_2ВыходныеИзделия.Номенклатура КАК Номенклатура,
	               |	ЕСТЬNULL(ВТ_ЗарегистрированныеСерийныеНомера.СерийныйНомер, """") КАК СерийныйНомер,
	               |	ЭтапПроизводства2_2ВыходныеИзделия.Назначение КАК Назначение,
	               |	ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.КоличествоУпаковокФакт КАК Выполнено,
	               |	ЕСТЬNULL(ВТ_ЗарегистрированныеСерийныеНомера.Количество, ЭтапПроизводства2_2ВыходныеИзделия.КоличествоУпаковок) КАК Количество,
	               |	ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.КоличествоУпаковокПлан КАК Запланировано,
	               |	ЛОЖЬ КАК Отметка
	               |ИЗ
	               |	Документ.ЭтапПроизводства2_2.ВыходныеИзделия КАК ЭтапПроизводства2_2ВыходныеИзделия
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЗарегистрированныеСерийныеНомера КАК ВТ_ЗарегистрированныеСерийныеНомера
	               |		ПО ЭтапПроизводства2_2ВыходныеИзделия.Ссылка = ВТ_ЗарегистрированныеСерийныеНомера.Регистратор
	               |			И ЭтапПроизводства2_2ВыходныеИзделия.Номенклатура = ВТ_ЗарегистрированныеСерийныеНомера.Номенклатура
	               |ГДЕ
	               |	ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.Проведен
	               |	И ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЭтаповПроизводства2_2.Начат)
	               |	И НЕ ЭтапПроизводства2_2ВыходныеИзделия.Отменено
	               |	И НЕ ЭтапПроизводства2_2ВыходныеИзделия.Произведено
				   //|";
	               |	&УсловиеНоменклатура
				   |	&УсловиеЗаказКлиента
	               |
	               |УПОРЯДОЧИТЬ ПО 
				   |	СерийныйНомер";
		
	Запрос.УстановитьПараметр("Номенклатура",Объект.Изделие);
	//Запрос.УстановитьПараметр("Заказ", Объект.ЗаказКлиента);
	
	Если ЗначениеЗаполнено(Объект.Изделие) Тогда 
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"&УсловиеНоменклатура"," И ЭтапПроизводства2_2ВыходныеИзделия.Номенклатура = &Номенклатура ");		
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"&УсловиеУчетСН"," И ТТМ_УчетСерийныхНомеровПродукции.Номенклатура = &Номенклатура ");
		//Запрос.УстановитьПараметр("Номенклатура",Объект.Изделие);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"&УсловиеНоменклатура","");
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"&УсловиеУчетСН","");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ЗаказКлиента) Тогда 
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"&УсловиеЗаказКлиента"," И ЭтапПроизводства2_2ВыходныеИзделия.Назначение.Заказ = &Заказ ");
		Запрос.УстановитьПараметр("Заказ", Объект.ЗаказКлиента);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"&УсловиеЗаказКлиента","");
	КонецЕсли;
	
	ТабЭтапы = Запрос.Выполнить().Выгрузить();
	ЗначениеВРеквизитФормы(ТабЭтапы, "ТаблицаЭтапов");
	
	Объект.Количество = 0;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьКоличествоНоменклатуры()
	ПараметрыОтбора = Новый Структура("Отметка", Истина);
	Возврат ТаблицаЭтапов.Выгрузить(ПараметрыОтбора,"Количество").Итог("Количество");
КонецФункции

 &НаСервереБезКонтекста
Функция ПолучитьТекДату()
	
	Возврат ТекущаяДатаСеанса();
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьДанныеВыбораРасширенные(СтрокаПоиска)
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("СтрокаПоиска", СтрокаПоиска);
	СтруктураОтбора.Вставить("ВводПоСтрокеРасширенный", Истина);
	
	СтрокаПоиска = СтрЗаменить(СтруктураОтбора.СтрокаПоиска, """", ""); 
	
	Если СтрокаПоиска <> "" И СтруктураОтбора.Свойство("ВводПоСтрокеРасширенный") Тогда
		МассивСловПоиска = СтрРазделить(СтрокаПоиска, " ", Ложь); 

		Запрос = Новый Запрос;
        Запрос.Текст = "ВЫБРАТЬ		
						|	Назначения.Заказ КАК Заказ,
						|	Назначения.Наименование КАК Наименование,
						|	Назначения.ПометкаУдаления КАК ПометкаУдаления
						|ПОМЕСТИТЬ ВТ_ЗаказКлиентаОтборПоНомеру
						|ИЗ
						|	Справочник.Назначения КАК Назначения
						|ГДЕ
						|	Назначения.Наименование ПОДОБНО &СловоПоиска
						|	И НЕ Назначения.ПометкаУдаления
						|	И НЕ Назначения.Заказ.ПометкаУдаления
						//|	И Назначения.Заказ.Статус <> &СтатусЗаказа
						|;
						|
						|////////////////////////////////////////////////////////////////////////////////
						|ВЫБРАТЬ
						|	СостоянияЗаказовКлиентов.Заказ КАК Заказ,
						|	ВТ_ЗаказКлиентаОтборПоНомеру.Наименование КАК Наименование,
						|	ВТ_ЗаказКлиентаОтборПоНомеру.ПометкаУдаления КАК ПометкаУдаления
						|ИЗ
						|	ВТ_ЗаказКлиентаОтборПоНомеру КАК ВТ_ЗаказКлиентаОтборПоНомеру
						|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияЗаказовКлиентов КАК СостоянияЗаказовКлиентов
						|		ПО (СостоянияЗаказовКлиентов.Заказ = ВТ_ЗаказКлиентаОтборПоНомеру.Заказ)
						|ГДЕ
						|	СостоянияЗаказовКлиентов.Состояние <> &Состояние";
		
		Запрос.УстановитьПараметр("СловоПоиска", "%" + СтрокаПоиска + "%");
		//Запрос.УстановитьПараметр("СтатусЗаказа", Перечисления.СтатусыЗаказовКлиентов.Закрыт);
		Запрос.УстановитьПараметр("Состояние", Перечисления.СостоянияЗаказовКлиентов.ГотовКЗакрытию);
				
		Выборка = Запрос.Выполнить();
		ВыборкаДетальныеЗаписи = Выборка.Выбрать();
		
		СписокВыбора = Новый СписокЗначений;
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			СтруктураОтбора = Новый Структура;
			СтруктураОтбора.Вставить("Значение", ВыборкаДетальныеЗаписи.Заказ);
			СтруктураОтбора.Вставить("ПометкаУдаления", ВыборкаДетальныеЗаписи.ПометкаУдаления);
			
			СписокВыбора.Добавить(СтруктураОтбора, ТТМ_ДанныеВыбораСервер.ПодсветитьСлова(ВыборкаДетальныеЗаписи.Наименование, МассивСловПоиска));
		КонецЦикла;
	
		ДанныеВыбора = СписокВыбора;
	КонецЕсли;
		
	Возврат ДанныеВыбора;	
КонецФункции

#КонецОбласти


