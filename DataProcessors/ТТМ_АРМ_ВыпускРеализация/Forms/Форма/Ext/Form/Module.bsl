		//Отменяем выпуск в этапе          
		//ДокЭтап = Документы.ЭтапПроизводства2_2.СоздатьДокумент();
		ТабТовары = ДокЭтап.ВыходныеИзделия;
		Для Каждого стр из ТабТовары Цикл 
			стр.Произведено = Ложь;               
			//*****************************************************************
			СтруктураДействий = Новый Структура;
			
			ПараметрыУказанияСерий = Документы.ЭтапПроизводства2_2.ПараметрыУказанияСерий(ДокЭтап);
			
			ИмяТЧ = "ВыходныеИзделия";
			ПараметрыПроверкиСерий = Новый Структура;
			ПараметрыПроверкиСерий.Вставить("Склад", стр.Получатель);
			ПараметрыПроверкиСерий.Вставить("ПараметрыУказанияСерий", ПараметрыУказанияСерий[ИмяТЧ]);
			СтруктураДействий.Вставить("ПроверитьСериюРассчитатьСтатус", ПараметрыПроверкиСерий);
			
			Если ДокЭтап.ПроизводствоОднойДатой Тогда
				ПараметрыДействия = УправлениеПроизводствомКлиентСервер.ПараметрыДействияЗаполнитьДатуПроизводства(
					ДокЭтап.ДатаПроизводства,
					ДокЭтап.ДатаПроизводства);
				СтруктураДействий.Вставить("ЗаполнитьДатуПроизводства", ПараметрыДействия);
			КонецЕсли;
			ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(стр, СтруктураДействий, Неопределено);
			//*********************************************************************
		КонецЦикла; 
		Попытка   
			ДокЭтап.КоличествоУпаковокФакт = 0.4;
			ДокЭтап.Записать(РежимЗаписиДокумента.Запись);
			ЗафиксироватьТранзакцию();
			Сообщить("Отменили производство единицы продукции!");
		Исключение
			Сообщить("Не удалось отменить выпуск в Этапе" + ДокЭтап.Ссылка);
			Пока ТранзакцияАктивна() Цикл  
				ОтменитьТранзакцию();
			КонецЦикла;
		КонецПопытки;
		
		//Отменяем выпуск в регистре Учет серийных номеров происходит автоматически при отмене проведения этапа
			
КонецПроцедуры
#КонецОбласти

&НаСервере
Функция ПолучитьДокументыДляОтменыВыпуска(УчетСерийныхНомеров, Номенклатура, Назначение, СерийныйНомер = "");
	
	ДокументыДляОтменыВыпуска = Новый Структура("ДокЭтап, ДокПередачаПродукции");
	
	Если УчетСерийныхНомеров Тогда              
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ТТМ_УчетСерийныхНомеровПродукции.Регистратор КАК Регистратор
		               |ИЗ
		               |	РегистрНакопления.ТТМ_УчетСерийныхНомеровПродукции КАК ТТМ_УчетСерийныхНомеровПродукции
		               |ГДЕ
		               |	ТТМ_УчетСерийныхНомеровПродукции.Номенклатура = &Номенклатура
		               |	И ТТМ_УчетСерийныхНомеровПродукции.Назначение = &Назначение
		               |	И ТТМ_УчетСерийныхНомеровПродукции.СерийныйНомер = &СерийныйНомер
		               |	И ТТМ_УчетСерийныхНомеровПродукции.Произведено
		               |	И НЕ ТТМ_УчетСерийныхНомеровПродукции.Реализовано
		               |	И ТТМ_УчетСерийныхНомеровПродукции.Регистратор ССЫЛКА Документ.ЭтапПроизводства2_2
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ДвижениеПродукцииИМатериаловТовары.Ссылка КАК Ссылка
		               |ИЗ
		               |	РегистрНакопления.ТТМ_УчетСерийныхНомеровПродукции КАК ТТМ_УчетСерийныхНомеровПродукции
		               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ДвижениеПродукцииИМатериалов.Товары КАК ДвижениеПродукцииИМатериаловТовары
		               |		ПО ТТМ_УчетСерийныхНомеровПродукции.Регистратор = ДвижениеПродукцииИМатериаловТовары.Ссылка.Распоряжение
		               |ГДЕ
		               |	ТТМ_УчетСерийныхНомеровПродукции.Номенклатура = &Номенклатура
		               |	И ТТМ_УчетСерийныхНомеровПродукции.Назначение = &Назначение
		               |	И ТТМ_УчетСерийныхНомеровПродукции.СерийныйНомер = &СерийныйНомер
		               |	И ТТМ_УчетСерийныхНомеровПродукции.Произведено
		               |	И НЕ ТТМ_УчетСерийныхНомеровПродукции.Реализовано
		               |	И ТТМ_УчетСерийныхНомеровПродукции.Регистратор ССЫЛКА Документ.ЭтапПроизводства2_2
		               |	И ДвижениеПродукцииИМатериаловТовары.Ссылка.Проведен
		               |	И ДвижениеПродукцииИМатериаловТовары.Ссылка.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПередачаПродукцииИзПроизводства)";
		Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
		Запрос.УстановитьПараметр("Назначение",Назначение);
		Запрос.УстановитьПараметр("СерийныйНомер",СерийныйНомер);
		МассивРезультатов = Запрос.ВыполнитьПакет();
		
		ЭтапПроизводства = МассивРезультатов[0].Выгрузить();
		Если ЭтапПроизводства.Количество() <> 1 Тогда 
			Сообщить("не удалось однозначно определить этап производства!");
		КонецЕсли;
		ДокументыДляОтменыВыпуска.ДокЭтап = ЭтапПроизводства[0].Регистратор;              
		
		ПередачаПродукции = МассивРезультатов[1].Выгрузить(); 
		Если ПередачаПродукции.Количество() <> 1 Тогда 
			Сообщить("не удалось однозначно определить документ передачи продукции!");
		КонецЕсли;
		ДокументыДляОтменыВыпуска.ДокПередачаПродукции = ПередачаПродукции[0].Ссылка;
		
	Иначе 
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ДвижениеПродукцииИМатериаловТовары.Ссылка КАК Ссылка,
		               |	ДвижениеПродукцииИМатериаловТовары.Ссылка.Распоряжение КАК Распоряжение
		               |ИЗ
		               |	Документ.ДвижениеПродукцииИМатериалов.Товары КАК ДвижениеПродукцииИМатериаловТовары
		               |ГДЕ
		               |	ДвижениеПродукцииИМатериаловТовары.Ссылка.Проведен
		               |	И ДвижениеПродукцииИМатериаловТовары.Ссылка.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПередачаПродукцииИзПроизводства)
		               |	И ДвижениеПродукцииИМатериаловТовары.Назначение = &Назначение
		               |	И ДвижениеПродукцииИМатериаловТовары.Номенклатура = &Номенклатура
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	ДвижениеПродукцииИМатериаловТовары.Ссылка.Дата УБЫВ";
		Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
		Запрос.УстановитьПараметр("Назначение", Назначение);
		ТабДокуентыПередачи = Запрос.Выполнить().Выгрузить();
		Если ТабДокуентыПередачи.Количество() <> 1 Тогда 
			Сообщить("не удалось однозначно определить документ передачи продукции!");
		КонецЕсли;
		ДокументыДляОтменыВыпуска.ДокПередачаПродукции = ТабДокуентыПередачи[0].Ссылка;
		ДокументыДляОтменыВыпуска.ДокЭтап = ТабДокуентыПередачи[0].Распоряжение;
		
	КонецЕсли;             
	
	Возврат ДокументыДляОтменыВыпуска;
	
КонецФункции

