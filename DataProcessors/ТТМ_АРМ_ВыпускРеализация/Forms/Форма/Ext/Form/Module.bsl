&НаКлиенте
Процедура ПечатьЭтикеток(Команда)
	
	ПроверкаВыполнена = ПроверкаЗаполненияКлючевыхПолей(Команда);
	
	Если Не ПроверкаВыполнена Тогда 
		Возврат;
	КонецЕсли;
	
	//16.01.2026                                                        
	ДанныеТекущейСтрокиТаблицы = Элементы.ТаблицаЭтапов.ТекущиеДанные;
	Номенклатура = Объект.Изделие;
	Если не ЗначениеЗаполнено(Номенклатура) Тогда 
		//Передаем номенклатуру из текущей строки Таблицы
		Номенклатура = ДанныеТекущейСтрокиТаблицы.Номенклатура;
	КонецЕсли;
	КоличествоВыбрано = Объект.Количество;
	Если Объект.Количество = 0 Тогда 
		КоличествоВыбрано = ДанныеТекущейСтрокиТаблицы.Количество;
	КонецЕсли;
	
	//23.06.2025 
	СтруктураПечати = ПолучитьСтруктуруПечати(Номенклатура, КоличествоВыбрано, КоличествоЭтикетокДляПечати);
	
	МассивОбъектов = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Объект.Изделие);
	ИменаМакетов = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве("ЭтикеткаТовары");	 
	
	//23.06.2025
	//СтруктураПечати = ПолучитьСтруктуруПечати(МассивОбъектов, Объект.Количество, КоличествоЭтикетокДляПечати);
	//-
		
	УправлениеПечатьюКлиент.ВыполнитьКомандуПечати(
		"Обработка.ПечатьЭтикетокИЦенников",
		ИменаМакетов,
		МассивОбъектов,
		ЭтаФорма,
		СтруктураПечати
	);
	
КонецПроцедуры    

&НаКлиенте
Процедура НапечататьУПД()
	Если ЗначениеЗаполнено(Реализация) Тогда
		ВПФ = НайтиВПФ();
		
		Если ВПФ.Пустая() Тогда
			Сообщить("Не найдена внешняя печатная форма ""УПД с комментарием""!");
			Возврат;
		КонецЕсли;
		
		ОбъектыНазначения = Новый Массив;
		ОбъектыНазначения.Добавить(Реализация);
		ПараметрыОткрытия = Новый Структура("ИсточникДанных, ПараметрыИсточника");
		ПараметрыОткрытия.ИсточникДанных = ВПФ;
		ПараметрыОткрытия.ПараметрыИсточника = Новый Структура("ИдентификаторКоманды, ОбъектыНазначения");
		ПараметрыОткрытия.ПараметрыИсточника.ИдентификаторКоманды = "УПДСКомментариемТТМ";
		ПараметрыОткрытия.ПараметрыИсточника.ОбъектыНазначения = ОбъектыНазначения;
		ОткрытьФорму("ОбщаяФорма.ПечатьДокументов", ПараметрыОткрытия);
	КонецЕсли;
КонецПроцедуры
        
