#Область ФормированиеДокументовОтгрузки

&НаКлиенте
Процедура ЗаполнитьДокументОтгрузка(Команда)
	//+Ганьшина Е.
	Возврат;
	//-
	ВопросПользователюПередВыполнениемОперации(Команда);
КонецПроцедуры

&НаСервере
Процедура СформироватьДокументТекущаяОтгрузка()
	ВыгруженныеЗаказы = ПолучитьСписокЗаказовДляОтгрузки();
	
	Если ВыгруженныеЗаказы.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Нет ни одного заказа с выпуском'"));
		Возврат;
	КонецЕсли;
	
	//Вызов серверной функции из модуля объекта
	ТекущийОбъект = РеквизитФормыВЗначение("Объект");
	ТаблицаТоваров = ТекущийОбъект.ГруппировкаЗаказовСВыпуском(ВыгруженныеЗаказы, Истина);
	
	//Получаем документ со статусом завершен или завершен с расхождениями
	СписокОтсканированныхИзделий = ПроверкаДокументаПередФормированием(Истина);
	
	Если СписокОтсканированныхИзделий.Количество() > 0 Тогда
		ТаблицаТоваров = ВыполнитьПроверкуОтсканированныхТоваров(ТаблицаТоваров, СписокОтсканированныхИзделий);
	КонецЕсли;
	
	//Получаем действующий документ со статусом в работе или к выполнению и проверяем имеющиеся комплекты таблице
	НайденныйДокумент = ПроверкаДокументаПередФормированием();
	ТаблицаТоваров = ПроверитьИУдалитьЕслиЕстьКомплекты(ТаблицаТоваров);
	
	//Если документ не найден, создаем новый и заполняем его реквизиты
	Если НайденныйДокумент = Неопределено Тогда
		СозданиеНовогоДокумента(ТаблицаТоваров);
	Иначе
	//Иначе перезаполняем существующий документ
		ПерезаполнитьСуществующийДокумент(ТаблицаТоваров, НайденныйДокумент);		
	КонецЕсли;
			
КонецПроцедуры

&НаСервере
Процедура СозданиеНовогоДокумента(ТаблицаТоваров)
	НовыйДокумент = Документы.ТТМ_ОтгрузкаТоваров.СоздатьДокумент();
		
	Для Каждого Товар Из ТаблицаТоваров Цикл		
		Организация = Товар.Организация;
		СкладОтгрузки = Товар.Склад;
			
		ТоварСтрока = НовыйДокумент.ВыпущеннаяПродукция.Добавить();
		ТоварСтрока.Номенклатура = Товар.Номенклатура;
		ТоварСтрока.Количество = Товар.Количество;
		ТоварСтрока.ЕдиницаИзмерения = Товар.Номенклатура.ЕдиницаИзмерения;			
	КонецЦикла;
		
	НовыйДокумент.Дата = ПолучитьТекДату();
	НовыйДокумент.Ответственный = Пользователи.ТекущийПользователь();
	НовыйДокумент.Организация = Организация;
	НовыйДокумент.Склад = СкладОтгрузки;
	НовыйДокумент.Статус = Перечисления.СтатусыТТМОтгрузка.КВыполнению;
		
	Попытка
		НачатьТранзакцию();
		НовыйДокумент.Записать(РежимЗаписиДокумента.Запись);
		ЗафиксироватьТранзакцию();
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Формирование нового документа завершено: '") + НовыйДокумент);
	Исключение 
		ОтменитьТранзакцию();
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Произошла ошибка при формировании нового документа: '") + ОписаниеОшибки());
		
		// Запись события в журнал регистрации для системного администратора.
    	ЗаписьЖурналаРегистрации(
			НСтр("ru = 'Выполнение операции'"),
			УровеньЖурналаРегистрации.Ошибка,,, 
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
    	ВызватьИсключение;

	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура ПерезаполнитьСуществующийДокумент(ТаблицаТоваров, НайденныйДокумент)
	ДокументСсылка = НайденныйДокумент.ПолучитьОбъект();
	ДокументСсылка.ВыпущеннаяПродукция.Очистить();
	
	ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(ТаблицаТоваров, ДокументСсылка.ВыпущеннаяПродукция);   
			
	Попытка
		НачатьТранзакцию();
		ДокументСсылка.Записать(РежимЗаписиДокумента.Запись);
		ЗафиксироватьТранзакцию();
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Документ: '") + ДокументСсылка + " успешно перезаписан");
	Исключение 
		ОтменитьТранзакцию();
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Произошла во время записи документа: '") + ДокументСсылка + " " +  ОписаниеОшибки());
		
		// Запись события в журнал регистрации для системного администратора.
    	ЗаписьЖурналаРегистрации(
			НСтр("ru = 'Выполнение операции'"),
			УровеньЖурналаРегистрации.Ошибка,,, 
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
    	ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

&НаСервере
функция ВыполнитьПроверкуОтсканированныхТоваров(ТаблицаТоваров, СписокОтсканированныхИзделий)
	
	Для Каждого ТоварВыпуск Из ТаблицаТоваров Цикл
		НоменклатураНайдена = Ложь;
		
		Для Каждого ТоварИзДокумента Из СписокОтсканированныхИзделий Цикл
			
			Если ТоварВыпуск.Номенклатура = ТоварИзДокумента.Номенклатура Тогда 
			    НоменклатураНайдена = Истина;
				КоличествоТСД = ТоварИзДокумента.ТСД;
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		Если НоменклатураНайдена Тогда
			ТоварВыпуск.Количество = ТоварВыпуск.Количество - КоличествоТСД;
		КонецЕсли;
		
	КонецЦикла;
	
	СтруктураДляПоиска = Новый Структура("Количество", 0);
	МассивПустыхСтрок = ТаблицаТоваров.НайтиСтроки(СтруктураДляПоиска);
	
	Для каждого СтрокаКУдалению Из МассивПустыхСтрок Цикл 
     	ТаблицаТоваров.Удалить(СтрокаКУдалению); 
    КонецЦикла; 
	
	Возврат ТаблицаТоваров; 
	
КонецФункции

&НаСервереБезКонтекста
функция ПроверкаДокументаПередФормированием(Знач ПроверкаОтсканированныхИзделий = Ложь)
					
	МассивСтатусов = Новый Массив;	
	
	Если ПроверкаОтсканированныхИзделий Тогда
		МассивСтатусов.Добавить(Перечисления.СтатусыТТМОтгрузка.Завершен);
		МассивСтатусов.Добавить(Перечисления.СтатусыТТМОтгрузка.ЗавершенСРасхождениями);
		Запрос = Новый Запрос;
		
		Запрос.Текст = "ВЫБРАТЬ
		               |	ТТМ_ОтгрузкаТоваровВыпущеннаяПродукция.Номенклатура КАК Номенклатура,
		               |	СУММА(ТТМ_ОтгрузкаТоваровВыпущеннаяПродукция.ТСД) КАК ТСД
		               |ИЗ
		               |	Документ.ТТМ_ОтгрузкаТоваров.ВыпущеннаяПродукция КАК ТТМ_ОтгрузкаТоваровВыпущеннаяПродукция
		               |ГДЕ
		               |	ТТМ_ОтгрузкаТоваровВыпущеннаяПродукция.Ссылка.Статус В(&МассивСтатусов)
		               |	И НЕ ТТМ_ОтгрузкаТоваровВыпущеннаяПродукция.Ссылка.ПометкаУдаления
		               |	И ТТМ_ОтгрузкаТоваровВыпущеннаяПродукция.Ссылка.Дата МЕЖДУ &НачалоТекущегоДня И &КонецТекущегоДня
		               |
		               |СГРУППИРОВАТЬ ПО
