#Область ФормированиеРеализации

&НаКлиенте
Процедура Реализация(Команда)
	КлючевыеПоляЗаполнены = ПроверкаЗаполненияКлючевыхПолей(Команда);
	ДокументСсылка = ПроверкаДокументаПередФормированием();
	
	Если Не КлючевыеПоляЗаполнены Тогда
		Возврат;
	ИначеЕсли ДокументСсылка <> Неопределено Тогда
		ПредупреждениеПользователю(ДокументСсылка);
		Возврат;
	КонецЕсли;

	ВопросПользователюПередВыполнениемОперации(Команда);
КонецПроцедуры

&НаКлиенте
Процедура РеализацияВсехЗаказов(Команда)
	ДокументСсылка = ПроверкаДокументаПередФормированием();
	
	Если ДокументСсылка <> Неопределено Тогда
		ПредупреждениеПользователю(ДокументСсылка);
		Возврат;
	КонецЕсли;
	
	ВопросПользователюПередВыполнениемОперации(Команда);
КонецПроцедуры

&НаКлиенте
Процедура СозданиеРеализацияПродолжение(Результат, ДопПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда 
		Возврат; 
	КонецЕсли;                                         
			
	МассивЗаказов = Новый Массив;
	Для Каждого Стр из СписокЗаказовКРеализации Цикл    
		Если Стр.Отметка Тогда 
			МассивЗаказов.Добавить(Стр.ЗаказКлиента);
		КонецЕсли;
	КонецЦикла;               
	Если МассивЗаказов.Количество() > 0 Тогда 
		Для Каждого ЗаказКлиента Из МассивЗаказов Цикл
			ДокументРеализации = ПредопределенноеЗначение("Документ.РеализацияТоваровУслуг.ПустаяСсылка");
			ДокументРеализации = СозданиеРеализацииЗавершение(ЗаказКлиента, Объект.ДатаРеализации);
			РеализацияСформирована = ДокументРеализации <> ПредопределенноеЗначение("Документ.РеализацияТоваровУслуг.ПустаяСсылка");
			УПДРаспечатан = не ПечатьУПД;
			Если ПечатьУПД и РеализацияСформирована Тогда  
				УПДРаспечатан = НапечататьУПД_ПоРеализации(ДокументРеализации);
			КонецЕсли; 
			РезультатВыполнения = РеализацияСформирована и УПДРаспечатан;
		КонецЦикла;	
	Иначе 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Нет заказов с неотгруженными остатками!'"));
	КонецЕсли;
	
	Если РезультатВыполнения Тогда
		ПолучитьСписокЗаказовДляОтгрузки1();
		ПоказатьОповещениеПользователя(
			НСтр("ru = 'АРМ Выпуск и реализация'"),, 
			НСтр("ru = 'Формирование реализаций завершено'"), 
			БиблиотекаКартинок.Информация, 
			СтатусОповещенияПользователя.Информация
		);
	КонецЕсли;
	
КонецПроцедуры   

