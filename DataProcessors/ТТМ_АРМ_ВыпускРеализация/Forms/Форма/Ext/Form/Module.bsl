&НаСервере
функция ОформитьВыпускНаСервере()
	//++Дарвин 18.08.23
	ВыпускСформирован = Ложь;
	//Дарвин 
	
	ИзделиеПоЗаказу = Объект.ЗаказКлиента.Товары.Выгрузить(Новый Структура("Номенклатура, ВариантОбеспечения", Объект.Изделие, Перечисления.ВариантыОбеспечения.КОбеспечению));
	КоличествоПоЗаказуКОбеспечению =  ИзделиеПоЗаказу.Итог("Количество");
	
	ИзделиеПоЗаказу = Объект.ЗаказКлиента.Товары.Выгрузить(Новый Структура("Номенклатура, ВариантОбеспечения", Объект.Изделие, Перечисления.ВариантыОбеспечения.РезервироватьПоМереПоступления));
	КоличествоПоЗаказуРезервПоМереПоступления =  ИзделиеПоЗаказу.Итог("Количество");	
	
	КоличествоПоЗаказу = КоличествоПоЗаказуКОбеспечению + КоличествоПоЗаказуРезервПоМереПоступления;
	
	//*Ганьшина Е. 24.10.2025
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Т.Ссылка КАК Ссылка,
	               |	Т.Номенклатура КАК Номенклатура,
	               |	Т.Назначение КАК Назначение,
	               |	Т.СерийныйНомер КАК СерийныйНомер,
	               |	Т.Количество КАК Количество
	               |ПОМЕСТИТЬ ВТ_Этапы
	               |ИЗ
	               |	&ТабЭтапы КАК Т
	               |ГДЕ
	               |	Т.Отметка = ИСТИНА
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	НоменклатураДополнительныеРеквизиты.Ссылка КАК Ссылка,
	               |	НоменклатураДополнительныеРеквизиты.Свойство КАК Свойство,
	               |	НоменклатураДополнительныеРеквизиты.Значение КАК Значение
	               |ПОМЕСТИТЬ НоменклатураУчитываетсяПоСН
	               |ИЗ
	               |	ВТ_Этапы КАК ВТ_Этапы
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура.ДополнительныеРеквизиты КАК НоменклатураДополнительныеРеквизиты
	               |		ПО ВТ_Этапы.Номенклатура = НоменклатураДополнительныеРеквизиты.Ссылка
	               |ГДЕ
	               |	НоменклатураДополнительныеРеквизиты.Свойство = &ДопРеквизитУчетСерий
	               |	И НоменклатураДополнительныеРеквизиты.Значение = ИСТИНА
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЭтапПроизводства2_2ВыходныеИзделия.Ссылка КАК Ссылка,
	               |	СУММА(ЭтапПроизводства2_2ВыходныеИзделия.Количество) КАК Количество,
	               |	ЕСТЬNULL(НоменклатураУчитываетсяПоСН.Значение, ЛОЖЬ) КАК УчитыватьСерийныйНомера,
	               |	ВТ_Этапы.СерийныйНомер КАК СерийныйНомер
	               |ИЗ
	               |	Документ.ЭтапПроизводства2_2.ВыходныеИзделия КАК ЭтапПроизводства2_2ВыходныеИзделия
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Назначения КАК Назначения
	               |		ПО ЭтапПроизводства2_2ВыходныеИзделия.Назначение = Назначения.Ссылка
	               |		ЛЕВОЕ СОЕДИНЕНИЕ НоменклатураУчитываетсяПоСН КАК НоменклатураУчитываетсяПоСН
	               |		ПО ЭтапПроизводства2_2ВыходныеИзделия.Номенклатура = НоменклатураУчитываетсяПоСН.Ссылка
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Этапы КАК ВТ_Этапы
	               |		ПО ЭтапПроизводства2_2ВыходныеИзделия.Номенклатура = ВТ_Этапы.Номенклатура
	               |			И ЭтапПроизводства2_2ВыходныеИзделия.Назначение = ВТ_Этапы.Назначение
	               |			И ЭтапПроизводства2_2ВыходныеИзделия.Ссылка = ВТ_Этапы.Ссылка
	               |ГДЕ
	               |	НЕ Назначения.ПометкаУдаления
	               |	И ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.Проведен
	               |	И НЕ ЭтапПроизводства2_2ВыходныеИзделия.Отменено
	               |	И НЕ ЭтапПроизводства2_2ВыходныеИзделия.Произведено
	               |	И ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.Статус = &Статус
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЭтапПроизводства2_2ВыходныеИзделия.Ссылка,
	               |	ЕСТЬNULL(НоменклатураУчитываетсяПоСН.Значение, ЛОЖЬ),
	               |	ВТ_Этапы.СерийныйНомер";  
	
	ПараметрыОтбора = Новый Структура("Отметка",Истина);
	МассивЭтапов = ТаблицаЭтапов.Выгрузить(ПараметрыОтбора,"Ссылка").ВыгрузитьКолонку("Ссылка");
