&НаКлиенте
Процедура ДокументыРеализацииПриАктивизацииСтроки(Элемент)
	
	Если ДокументыРеализации.Количество() > 0 Тогда              
		Если Элементы.ДокументыРеализации.ТекущиеДанные <> Неопределено Тогда  
			Реализация = ?(ЗначениеЗаполнено(Элементы.ДокументыРеализации.ТекущиеДанные.Реализация),
						Элементы.ДокументыРеализации.ТекущиеДанные.Реализация,
						ПредопределенноеЗначение("Документ.РеализацияТоваровУслуг.ПустаяСсылка")); 
			Если ЗначениеЗаполнено(Реализация) Тогда 
				СтруктураОтбораПоРеализации = Новый Структура("Реализация",Реализация);
				ОтборПоРеализации = Новый ФиксированнаяСтруктура(СтруктураОтбораПоРеализации); 
				Если Объект.ТЧТоварыРеализации.Количество() > 0 Тогда 
					Элементы.ТЧТоварыРеализации.ОтборСтрок = ОтборПоРеализации;
				КонецЕсли;  
				
				ТекСтрокаТоварыРеализаций = Элементы.ТЧТоварыРеализации.ТекущиеДанные;
				ПерваяСтрокаТоварыРеализаций = Объект.ТЧТоварыРеализации[0].Номенклатура;
				
				ТоварРеализации = ?(ТекСтрокаТоварыРеализаций = Неопределено, ПерваяСтрокаТоварыРеализаций, ТекСтрокаТоварыРеализаций.Номенклатура);
				Номенклатура = ?(ЗначениеЗаполнено(Объект.Изделие), Объект.Изделие, ТоварРеализации);  
				Если ЗначениеЗаполнено(Номенклатура) Тогда
					СтруктураОтботаПоНоменклатуреРеализации = Новый Структура("Номенклатура, Реализация",Номенклатура, Реализация); 
					ОтборПоНоменклатуреРеализации = Новый ФиксированнаяСтруктура(СтруктураОтботаПоНоменклатуреРеализации);
					Если Объект.ТЧТоварыРеализацииССН.Количество()> 0 Тогда 
						Элементы.ТЧТоварыРеализацииССН.ОтборСтрок = ОтборПоНоменклатуреРеализации;
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли; 
		КонецЕсли;
	КонецЕсли;
		
КонецПроцедуры

