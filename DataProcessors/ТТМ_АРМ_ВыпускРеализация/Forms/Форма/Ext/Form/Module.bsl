&НаСервере
Процедура ПолучитьНастройкиИзХранилища()
	КлючНастроек = "Обработка.ТТМ_АРМ_ВыпускРеализация";  // + ПараметрыСеанса.ТекущийПользователь;
	ЗначениеНастроек = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("Обработка.ТТМ_АРМ_ВыпускРеализация", КлючНастроек);
			
	Если ЗначениеНастроек = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru ='Не найден список настроек для проверки цен в заказах'"));
		Возврат;
	КонецЕсли;
			
	Если ТипЗнч(ЗначениеНастроек) = Тип("Соответствие") Тогда
		Для Каждого ТекНастройки Из ЗначениеНастроек Цикл
			Если ТекНастройки.Ключ = "ТаблицаОтбораЦен" Тогда  
				ТаблицаНастроекОтбораЦен = ТекНастройки.Значение;
				ТаблицаОтбораЦен.Загрузить(ТаблицаНастроекОтбораЦен);
			КонецЕсли;
			
			Если ТекНастройки.Ключ = "СписокАдресовДляРассылки" Тогда
				МассивПочтовыхАдресов = ТекНастройки.Значение;
				СписокАдресовДляРассылки.ЗагрузитьЗначения(МассивПочтовыхАдресов);
			КонецЕсли;	
		КонецЦикла;	
	КонецЕсли;		
		
КонецПроцедуры

