 &НаСервере
Процедура СформироватьРеализациюПоЗаказу(ЗаказКлиента)
	
	//Изменим статус обеспечения
	ЗаказОбъект = ЗаказКлиента;
	
	ПереченьВариантов = Новый Массив();
	ПереченьВариантов.Добавить(ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.Отгрузить"));  
	
	Результат = Новый Структура("ПереченьВариантов, ЗаполнятьЦелымиУпаковками");
	Результат.ПереченьВариантов = ПереченьВариантов;
	Результат.ЗаполнятьЦелымиУпаковками = Ложь;
	
	ЗаказИзменен = Ложь; 
	
	ПараметрыВстраивания = Документы.ЗаказКлиента.ДоступныеОстаткиПараметрыВстраивания();
	
	МассивДок = Новый Массив();
	МассивДок.Добавить(ЗаказОбъект);
	
	ПараметрыПроцедуры = Новый Структура();
	
	ПараметрыПроцедуры.Вставить("КодДействия", "ДЕЙСТВИЕ_ОТГРУЗИТЬ");
	ПараметрыЗаполнения = Новый Структура();
	ПараметрыЗаполнения.Вставить("СнятьФлагОтгружатьОднойДатой", Истина);
	ПараметрыЗаполнения.Вставить("ЗаполнитьДатуОтгрузкиОднойДатой", Ложь );
	ПараметрыПроцедуры.Вставить("ПараметрыЗаполнения", ПараметрыЗаполнения);        
	
	ПараметрыПроцедуры.Вставить("Заказы", МассивДок);
	ПараметрыПроцедуры.Вставить("ПараметрыВстраивания", ПараметрыВстраивания);
	
	РезультатВыполненияДействий = ОбеспечениеВДокументахСервер.ВыполнитьДействиеДляЗаказовПослеВопроса(ПараметрыПроцедуры);
	Если РезультатВыполненияДействий.СписокОшибок.Количество() = 0 Тогда  
		СоздатьРеализациюПоЗаказу(ЗаказКлиента);  
	Иначе 
		Сообщить("Не удалось проставить действике ""Отгрузить"" в строках Заказа клиента: " + ЗаказОбъект);
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Выполнение операции'"), УровеньЖурналаРегистрации.Ошибка,,, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецЕсли;
	
КонецПроцедуры  

&НаСервере
Процедура СоздатьРеализациюПоЗаказу(Основание)
	
	МассивСсылок = Новый Массив();
	МассивСсылок.Добавить(Основание);
	ПараметрыОткрытия = СозданиеНаОснованииУТВызовСервера.РеализацияТоваровУслугПараметрыОткрытияФормы(МассивСсылок);
	ДанныеЗаполнения = ПараметрыОткрытия.Основание;
	
	Документ = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
	Документ.Заполнить(ДанныеЗаполнения);
	Документ.Дата = ?(Объект.ДатаРеализации = НачалоДня(ТекущаяДата()), ТекущаяДата(), Объект.ДатаРеализации + 60*60*17);
	
	//***************************************  
	//Если заполнено поле продукция, 
	//удалим из ТЧ Товары строки не соответствующие отбору	
	//Если ЗначениеЗаполнено(Объект.Изделие) и ЗначениеЗаполнено(Объект.Количество) Тогда 
	//	ТЗ_Товары = Документ.Товары.Выгрузить();
	//	КоличествоРеализовано = 0;
	//	
	//	Для Каждого СтрТовары из ТЗ_Товары Цикл 
	//		Если СтрТовары.Номенклатура <> Объект.Изделие Тогда 
	//			ТЗ_Товары.Удалить(СтрТовары);
	//		Иначе  
	//			//уточнить количество и выполнить обработку строки
	//			//Если СтрТовары.Количество < КоличествоРеализовано Тогда 
	//		КонецЕсли;
	//	КонецЦикла;
	//	
	//	Документ.Товары.Загрузить(ТЗ_Товары);
	//КонецЕсли;
	//**************************
	
	Реализация = Документы.РеализацияТоваровУслуг.ПустаяСсылка();
	СоздатьСчетФактуру = Ложь;
	Если Документ.Товары.Количество() > 0 Тогда
		Попытка
			
			НачатьТранзакцию();      
			
			НовыйНомер = ПолучитьСледующийНомерРеализации(Документ.Организация);  
			Если НовыйНомер = 0 Тогда 
				Документ.УстановитьНовыйНомер();                
			Иначе 
				Документ.Номер = НовыйНомер;
			КонецЕсли;
			Документ.Записать(РежимЗаписиДокумента.Проведение);
			
			ЗафиксироватьТранзакцию();
			
			СоздатьСчетФактуру = Истина;
			
		Исключение
			ОтменитьТранзакцию();
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Выполнение операции'"), УровеньЖурналаРегистрации.Ошибка,,, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
    		ВызватьИсключение;
		КонецПопытки;
		
		Если СоздатьСчетФактуру Тогда
			НовыйСчетФактура = Документы.СчетФактураВыданный.СоздатьДокумент();
			ЗаполнитьЗначенияСвойств(НовыйСчетФактура, Документ.Ссылка);
			
			НовыйСчетФактура.ДокументОснование 	= Документ.Ссылка;
			СтрокаОснований = НовыйСчетФактура.ДокументыОснования.Добавить();  
			СтрокаОснований.ДокументОснование 	= Документ.Ссылка;   
			
			НовыйСчетФактура.ЗаполнитьПараметрыСчетаФактурыПоОснованию(Документ.Ссылка);
						
			НовыйСчетФактура.КодВидаОперацииНаУменьшение = "18";
			НовыйСчетФактура.Дата 				= Объект.ДатаРеализации;
			НовыйСчетФактура.ДатаВыставления 	= Объект.ДатаРеализации;
			
			НовыйСчетФактура.Записать(РежимЗаписиДокумента.Проведение);
		КонецЕсли;
		Реализация = Документ.Ссылка;
	Иначе
		Реализация = Документы.РеализацияТоваровУслуг.ПустаяСсылка();
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не удалось сформировать документ реализации. Табличная часть товары пустая.'"));
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Функция ПолучитьСледующийНомерРеализации(Организация)
	
	НовыйНомер = 0;
	Запрос= Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ВЫБОР
	               |		КОГДА ПОДСТРОКА(СчетФактураВыданный.Номер, 0, 2) = ""ЦБ""
	               |			ТОГДА ПОДСТРОКА(СчетФактураВыданный.Номер, 4, 6)
	               |		КОГДА ПОДСТРОКА(СчетФактураВыданный.Номер, 0, 4) = ""00ЦБ""
	               |			ТОГДА ПОДСТРОКА(СчетФактураВыданный.Номер, 6, 7)
	               |		КОГДА ПОДСТРОКА(СчетФактураВыданный.Номер, 0, 4) = ""РБЦБ""
	               |			ТОГДА ПОДСТРОКА(СчетФактураВыданный.Номер, 6, 7)
				   |		КОГДА ПОДСТРОКА(СчетФактураВыданный.Номер, 0, 4) = ""0РЦБ""
	               |			ТОГДА ПОДСТРОКА(СчетФактураВыданный.Номер, 6, 7)
	               |		ИНАЧЕ ""0""
	               |	КОНЕЦ КАК НомерЧисловой,
	               |	СчетФактураВыданный.Номер КАК Номер
	               |ИЗ
	               |	Документ.СчетФактураВыданный КАК СчетФактураВыданный
	               |ГДЕ
	               |	СчетФактураВыданный.Организация = &Организация
	               |	И СчетФактураВыданный.Дата >= НАЧАЛОПЕРИОДА(&ДатаОтгрузки, ГОД)
	               |	И СчетФактураВыданный.Дата <= КОНЕЦПЕРИОДА(&ДатаОтгрузки, ГОД)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	НомерЧисловой УБЫВ
	               |АВТОУПОРЯДОЧИВАНИЕ";    
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ДатаОтгрузки", Объект.ДатаРеализации);
	
	Выборка = Запрос.Выполнить().Выбрать(); 
	
	Если Выборка.Следующий() Тогда 
		МаксНомер = Выборка.Номер;  
		НомерЧисловой = Выборка.НомерЧисловой;
	Иначе 
		МаксНомер = "0";                       
		НомерЧисловой = "0";
	КонецЕсли;
	
	Если МаксНомер = "0" Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Максимальный номер не определён! Нумерация начнётся сначала!'"),,,,);
		Возврат Число(МаксНомер);
	КонецЕсли;
	
	НовыйНомерЧисло = Формат(Число(НомерЧисловой) + 1,"ЧГ=0");
	НовыйНомерСтрока = Строка(НовыйНомерЧисло);
	НовыйНомер = Лев(МаксНомер,СтрДлина(МаксНомер) - СтрДлина(НовыйНомерСтрока)-1) + НовыйНомерСтрока;
	
	Возврат НовыйНомер; 
КонецФункции

