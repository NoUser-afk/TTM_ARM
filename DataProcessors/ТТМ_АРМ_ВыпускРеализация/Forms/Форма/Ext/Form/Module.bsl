#Область ПроверкаУстановленныхЦенВЗаказеКлиента

&НаСервере
Процедура НачатьПроверкуЦенВРеализации()
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Валюта", Справочники.Валюты.НайтиПоНаименованию("руб.", Истина)); 
	ПараметрыОтбора.Вставить("ТЗГраницыИЦены", ТаблицаОтбораЦен.Выгрузить());
	ПараметрыОтбора.Вставить("ДатаНачала", НачалоДня(Объект.ДатаРеализации));
	ПараметрыОтбора.Вставить("ДатаОкончания", КонецДня(Объект.ДатаРеализации));
	ПараметрыОтбора.Вставить("НаДату", КонецДня(Объект.ДатаРеализации)); 
	ПараметрыОтбора.Вставить("ВидЦены", Справочники.ВидыЦен.НайтиПоНаименованию("Фоб", Истина));
	
	ТекущийОбъект = РеквизитФормыВЗначение("Объект");
	ВыгруженнаяТаблица = ТекущийОбъект.ПроверитьУстановленныеЦеныВЗаказеКлиента(ПараметрыОтбора);
	
	Если ВыгруженнаяТаблица.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	НачатьПроверкуЗаписейВРегистреОтправленныхПисем(ВыгруженнаяТаблица);
	
КонецПроцедуры

&НаСервере
Процедура ОтправитьПочтовоеСообщение(ВыгруженнаяТаблица, СписокАдресовДляРассылки)
	ТабДок = ПодготовитьТабличныйДокументДляОтправки(ВыгруженнаяТаблица);
	
	УчетнаяЗаписьОтправителя = Справочники.УчетныеЗаписиЭлектроннойПочты.НайтиПоНаименованию("1C:ТТМ АРМ Выпуск и реализация", Истина);
	Письмо = Новый ИнтернетПочтовоеСообщение;
	Письмо.Тема = "Уведомление из 1С";
	
	Для Каждого ВыбранныйАдрес Из СписокАдресовДляРассылки Цикл 
		Письмо.Получатели.Добавить(ВыбранныйАдрес.Значение);
	КонецЦикла;
		
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("html");
	ТабДок.Записать(ИмяВременногоФайла, ТипФайлаТабличногоДокумента.HTML5);
	Файл = Новый ЧтениеТекста(ИмяВременногоФайла);
	Текст = Файл.Прочитать();
	Письмо.Тексты.Добавить(Текст, ТипТекстаПочтовогоСообщения.HTML);
	Письмо.ОбработатьТексты();
	
    РаботаСПочтовымиСообщениями.ОтправитьПисьмо(УчетнаяЗаписьОтправителя, Письмо);	
КонецПроцедуры

&НаСервере
функция ПодготовитьТабличныйДокументДляОтправки(ВыгруженнаяТаблица)
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.Очистить();
	
	ТекущийОбъект = РеквизитФормыВЗначение("Объект");
	МакетОтчета = ТекущийОбъект.ПолучитьМакет("РасхожденияУстановленныхЦенВЗакахИРеализации_XML");
	
	ОбластьШапка = МакетОтчета.ПолучитьОбласть("Шапка");
	ТабДок.Вывести(ОбластьШапка);
	
	ОбластьРеквизитыТаблицы = МакетОтчета.ПолучитьОбласть("РеквизитыТаблицы");	
	ТабДок.Вывести(ОбластьРеквизитыТаблицы);
	
    ЗначенияРеквизитовТаблицы = МакетОтчета.ПолучитьОбласть("ЗначенияРеквизитовТаблицы");
	
	Для Каждого ТекДанные Из ВыгруженнаяТаблица Цикл		
		ЗначенияРеквизитовТаблицы.Параметры.Заполнить(ТекДанные);
		ТабДок.Вывести(ЗначенияРеквизитовТаблицы);
	КонецЦикла;
	
	ТабДок.ТолькоПросмотр = Истина;
	ТабДок.ОтображатьЗаголовки = Истина;
	ТабДок.ОтображатьСетку = Ложь;

	Возврат ТабДок; 
КонецФункции

// - Проверяем регистр перед отправкой почтового сообщения
&НаСервере
Процедура НачатьПроверкуЗаписейВРегистреОтправленныхПисем(ИсходныйСписокНоменклатуры)
	
	СписокНаОтправкуБезДублей = СформироватьНовуюТаблицуРассылкиБезДублей();
		
	Для Каждого ТекДанные Из ИсходныйСписокНоменклатуры Цикл
		МожемОтправитьПисьмо = ПроверитьЗаписиВРегистреОтправленныхПисем(ТекДанные);
		
		Если МожемОтправитьПисьмо Тогда
			НоваяСтрока = СписокНаОтправкуБезДублей.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекДанные);
		КонецЕсли;
	КонецЦикла;
	
	Если СписокНаОтправкуБезДублей.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ОтправитьПочтовоеСообщение(СписокНаОтправкуБезДублей, СписокАдресовДляРассылки);
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьЗаписиВРегистреОтправленныхПисем(ТекущиеДанные, Знач СоздатьНовыйНаборЗаписей = Ложь, Знач МожемОтправитьПисьмо = Ложь) 
	НазначениеСсылка = Справочники.Назначения.НайтиПоНаименованию(ТекущиеДанные.Заказ);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТТМ_РассылкаЭлектронныхПисем.Период КАК Период,
	               |	ТТМ_РассылкаЭлектронныхПисем.Назначение КАК Назначение,
	               |	ТТМ_РассылкаЭлектронныхПисем.Номенклатура КАК Номенклатура,
	               |	ТТМ_РассылкаЭлектронныхПисем.Статус КАК Статус
	               |ИЗ
	               |	РегистрСведений.ТТМ_РассылкаЭлектронныхПисем КАК ТТМ_РассылкаЭлектронныхПисем
	               |ГДЕ
	               |	ТТМ_РассылкаЭлектронныхПисем.Статус = &Статус
	               |	И ТТМ_РассылкаЭлектронныхПисем.Период = &Период
	               |	И ТТМ_РассылкаЭлектронныхПисем.Назначение = &Назначение
	               |	И НЕ ТТМ_РассылкаЭлектронныхПисем.Назначение.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Назначение", НазначениеСсылка);
	Запрос.УстановитьПараметр("Период", НачалоДня(ТекущаяДата()));
	Запрос.УстановитьПараметр("Статус",  Перечисления.ТТМ_СтатусыОтправленныхПисем.Отправлено);
	 
	СписокРассылок = Запрос.Выполнить().Выгрузить();
	СтруктураОтбора = Новый Структура("Номенклатура", ТекущиеДанные.Номенклатура);
	МассивНайденныхСтрок = СписокРассылок.НайтиСтроки(СтруктураОтбора);

	СоздатьНовыйНаборЗаписей = ?(МассивНайденныхСтрок.Количество() >  0, Ложь, Истина);

	//Создаем новую запись, если не было отправленных писем по данному заказу
	Если СоздатьНовыйНаборЗаписей Тогда
		СделатьЗаписьВРегистрПоПисьму(ТекущиеДанные, НазначениеСсылка);
		МожемОтправитьПисьмо = Истина;
	КонецЕсли;
	
	Возврат МожемОтправитьПисьмо;	
КонецФункции

&НаСервереБезКонтекста
Процедура СделатьЗаписьВРегистрПоПисьму(ТекущиеДанные, НазначениеСсылка) 
	
	НаборЗаписей = РегистрыСведений.ТТМ_РассылкаЭлектронныхПисем.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Назначение.Установить(НазначениеСсылка); 
	НаборЗаписей.Отбор.Номенклатура.Установить(ТекущиеДанные.Номенклатура);
	
	НоваяЗапись = НаборЗаписей.Добавить();	
	НоваяЗапись.Период = ТекущаяДатаСеанса();
	НоваяЗапись.Назначение = НазначениеСсылка;
	НоваяЗапись.Номенклатура = ТекущиеДанные.Номенклатура;
	НоваяЗапись.Статус = Перечисления.ТТМ_СтатусыОтправленныхПисем.Отправлено;
		
	Попытка
		НачатьТранзакцию();
		НаборЗаписей.Записать(Истина);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Ошибка записи отправленного письма: '") + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СформироватьНовуюТаблицуРассылкиБезДублей()
	СписокНаОтправкуБезДублей = Новый ТаблицаЗначений;
	СписокНаОтправкуБезДублей.Колонки.Добавить("Заказ", Новый ОписаниеТипов("Строка"));
	СписокНаОтправкуБезДублей.Колонки.Добавить("Реализация", Новый ОписаниеТипов("ДокументСсылка.РеализацияТоваровУслуг"));
	СписокНаОтправкуБезДублей.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	СписокНаОтправкуБезДублей.Колонки.Добавить("Валюта", Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	СписокНаОтправкуБезДублей.Колонки.Добавить("ВидЦены", Новый ОписаниеТипов("СправочникСсылка.ВидыЦен"));
	СписокНаОтправкуБезДублей.Колонки.Добавить("ДатаОтгрузки", Новый ОписаниеТипов("Дата"));
	СписокНаОтправкуБезДублей.Колонки.Добавить("ПроцентОтличия", Новый ОписаниеТипов("Число"));
	СписокНаОтправкуБезДублей.Колонки.Добавить("Разница", Новый ОписаниеТипов("Число"));
	СписокНаОтправкуБезДублей.Колонки.Добавить("УстановкаЦен", Новый ОписаниеТипов("ДокументСсылка.УстановкаЦенНоменклатуры"));
	СписокНаОтправкуБезДублей.Колонки.Добавить("ЦенаРеализации", Новый ОписаниеТипов("Число"));
	СписокНаОтправкуБезДублей.Колонки.Добавить("ЦенаУстановленная", Новый ОписаниеТипов("Число"));
	
	Возврат СписокНаОтправкуБезДублей;
КонецФункции

#КонецОбласти


