КонецФункции

&НаКлиенте
Функция ДР_ТекущиеДанныеЭтапаДляQR() Экспорт
	Данные = Элементы.ТаблицаЭтапов.ТекущиеДанные;
	Возврат ДР_СформироватьСтруктуруЭтапаДляQR(Данные);
КонецФункции

&НаКлиенте
Функция ДР_ОтмеченныеДанныеЭтаповДляQR() Экспорт
	Результат = Новый Массив;
	Таблица = ТаблицаЭтапов;

	Если Таблица = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Для каждого Стр Из Таблица Цикл
		Если Стр.Отметка <> Истина Тогда
			Продолжить;
		КонецЕсли;

		СтруктураСтроки = ДР_СформироватьСтруктуруЭтапаДляQR(Стр);
		Если СтруктураСтроки <> Неопределено Тогда
			Результат.Добавить(СтруктураСтроки);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;
КонецФункции

&НаКлиенте
Функция ПолучитьНомерЗаказаИДату(Стр) Экспорт

	Представление = "";
	Попытка
		Представление = Строка(Стр.Назначение);
	Исключение
		Представление = "";
	КонецПопытки;

	Части = СтрРазделить(Представление, ",");

	Номер = "";
	Дата  = "";

	Если Части.Количество() >= 1 Тогда
		Номер = СокрЛП(Части.Получить(0));
	КонецЕсли;

	Если Части.Количество() >= 2 Тогда
		Дата = СокрЛП(Части.Получить(1));
	КонецЕсли;

	Возврат Новый Структура("Номер,Дата", Номер, Дата);

КонецФункции

&НаКлиенте
Функция ДР_СформироватьСтруктуруЭтапаДляQR(СтрокаИсточник) Экспорт
	Если СтрокаИсточник = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Рез = Новый Структура;

	// Обязательное
	Попытка
		Рез.Вставить("Номенклатура", СтрокаИсточник.Номенклатура);
	Исключение
		Рез.Вставить("Номенклатура", Неопределено);
	КонецПопытки;

	// Опциональные
	Попытка Рез.Вставить("СерийныйНомер", СтрокаИсточник.СерийныйНомер); Исключение Рез.Вставить("СерийныйНомер",""); КонецПопытки;
	Попытка Рез.Вставить("Количество", СтрокаИсточник.Количество); Исключение Рез.Вставить("Количество",1); КонецПопытки;

	// Заказ/дата
	ДатаНомер = ПолучитьНомерЗаказаИДату(СтрокаИсточник);
	Рез.Вставить("Назначение",     ДатаНомер.Номер);
	Рез.Вставить("ДатаНазначения", ДатаНомер.Дата);

	Возврат Рез;
КонецФункции

