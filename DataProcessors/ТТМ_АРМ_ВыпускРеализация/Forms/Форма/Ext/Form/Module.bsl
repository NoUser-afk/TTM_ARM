&НаСервере
Процедура ИзменитьЭтапы(ДокЭтапы)
	
	ОсталосьВыпустить = Объект.Количество;
	
	Для каждого Док из ДокЭтапы Цикл 
		//+Ганьшина Е. 24.10.2025
		Если Док.УчитыватьСерийныйНомера и не ЗначениеЗаполнено(Док.Серийныйномер) Тогда 
			Сообщить("Не указан серийный номер продукции " + Док.Номенклатура + Символы.ПС + "Выпуск не офромлен! " + Док.Ссылка);
			Возврат;
		КонецЕсли;
		//-
		
		ДокОбъект = Док.Ссылка.ПолучитьОбъект();
		НайденныеСтроки = ДокОбъект.ВыходныеИзделия.НайтиСтроки(Новый Структура("Номенклатура", Объект.Изделие));
		
		Для Каждого Стр из НайденныеСтроки Цикл   
			Если ОсталосьВыпустить >= Стр.Количество Тогда
				Стр.Произведено = Истина;
				Стр.ДатаПроизводства = Объект.ДатаВыпуска;
				ОсталосьВыпустить = ОсталосьВыпустить - Стр.Количество;
			Иначе
				Прервать;
			КонецЕсли;
		КонецЦикла;
		ДокОбъект.КоличествоУпаковокФакт  = 0.5;
		
		ЭтапОбновлен = Ложь;
		Попытка
			УстановитьПривилегированныйРежим(Истина);
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
			УстановитьПривилегированныйРежим(Ложь);
			ЭтапОбновлен = Истина;
		Исключение
			Сообщить("Не удалось изменить документ " + ДокОбъект.Номер + " от " + ДокОбъект.Дата);
			
			// Запись события в журнал регистрации для системного администратора.
	    	ЗаписьЖурналаРегистрации(
				НСтр("ru = 'Выполнение операции'"),
				УровеньЖурналаРегистрации.Ошибка,,, 
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	    	ВызватьИсключение;
		КонецПопытки;
		
		Если ЭтапОбновлен Тогда
			КОтгрузке = КОтгрузке + СоздатьПередачуПродукцииНаСклад(ДокОбъект);
		КонецЕсли;
		
		Если ОсталосьВыпустить <= 0 Тогда
			Прервать;
		КонецЕсли
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция СоздатьПередачуПродукцииНаСклад(Этап)
	
	МассивСсылок = Новый Массив();
	МассивСсылок.Добавить(Этап.Ссылка);
	ПараметрыОткрытия = СозданиеНаОснованииУТВызовСервера.ПараметрыОткрытияФормыНакладнойНаОснованииЗаказа(МассивСсылок,
		"ДвижениеПродукцииИМатериалов", ПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.ПередачаПродукцииИзПроизводства"));
	ДанныеЗаполнения = ПараметрыОткрытия.ПараметрыФормы.Основание;
	
	Документ = Документы.ДвижениеПродукцииИМатериалов.СоздатьДокумент();
	Документ.Заполнить(ДанныеЗаполнения);
	Документ.Дата = Объект.ДатаВыпуска;
	
	Попытка
		НачатьТранзакцию();
		Документ.Записать(РежимЗаписиДокумента.Проведение);
		ЗафиксироватьТранзакцию();
		
		Возврат Документ.Товары.Итог("Количество");
	Исключение
		ОтменитьТранзакцию();
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("'Ошибка во время проведения документа: '") + Документ + " " + ОписаниеОшибки());
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Выполнение операции'"), УровеньЖурналаРегистрации.Ошибка,,, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
		Возврат 0;
	КонецПопытки;
	
КонецФункции

#КонецОбласти


