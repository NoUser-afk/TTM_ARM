#Область ТЧОстаткиСерий 
&НаКлиенте
Процедура ОтгрузкаВыбранныхСерийСХранения(Команда) //////////////////////////////// Команда, вызывает диалог подтверждения и собирает помеченные строки в массив структур

	Если ТЧОстаткиСерий = Неопределено Тогда
		Сообщить("Нет данных для отгрузки."); 
		Возврат;
	КонецЕсли;

	// Соберём выбранные строки
	Выбранные = Новый Массив;
	Для Каждого Стр Из ТЧОстаткиСерий Цикл
		Если Стр.Отметка Тогда
			Кол = ?(ЗначениеЗаполнено(Стр.Количество) И Стр.Количество > 0, Стр.Количество, 1);
			Выбранные.Добавить(Новый Структура(
				"Номенклатура,Характеристика,СерийныйНомер,Количество,ДокументРегистратор,Назначение,Склад,ТипСтроки",
				Стр.Номенклатура, Стр.Характеристика, Стр.СерийныйНомер, Кол, Стр.Ссылка, Стр.Назначение, Стр.Склад, Стр.ТипСтроки));
		КонецЕсли;
	КонецЦикла;

	Если Выбранные.Количество() = 0 Тогда
		Сообщить("Не выбрано ни одной строки.");
		Возврат;
	КонецЕсли;

	// Подтверждение (немодально) - Параметр передаём 3-м аргументом конструктора
	ТекстВопроса = "Сформировать отгрузку по выбранным товарам?";
	Оповещение = Новый ОписаниеОповещения("Отгрузка_ПослеПодтверждения", ЭтотОбъект, Выбранные);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 0, КодВозвратаДиалога.Нет, "Подтверждение");

КонецПроцедуры


&НаКлиенте
Процедура Отгрузка_ПослеПодтверждения(Результат, Параметр) Экспорт //////////////// Обработка выборка диалога. В зависимости от выбора либо генерация документа либо сообщение
	
	// "Параметр" - это тот самый массив "Выбранные", переданный в ОписаниеОповещения

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Сообщить("Операция отменена пользователем.");
		Возврат;
	КонецЕсли;

	Если Параметр = Неопределено Тогда
		Сообщить("Не удалось получить выбранные строки.");
		Возврат;
	КонецЕсли;

	Выбранные = Параметр;

	// Сервер создаст непроведенный документ отгрузки
	Попытка
		СозданныеДокументы = СоздатьИПровестиОтгрузкуСХраненияСервер(Выбранные);
	Исключение
		Сообщить("Ошибка при создании отгрузки: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	Если СозданныеДокументы = Неопределено Или СозданныеДокументы.Количество() = 0 Тогда
		Сообщить("Документы отгрузки не были созданы.");
		Возврат;
	КонецЕсли;

	// соберём номера документов
	Номера = Новый Массив;
	Для Каждого ДокСсылка Из СозданныеДокументы Цикл
		Ном = "";
		Попытка
			Ном = ДокСсылка.Номер;
		Исключение
			Ном = Строка(ДокСсылка);
		КонецПопытки;
		Если ПустаяСтрока(Ном) Тогда Ном = Строка(ДокСсылка); КонецЕсли;
		Номера.Добавить(Ном);
	КонецЦикла;

	М = Новый СообщениеПользователю;
	М.Текст = "Создан документ отгрузки: № " + СтрСоединить(Номера, ", № ");
	М.Сообщить();

	Попытка
		ПараметрыОткрытия = Новый Структура("Ключ", СозданныеДокументы[0]);
		ОткрытьФорму("Документ.ОтгрузкаТоваровСХранения.ФормаДокумента", ПараметрыОткрытия, ЭтаФорма);
	Исключение
		ОписаниеОшибкиОткрытия = ОписаниеОшибки();
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьДокументыОтгрузкиСХранения(Команда)
	
	ОткрытьФорму("Документ.ОтгрузкаТоваровСХранения.ФормаСписка", , ЭтаФорма);
	
КонецПроцедуры


&НаКлиенте
Процедура ПриСозданииНаКлиенте(Отказ) ///////////////////////////////////////////// Микропроверка чтобы гарантировать нужные колонки
    // Реквизит ТЧ гарантированно существует (мы добавили его на форме)
	// Но подстрахуем колонки, если реквизит пустой
    Если ТЧОстаткиСерий = Неопределено Тогда
        // динамический конструктор, чтобы тонкий клиент не ругался
        Попытка
            ТЧОстаткиСерий = Новый("ТаблицаЗначений");
        Исключение
            ТЧОстаткиСерий = Новый("ValueTable");
        КонецПопытки;
    КонецЕсли;

    // Колонки
    Если ТЧОстаткиСерий.Колонки.Найти("Номенклатура") = Неопределено Тогда ТЧОстаткиСерий.Колонки.Добавить("Номенклатура"); КонецЕсли;
    Если ТЧОстаткиСерий.Колонки.Найти("СерийныйНомер") = Неопределено Тогда ТЧОстаткиСерий.Колонки.Добавить("СерийныйНомер"); КонецЕсли;
    Если ТЧОстаткиСерий.Колонки.Найти("Количество") = Неопределено Тогда ТЧОстаткиСерий.Колонки.Добавить("Количество"); КонецЕсли;
    Если ТЧОстаткиСерий.Колонки.Найти("Назначение") = Неопределено Тогда ТЧОстаткиСерий.Колонки.Добавить("Назначение"); КонецЕсли;
    Если ТЧОстаткиСерий.Колонки.Найти("Склад") = Неопределено Тогда ТЧОстаткиСерий.Колонки.Добавить("Склад"); КонецЕсли;
    Если ТЧОстаткиСерий.Колонки.Найти("Характеристика") = Неопределено Тогда ТЧОстаткиСерий.Колонки.Добавить("Характеристика"); КонецЕсли;
    Если ТЧОстаткиСерий.Колонки.Найти("ТипСтроки") = Неопределено Тогда ТЧОстаткиСерий.Колонки.Добавить("ТипСтроки"); КонецЕсли;

КонецПроцедуры


&НаСервереБезКонтекста
Функция ПолучитьСерииНаОстаткеМС(НаДату = Неопределено) // Получение актуальных данных по остаткам серий номенклатуры на дату

	Если НаДату = Неопределено Тогда НаДату = ТекущаяДатаСеанса(); КонецЕсли;

    ТекстЗапроса = "ВЫБРАТЬ РАЗЛИЧНЫЕ
    |    Рег.Регистратор           КАК ДокументРегистратор,
    |    Ост.Склад                 КАК Склад,
    |    Ост.Номенклатура          КАК Номенклатура,
    |    Ост.Назначение            КАК Назначение,
    |    Ост.СерийныйНомер         КАК СерийныйНомер,
    |    Ост.КоличествоОстаток     КАК Количество
    |ИЗ
    |    РегистрНакопления.ТТМ_УчетСерийныхНомеровПродукции.Остатки(&НаДату) КАК Ост
    |        ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ТТМ_УчетСерийныхНомеровПродукции КАК Рег
    |        ПО Рег.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
    |           И Рег.Регистратор ССЫЛКА Документ.ПриемкаТоваровНаХранение
    |           И Рег.Склад = Ост.Склад
    |           И Рег.Номенклатура = Ост.Номенклатура
    |           И Рег.Назначение = Ост.Назначение
    |           И Рег.СерийныйНомер = Ост.СерийныйНомер
    |ГДЕ
    |    Ост.КоличествоОстаток > 0
    |УПОРЯДОЧИТЬ ПО
    |    Ост.Номенклатура, Ост.СерийныйНомер";

    Запрос = Новый Запрос(ТекстЗапроса);
    Запрос.УстановитьПараметр("НаДату", КонецДня(НаДату));

    ТЗ = Запрос.Выполнить().Выгрузить();

    // конвертируем в массив структур (XDTO-safe)
    Рез = Новый Массив;
	Для Каждого Р Из ТЗ Цикл
        Рез.Добавить(Новый Структура(
            "Ссылка,Номенклатура,Характеристика,СерийныйНомер,Количество,Назначение,Склад,ТипСтроки",
            Р.ДокументРегистратор, Р.Номенклатура, Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка(), Р.СерийныйНомер, Р.Количество, Р.Назначение, Р.Склад, "Серия"));
    КонецЦикла;

	Возврат Рез;
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьОстаткиОбычныхТоваровСХранения()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПриемкаТовары.Ссылка КАК Регистратор,
	|	ПриемкаТовары.Склад КАК Склад,
	|	ПриемкаТовары.Номенклатура КАК Номенклатура,
	|	ПриемкаТовары.Характеристика КАК Характеристика,
	|	ПриемкаТовары.Назначение КАК Назначение,
	|	СУММА(ПриемкаТовары.Количество) - ЕСТЬNULL(Отгрузки.Количество, 0) КАК Количество
	|ИЗ
	|	Документ.ПриемкаТоваровНаХранение.Товары КАК ПриемкаТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ОтгрузкаТовары.ДокументПоступления КАК ДокументПоступления,
	|			ОтгрузкаТовары.Склад КАК Склад,
	|			ОтгрузкаТовары.Номенклатура КАК Номенклатура,
	|			ОтгрузкаТовары.Характеристика КАК Характеристика,
	|			ОтгрузкаТовары.Назначение КАК Назначение,
	|			СУММА(ОтгрузкаТовары.Количество) КАК Количество
	|		ИЗ
	|			Документ.ОтгрузкаТоваровСХранения.Товары КАК ОтгрузкаТовары
	|		ГДЕ
	|			НЕ ОтгрузкаТовары.Ссылка.ПометкаУдаления
	|			И ОтгрузкаТовары.ДокументПоступления <> ЗНАЧЕНИЕ(Документ.ПриемкаТоваровНаХранение.ПустаяСсылка)
	|			И СОКРЛП(ОтгрузкаТовары.СерийныйНомер) = """"
	|		СГРУППИРОВАТЬ ПО
	|			ОтгрузкаТовары.ДокументПоступления,
	|			ОтгрузкаТовары.Склад,
	|			ОтгрузкаТовары.Номенклатура,
	|			ОтгрузкаТовары.Характеристика,
	|			ОтгрузкаТовары.Назначение) КАК Отгрузки
	|		ПО ПриемкаТовары.Ссылка = Отгрузки.ДокументПоступления
	|			И ПриемкаТовары.Склад = Отгрузки.Склад
	|			И ПриемкаТовары.Номенклатура = Отгрузки.Номенклатура
	|			И ПриемкаТовары.Характеристика = Отгрузки.Характеристика
	|			И ПриемкаТовары.Назначение = Отгрузки.Назначение
	|ГДЕ
	|	ПриемкаТовары.Ссылка.Проведен
	|	И НЕ ПриемкаТовары.Ссылка.ПометкаУдаления
	|	И ПриемкаТовары.Количество > 0
	|	И ЕСТЬNULL(ПриемкаТовары.Номенклатура.ВидНоменклатуры.ИспользоватьСерии, ЛОЖЬ) = ЛОЖЬ
	|СГРУППИРОВАТЬ ПО
	|	ПриемкаТовары.Ссылка,
	|	ПриемкаТовары.Склад,
	|	ПриемкаТовары.Номенклатура,
	|	ПриемкаТовары.Характеристика,
	|	ПриемкаТовары.Назначение,
	|	Отгрузки.Количество
	|ИМЕЮЩИЕ
	|	СУММА(ПриемкаТовары.Количество) - ЕСТЬNULL(Отгрузки.Количество, 0) > 0
	|УПОРЯДОЧИТЬ ПО
	|	ПриемкаТовары.Номенклатура,
	|	ПриемкаТовары.Характеристика,
	|	ПриемкаТовары.Ссылка";

	ТЗ = Запрос.Выполнить().Выгрузить();
	Рез = Новый Массив;
	Для Каждого СтрокаРезультата Из ТЗ Цикл
		Рез.Добавить(Новый Структура(
			"Ссылка,Склад,Номенклатура,Характеристика,Назначение,СерийныйНомер,Количество,ТипСтроки",
			СтрокаРезультата.Регистратор,
			СтрокаРезультата.Склад,
			СтрокаРезультата.Номенклатура,
			СтрокаРезультата.Характеристика,
			СтрокаРезультата.Назначение,
			"",
			СтрокаРезультата.Количество,
			"Товар"));
	КонецЦикла;

	Возврат Рез;
КонецФункции

&НаСервере
Процедура ЗаполнитьТЧОстаткиСерий(ДанныеСерий)
	ТЧОстаткиСерий.Очистить();

	Для Каждого Р Из ДанныеСерий Цикл
		Стр = ТЧОстаткиСерий.Добавить();
		Стр.Ссылка = Р.Ссылка;
		Попытка
			Стр.Склад = Р.Склад;
		Исключение
			ОписаниеОшибкиСкладаТЧ = ОписаниеОшибки();
		КонецПопытки;
		Стр.Номенклатура = Р.Номенклатура;
		Попытка
			Стр.Характеристика = Р.Характеристика;
		Исключение
			ОписаниеОшибкиХарактеристикиТЧ = ОписаниеОшибки();
		КонецПопытки;
		Попытка
			Стр.Назначение = Р.Назначение;
		Исключение
			ОписаниеОшибкиНазначенияТЧ = ОписаниеОшибки();
		КонецПопытки;
		Стр.СерийныйНомер = Р.СерийныйНомер;
		Стр.Количество = Р.Количество;
		Стр.ТипСтроки = Р.ТипСтроки;
	КонецЦикла;

	Попытка
		Эл = ЭтаФорма.ЭлементыФормы.Найти("ТЧОстаткиСерий");
		Если Эл <> Неопределено Тогда
			Эл.Обновить();
		КонецЕсли;
	Исключение
		ОписаниеОшибкиОбновленияТЧОстатков = ОписаниеОшибки();
	КонецПопытки;
КонецПроцедуры


&НаСервере
Процедура ОбновитьОстаткиСерий() /////////////////////////////////////////////////// Просто обновление таблиичной части аКа "F5"
	
	ДанныеМС = ПолучитьСерииНаОстаткеМС(ТекущаяДатаСеанса());
	ОбычныеТовары = ПолучитьОстаткиОбычныхТоваровСХранения();
	Для Каждого СтрокаОбычногоТовара Из ОбычныеТовары Цикл
		ДанныеМС.Добавить(СтрокаОбычногоТовара);
	КонецЦикла;
	ЗаполнитьТЧОстаткиСерий(ДанныеМС);
		
КонецПроцедуры


&НаКлиенте
Процедура ВыделитьВсе(Команда) ///////////////////////////////////////////////////// Поставить истина на всех строках в ТЧОстаткиСерий
	
	Если ТЧОстаткиСерий = Неопределено Тогда Возврат; КонецЕсли;

	// самый быстрый способ - метод ТаблицаЗначений.ЗаполнитьЗначения
	// (заполняет указанной константой только заданную колонку)
	Попытка
		// работает и с именем колонки, и с объектом колонки
		ТЧОстаткиСерий.ЗаполнитьЗначения(Истина, "Отметка");
	Исключение
		// запасной вариант - просто цикл по строкам
		Для Каждого Стр Из ТЧОстаткиСерий Цикл
			Стр.Отметка = Истина;
		КонецЦикла;
	КонецПопытки;

	// обновим визуальный элемент (если он есть на форме)
	Попытка
		Эл = ЭтаФорма.ЭлементыФормы.Найти("ТЧОстаткиСерий");
		Если Эл <> Неопределено Тогда Эл.Обновить(); КонецЕсли;
	Исключение
		ОписаниеОшибкиОбновленияВыделения = ОписаниеОшибки();
	КонецПопытки;

КонецПроцедуры


&НаКлиенте
Процедура СнятьВыделение(Команда) ////////////////////////////////////////////////// Обратное действие к выделению

	Попытка
		ТЧОстаткиСерий.ЗаполнитьЗначения(Ложь, "Отметка");
	Исключение
