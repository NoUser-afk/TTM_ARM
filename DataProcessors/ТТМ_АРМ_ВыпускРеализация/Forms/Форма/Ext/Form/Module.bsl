Функция ПроверитьИУдалитьЕслиЕстьКомплекты(ТаблицаТоваров, Знач СоответствиеНаименования = "Комплект", Знач Начало = -1)
	МассивТоваровБезШтрихкода = Новый Массив;	
	ТаблицаТоваров.Колонки.Добавить("Удалить");
	
	Для Каждого ТекТовар Из ТаблицаТоваров Цикл
		НоменклатураСсылка = ТекТовар.Номенклатура;
		ДанныеПоиска = СтрНайти(НРег(НоменклатураСсылка.Наименование), НРег(СоответствиеНаименования), НаправлениеПоиска.СНачала);
		
		Если ДанныеПоиска > 0 Тогда
			Штрихкод = ТТМ_ДанныеВыбораСервер.ПолучитьШтрихкод(НоменклатураСсылка);
			
			Если Штрихкод = "" Тогда
				ТекТовар.Удалить = Истина;
				МассивТоваровБезШтрихкода.Добавить(НоменклатураСсылка);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если МассивТоваровБезШтрихкода.Количество() > 0 Тогда
		Индекс = ТаблицаТоваров.Количество() -1;
		Пока Индекс > Начало Цикл
			ТекСтрока = ТаблицаТоваров.Получить(Индекс);
						
			Если ТекСтрока.Удалить = Истина Тогда  
				ТаблицаТоваров.Удалить(Индекс);
			КонецЕсли;
			
			Индекс = Индекс - 1;
		КонецЦикла;
	КонецЕсли;
	
	ТаблицаТоваров.Колонки.Удалить("Удалить");	
	Возврат ТаблицаТоваров; 
КонецФункции

