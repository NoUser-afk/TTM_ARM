&НаКлиенте
Процедура ПечатьСерийныхНомеров(Команда)
	
	ПроверкаВыполнена = ПроверкаЗаполненияКлючевыхПолей(Команда);
	
	Если Не ПроверкаВыполнена Тогда 
		Возврат;
	КонецЕсли;
	
	//23.06.2025           
	
	ПараметрыПоиска = Новый Структура("Отметка",Истина);
	МассивСтрок = ТаблицаЭтапов.НайтиСтроки(ПараметрыПоиска); 
	Если МассивСтрок.Количество() = 0 Тогда    
		ДанныеТекущейСтроки = Элементы.ТаблицаЭтапов.ТекущиеДанные;
		Если не ДанныеТекущейСтроки = Неопределено Тогда 
			МассивСтрок.Добавить(ДанныеТекущейСтроки);
		КонецЕсли;
		//Сообщить("Не выбраны этапы для печати серийных номеров!");
		//Возврат;
	КонецЕсли;  
	
	МассивСН = Новый Массив;
	Для Каждого Стр из МассивСтрок Цикл 
		МассивСН.Добавить(Стр.СерийныйНомер);
	КонецЦикла; 
	Если МассивСН.Количество() = 0 Тогда 
		Сообщить("Отсутствуют Серийные номера для печати штрихкода");
		Возврат
	КонецЕсли;
		
		
		
	
	СтруктураПечати = ПолучитьСтруктуруПечати(Объект.Изделие, Объект.Количество, КоличествоЭтикетокДляПечати, МассивСН, 2);
	
	МассивОбъектов = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Объект.Изделие);
	ИменаМакетов = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве("ЭтикеткаТовары");	                                      
	
	//23.06.2025
	//СтруктураПечати = ПолучитьСтруктуруПечати(МассивОбъектов, Объект.Количество, КоличествоЭтикетокДляПечати, МассивЭтапов);
	//-
		
	УправлениеПечатьюКлиент.ВыполнитьКомандуПечати(
		"Обработка.ПечатьЭтикетокИЦенников",
		ИменаМакетов,
		МассивОбъектов,
		ЭтаФорма,
		СтруктураПечати
	);   
	
КонецПроцедуры

