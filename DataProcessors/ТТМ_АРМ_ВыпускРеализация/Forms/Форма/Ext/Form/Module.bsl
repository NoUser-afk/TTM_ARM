	               |		ЛЕВОЕ СОЕДИНЕНИЕ ОтгруженоПоНазначениям КАК ОтгруженоПоНазначениям
	               |		ПО ТоварыОткрытыхЗаказов.Номенклатура = ОтгруженоПоНазначениям.Номенклатура
	               |			И ТоварыОткрытыхЗаказов.Назначение = ОтгруженоПоНазначениям.Назначение
	               |			И ТоварыОткрытыхЗаказов.Склад = ОтгруженоПоНазначениям.Склад
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВыпущенныеТоварыПоНазначениям КАК ВыпущенныеТоварыПоНазначениям
	               |		ПО ТоварыОткрытыхЗаказов.Номенклатура = ВыпущенныеТоварыПоНазначениям.Номенклатура
	               |			И ТоварыОткрытыхЗаказов.Назначение = ВыпущенныеТоварыПоНазначениям.Назначение
	               |			И ТоварыОткрытыхЗаказов.Склад = ВыпущенныеТоварыПоНазначениям.Склад
	               |ГДЕ
	               |	ЕСТЬNULL(ОтгруженоПоНазначениям.Количество, 0) < ЕСТЬNULL(ВыпущенныеТоварыПоНазначениям.Количество, 0)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ИСТИНА КАК Отметка,
	               |	ТоварыОткрытыхЗаказов.Номенклатура КАК Номенклатура,
	               |	ТоварыОткрытыхЗаказов.Назначение КАК Назначение,
	               |	ЕСТЬNULL(ТТМ_УчетСерийныхНомеровПродукцииОстатки.СерийныйНомер, """") КАК СерийныйНомер,
	               |	ВЫБОР
	               |		КОГДА ЕСТЬNULL(ТТМ_УчетСерийныхНомеровПродукцииОстатки.СерийныйНомер, """") = """"
	               |			ТОГДА ЕСТЬNULL(ВыпущенныеТоварыПоНазначениям.Количество, 0) - ЕСТЬNULL(ОтгруженоПоНазначениям.Количество, 0)
	               |		ИНАЧЕ 1
	               |	КОНЕЦ КАК Количество
	               |ИЗ
	               |	ТоварыОткрытыхЗаказов КАК ТоварыОткрытыхЗаказов
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ОтгруженоПоНазначениям КАК ОтгруженоПоНазначениям
	               |		ПО ТоварыОткрытыхЗаказов.Номенклатура = ОтгруженоПоНазначениям.Номенклатура
	               |			И ТоварыОткрытыхЗаказов.Назначение = ОтгруженоПоНазначениям.Назначение
	               |			И ТоварыОткрытыхЗаказов.Склад = ОтгруженоПоНазначениям.Склад
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВыпущенныеТоварыПоНазначениям КАК ВыпущенныеТоварыПоНазначениям
	               |		ПО ТоварыОткрытыхЗаказов.Номенклатура = ВыпущенныеТоварыПоНазначениям.Номенклатура
	               |			И ТоварыОткрытыхЗаказов.Назначение = ВыпущенныеТоварыПоНазначениям.Назначение
	               |			И ТоварыОткрытыхЗаказов.Склад = ВыпущенныеТоварыПоНазначениям.Склад
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТТМ_УчетСерийныхНомеровПродукции.Остатки(, Произведено) КАК ТТМ_УчетСерийныхНомеровПродукцииОстатки
	               |		ПО ТоварыОткрытыхЗаказов.Номенклатура = ТТМ_УчетСерийныхНомеровПродукцииОстатки.Номенклатура
	               |			И ТоварыОткрытыхЗаказов.Назначение = ТТМ_УчетСерийныхНомеровПродукцииОстатки.Назначение
	               |			И ТоварыОткрытыхЗаказов.Склад = ТТМ_УчетСерийныхНомеровПродукцииОстатки.Склад
	               |ГДЕ
	               |	ЕСТЬNULL(ОтгруженоПоНазначениям.Количество, 0) < ЕСТЬNULL(ВыпущенныеТоварыПоНазначениям.Количество, 0)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Назначение,
	               |	Номенклатура,
	               |	СерийныйНомер
	               |АВТОУПОРЯДОЧИВАНИЕ";
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	Заказы = МассивРезультатов[3].Выгрузить();
	Товары = МассивРезультатов[4].Выгрузить();
	
	СписокЗаказовКРеализации.Загрузить(Заказы);
	Объект.ТЧВыпущенныеТоварыЗаказов.Загрузить(Товары);
	
КонецПроцедуры

