&НаСервере
Функция ДР_СформироватьТабДокQRПакетомНаСервере(МассивСтрок, ОдинQRНаУпаковку = Ложь) Экспорт
	Возврат ТТМ_QRПечатьСервер.СформироватьТабличныйДокументQRПакет(МассивСтрок, ОдинQRНаУпаковку);
КонецФункции

&НаКлиенте
Процедура АРМ1_ПечатьQRПосле(Команда) // N Этикеток с 1 единиц 
	// Основная кнопка: поштучно
	ДР_ПечатьQR(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура АРМ1_ПечатьQRУпаковка(Команда) // 1 Этикетка с N единиц
	// Вторая кнопка: 1 QR на упаковку
	ДР_ПечатьQR(Истина);
КонецПроцедуры

&НаКлиенте
Процедура ДР_ПечатьQR(ОдинQRНаУпаковку) // Отсюда запускается вся логика, параметр - истина или булево от кнопок
	
	МассивСтрок = ДР_ОтмеченныеДанныеЭтаповДляQR();
	
	Если МассивСтрок.Количество() > 0 Тогда
		
		ТабДок = ДР_СформироватьТабДокQRПакетомНаСервере(МассивСтрок, ОдинQRНаУпаковку);
		
		ОбъектыПечати = Новый СписокЗначений;
		Для каждого Стр Из МассивСтрок Цикл
			Если Стр.Номенклатура <> Неопределено Тогда
				ОбъектыПечати.Добавить(Стр.Номенклатура);
			КонецЕсли;
		КонецЦикла;
		
	Иначе
		
		ДанныеСтрокиЭтапа = ДР_ТекущиеДанныеЭтапаДляQR();
		Если ДанныеСтрокиЭтапа = Неопределено Или ДанныеСтрокиЭтапа.Номенклатура = Неопределено Тогда
			Сообщить("Не отмечено ни одной строки и не выбрана текущая строка.");
			Возврат;
		КонецЕсли;
		
		МассивСтрок = Новый Массив;
		МассивСтрок.Добавить(ДанныеСтрокиЭтапа);
		
		ТабДок = ДР_СформироватьТабДокQRПакетомНаСервере(МассивСтрок, ОдинQRНаУпаковку);
		
		ОбъектыПечати = Новый СписокЗначений;
		ОбъектыПечати.Добавить(ДанныеСтрокиЭтапа.Номенклатура);
		
	КонецЕсли;
	
	// стандартная печать БСП
	ИдентификаторФормы = "ДР_QRНоменклатуры";
	Коллекция = УправлениеПечатьюКлиент.НоваяКоллекцияПечатныхФорм(ИдентификаторФормы);
	Описание  = УправлениеПечатьюКлиент.ОписаниеПечатнойФормы(Коллекция, ИдентификаторФормы);
	
	Описание.СинонимМакета       = НСтр("ru='QR номенклатуры'");
	Описание.ТабличныйДокумент   = ТабДок;
	Описание.Экземпляров         = 1;
	
	УправлениеПечатьюКлиент.ПечатьДокументов(Коллекция, ОбъектыПечати, ЭтаФорма);
	
КонецПроцедуры

