&НаСервере
Процедура ОбновитьСписокРеализаций()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
				   |	РеализацияТоваровУслугТовары.Ссылка.Организация КАК Организация,
				   |	РеализацияТоваровУслугТовары.Ссылка.Номер КАК НомерРеализации,
	               |	РеализацияТоваровУслугТовары.Ссылка.Дата КАК ДатаРеализации,
	               |	РеализацияТоваровУслугТовары.Назначение КАК Назначение,
	               |	РеализацияТоваровУслугТовары.Ссылка.СуммаДокумента КАК СуммаРеализации,
	               |	РеализацияТоваровУслугТовары.Ссылка КАК Реализация,
	               |	РеализацияТоваровУслугТовары.Количество КАК Количество,
	               |	РеализацияТоваровУслугТовары.Номенклатура КАК Номенклатура
	               |ПОМЕСТИТЬ Реализации
	               |ИЗ
	               |	Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
				   |ГДЕ РеализацияТоваровУслугТовары.Ссылка.Проведен 
				   |#УсловиеЗапроса
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
				   |	Реализации.Организация КАК Организация,
				   |	Реализации.НомерРеализации КАК НомерРеализации,
	               |	Реализации.ДатаРеализации КАК ДатаРеализации,
	               |	Реализации.Назначение КАК Назначение,
	               |	Реализации.СуммаРеализации КАК СуммаРеализации,
	               |	Реализации.Реализация КАК Реализация
	               |ИЗ
	               |	Реализации КАК Реализации
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Реализации.НомерРеализации,
	               |	Реализации.ДатаРеализации
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////  
				   |ВЫБРАТЬ
				   |	Реализации.Номенклатура КАК Номенклатура,
				   |	Реализации.Количество КАК Количество,
	               |	Реализации.Реализация КАК Реализация
	               |ИЗ
	               |	Реализации КАК Реализации
	               |
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////

	               |ВЫБРАТЬ
				   |	Реализации.Реализация КАК Реализация,
	               |	Реализации.Номенклатура КАК Номенклатура,
	               |	ЕСТЬNULL(ТТМ_УчетСерийныхНомеровПродукции.СерийныйНомер, """") КАК СерийныйНомер
	               |ИЗ
	               |	Реализации КАК Реализации
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТТМ_УчетСерийныхНомеровПродукции КАК ТТМ_УчетСерийныхНомеровПродукции
	               |		ПО (Реализации.Реализация = (ВЫРАЗИТЬ(ТТМ_УчетСерийныхНомеровПродукции.Регистратор КАК Документ.РеализацияТоваровУслуг)))
	               |			И Реализации.Номенклатура = ТТМ_УчетСерийныхНомеровПродукции.Номенклатура
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	НомерРеализации,
	               |	ДатаРеализации,
	               |	СерийныйНомер
				   |;
				   |
				   |////////////////////////////////////////////////////////////////////////////////
				   |ВЫБРАТЬ
				   |	ЭтапПроизводства2_2ВыходныеИзделия.Ссылка КАК ЭтапПроизводства,
				   |	ЭтапПроизводства2_2ВыходныеИзделия.ДатаПроизводства КАК ДатаПроизводства,
				   |	ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.КоличествоУпаковокПлан КАК Запланировано,
				   |	ТТМ_УчетСерийныхНомеровПродукции.СерийныйНомер КАК СерийныйНомер,
				   |	ЭтапПроизводства2_2ВыходныеИзделия.Номенклатура КАК Номенклатура,
				   |	ЭтапПроизводства2_2ВыходныеИзделия.Назначение КАК Назначение,
				   |	ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.Статус КАК Статус
				   |ИЗ
				   |	Документ.ЭтапПроизводства2_2.ВыходныеИзделия КАК ЭтапПроизводства2_2ВыходныеИзделия
				   |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТТМ_УчетСерийныхНомеровПродукции КАК ТТМ_УчетСерийныхНомеровПродукции
				   |		ПО (ЭтапПроизводства2_2ВыходныеИзделия.Ссылка = (ВЫРАЗИТЬ(ТТМ_УчетСерийныхНомеровПродукции.Регистратор КАК Документ.ЭтапПроизводства2_2)))
				   |ГДЕ
				   |	ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.Проведен
				   |	И ЭтапПроизводства2_2ВыходныеИзделия.Произведено
				   |	#УсловиеОтбораЭтапов
				   |
				   |УПОРЯДОЧИТЬ ПО
				   |	СерийныйНомер"; 
	
	ТекстНачалоУсловия = Символы.пс + "Где ";
	РазделительУсловия = Символы.ПС + "И ";
	МассивУсловийРеализации = Новый Массив;
	МассивУсловийЭтапов = Новый Массив;
	
	Если ЗначениеЗаполнено(Объект.Организация) Тогда 
		МассивУсловийРеализации.Добавить("РеализацияТоваровУслугТовары.Ссылка.Организация В(&Организация)");
		МассивУсловийЭтапов.Добавить("ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.Организация В(&Организация)");
		Запрос.УстановитьПараметр("Организация",Объект.Организация);
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.НачалоПериода) Тогда 
		МассивУсловийРеализации.Добавить("РеализацияТоваровУслугТовары.Ссылка.Дата >= &НачалоПериода");
		МассивУсловийЭтапов.Добавить("ЭтапПроизводства2_2ВыходныеИзделия.ДатаПроизводства >= &НачалоПериода");
		Запрос.УстановитьПараметр("НачалоПериода",Объект.НачалоПериода);
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ОкончаниеПериода) Тогда 
		МассивУсловийРеализации.Добавить("РеализацияТоваровУслугТовары.Ссылка.Дата <= &ОкончаниеПериода");
		МассивУсловийЭтапов.Добавить("ЭтапПроизводства2_2ВыходныеИзделия.ДатаПроизводства <= &ОкончаниеПериода");
		Запрос.УстановитьПараметр("ОкончаниеПериода",Объект.ОкончаниеПериода);
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.Изделие) Тогда 
		МассивУсловийРеализации.Добавить("РеализацияТоваровУслугТовары.Номенклатура В(&Изделие)"); 
		МассивУсловийЭтапов.Добавить("ЭтапПроизводства2_2ВыходныеИзделия.Номенклатура В(&Изделие)");
		Запрос.УстановитьПараметр("Изделие",Объект.Изделие);
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ЗаказКлиента) Тогда 
		МассивУсловийРеализации.Добавить("РеализацияТоваровУслугТовары.Ссылка.ЗаказКлиента = &ЗаказКлиента");
		МассивУсловийЭтапов.Добавить("Выразить(ЭтапПроизводства2_2ВыходныеИзделия.Назначение.Заказ как Документ.ЗаказКлиента) = &ЗаказКлиента");
		Запрос.УстановитьПараметр("ЗаказКлиента",Объект.ЗаказКлиента);
	КонецЕсли;
	
	ТекстУсловияРеализации = "";
	Если МассивУсловийРеализации.Количество() > 0 Тогда 
		
		Для Каждого Условие из МассивУсловийРеализации Цикл 
			ТекстУсловияРеализации = ТекстУсловияРеализации + ?(ЗначениеЗаполнено(ТекстУсловияРеализации),РазделительУсловия,"") + Условие;
		КонецЦикла;                                                     
		ТекстУсловияРеализации = РазделительУсловия + ТекстУсловияРеализации;
		
	КонецЕсли;
	Запрос.Текст = СтрЗаменить(Запрос.Текст,"#УсловиеЗапроса",ТекстУсловияРеализации);
	
	ТекстУсловияЭтапы = "";
	Если МассивУсловийЭтапов.Количество() > 0 Тогда 
		
		Для Каждого Условие из МассивУсловийЭтапов Цикл  
			ТекстУсловияЭтапы = ТекстУсловияЭтапы + ?(ЗначениеЗаполнено(ТекстУсловияЭтапы),РазделительУсловия,"") + Условие;
		КонецЦикла;
		ТекстУсловияЭтапы = РазделительУсловия + ТекстУсловияЭтапы;
		
	КонецЕсли;
	Запрос.Текст = СтрЗаменить(Запрос.Текст,"#УсловиеОтбораЭтапов",ТекстУсловияЭтапы);
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	ТабРеализации = МассивРезультатов[1].Выгрузить();
	ДокументыРеализации.Загрузить(ТабРеализации); 
	
	ТабТоварыРеализации = МассивРезультатов[2].Выгрузить();
	Объект.ТЧТоварыРеализации.Загрузить(ТабТоварыРеализации);
	
	ТабТоварыРеализацииСН = МассивРезультатов[3].Выгрузить();
	Объект.ТЧТоварыРеализацииССН.Загрузить(ТабТоварыРеализацииСН);
	
	ТабВыпущенныеЭтапы = МассивРезультатов[4].Выгрузить();
	Объект.ТЧВыпущенныеЭтапы.Загрузить(ТабВыпущенныеЭтапы);
	
КонецПроцедуры

