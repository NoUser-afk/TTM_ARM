#Область ДополнительныеКоманды 

&НаКлиенте
Процедура ОтметитьВсеЭтапы(Команда)  
	ВыбраннаяСтраница = Элементы.НастройкиАРМ.ТекущаяСтраница.Имя;
	
	Если ВыбраннаяСтраница = "ВыпускИРеализация" Тогда 
		Для Каждого Стр из ТаблицаЭтапов Цикл 
			стр.Отметка = Истина;
		КонецЦикла;		
		КоличествоОтмеченныхЭтапов = ПолучитьКоличествоНоменклатуры();
		Объект.Количество = КоличествоОтмеченныхЭтапов;	
	ИначеЕсли ВыбраннаяСтраница = "СтраницаРеализация" Тогда 
		Для Каждого Стр из СписокЗаказовКРеализации Цикл 
			стр.Отметка = Истина;
		КонецЦикла;	
	Иначе
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Для выбранной страницы обработка не задана!'"));
	КонецЕсли;
КонецПроцедуры 

&НаКлиенте
Процедура СнятьОтметкиВсе(Команда)   
	ВыбраннаяСтраница = Элементы.НастройкиАРМ.ТекущаяСтраница.Имя;
	Если ВыбраннаяСтраница = "ВыпускИРеализация" Тогда 
		Для Каждого Стр из ТаблицаЭтапов Цикл 
			стр.Отметка = Ложь;
		КонецЦикла;   
		КоличествоОтмеченныхЭтапов = ПолучитьКоличествоНоменклатуры();
		Объект.Количество = КоличествоОтмеченныхЭтапов;
	ИначеЕсли ВыбраннаяСтраница = "СтраницаРеализация" Тогда 
		Для Каждого Стр из СписокЗаказовКРеализации Цикл 
			стр.Отметка = Ложь;
		КонецЦикла;	
	Иначе
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Для выбранной страницы обработка не задана!'"));
	КонецЕсли;
КонецПроцедуры     

#КонецОбласти


//////////////////////////////////////////////////////////////////////////////////////////////////////////
#Область ОповещениеПользователя

&НаКлиенте
Процедура ОповеститьПользователя(ТекущаяКоманда)
	Если ТекущаяКоманда = "Выпуск" Тогда
		ПоказатьОповещениеПользователя(
			НСтр("ru = 'АРМ Выпуск и реализация'"),, 
			НСтр("ru = 'Формирование выпуска завершено'"), 
			БиблиотекаКартинок.Информация, 
			СтатусОповещенияПользователя.Информация
		);
	ИначеЕсли ТекущаяКоманда = "Реализация" Или ТекущаяКоманда = "РеализацияВсехЗаказов" Тогда
		ПоказатьОповещениеПользователя(
			НСтр("ru = 'АРМ Выпуск и реализация'"),, 
			НСтр("ru = 'Формирование реализаций завершено'"), 
			БиблиотекаКартинок.Информация, 
			СтатусОповещенияПользователя.Информация
		); 	
	ИначеЕсли ТекущаяКоманда = "ЗаполнитьДокументОтгрузка" Тогда
		ПоказатьОповещениеПользователя(
			НСтр("ru = 'АРМ Выпуск и реализация'"),, 
			НСтр("ru = 'Формирование докумета отгрузки завершено'"), 
			БиблиотекаКартинок.Информация, 
			СтатусОповещенияПользователя.Информация
		);
	ИначеЕсли ТекущаяКоманда = "СохранитьТекущиеНастройки" Тогда
		ПоказатьОповещениеПользователя(
			НСтр("ru = 'АРМ Выпуск и реализация'"),, 
			НСтр("ru = 'Настройки успешно сохранены'"), 
			БиблиотекаКартинок.Информация, 
			СтатусОповещенияПользователя.Информация
		);
	ИначеЕсли ТекущаяКоманда = "ВосстановитьНастройки" Тогда
		ПоказатьОповещениеПользователя(
			НСтр("ru = 'АРМ Выпуск и реализация'"),, 
			НСтр("ru = 'Настройки успешно выгружены'"), 
			БиблиотекаКартинок.Информация, 
			СтатусОповещенияПользователя.Информация
		); 
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ПроверкаЗаполненияКлючевыхПолей(ТекущаяКоманда, Знач ПроверкаВыполнена = Истина)
	Сообщение = Новый СообщениеПользователю;
	
	Если ТекущаяКоманда.Действие = "Выпуск" Тогда
		Если Объект.Изделие.Пустая() Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(
			   НСтр("ru = 'Не выбрано изделие'"),,
			   "Изделие",
			   "Объект.Изделие");
			
			ПроверкаВыполнена = Ложь;		
		ИначеЕсли Объект.ЗаказКлиента.Пустая() Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(
			   НСтр("ru = 'Не выбран заказ клиента'"),,
			   "ЗаказКлиента",
			   "Объект.ЗаказКлиента");
			
			ПроверкаВыполнена = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если ТекущаяКоманда.Действие = "Реализация" Тогда
		Если Объект.ЗаказКлиента.Пустая() Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(
			   НСтр("ru = 'Не выбран заказ клиента'"),,
			   "ЗаказКлиента",
			   "Объект.ЗаказКлиента");
			
			ПроверкаВыполнена = Ложь;	
		//ИначеЕсли ТаблицаОтбораЦен.Количество() = 0 Тогда
		//	ОбщегоНазначенияКлиент.СообщитьПользователю(
		//	   НСтр("ru = 'Не заполнены настройки для проверки установленных цен в заказе'"),,
		//	   "ТаблицаОтбораЦен");			
		//	
		//	ПроверкаВыполнена = Ложь;	
		//ИначеЕсли СписокАдресовДляРассылки.Количество() = 0 Тогда
		//	ОбщегоНазначенияКлиент.СообщитьПользователю(
		//	   НСтр("ru = 'Нет ни одного адреса для отправки уведомлений'"),,
		//	   "СписокАдресовДляРассылки");			
		//	
		//	ПроверкаВыполнена = Ложь;
		КонецЕсли;
	КонецЕсли;
		
	Если ТекущаяКоманда.Действие = "РеализацияВсехЗаказов" Тогда
		//Если ТаблицаОтбораЦен.Количество() = 0 Тогда
		//	ОбщегоНазначенияКлиент.СообщитьПользователю(
		//		НСтр("ru = 'Не заполнены настройки для проверки установленных цен в заказе'"),,
		//		"ТаблицаОтбораЦен");			
		//	ПроверкаВыполнена = Ложь;
		//ИначеЕсли СписокАдресовДляРассылки.Количество() = 0 Тогда
		//	ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Нет ни одного адреса для отправки уведомлений'"),,"СписокАдресовДляРассылки");			
		//	ПроверкаВыполнена = Ложь;	
		//Иначе
			ОтветПользователя = Вопрос(НСтр("ru = 'Напечать УПД по всем заказам?'"), РежимДиалогаВопрос.ДаНет, 0,, НСтр("ru = 'Печать УПД'"));
			
			Если ОтветПользователя = КодВозвратаДиалога.Нет Тогда
				ПроверкаВыполнена = Ложь;
			КонецЕсли;
		//КонецЕсли;
	КонецЕсли;
	
	Если ТекущаяКоманда.Действие = "ПечатьЭтикеток" Тогда
		Если Объект.Изделие.Пустая() Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(
			   НСтр("ru = 'Не выбрано изделие'"),,
			   "Изделие",
			   "Объект.Изделие");
			ПроверкаВыполнена = Ложь;    
		ИначеЕсли Объект.ШаблонЭтикетки.Пустая() Тогда    
			Объект.ШаблонЭтикетки = ПолучитьШаблонЭтикетки("Этикетка ТТМ");
			//Объект.ШаблонЭтикетки = Элементы.ШаблонЭтикетки.СписокВыбора.НайтиПоЗначению("Этикетка ТТМ");
		КонецЕсли;  
	КонецЕсли;
	Если ТекущаяКоманда.Действие = "ПечатьСерийныхНомеров" Тогда
		Если Объект.Изделие.Пустая() Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Не выбрано изделие'"),,
			   "Изделие",
			   "Объект.Изделие");
			ПроверкаВыполнена = Ложь;    
		ИначеЕсли Объект.ШаблонЭтикетки.Пустая() Тогда  
			Объект.ШаблонЭтикетки = ПолучитьШаблонЭтикетки("Этикетка СН");
			//Объект.ШаблонЭтикетки =  Элементы.ШаблонЭтикетки.СписокВыбора.НайтиПоЗначению("Этикетка СН");
		КонецЕсли;
	КонецЕсли;
		
	Возврат ПроверкаВыполнена;	
КонецФункции
