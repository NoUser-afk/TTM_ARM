#Область ОбработчикиСобытийРаспределениеМатериала

&НаКлиенте
Процедура РаспределениеМатериалаПриАктивизацииСтроки(Элемент)
	
	Если Элементы.МатериалыСпецификации.ВыделенныеСтроки.Количество() = 0 Тогда 
		Возврат;         
	КонецЕсли;    
	
	//+ Ганьшина Е 14.04.2025
	Если ОбновлениеДанныхФормы Тогда 
		Возврат;
	КонецЕсли;   
	//- Ганьшина Е 14.04.2025
	
	ВыбраннаяСтрока = Элемент.ТекущиеДанные; 
	Если ВыбраннаяСтрока <> Неопределено Тогда 
		ТекущийЭтап = ВыбраннаяСтрока.ЭтапПроизводства; //+ Ганьшина Е 14.04.2025
	КонецЕсли;     
	
	Если ИсходныеДанныеСтрокиМатериаловСпецификации.Номенклатура <> Неопределено и ВыбраннаяСтрока <> Неопределено Тогда   
		//+ Ганьшина е. 16.04.2025
		ЗаполнитьЗначенияСвойств(ИсходныеДанныеСтрокиМатериаловСпецификации,ВыбраннаяСтрока);
		//-
		ИсходныеДанныеСтрокиМатериаловСпецификации.ЭтапПроизводства = ТекущийЭтап; //+ Ганьшина Е 14.04.2025 //ВыбраннаяСтрока.ЭтапПроизводства;
		КоличествоУпаковок = ?(ЗначениеЗаполнено(ВыбраннаяСтрока.КоличествоУпаковок), ВыбраннаяСтрока.КоличествоУпаковок, ВыбраннаяСтрока.Норматив);
		ИсходныеДанныеСтрокиМатериаловСпецификации.КоличествоУпаковок = КоличествоУпаковок; 
		СтруктураКоэффициента = ПолучитьКоэффициентУпаковки(ИсходныеДанныеСтрокиМатериаловСпецификации);
		КоэффициентУпаковки = СтруктураКоэффициента.Знаменатель / СтруктураКоэффициента.Числитель;
		ИсходныеДанныеСтрокиМатериаловСпецификации.Количество = КоличествоУпаковок * КоэффициентУпаковки;		
	КонецЕсли;       
	
	//+ Ганьшина Е 14.04.2025
	ПараметрыПоиска = Новый Структура("ЭтапПроизводства");
	МассивСтрок = Объект.РаспределениеМатериала.НайтиСтроки(ПараметрыПоиска);
	Если МассивСтрок.Количество() > 0 Тогда 
		ТекСтрока = МассивСтрок[0];
		Элементы.РаспределениеМатериала.ТекущаяСтрока = ТекСтрока.ПолучитьИдентификатор();    //Элементы.ПолучитьИдентификатор();    
	КонецЕсли;
	//- Ганьшина Е 14.04.2025
	
КонецПроцедуры

&НаКлиенте
Процедура РаспределениеМатериалаПередУдалением(Элемент, Отказ)
	//ИсходныеДанныеСтрокиМатериаловСпецификации.ЭтапПроизводства = Элемент.Родитель.ТекущиеДанные().ЭтапПроизводства;
	Номенклатура = ИсходныеДанныеСтрокиМатериаловСпецификации.Номенклатура;
	ЭтапПроизводства = ИсходныеДанныеСтрокиМатериаловСпецификации.ЭтапПроизводства;
	УдалитьСтрокиРегистраСОтбором(Номенклатура,ЭтапПроизводства,Истина);
КонецПроцедуры  

&НаСервере
Функция УдалитьСтрокиРегистраСОтбором(Номенклатура, ЭтапПроизводства = Неопределено, ЭтоСписание)
	
	НЗ = РегистрыСведений.ТТМ_АРМ_РезервированиеСписаниеМатериалов.СоздатьНаборЗаписей();
	НЗ.Отбор.Пользователь.Установить(Пользователи.АвторизованныйПользователь());
	НЗ.Отбор.ЭтоСписание.Установить(ЭтоСписание);
	НЗ.Отбор.Номенклатура.Установить(Номенклатура);
	
	Если ЗначениеЗаполнено(ЭтапПроизводства) Тогда 
		НЗ.Отбор.ЭтапПроизводства.Установить(ЭтапПроизводства);
	КонецЕсли;
	
	НЗ.Прочитать();
	НЗ.Очистить();
	НЗ.Записать();

КонецФункции

