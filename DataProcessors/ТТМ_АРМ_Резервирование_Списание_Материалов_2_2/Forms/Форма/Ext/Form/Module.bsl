						СтрНЗ.КоличествоУпаковок = Окр(РасчетныйОстатокНаСкладе / ВсегоИзделий * СтрНЗ.Запланировано,0,РежимОкругления.Окр15как20); //ОстатокРаспределения; //29.05.2025
					Иначе 
						//СтрНЗ.Количество = Окр(НовоеКоличествоДляРаспределения/ОтмеченоЭтапов*КоэффициентУпаковки,0,РежимОкругления.Окр15как20);
