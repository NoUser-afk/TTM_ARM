&НаСервереБезКонтекста
Функция ПолучитьКоэффициентУпаковки(ТекСтрокаМатериалы) 

	Если не ТекСтрокаМатериалы.Номенклатура = Неопределено Тогда 	
		СтруктураКоэффициента = Новый Структура;
		Знаменатель = ?(ЗначениеЗаполнено(ТекСтрокаМатериалы.Упаковка), ТекСтрокаМатериалы.Упаковка.Знаменатель,1);
		Числитель = ?(ЗначениеЗаполнено(ТекСтрокаМатериалы.Упаковка.Числитель),ТекСтрокаМатериалы.Упаковка.Числитель,1);
		СтруктураКоэффициента.Вставить("Числитель",Числитель);
		СтруктураКоэффициента.Вставить("Знаменатель",Знаменатель);
		Возврат СтруктураКоэффициента;                           
	КонецЕсли;
		
КонецФункции

