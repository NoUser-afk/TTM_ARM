&НаСервере
Процедура ВыгрузитьМатериалыДляТСДНаСервере(Спецификация)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТТМ_АРМ_РезервированиеСписаниеМатериалов.Номенклатура КАК Номенклатура,
	               |	ТТМ_АРМ_РезервированиеСписаниеМатериалов.Упаковка КАК Упаковка,
	               |	ТТМ_АРМ_РезервированиеСписаниеМатериалов.Спецификация КАК Спецификация,
	               |	&Пользователь КАК Пользователь,
	               |	СУММА(ТТМ_АРМ_РезервированиеСписаниеМатериалов.Количество) КАК Количество,
	               |	СУММА(ТТМ_АРМ_РезервированиеСписаниеМатериалов.КоличествоУпаковок) КАК КоличествоУпаковок,
	               |	&КоличествоЭтапов КАК КоличествоЭтапов,
	               |	ТТМ_РазмещениеНоменклатурыПоСкладскимЯчейкам.Ячейка КАК Ячейка,
				   |	ТТМ_АРМ_РезервированиеСписаниеМатериалов.Остаток КАК Остаток
	               |ИЗ
	               |	РегистрСведений.ТТМ_АРМ_РезервированиеСписаниеМатериалов КАК ТТМ_АРМ_РезервированиеСписаниеМатериалов
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТТМ_РазмещениеНоменклатурыПоСкладскимЯчейкам КАК ТТМ_РазмещениеНоменклатурыПоСкладскимЯчейкам
	               |		ПО ТТМ_АРМ_РезервированиеСписаниеМатериалов.Номенклатура = ТТМ_РазмещениеНоменклатурыПоСкладскимЯчейкам.Номенклатура
	               |ГДЕ
	               |	ТТМ_АРМ_РезервированиеСписаниеМатериалов.Пользователь = &Пользователь
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ТТМ_АРМ_РезервированиеСписаниеМатериалов.Номенклатура,
	               |	ТТМ_АРМ_РезервированиеСписаниеМатериалов.Упаковка,
	               |	ТТМ_АРМ_РезервированиеСписаниеМатериалов.Спецификация,
	               |	ТТМ_РазмещениеНоменклатурыПоСкладскимЯчейкам.Ячейка,
				   |	ТТМ_АРМ_РезервированиеСписаниеМатериалов.Остаток
				   //,
	               //|	ТТМ_АРМ_РезервированиеСписаниеМатериалов.Назначение
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Номенклатура
	               |АВТОУПОРЯДОЧИВАНИЕ";

	ОтборЭтапов = Новый Структура("Обрабатывать",Истина); 
	ТабЭтапы = Этапы.Выгрузить(ОтборЭтапов, "ЭтапПроизводства, Назначение,Запланировано");
	ТабЭтапы.Свернуть("ЭтапПроизводства, Назначение,Запланировано");
	КоличествоЭтаповДляОбработки = ТабЭтапы.Количество();	
	Запрос.УстановитьПараметр("КоличествоЭтапов", КоличествоЭтаповДляОбработки);  
	Запрос.УстановитьПараметр("Пользователь", Пользователи.АвторизованныйПользователь());
	Выборка = Запрос.Выполнить().Выбрать();
	
	ДокПодборМатериалов = Документы.ТТМ_ПодборМатериаловПоСпецификации.СоздатьДокумент();
	ДокПодборМатериалов.Организация = Объект.Организация; 
	ДокПодборМатериалов.Статус = Перечисления.ТТМ_СтатусыПодбораМатериалов.Сформирован;
	ДокПодборМатериалов.Склад = Объект.Склад;
	ДокПодборМатериалов.Дата = ТекущаяДатаСеанса();
	ДокПодборМатериалов.Продукция = Объект.Номенклатура;
	ДокПодборМатериалов.Спецификация = Спецификация;
	ДокПодборМатериалов.Ответственный = Пользователи.АвторизованныйПользователь();
	
	ДокПодборМатериалов.Этапы.Загрузить(ТабЭтапы);                                       
	КоличествоИзделий = ТабЭтапы.Итог("Запланировано");     
	КоличествоЭтапов = ТабЭтапы.Количество();
	ДокПодборМатериалов.Количество = КоличествоИзделий;  
	ДокПодборМатериалов.Комментарий = "## "+КоличествоИзделий + " " + Спецификация;
	
	
	Пока Выборка.Следующий() Цикл    
		НоваяСтрокаТЧ = ДокПодборМатериалов.ОбеспечениеМатериаламиИРаботами.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаТЧ,Выборка); 
	КонецЦикла;
	
	Попытка
		НачатьТранзакцию();	
		ДокПодборМатериалов.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);    		
		ЗафиксироватьТранзакцию();
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Создан: '") + ДокПодборМатериалов.Ссылка);
	Исключение
		ОтменитьТранзакцию();
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Ошибка во время записи документа: '") + ДокПодборМатериалов.Ссылка);
	КонецПопытки;
	
КонецПроцедуры   

&НаКлиенте
Процедура ВыгрузитьМатериалыДляТСД(Команда)  
	Если не ЗначениеЗаполнено(Спецификация) Тогда 
		Сообщить("Выберите спецификацию для сборки! Документ не создан!"); 
		Возврат;
	КонецЕсли;
	ВопросПользователюПередВыполнениемОперации(, Команда.Действие);
	Объект.ДокументПодбораМатериалов = ОчиститьСсылкуНаДокументПодбораПослеФормирования();
КонецПроцедуры

&НаСервере
Функция ПолучитьТаблицуПодбора(Знач ВыгруженнаяТаблица = Неопределено)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ТТМ_ПодборМатериаловПоСпецификацииЭтапы.ЭтапПроизводства) КАК КоличествоЭтапов,
	               |	ТТМ_ПодборМатериаловПоСпецификацииЭтапы.Ссылка КАК Ссылка
	               |ПОМЕСТИТЬ КоличествоЭтаповДокумента
	               |ИЗ
	               |	Документ.ТТМ_ПодборМатериаловПоСпецификации.Этапы КАК ТТМ_ПодборМатериаловПоСпецификацииЭтапы
	               |ГДЕ
	               |	ТТМ_ПодборМатериаловПоСпецификацииЭтапы.Ссылка.Проведен
	               |	И ТТМ_ПодборМатериаловПоСпецификацииЭтапы.Ссылка.Ответственный = &Пользователь
	               |	И ТТМ_ПодборМатериаловПоСпецификацииЭтапы.Ссылка.Статус = &СтатусДокумента
	               |	И ТТМ_ПодборМатериаловПоСпецификацииЭтапы.Ссылка.Номер = &НомерДокумента
	               |	И НАЧАЛОПЕРИОДА(ТТМ_ПодборМатериаловПоСпецификацииЭтапы.Ссылка.Дата, ДЕНЬ) = НАЧАЛОПЕРИОДА(&ДатаДокумента, ДЕНЬ)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ТТМ_ПодборМатериаловПоСпецификацииЭтапы.Ссылка
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТТМ_ПодборМатериаловПоСпецификацииЭтапы.Ссылка КАК ДокументПодбора,
	               |	ТТМ_ПодборМатериаловПоСпецификацииОбеспечениеМатериаламиИРаботами.Номенклатура КАК Номенклатура,
	               |	ВЫБОР
	               |		КОГДА ЕСТЬNULL(ТТМ_ПодборМатериаловПоСпецификацииОбеспечениеМатериаламиИРаботами.Упаковка.Числитель, 1) = 1
	               |			ТОГДА ТТМ_ПодборМатериаловПоСпецификацииОбеспечениеМатериаламиИРаботами.Количество / КоличествоЭтаповДокумента.КоличествоЭтапов / 1 * ЕСТЬNULL(ТТМ_ПодборМатериаловПоСпецификацииОбеспечениеМатериаламиИРаботами.Упаковка.Знаменатель, 1)
	               |		КОГДА ТТМ_ПодборМатериаловПоСпецификацииОбеспечениеМатериаламиИРаботами.Упаковка.Числитель = 0
	               |			ТОГДА ТТМ_ПодборМатериаловПоСпецификацииОбеспечениеМатериаламиИРаботами.Количество / КоличествоЭтаповДокумента.КоличествоЭтапов / 1 * 1
	               |		ИНАЧЕ ТТМ_ПодборМатериаловПоСпецификацииОбеспечениеМатериаламиИРаботами.Количество / КоличествоЭтаповДокумента.КоличествоЭтапов / ЕСТЬNULL(ТТМ_ПодборМатериаловПоСпецификацииОбеспечениеМатериаламиИРаботами.Упаковка.Числитель, 1) * ЕСТЬNULL(ТТМ_ПодборМатериаловПоСпецификацииОбеспечениеМатериаламиИРаботами.Упаковка.Знаменатель, 1)
	               |	КОНЕЦ КАК Количество,
	               |	ТТМ_ПодборМатериаловПоСпецификацииОбеспечениеМатериаламиИРаботами.Упаковка КАК Упаковка,
	               |	ТТМ_ПодборМатериаловПоСпецификацииЭтапы.ЭтапПроизводства КАК ЭтапПроизводства,
	               |	ТТМ_ПодборМатериаловПоСпецификацииЭтапы.Назначение КАК Назначение,
	               |	ТТМ_ПодборМатериаловПоСпецификацииОбеспечениеМатериаламиИРаботами.Ссылка.Спецификация КАК Спецификация,
	               |	ТТМ_ПодборМатериаловПоСпецификацииОбеспечениеМатериаламиИРаботами.Ссылка.Склад КАК Склад,
	               |	ТТМ_ПодборМатериаловПоСпецификацииОбеспечениеМатериаламиИРаботами.Количество / КоличествоЭтаповДокумента.КоличествоЭтапов КАК КоличествоУпаковок,
	               |	КоличествоЭтаповДокумента.КоличествоЭтапов КАК КоличествоЭтапов
	               |ИЗ
	               |	Документ.ТТМ_ПодборМатериаловПоСпецификации.ОбеспечениеМатериаламиИРаботами КАК ТТМ_ПодборМатериаловПоСпецификацииОбеспечениеМатериаламиИРаботами
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ТТМ_ПодборМатериаловПоСпецификации.Этапы КАК ТТМ_ПодборМатериаловПоСпецификацииЭтапы
	               |		ПО ТТМ_ПодборМатериаловПоСпецификацииОбеспечениеМатериаламиИРаботами.Ссылка = ТТМ_ПодборМатериаловПоСпецификацииЭтапы.Ссылка
	               |		ЛЕВОЕ СОЕДИНЕНИЕ КоличествоЭтаповДокумента КАК КоличествоЭтаповДокумента
	               |		ПО (КоличествоЭтаповДокумента.Ссылка = ТТМ_ПодборМатериаловПоСпецификацииОбеспечениеМатериаламиИРаботами.Ссылка)
	               |ГДЕ
	               |	ТТМ_ПодборМатериаловПоСпецификацииОбеспечениеМатериаламиИРаботами.Ссылка.Ответственный = &Пользователь
	               |	И ТТМ_ПодборМатериаловПоСпецификацииОбеспечениеМатериаламиИРаботами.Ссылка.Проведен
	               |	И ТТМ_ПодборМатериаловПоСпецификацииОбеспечениеМатериаламиИРаботами.Ссылка.Статус = &СтатусДокумента
	               |	И ТТМ_ПодборМатериаловПоСпецификацииЭтапы.Ссылка В
	               |			(ВЫБРАТЬ ПЕРВЫЕ 1
	               |				Т.Ссылка
	               |			ИЗ
	               |				КоличествоЭтаповДокумента КАК Т)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ДокументПодбора,
	               |	Номенклатура
	               |АВТОУПОРЯДОЧИВАНИЕ";
	
	Запрос.УстановитьПараметр("Пользователь", Пользователи.АвторизованныйПользователь());
	Запрос.УстановитьПараметр("ДатаДокумента", НачалоДня(Объект.ДокументПодбораМатериалов.Дата)); 
	Запрос.УстановитьПараметр("НомерДокумента", Объект.ДокументПодбораМатериалов.Номер);
	Запрос.УстановитьПараметр("СтатусДокумента", Перечисления.ТТМ_СтатусыПодбораМатериалов.Собран);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		ВыгруженнаяТаблица = РезультатЗапроса.Выгрузить();
	КонецЕсли;
	
	Возврат ВыгруженнаяТаблица; 

КонецФункции

