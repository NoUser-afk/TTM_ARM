&НаСервере
Процедура ОчиститьЗаписиРегистраДляУдаления(ДанныеУдаляемойСтроки, ЭтоСписание);
	
	НЗ = РегистрыСведений.ТТМ_АРМ_РезервированиеСписаниеМатериалов.СоздатьНаборЗаписей();
	НЗ.Отбор.Пользователь.Установить(Пользователи.АвторизованныйПользователь());
	НЗ.Отбор.ЭтоСписание.Установить(ЭтоСписание);
	НЗ.Отбор.Номенклатура.Установить(ДанныеУдаляемойСтроки.Номенклатура);    
	Если ЗначениеЗаполнено(ДанныеУдаляемойСтроки.ЭтапПроизводства) Тогда 
		НЗ.Отбор.ЭтапПроизводства.Установить(ДанныеУдаляемойСтроки.ЭтапПроизводства);
	КонецЕсли;
	Если ЗначениеЗаполнено(ДанныеУдаляемойСтроки.ВариантОбеспечения) Тогда 
		НЗ.Отбор.ВариантОбеспечения.Установить(ДанныеУдаляемойСтроки.ВариантОбеспечения);
	КонецЕсли;   
	Если ЗначениеЗаполнено(ДанныеУдаляемойСтроки.Спецификация) Тогда 
		НЗ.Отбор.СпецификацияЭтапа.Установить(ДанныеУдаляемойСтроки.Спецификация);      
	КонецЕсли;
	НЗ.Прочитать();
	НЗ.Очистить();
	НЗ.Записать();
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоМатериаловРезервированиеПередНачаломИзменения(Элемент, Отказ)
	
	ДанныеТекСтроки = ЗапомнитьИсходныеДанныеСтроки(); 
	Если ТекСтраница = "Списание" Тогда 
		ИмяДерева = "ДеревоМатериалов"; 
		ИмяТаблицыИдентификаторов = "ИдентификаторыРаскрытыхСтрокДереваМатериалов";
	ИначеЕсли ТекСтраница = "Резервирование" Тогда 
		ИмяДерева = "ДеревоМатериаловРезервирование"; 
		ИмяТаблицыИдентификаторов = "ИдентификаторыРаскрытыхСтрокДереваМатериаловРезервирование";
	КонецЕсли;
		
	ЗапишемДанныеТекущейСтрокиВТабИД(ИмяДерева,ИмяТаблицыИдентификаторов);
	
КонецПроцедуры
	
