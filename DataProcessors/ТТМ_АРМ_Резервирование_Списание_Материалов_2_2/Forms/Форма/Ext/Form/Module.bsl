&НаКлиенте
Процедура ВопросПользователюПередВыполнениемОперации(Знач ПереходНаСтраницуЭтапы = Ложь, Знач ТекущаяКоманда = Неопределено)
	
	Если ПереходНаСтраницуЭтапы Тогда
		Если Объект.МатериалыСпецификации.Количество() > 0 Тогда
			Списание = Не Объект.Резерв;
			ДопПараметры = Новый Структура("ЭтоСписание",Списание);
			ОповещениеПриПереходеНаСтрЭтапы = Новый ОписаниеОповещения("ПереходНаСтрЭтапыПродолжение", ЭтотОбъект, ДопПараметры);
			ПоказатьВопрос(ОповещениеПриПереходеНаСтрЭтапы, "Данные по корректировке материалов будут утеряны, продолжить?", РежимДиалогаВопрос.ДаНет, 300);
		КонецЕсли;
	ИначеЕсли ТекущаяКоманда = "ВыгрузитьМатериалыДляТСД" Тогда
		ОповещениеВыгрузкаТСД = Новый ОписаниеОповещения("ПослеЗакрытияВопросаПриВыполненииОперации", ЭтотОбъект, ТекущаяКоманда);
		ПоказатьВопрос(ОповещениеВыгрузкаТСД, "Сформировать документ ТСД?", РежимДиалогаВопрос.ДаНет, 0,, "Документ ТСД");
	ИначеЕсли ТекущаяКоманда = "ЗафиксироватьКорректировкиНовая" Тогда
		ОповещениеВыгрузкаТСД = Новый ОписаниеОповещения("ПослеЗакрытияВопросаПриВыполненииОперации", ЭтотОбъект, ТекущаяКоманда);
		ПоказатьВопрос(ОповещениеВыгрузкаТСД, "Зарезервировать выбранные материалы?", РежимДиалогаВопрос.ДаНет, 0,, "Резервирование");
	ИначеЕсли ТекущаяКоманда = "ВыполнитьСписание" Тогда
		ОповещениеВыгрузкаТСД = Новый ОписаниеОповещения("ПослеЗакрытияВопросаПриВыполненииОперации", ЭтотОбъект, ТекущаяКоманда);
		ПоказатьВопрос(ОповещениеВыгрузкаТСД, "Выполнить списание выбранных материалов?", РежимДиалогаВопрос.ДаНет, 0,, "Списание");	
	Иначе
		ОповещениеПриПереходеНаСтрЭтапы = Новый ОписаниеОповещения("ПереходНаСтрМатериалыСпецификацииПродолжение", ЭтотОбъект);
		ПоказатьВопрос(ОповещениеПриПереходеНаСтрЭтапы, "Подготовить список материалов для резервирования и списания?", РежимДиалогаВопрос.ДаНет, 300);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПереходНаСтрЭтапыПродолжение(ОтветПользователя, ДопПараметры) Экспорт   
	
	Если ОтветПользователя = КодВозвратаДиалога.Да Тогда 
		УдалитьМатериалыДляКорректирвкиИзРегистра(ДопПараметры.ЭтоСписание);
		Объект.МатериалыСпецификации.Очистить();
		Объект.РаспределениеМатериала.Очистить();
	Иначе 
		Если Элементы.СтраницыСписания.ТекущаяСтраница.Имя = "СтраницаЭтапы" Тогда 
			Элементы.СтраницыСписания.ТекущаяСтраница = Элементы.СтраницаМатериалыСпецификации;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПереходНаСтрМатериалыСпецификацииПродолжение(ОтветПользователя, ДопПараметры) Экспорт
	Если ОтветПользователя = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	// <+ 
	_Протокол.ДобавитьСтроку(СтрШаблон("Начало заполнения материалов - %1",ТекущаяДата()));
	// +>
		
	ЭтоСписание = Не Объект.Резерв;	
	ЗаполнитьСпецификациюПоВыбраннымЭтапам("Этапы", ЭтоСписание);
	Команда = "ПереходыМеждуСтраницами";
	
	Попытка
		ДлительнаяОперация = ЗаполнитьМатериалыСпецификации(Истина, Истина);
	 	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	 	ПараметрыОжидания.Заголовок = "Формирование списка материалов...";
	 	ПараметрыОжидания.ВыводитьПрогрессВыполнения = Истина;
	 	ПараметрыОжидания.ВыводитьСообщения = Истина;
	 	ПараметрыОжидания.ПолучатьРезультат = Истина;
	 	 
	 	Оповещение = Новый ОписаниеОповещения("ПриЗавершенииОбработкиФоновойОперации", ЭтотОбъект, Команда);
	 	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, Оповещение, ПараметрыОжидания);
		
	Исключение
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Ошибка формирования списка материалов: '") + КраткоеПредставлениеОшибки(ОписаниеОшибки()));
	КонецПопытки;
	
	//Элементы.РаспределениеМатериалаРезерв.Видимость = Объект.Резерв;	
КонецПроцедуры	

&НаКлиенте
Процедура ОповеститьПользователя(Знач ПереходМеждуСтраниц = Ложь, Знач ВыгрузкаТСД = Ложь, Знач Резервирование = Ложь, Знач ОформленоСписание = Ложь)
	
	Если ПереходМеждуСтраниц Тогда
		ПоказатьОповещениеПользователя(
			НСтр("ru = 'АРМ Резервирование и списание'"),, 
			НСтр("ru = 'Список материалов успешно сформирован!'"), 
			БиблиотекаКартинок.Информация, 
			СтатусОповещенияПользователя.Информация);
	ИначеЕсли ВыгрузкаТСД Тогда
		ПоказатьОповещениеПользователя(
			НСтр("ru = 'АРМ Резервирование и списание'"),, 
			НСтр("ru = 'Документ ТСД сформирован!'"), 
			БиблиотекаКартинок.Информация, 
			СтатусОповещенияПользователя.Информация);
	ИначеЕсли Резервирование Тогда
		ПоказатьОповещениеПользователя(
			НСтр("ru = 'АРМ Резервирование и списание'"),, 
			НСтр("ru = 'Материалы зарезервированы!'"), 
			БиблиотекаКартинок.Информация, 
			СтатусОповещенияПользователя.Информация);
	ИначеЕсли ОформленоСписание Тогда
		ПоказатьОповещениеПользователя(
			НСтр("ru = 'АРМ Резервирование и списание'"),, 
			НСтр("ru = 'Материалы списаны!'"), 
			БиблиотекаКартинок.Информация, 
			СтатусОповещенияПользователя.Информация);	
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаПриВыполненииОперации(ОтветПользователя, ДопПараметры) Экспорт
	
	/////////////////////////////////////////////////////
	Если ДопПараметры = "ВыгрузитьМатериалыДляТСД" Тогда
		Если ОтветПользователя = КодВозвратаДиалога.Нет Тогда
			Возврат;
		КонецЕсли;
		
		Попытка 
			ВыгрузитьМатериалыДляТСДНаСервере(Спецификация);
			ОперацияВыполнена = Истина;
		Исключение
			ОперацияВыполнена = Ложь;
		КонецПопытки;
		
		Если ОперацияВыполнена Тогда	
			ОповеститьПользователя(, Истина);
		КонецЕсли;
	КонецЕсли;
	
	/////////////////////////////////////////////////////
	Если ДопПараметры = "ЗафиксироватьКорректировкиНовая" Тогда
		Если ОтветПользователя = КодВозвратаДиалога.Нет Тогда
			Возврат;
		КонецЕсли;
		
		ВыполнитьРезервированиеПодтверждение(ДопПараметры);	
	КонецЕсли;

	/////////////////////////////////////////////////////
	Если ДопПараметры = "ВыполнитьСписание" Тогда
		Если ОтветПользователя = КодВозвратаДиалога.Нет Тогда
			Возврат;
		КонецЕсли;

		ВыполнитьСписаниеПодтверждение(ДопПараметры);		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗавершенииОбработкиФоновойОперации(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда // Пользователь отменил задание.
	//	ОчиститьДанныеИзВременногоРегистраФоновыхЗаданий();
	  	Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		ВызватьИсключение Результат.КраткоеПредставлениеОшибки;
	КонецЕсли;
	
	Если Результат.Статус = "Выполнено" Тогда
		
		// <+
		_Протокол.ДобавитьСтроку(СтрШаблон("Изделие: %1",Объект.Номенклатура));
		_Протокол.ДобавитьСтроку(СтрШаблон("Выполнено - %1",ТекущаяДата()));
		// +>
		
		Если ДополнительныеПараметры = "ПереходыМеждуСтраницами" Тогда
			СписокНоменклатурыБезОстатка.Очистить();
			СтатусВыполнения = ЗаполнитьМатериалыСпецификации(Истина, Ложь, Истина);
			
			Если СтатусВыполнения Тогда
				Если СписокНоменклатурыБезОстатка.Количество() > 0 Тогда 
					ТекстСообщенияНоменклатураБезОстатка = "";
					Для Каждого Номенклатура из СписокНоменклатурыБезОстатка Цикл 
						ТекстСообщенияНоменклатураБезОстатка = ТекстСообщенияНоменклатураБезОстатка + Номенклатура + Символы.ПС;
					КонецЦикла;
					Сообщить("Нет остатка на складе по номенклатуре:" + Символы.ПС + ТекстСообщенияНоменклатураБезОстатка);
				КонецЕсли;
				Элементы.РаспределениеМатериалаМягкиРезерв.Видимость = Объект.Резерв;
				Элементы.РаспределениеМатериалаОтгрузить.Видимость = Не Объект.Резерв;
				
				//28.05.2025
				ТекущаяНоменклатура = Объект.МатериалыСпецификации[0].Номенклатура;  
				ЗаполнитьТЧРаспределениеМатериалаПоДаннымРегистра(ТекущаяНоменклатура);
				//
				ОповеститьПользователя(Истина);
			КонецЕсли;
		КонецЕсли;
		
		Если ДополнительныеПараметры = "ЗафиксироватьКорректировкиНовая" Тогда
			ОповеститьПользователя(,, Истина);
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru ='Резервирование завершено!'"));
		КонецЕсли;
		
		Если ДополнительныеПараметры = "ВыполнитьСписание" Тогда
			ОтборСтрок = Новый Структура("Обрабатывать", Истина);
			МассивЭтаповДляОбработки = Этапы.НайтиСтроки(ОтборСтрок);
			
			Для Каждого СтрЭтап Из МассивЭтаповДляОбработки Цикл
				Если Не СтрЭтап.Обрабатывать Тогда 
					Продолжить;
				КонецЕсли;
				
				Этап = СтрЭтап.ЭтапПроизводства;
				РасходыЗаполнены = ЗаполнитьРасходЭтапа(Этап);
				
				Если Не РасходыЗаполнены Тогда
					Возврат;
				КонецЕсли;
			КонецЦикла;
			
			ОповеститьПользователя(,,, Истина);
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru ='Списание завершено!'"));
		КонецЕсли; 
	КонецЕсли;
	
	УдалитьИзВременногоХранилища(Результат.АдресРезультата);
	
КонецПроцедуры

#КонецОбласти


