						СтрНЗ.КоличествоУпаковок = Окр(НовоеКоличествоДляРаспределения / ВсегоИзделий * СтрНЗ.Запланировано,0,РежимОкругления.Окр15как20); 	 //* ?(Норматив= 0,1,Норматив)		  //ОтмеченоЭтапов,0,РежимОкругления.Окр15как20);
					КонецЕсли;  
				Иначе 
