&НаСервере
Функция ОтменитьРасходМатериаловВЭтапе(Этап, Знач ЗаписьУспешна = Истина)
	
	ОбъектЭтап = Этап.ПолучитьОбъект(); 
	ОбъектЭтап.Статус = Перечисления.СтатусыЭтаповПроизводства2_2.Начат;
	ОбъектЭтап.КоличествоУпаковокФакт = 0.5;
	ОбъектЭтап.РасходМатериаловИРабот.Очистить(); 
	
	Попытка
		НачатьТранзакцию();
		ОбъектЭтап.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Сообщить("Не удалось отменить завершение этапа " + Этап);
		ЗаписьУспешна = Ложь;
	КонецПопытки;    
	
	Возврат ЗаписьУспешна;
	
КонецФункции

&НаСервере
Функция СформироватьПередачуМатериаловНаСервере(Этап)
	
	перем СписокОшибок;
	
	МассивСсылок = Новый Массив();
	МассивСсылок.Добавить(Этап);  
	
	ТабСклады = Этап.ОбеспечениеМатериаламиИРаботами.Выгрузить(,"Склад"); //.Свернуть("Склад");
	ТабСклады.Свернуть("Склад");
	КоличествоОтправителей = ТабСклады.Количество();
	
	ПараметрыОткрытия = СозданиеНаОснованииУТВызовСервера.ПараметрыОткрытияФормыНакладнойНаОснованииЗаказа(МассивСсылок,
			"ДвижениеПродукцииИМатериалов", ПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.ПередачаМатериаловВПроизводство"));
	
	СозданныеДокументы = Новый Массив;
	Если КоличествоОтправителей = 1 Тогда   //1 склад в ТЧ Обеспечение и 1 документ передачи материалов в производство
		
		ДанныеЗаполнения = ПараметрыОткрытия.ПараметрыФормы.Основание;  
		Документ = Документы.ДвижениеПродукцииИМатериалов.СоздатьДокумент();
		Документ.Заполнить(ДанныеЗаполнения);
		Документ.Дата = Объект.ПериодОтгрузки;  
		
		Попытка
			Документ.Записать(РежимЗаписиДокумента.Проведение);
			Возврат Истина;
		Исключение
			Сообщить("Ошибка формирования Передачи материалов "+Этап+"  "+ОписаниеОшибки());
			Возврат Ложь;
		КонецПопытки;
		
	Иначе  
		//Формирование нескольких документов Передачи материалов в производство по различным складам в ТЧ Обеспечение ЭтапаПроизводства
		РежимФормирования = 0;
		
		ОтборХозяйственныеОперации = ПараметрыОткрытия.ПараметрыФормы.СтруктураБыстрогоОтбора.ОтборХозяйственныеОперации;
		ОтборТипыДокументов = ПараметрыОткрытия.ПараметрыФормы.СтруктураБыстрогоОтбора.ОтборТипыДокументов;    
		
		Если ПараметрыОткрытия.ПараметрыФормы.Свойство("Распоряжения") Тогда
			Распоряжения.ЗагрузитьЗначения(ПараметрыОткрытия.ПараметрыФормы.Распоряжения);
		КонецЕсли;
		
		КлючНастроек = ПараметрыОткрытия.ПараметрыФормы.КлючНазначенияФормы;
		ТЗХозОперацииИТипыДокументов = ОбщегоНазначенияУТ.ДоступныеХозяйственныеОперацииИДокументы(ОписаниеОперацийИТиповДокументов(),
																	ОтборХозяйственныеОперации, ОтборТипыДокументов, КлючНастроек);   
		ХозяйственныеОперацииИДокументы.Загрузить(ТЗХозОперацииИТипыДокументов);																			
		
		СформироватьТекстыЗапросов();
		ОбновитьСписокРаспоряженияНаОформлениеНаСервере();
		
		ВыделенныеСтроки = СписокРаспоряженияНаОформление.Выгрузить();
		ГруппировкиРаспоряжений = Новый Массив; 
		Для Каждого Строка из ВыделенныеСтроки Цикл 
			//Строка = СписокРаспоряженияНаОформление.НайтиПоИдентификатору(ИдентификторСтроки); 
			ПоляГруппировки = "ХозяйственнаяОперация,ВнутренняяПереработка,ОрганизацияДавалец,Отправитель,Получатель"; 
			
			Группировка1 = ПолучитьГруппировку(ГруппировкиРаспоряжений, Строка, ПоляГруппировки, ХозяйственныеОперацииИДокументы, Ложь);
			Группировка1.МассивЗаказов.Добавить(Строка.Ссылка);   
			
		КонецЦикла;

		Если ЗначениеЗаполнено(ГруппировкиРаспоряжений) Тогда
			
			ПолеОшибки = "Объект.СписокРаспоряженияНаОформление";
			НакладныеСервер.СгруппироватьДокументыПоКлючевымПолямВКоллекции(ГруппировкиРаспоряжений, "МассивЗаказов", "КлючевыеПоляШапки");
			Результат = СформироватьДокументыПоРаспоряжениям(ГруппировкиРаспоряжений, СписокОшибок, ПолеОшибки);
			СозданныеДокументы = Результат.СозданныеДокументы; 
			СписокОшибок = Результат.СписокОшибок;
			Если СозданныеДокументы.Количество() > 0 Тогда 
				Возврат Истина;
			Иначе 
				Возврат Ложь;  
			КонецЕсли;
		КонецЕсли;
	КонецЕсли; 
	
КонецФункции   




