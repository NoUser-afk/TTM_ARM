&НаКлиенте
Функция ЗаполнитьМатериалыЭтапаПоДаннымРегистра(ЭтапПроизводства)
	
	Если ТекСтраница = "Резервирование" Тогда 
		ЭтоСписание = Ложь;
		//ТабЭтапы = ЭтапыРезервирование;
		ТабМатериалы = Объект.МатериалыРезервирование;
	ИначеЕсли ТекСтраница = "Списание" Тогда 
		ЭтоСписание = Истина;
		//ТабЭтапы = Этапы;
		ТабМатериалы = Объект.МатериалыСписание;
	КонецЕсли;
	//Для Каждого Стр из ТабЭтапы Цикл 
		//Если не Стр.Обрабатывать Тогда 
		//	Продолжить;
		//КонецЕсли;
		СтруктураКлючФормы = Новый Структура("Ключ",ЭтапПроизводства);
		Форма = ПолучитьФорму("Документ.ЭтапПроизводства2_2.ФормаОбъекта",СтруктураКлючФормы);
		ТЧОбеспечение = Форма.Объект.ОбеспечениеМатериаламиИРаботами;
		ТЧОбеспечение.Очистить();
		ПереченьКолонок = ПолучитьПереченьКолонокТЧМатериалыЭтапа();   
		//ТабМатериалы = 
		ПеренестиКорректировкиВТЧ(ЭтоСписание, ЭтапПроизводства, ПереченьКолонок);
		//ТЧОбеспечение.Загрузить(ТабМатериалы.Выгрузить()); //**Метод недоступен на клиенте**//
		Для Каждого Стр из ТабМатериалы Цикл 
			НоваяСтрока = ТЧОбеспечение.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока,Стр); 
		КонецЦикла;  
		//Форма.Объект.ОбеспечениеМатериаламиИРаботами = ТЧОбеспечение;
		Форма.Объект.НеОтгружатьЧастями = Истина; 
		Если ЭтоСписание Тогда 
			Форма.Объект.ДатаОтгрузки = Объект.ПериодОтгрузки;
		//Иначе 
		//	Форма.Объект.ДатаОтгрузки = ТекущаяДатаСеанса();
		КонецЕсли;
		Попытка
			Форма.Записать();
			Возврат Истина;
		Исключение
			Сообщить("Ошибка записи "+Стр.ЭтапПроизводства+"  "+ОписаниеОшибки());
			Возврат Ложь;
		КонецПопытки;
