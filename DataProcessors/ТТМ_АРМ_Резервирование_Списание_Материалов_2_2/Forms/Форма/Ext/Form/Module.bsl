#Область ПриИзмененииПолейФормы

&НаКлиенте
Процедура НомерЗаказаПриИзменении(Элемент)
	ЗаказВерный = ПроверитьВведенныйЗаказПользователем(Новый Структура("Назначение", Объект.НомерЗаказа));
	
	Если Не ЗаказВерный Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не верно выбран номер заказа'"),, "Объект.НомерЗаказа");
		Возврат;
	КонецЕсли;
	
	Новая_ЗаполнитьЭтапыНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура НомерЗаказаАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("СтрокаПоиска", Текст);
	СтруктураОтбора.Вставить("ВводПоСтрокеРасширенный", Истина);
	
	ДанныеВыбора = ПолучитьДанныеВыбораРасширенные(СтруктураОтбора);
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДанныеВыбораРасширенные(СтруктураОтбора)
	
	СписокВыбора = Новый СписокЗначений;
	СтрокаПоиска = СтрЗаменить(СтруктураОтбора.СтрокаПоиска, """", ""); 
	
	Если СтрокаПоиска <> "" И СтруктураОтбора.Свойство("ВводПоСтрокеРасширенный") Тогда
		МассивСловПоиска = СтрРазделить(СтрокаПоиска, " ", Ложь); 

		Запрос = Новый Запрос;
        Запрос.Текст = "ВЫБРАТЬ
                       |	Назначения.Ссылка КАК Заказ,
                       |	Назначения.Наименование КАК Наименование,
                       |	Назначения.ПометкаУдаления КАК ПометкаУдаления
                       |ИЗ
                       |	Справочник.Назначения КАК Назначения
                       |ГДЕ
                       |	Назначения.Наименование ПОДОБНО &СловоПоиска
                       |	И НЕ Назначения.ПометкаУдаления";
			
		Запрос.УстановитьПараметр("СловоПоиска", "%" + СтрокаПоиска + "%");
				
		Выборка = Запрос.Выполнить();
		ВыборкаДетальныеЗаписи = Выборка.Выбрать();
				
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			СтруктураОтбора = Новый Структура;
			СтруктураОтбора.Вставить("Значение", ВыборкаДетальныеЗаписи.Заказ);
			СтруктураОтбора.Вставить("ПометкаУдаления", ВыборкаДетальныеЗаписи.ПометкаУдаления);
			
			СписокВыбора.Добавить(СтруктураОтбора, ТТМ_ДанныеВыбораСервер.ПодсветитьСлова(ВыборкаДетальныеЗаписи.Наименование, МассивСловПоиска));
		КонецЦикла;
	
		ДанныеВыбора = СписокВыбора;
	КонецЕсли;
	
	Возврат ДанныеВыбора;	
КонецФункции

&НаКлиенте
Процедура НомерЗаказаОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
	Если Текст = "" Тогда
		ОчиститьЗаказНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПроверитьВведенныйЗаказПользователем(СтруктураОтбора, Знач ЗаказВерный = Истина)
	
	МассивНайденных = Этапы.НайтиСтроки(СтруктураОтбора);
	
	Если МассивНайденных.Количество() = 0 Тогда
		ЗаказВерный = Ложь;
	КонецЕсли;
	
	Если СтруктураОтбора["Назначение"] = Справочники.Назначения.ПустаяСсылка() Тогда
		ЗаказВерный = Истина;
	КонецЕсли;
		
	Возврат ЗаказВерный; 
КонецФункции

&НаКлиенте
Процедура РезервПриИзменении(Элемент)
	
	Если не ЗначениеЗаполнено(Объект.ПериодОтгрузки) Тогда 
		Объект.ПериодОтгрузки = ПолучитьТекущуюДату();
	КонецЕсли;
	
	ИсходнаяОперация = Не Объект.Резерв;
	ЕстьЗаписиВРегистреНеСоответствующиеОтбору = ПолучитьЗаписиРегистраПоОтбору(ИсходнаяОперация);
	
	Если ЕстьЗаписиВРегистреНеСоответствующиеОтбору Тогда     
		Сообщить("В регистре присутствуют данные, не соответствующие отбору!");
		Объект.Резерв = Не Объект.Резерв;
		Возврат;
	Иначе          
		ЭтаФорма.ТекущийЭлемент = Элементы.СтраницаЭтапы;
		Новая_ЗаполнитьЭтапыНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьТекущуюДату()
	Возврат ТекущаяДатаСеанса();
КонецФункции

&НаКлиенте
Процедура НоменклатураПриИзменении(Элемент)
	Списание = не Объект.Резерв;    
	
	/////////////////////////////////////////////////////////////////
	//Предупредить о потере данных
	////////////////////////////////////////////////////////////////
	ЗаписейВРегистре = ПолучитьКоличествоЗаписейРегистра(Списание);    
	Если ЗаписейВРегистре > 0 Тогда                                                                                      
		Номенклатура = ПолучитьНоменклатуруСпецификации(Спецификация);
		ДополнительныеПараметры = Новый Структура("ЭтоСписание,Номенклатура",не Объект.Резерв,Номенклатура);
		ОповещениеОбУдаленииЗаписейРегистра = Новый ОписаниеОповещения("УдалениеЗаписейРегистраПродолжение",ЭтаФорма,ДополнительныеПараметры);
		ПоказатьВопрос(ОповещениеОбУдаленииЗаписейРегистра,"Внимание, данные по номенклатуре! " + Номенклатура + "будут очищены! Продолжить?",РежимДиалогаВопрос.ДаНет,);
	КонецЕсли;
	//Если ЗаписейВРегистре > 0 Тогда  		
	//	УдалитьЗаписиРегистра(Списание);
	//КонецЕсли;
	////////////////////////////////////////////////////////////////
	
	Спецификация = ПредопределенноеЗначение("Справочник.РесурсныеСпецификации.ПустаяСсылка");
	Объект.НомерЗаказа = ПредопределенноеЗначение("Справочник.Назначения.ПустаяСсылка");
	
	АдресХранилищаНормативы = "";
	ДанныеПартииПроизводства = Неопределено;	
	Новая_ЗаполнитьЭтапыНаСервере();
	
КонецПроцедуры 

