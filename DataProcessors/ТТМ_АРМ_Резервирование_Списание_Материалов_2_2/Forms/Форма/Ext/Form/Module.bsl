	//ЕдиницаИзмерения_ШТ = ИсходныеДанныеСтрокиМатериаловСпецификации.Номенклатура.ЕдиницаИзмерения.ЕдиницаИзмерения = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("796",Истина);
	
	ЕдиницаИзмерения_ШТ = ТекущаяНоменклатура.ЕдиницаИзмерения.ЕдиницаИзмерения = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("796",Истина); //ИсходныеДанныеСтрокиМатериаловСпецификации.Номенклатура.ЕдиницаИзмерения.ЕдиницаИзмерения = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("796",Истина);
	
