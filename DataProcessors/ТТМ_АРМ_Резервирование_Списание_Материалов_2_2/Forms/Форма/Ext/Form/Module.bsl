//Процедура записывает в регистр данные по обеспечению материалами по данным Этапов производста.
//устанавливает каждой строке регистра Уникальный идентификатор для связи со строками дерева знрачений.
//Параметры: Период = период среза остатков по материалам;
&НаСервере
Процедура ЗаписатьДанныеРезервированиеСписаниеМатериаловВРегистрСведений(РезультатЗапроса, Период, ЭтоСписание, ДатаОтгрузкиМатериалов)
	
	ТабДанныеРегистра = РезультатЗапроса.Выгрузить();
	
	
	Если ТабДанныеРегистра.Количество() > 0 Тогда 
		
		НЗ = РегистрыСведений.ТТМ_АРМ_РезервированиеСписаниеМатериалов.СоздатьНаборЗаписей();
		ТекПользователь = Пользователи.АвторизованныйПользователь(); 
		НЗ.Отбор.Пользователь.Установить(ТекПользователь);
		НЗ.Отбор.ЭтоСписание.Установить(ЭтоСписание);
		НЗ.Прочитать();   	
		НЗ.Загрузить(ТабДанныеРегистра); 
		НЗ.Записать();
		
		ПараметрыОтбора = Новый Структура("Обрабатывать",Истина);
		МассивЭтапов = Этапы.НайтиСтроки(ПараметрыОтбора);   
				
		МассивНоменклатурыБезНормативов = Новый Массив;
		Для Каждого ЭлементМассива из МассивЭтапов Цикл 
			Этап = ЭлементМассива.ЭтапПроизводства;
			НЗ = РегистрыСведений.ТТМ_АРМ_РезервированиеСписаниеМатериалов.СоздатьНаборЗаписей();
			НЗ.Отбор.Пользователь.Установить(ТекПользователь);
			НЗ.Отбор.ЭтоСписание.Установить(ЭтоСписание);
			НЗ.Отбор.ЭтапПроизводства.Установить(Этап);
			НЗ.Прочитать();
			//Установим для каждой строки регистра УникальныйИдентификатор 
			//Этап = Неопределено; 
			
			Для Каждого СтрНЗ из НЗ Цикл 
				
				СтрНЗ.ДатаОтгрузки = ДатаОтгрузкиМатериалов; 
				СтрНЗ.ИдентификаторСтрокиРегистра = Новый УникальныйИдентификатор;
				
				//Получим нормативы
				УстановитьДанныеПартииПроизводства(Этап);  
				Нормативы = ПолучитьНормативыИзВременногоХранилища(Этап);  
				
				//Запишем нормативы в регистр 
				
				СтруктураПоиска = Новый Структура("Номенклатура",СтрНЗ.Номенклатура); //,КлючСвязиСпецификация,СтрНЗ.КлючСвязиСпецификация
				МассивНайденныхСтрок = Нормативы.ОбеспечениеМатериаламиИРаботами.НайтиСтроки(СтруктураПоиска);
				Если МассивНайденныхСтрок.Количество() > 1 Тогда 
					Сообщить("Норматив: найдено более 1 строки! " + СтрНЗ.Номенклатура);
				ИначеЕсли МассивНайденныхСтрок.Количество() = 1 Тогда 
					СтрНЗ.Норматив = МассивНайденныхСтрок[0].КоличествоУпаковок;
				Иначе   
					Если МассивНоменклатурыБезНормативов.Найти(СтрНЗ.Номенклатура) = Неопределено Тогда 
						МассивНоменклатурыБезНормативов.Добавить(СтрНЗ.Номенклатура);
					КонецЕсли;
					
				КонецЕсли; 
					
			КонецЦикла; 
			НЗ.Записать();
			АдресХранилищаНормативы = Неопределено;
		КонецЦикла;
		
		ТекстНачалаСообщения = "Данная позиция отсутствует в спецификации, норматив не найден:" + Символы.ПС;
		ТекстСообщения = "";
		Для Каждого СтрНоменклатура из МассивНоменклатурыБезНормативов Цикл 
			ТекстСообщения = ТекстСообщения + СтрНоменклатура + Символы.ПС;  //ТекстНачалаСообщения + 
		КонецЦикла;        
		Если не ТекстСообщения = "" Тогда 
			ТекстСообщения = ТекстНачалаСообщения + ТекстСообщения;
			Сообщить(ТекстСообщения);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры  

//Рабочая 30.04.2025
&НаСервере
Функция ЗаполнитьМатериалыСпецификации(Знач ПоЭтапам = Истина, Знач ЗапускФоновогоЗадания = Ложь, Знач ОчиститьВременныйРегистр = Ложь)
	
	//Параметры для фонового задания
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	       	
	///////////////////////////////////////////////////////////////
	ТаблицаВыбранныхЭтапов = ПолучитьКоличествоВыбранныхЭтапов(Истина);	
	Списание = Не Объект.Резерв;
	СтатусВыполнения = Ложь;
	
	Если Списание Тогда 
		Если Объект.РазрешитьОстаткиНаТекущуюДатуПриСписании Тогда 
			Если Месяц(Объект.ПериодОтгрузки) <> Месяц(ТекущаяДатаСеанса()) Тогда 
				ДатаОстатков = КонецМесяца(Объект.ПериодОтгрузки);
			Иначе 
				ДатаОстатков = ТекущаяДатаСеанса();
			КонецЕсли;
		Иначе   
			ДатаОстатков = Объект.ПериодОтгрузки; 
		КонецЕсли; 
		ДатаОтгрузкиМатериалов = Объект.ПериодОтгрузки;
	Иначе 
		ДатаОстатков = ТекущаяДатаСеанса();
		ДатаОтгрузкиМатериалов = ТекущаяДатаСеанса();
	КонецЕсли;
	ОтборПоВариантамОбеспечения = ОтборВариантОбеспечения;
	
	Если ПоЭтапам Тогда		
		
		ИмяФункции = "ТТМ_ДанныеВыбораСервер.ПолучитьМатериалыПоДаннымЭтаповДляРегистра";
		//++ Дарвин А.А. 16.01.2024
		МассивСкладов = Новый Массив;
		МассивСкладов.Добавить(Объект.Склад);
		МассивСкладов.Добавить(Объект.СкладПФ);
		Если ЗапускФоновогоЗадания Тогда
			Возврат ДлительныеОперации.ВыполнитьФункцию(
		 		ПараметрыВыполнения, 
				ИмяФункции,
		 		ДатаОстатков, 
				МассивСкладов, 
				Списание, 
				ТаблицаВыбранныхЭтапов, 
				Объект.ДР_КатегорияМатериала);
		КонецЕсли;		 			
	КонецЕсли;
	ДанныеРегистра = ПолучитьМатериалыПоРегистру(ОтборПоВариантамОбеспечения, ДатаОстатков, Объект.Склад, Списание);
	ВыборкаМатериалов = ДанныеРегистра.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Объект.МатериалыСпецификации.Очистить();
	
	МассивНоменклатурыБезОстатка = Новый Массив;  
	СписокНоменклатурыБезОстатка.Очистить();
	Пока ВыборкаМатериалов.Следующий() Цикл  
		НоваяСтрока = Объект.МатериалыСпецификации.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,ВыборкаМатериалов);   
		КонтрольОстатка = ?(ЗначениеЗаполнено(ВыборкаМатериалов.Остаток),ВыборкаМатериалов.Остаток,0) - ?(ЗначениеЗаполнено(ВыборкаМатериалов.ПодобраноНаТСД),ВыборкаМатериалов.ПодобраноНаТСД,ВыборкаМатериалов.Обеспечить) - ВыборкаМатериалов.Зарезервировать - ВыборкаМатериалов.Отгрузить;
		НоваяСтрока.КонтрольОстатка = КонтрольОстатка; 
		
		Если КонтрольОстатка < 0 Тогда 
			МассивНоменклатурыБезОстатка.Добавить(ВыборкаМатериалов.Номенклатура); 
			СписокНоменклатурыБезОстатка.Добавить(ВыборкаМатериалов.Номенклатура); 
		КонецЕсли;
		
		Если ВыборкаМатериалов.ОтборПоВариантамОбеспечения = ВыборкаМатериалов.МАХОтборПоВариантамОбеспечения Тогда 
			НоваяСтрока.УО_ОтборПоВариантамОбеспечения = ВыборкаМатериалов.МАХОтборПоВариантамОбеспечения;
		Иначе 
			НоваяСтрока.УО_ОтборПоВариантамОбеспечения = 1;
		КонецЕсли;
		СтатусВыполнения = Истина;
	КонецЦикла;  
	
	Если МассивНоменклатурыбезОстатка.Количество() <> 0 Тогда 
		
	КонецЕсли;


	Возврат СтатусВыполнения;
	
КонецФункции

