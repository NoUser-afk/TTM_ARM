						//Если СтрНЗ.ВариантОбеспечения = ВО_Зарезервировать или СтрНЗ.ВариантОбеспечения = ВО_Отгрузить Тогда 
						//	Сообщить("В строке по номенклатуре " + Номенклатура +" количество заменено на подобранное", СтатусСообщения.Важное);
						//	//СтрНЗ.КоличествоУпаковок = СтрНЗ.КоличествоУпаковок + СтрНЗ.ПодобраноНаТСД;
						//	СтрНЗ.КоличествоУпаковок = СтрНЗ.ПодобраноНаТСД;
						//Иначе 
						//	СтрНЗ.КоличествоУпаковок = СтрНЗ.ПодобраноНаТСД;
						//	СтрНЗ.ВариантОбеспечения = ВариантОбеспеченияНовый;
						//КонецЕсли;   
						СтрНЗ.КоличествоУпаковок = СтруктураОтбора.ПодборНаТСД;
						СтрНЗ.ПодобраноНаТСД = 0;
						Числитель = ?(ЗначениеЗаполнено(СтруктураОтбора.ПодборУпаковка.Числитель),СтруктураОтбора.ПодборУпаковка.Числитель,1);
						Знаменатель = ?(ЗначениеЗаполнено(СтруктураОтбора.ПодборУпаковка.Знаменатель),СтруктураОтбора.ПодборУпаковка.Знаменатель,1); 
						СтрНЗ.Количество = СтрНЗ.КоличествоУпаковок * Числитель / Знаменатель;
					КонецЕсли;
					СтрНЗ.ВариантОбеспечения = ВариантОбеспеченияНовый;
					Если ВариантОбеспеченияНовый = ВО_Зарезервировать или ВариантОбеспеченияНовый = ВО_Отгрузить Тогда 
						СтрНЗ.Обособленно = Ложь;
					Иначе 
						СтрНЗ.Обособленно = Истина;
					КонецЕсли;                                                                      
					Если ВариантОбеспеченияНовый = Перечисления.ВариантыОбеспечения.Отгрузить Тогда 
						СтрНЗ.ОтборПоВариантамОбеспечения = 5;
					ИначеЕсли ВариантОбеспеченияНовый = Перечисления.ВариантыОбеспечения.СоСклада Тогда
						СтрНЗ.ОтборПоВариантамОбеспечения = 4;
					ИначеЕсли ВариантОбеспеченияНовый = Перечисления.ВариантыОбеспечения.РезервироватьПоМереПоступления Тогда
						СтрНЗ.ОтборПоВариантамОбеспечения = 3;
					ИначеЕсли ВариантОбеспеченияНовый = Перечисления.ВариантыОбеспечения.КОбеспечению Тогда 
						СтрНЗ.ОтборПоВариантамОбеспечения = 1;
					КонецЕсли; 
					Если не СтрНЗ.Обособленно Тогда 
						СтрНЗ.Назначение = Назначение; //Справочники.Назначения.ПустаяСсылка();
					Иначе 
						Если не ЗначениеЗаполнено(СтрНЗ.Назначение) Тогда 
							СтрНЗ.Назначение = Назначение; //СтрНЗ.ЭтапПроизводства.НазначениеПродукция;
						КонецЕсли;
					КонецЕсли;	
				КонецЕсли; 
			КонецЦикла;
			НЗ.Записать(); 
		//3. изменение количества (общего, в ТЧ МатериалыСпецификации)
		ИначеЕсли ЗначениеЗаполнено(НовоеКоличествоУпаковокОбщее) Тогда  
			НовоеКоличествоДляРаспределения = НовоеКоличествоУпаковокОбщее;
			РаспределитьКоличествоНаСервере(,НЗ);
		//4. изменение количества (в ТЧ РаспрееделениеМатериала)
		ИначеЕсли ЗначениеЗаполнено(НовоеКоличествоУпаковок) Тогда 
			Если НЗ.Количество() = 1 Тогда 
				Для Каждого СтрНЗ из НЗ Цикл
					СтрНЗ.КоличествоУпаковок = НовоеКоличествоУпаковок;   
					Упаковка = СтрНЗ.Упаковка;
					Знаменатель = ?(ЗначениеЗаполнено(Упаковка.Знаменатель),Упаковка.Знаменатель,1);
					Числитель = ?(ЗначениеЗаполнено(Упаковка.Числитель),Упаковка.Числитель,1);
					КоэффициентУпаковки = Знаменатель/Числитель;
					СтрНЗ.Количество = НовоеКоличествоУпаковок * КоэффициентУпаковки;     
					СтрНЗ.Обеспечить = СтрНЗ.Норматив - (НовоеКоличествоУпаковок - СтрНЗ.Количество);
				КонецЦикла;   
				НЗ.Записать();
			ИначеЕсли НЗ.Количество() > 1 Тогда  
				Сообщить("Найдено более 1 записи регистра при изменении количества в  ТЧ РаспределениеМатериаловСпецификации", СтатусСообщения.Важное);
			Иначе 
				Сообщить("Не найдено записи регистра для изменения при изменении количества в  ТЧ РаспределениеМатериаловСпецификации", СтатусСообщения.Важное);
			КонецЕсли;
			НЗ.Записать();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

