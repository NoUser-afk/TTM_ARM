&НаСервере
Процедура ЗаполнитьРеквизитыРФ_УстановитьПривилегированныйРежим(Включить)
	Если не Включить Тогда 
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;
	УстановитьПривилегированныйРежим(Включить);
	Если Включить Тогда 
		УстановитьБезопасныйРежим(Истина);
		УстановитьБезопасныйРежим(Ложь);
	Иначе 
		УстановитьБезопасныйРежим(Истина);
	КонецЕсли;
	РФ_ПривилегированныйРежим = ПривилегированныйРежим();
	РФ_БезопасныйРежим = БезопасныйРежим();
КонецПроцедуры

&НаСервере
Процедура ЗапроситьРазрешениеНаУстановкуПривилегированногоРежима()
	СписокИДЗапросовРазрешений.Очистить();
	Разрешение = РаботаВБезопасномРежиме.РазрешениеНаИспользованиеПривилегированногоРежима("Разрешение привилегированного режима для пользователей с ограниченными правами");
	МассивРазрешений = Новый Массив;
	МассивРазрешений.Добавить(Разрешение);
	ИДЗапроса = РаботаВБезопасномРежиме.ЗапросНаИспользованиеВнешнихРесурсов(МассивРазрешений, ЭтотОбъект, Истина);
	СписокИДЗапросовРазрешений.Добавить(ИДЗапроса);
КонецПроцедуры

