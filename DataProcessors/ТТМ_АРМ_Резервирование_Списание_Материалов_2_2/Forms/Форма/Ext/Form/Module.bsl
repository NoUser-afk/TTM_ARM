&НаСервере
Процедура ЗарезервироватьВыбранныеСтрокиНаСервере(МассивИДСтрокМатериалов, ВариантОбеспеченияНовый, Обособленно);
	
	ИДСтрокиМатериалыСпецификации = МассивИДСтрокМатериалов[0];
	
	//Запомним Номенклатру текущей строки ТЧ МатериалыСпецификации     
	Если не Элементы.МатериалыСпецификации.ТекущаяСтрока = Неопределено Тогда 
		ПерваяСтрокаВыделения = Объект.МатериалыСпецификации.НайтиПоИдентификатору(ИДСтрокиМатериалыСпецификации);
	Иначе            
		Если Объект.МатериалыСпецификации.Количество() > 0 Тогда 
			ПерваяСтрокаВыделения = Объект.МатериалыСпецификации.НайтиПоИдентификатору(0);
		КонецЕсли;
	КонецЕсли;
	
	ИндексТекСтроки = Объект.МатериалыСпецификации.Индекс(ПерваяСтрокаВыделения);
	Номенклатура = ПерваяСтрокаВыделения.Номенклатура;
	Остаток = ПерваяСтрокаВыделения.Остаток;
	
	//ВариантОбеспеченияНовый = ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.СоСклада");
	//Обособленно = Ложь;   
	Для Каждого ИДСтроки из МассивИДСтрокМатериалов Цикл 
		ТекСтрока = объект.МатериалыСпецификации.НайтиПоИдентификатору(ИДСтроки);
		СтруктураОтбора = Новый Структура("Номенклатура");
		ЗаполнитьЗначенияСвойств(СтруктураОтбора,ТекСтрока);
		УстановитьВариантОбеспеченияНовая(ВариантОбеспеченияНовый,Обособленно,НЕ Объект.Резерв,СтруктураОтбора);
		
		Если ТекСтрока.Остаток < ТекСтрока.КоличествоУпаковок Тогда 
			Сообщить("По номенклатуре "+ТекСтрока.Номенклатура+" Зарезеовировано только доступное для резерва количество!",СтатусСообщения.Важное);
			НовоеКоличествоДляРаспределения = ТекСтрока.КоличествоУпаковок;
			НЗ = РегистрыСведений.ТТМ_АРМ_РезервированиеСписаниеМатериалов.СоздатьНаборЗаписей();
			НЗ.Отбор.Пользователь.Установить(Пользователи.АвторизованныйПользователь());
			НЗ.Отбор.Номенклатура.Установить(ТекСтрока.Номенклатура);
			НЗ.Прочитать();                             
			Если ЗначениеЗаполнено(ТекСтрока.Норматив) Тогда 
				Норматив = ТекСтрока.Норматив;
			Иначе 
				Норматив = 1;
			КонецЕсли;
			РаспределитьКоличествоНаСервере(НЗ,Норматив);
		КонецЕсли;
	КонецЦикла;  
	
	ПоЭтапам = Ложь;
	ОбновитьМатериалыСпецификацииНаСервере(ПоЭтапам); 
	
	ЗаполнитьТЧРаспределениеМатериалаПоДаннымРегистра(Номенклатура); 
	Элементы.РаспределениеМатериала.ТекущаяСтрока = 0;
	
	//Восстановим ТекущуюСтроку ТЧ (по номенклатуре)          
	ПараметрыОтбора = Новый Структура("Номенклатура",Номенклатура);
	МассивСтрокПоНоменклатуре = Объект.МатериалыСпецификации.НайтиСтроки(ПараметрыОтбора);
	
	Если МассивСтрокПоНоменклатуре.Количество() > 0 Тогда 
		ПерваяСтрокаВыделения = Объект.МатериалыСпецификации.НайтиСтроки(ПараметрыОтбора)[0]; 
		Элементы.МатериалыСпецификации.ТекущаяСтрока = ПерваяСтрокаВыделения.ПолучитьИдентификатор();
	Иначе 
		Элементы.МатериалыСпецификации.ТекущаяСтрока = 0;
	КонецЕсли;
	
	УстановитьУсловноеОформлениеМатериаловСпецификации();	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьПодобранныеМатериалы(Команда)
	
	ПроверкаВыполнена = ПроверкаЗаполненияВажныхПолейФормы(Команда.Действие);
	
	Если Не ПроверкаВыполнена Тогда
		Возврат;
	КонецЕсли;
		
	МассивЭтапов = Новый СписокЗначений;
	
	Для Каждого Стр из Этапы Цикл 
		Если стр.Обрабатывать и МассивЭтапов.НайтиПоЗначению(Стр.ЭтапПроизводства) = Неопределено Тогда
			МассивЭтапов.Добавить(Стр.ЭтапПроизводства);
		КонецЕсли;
	КонецЦикла;
	
	ЗагрузитьПодборНаСервере(); 
	  	
	ПоЭтапам = Ложь;
	ОбновитьМатериалыСпецификацииНаСервере(ПоЭтапам);
КонецПроцедуры      

