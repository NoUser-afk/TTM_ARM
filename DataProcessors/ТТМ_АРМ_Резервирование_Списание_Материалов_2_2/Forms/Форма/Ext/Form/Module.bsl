&НаСервере
Функция ПолучитьТабОстаткиМатериалов(ТабМатериалов)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТабМатериалов.Номенклатура КАК Номенклатура
	               |ПОМЕСТИТЬ ТабНоменклатура
	               |ИЗ
	               |	&ТабМатериалов КАК ТабМатериалов
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТабНоменклатура.Номенклатура КАК Номенклатура,
	               |	ЕСТЬNULL(СвободныеОстаткиОстатки.ВНаличииОстаток, 0) КАК Остаток
	               |ИЗ
	               |	ТабНоменклатура КАК ТабНоменклатура
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.СвободныеОстатки.Остатки КАК СвободныеОстаткиОстатки
	               |		ПО ЕСТЬNULL(ТабНоменклатура.Номенклатура,Значение(Справочник.Номенклатура.ПустаяСсылка)) = ЕСТЬNULL(СвободныеОстаткиОстатки.Номенклатура,Значение(Справочник.Номенклатура.ПустаяСсылка))";
	Запрос.УстановитьПараметр("ТабМатериалов", ТабМатериалов.Выгрузить());
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

&НаСервере
Функция ПолучитьЗаписиРегистраПоОтбору(ЗначениеРеквизитаРезервДо)
	
	НЗ = РегистрыСведений.ТТМ_АРМ_РезервированиеСписаниеМатериалов.СоздатьНаборЗаписей();
	НЗ.Отбор.Пользователь.Установить(Пользователи.АвторизованныйПользователь());
	НЗ.Отбор.ЭтоСписание.Установить(ЗначениеРеквизитаРезервДо);
	НЗ.Прочитать();
	Если НЗ.Количество()>0 Тогда 
		Возврат Истина;
	Иначе 
		Возврат Ложь
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура ПроверитьУстановитьЭтоСписание()
	НЗ = РегистрыСведений.ТТМ_АРМ_РезервированиеСписаниеМатериалов.СоздатьНаборЗаписей();
	НЗ.Отбор.Пользователь.Установить(Пользователи.АвторизованныйПользователь());
	//НЗ.Отбор.ЭтоСписание = не Объект.Резерв;
	НЗ.Прочитать(); 
	Если НЗ.Количество() > 0 Тогда 
		//проверить что по этому пользователю и Призна
		НЗ.Очистить();
		НЗ.Записать();  
		поЭтапам = Истина;
		ОбновитьМатериалыСпецификацииНаСервере(ПоЭтапам);
	КонецЕсли;
КонецПроцедуры

