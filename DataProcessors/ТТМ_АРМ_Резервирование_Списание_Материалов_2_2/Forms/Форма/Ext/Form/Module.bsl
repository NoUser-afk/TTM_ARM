		МассивОтмеченныхСтрок = Объект.РаспределениеМатериала.Выгрузить(ПараметрыОтбора,"Отметка");
		КоличествоОтмеченныхЭтапов = МассивОтмеченныхСтрок.Количество();
		РасходВсего = Объект.РаспределениеМатериала.Итог("КоличествоУпаковок");
