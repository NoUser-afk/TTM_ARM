#Область ТТМ_АРМ_СписаниеРезервированиеГлобальныеПеременные 

&НаКлиенте
Перем ДанныеИсходнойСтроки;

&НаКлиенте
Перем ТекСтраница;

&НаКлиенте
Перем ТолькоРезерв;

&НаКлиенте
Перем ЗакрытьФормуОбработки;

&НаКлиенте
Перем МассивОбрабатываемыхСтрок;   

#КонецОбласти

&НаСервере
Функция ПолучитьНормативыПоСпецификации(ПолучатьМатериалыПоТребованию, Знач ПереченьДанных = Неопределено, ЭтапОбъект1)
	
	ДанныеПартииПроизводстваКопия = ОбщегоНазначения.СкопироватьРекурсивно(ДанныеПартииПроизводства, Ложь);
	КоэффициентПлан = Справочники.УпаковкиЕдиницыИзмерения.КоэффициентУпаковки
			(ЭтапОбъект1.УпаковкаПлан, Объект.Номенклатура);
	КоличествоПлан = ЭтапОбъект1.КоличествоУпаковокПлан * КоэффициентПлан;
	ДанныеПартииПроизводстваКопия.Количество = КоличествоПлан;
	
	Возврат Документы.ЭтапПроизводства2_2.ПолучитьНормативыПоСпецификации(
		ДанныеПартииПроизводстваКопия,
		ПолучатьМатериалыПоТребованию,
		ПереченьДанных);
	
КонецФункции
	

//** Нормативы **//
#Область Нормативы

&НаСервере
Функция ПолучитьНормативыИзВременногоХранилища(Этап)
	
	//*****************30.09.2024
	УстановитьДанныеПартииПроизводства(Этап);
	//****************

	Если ЭтоАдресВременногоХранилища(АдресХранилищаНормативы) Тогда
		
		Результат = ПолучитьИзВременногоХранилища(АдресХранилищаНормативы);
		Возврат Результат;
		
	КонецЕсли;
	
	Результат = Новый Структура();
	
	ДанныеСпецификации = ПолучитьНормативыПоСпецификации(Истина, "МатериалыИУслуги,ВходящиеИзделия,Трудозатраты",Этап);
	
	Если ДанныеСпецификации <> Неопределено Тогда
		
		Таблица = ДанныеСпецификации.МатериалыИУслуги.Скопировать(, "Номенклатура,Характеристика,Упаковка,ДанныеУпаковки,КоличествоУпаковок"); // ТаблицаЗначений - 
		Таблица.Свернуть("Номенклатура,Характеристика,Упаковка,ДанныеУпаковки", "КоличествоУпаковок");
		Результат.Вставить("ОбеспечениеМатериаламиИРаботами", Таблица);
		
		Таблица = ДанныеСпецификации.Трудозатраты.Скопировать(, "ВидРабот,Количество"); // ТаблицаЗначений - 
		Таблица.Свернуть("ВидРабот", "Количество");
		Результат.Вставить("Трудозатраты", Таблица);
		
	КонецЕсли;
	
	АдресХранилищаНормативы = ПоместитьВоВременноеХранилище(Результат, УникальныйИдентификатор);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти
//**/////////////////**//

&НаСервере 
//Не используется
Функция ПолучитьМатериалыПоЭтапам(ОтборПоВариантамОбеспечения, ДатаОстатков, Склад, Списание)
	
	ТаблицаЭтапов = РеквизитФормыВЗначение("Этапы", Тип("ТаблицаЗначений"));

	Если ТаблицаЭтапов.Количество() = 0 Тогда 
		Возврат Неопределено;
	КонецЕсли;
	
	ТекстЗапросаУсловие = СформироватьТекстУсловияДляЗапроса(ОтборПоВариантамОбеспечения, Списание);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТабЭтапы.Обрабатывать КАК Обрабатывать,
	               |	ТабЭтапы.Статус КАК Статус,
	               |	ТабЭтапы.ЭтапПроизводства КАК ЭтапПроизводства,
	               |	ТабЭтапы.КоличествоУпаковокФакт КАК КоличествоУпаковокФакт,
	               |	ТабЭтапы.Назначение КАК Назначение,
	               |	ТабЭтапы.Спецификация КАК Спецификация
	               |ПОМЕСТИТЬ ВТ_Этапы
	               |ИЗ
	               |	&ТабЭтапы КАК ТабЭтапы
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_Этапы.Обрабатывать КАК Обрабатывать,
	               |	ВТ_Этапы.Статус КАК Статус,
	               |	ВТ_Этапы.ЭтапПроизводства КАК ЭтапПроизводства,
	               |	ВТ_Этапы.КоличествоУпаковокФакт КАК КоличествоУпаковокФакт,
	               |	ВТ_Этапы.Назначение КАК Назначение,
	               |	ВТ_Этапы.Спецификация КАК Спецификация
	               |ПОМЕСТИТЬ Таб_ЭтапыДляОбработки
	               |ИЗ
	               |	ВТ_Этапы КАК ВТ_Этапы
	               |ГДЕ
	               |	ВТ_Этапы.Обрабатывать = ИСТИНА
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	РесурсныеСпецификацииМатериалыИУслуги.Номенклатура КАК Номенклатура,
	               |	РесурсныеСпецификацииМатериалыИУслуги.КоличествоУпаковок КАК Норматив,
	               |	ВЫБОР
	               |		КОГДА ЕСТЬNULL(РесурсныеСпецификацииМатериалыИУслуги.Упаковка, ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
	               |			ТОГДА РесурсныеСпецификацииМатериалыИУслуги.Номенклатура.ЕдиницаИзмерения
	               |		ИНАЧЕ РесурсныеСпецификацииМатериалыИУслуги.Упаковка
	               |	КОНЕЦ КАК Упаковка,
	               |	РесурсныеСпецификацииМатериалыИУслуги.Ссылка КАК Спецификация,
	               |	РесурсныеСпецификацииМатериалыИУслуги.СтатьяКалькуляции КАК СтатьяКалькуляции,
	               |	РесурсныеСпецификацииВыходныеИзделия.Номенклатура КАК ВыходноеИзделие
	               |ПОМЕСТИТЬ НормативыпоСпецификации
	               |ИЗ
	               |	Справочник.РесурсныеСпецификации.ВыходныеИзделия КАК РесурсныеСпецификацииВыходныеИзделия
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.РесурсныеСпецификации.МатериалыИУслуги КАК РесурсныеСпецификацииМатериалыИУслуги
	               |		ПО РесурсныеСпецификацииВыходныеИзделия.Ссылка = РесурсныеСпецификацииМатериалыИУслуги.Ссылка
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Таб_ЭтапыДляОбработки КАК Таб_ЭтапыДляОбработки
	               |		ПО РесурсныеСпецификацииВыходныеИзделия.Ссылка = Таб_ЭтапыДляОбработки.Спецификация
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	НоменклатураДополнительныеРеквизиты.Ссылка КАК СсылкаНаНоменклатуру,
	               |	НоменклатураДополнительныеРеквизиты.Свойство КАК Свойство,
	               |	НоменклатураДополнительныеРеквизиты.Значение КАК Значение
	               |ПОМЕСТИТЬ ЗначенияДополнительногоРеквизита
	               |ИЗ
	               |	НормативыпоСпецификации КАК НормативыпоСпецификации
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура.ДополнительныеРеквизиты КАК НоменклатураДополнительныеРеквизиты
	               |		ПО НормативыпоСпецификации.Номенклатура = НоменклатураДополнительныеРеквизиты.Ссылка
	               |ГДЕ
	               |	НоменклатураДополнительныеРеквизиты.Свойство = &Свойство
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ЕСТЬNULL(ЗначенияДополнительногоРеквизита.Значение, ЗНАЧЕНИЕ(Справочник.ЗначенияСвойствОбъектов.ПустаяСсылка)) КАК КатегорияМатериала,
	               |	ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Номенклатура.ВидНоменклатуры КАК ВидНоменклатуры,
	               |	ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Номенклатура КАК Номенклатура,
	               |	ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Ссылка КАК ЭтапПроизводства,
	               |	ВЫБОР
	               |		КОГДА ЕСТЬNULL(ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Упаковка, ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
	               |			ТОГДА ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Номенклатура.ЕдиницаИзмерения
	               |		ИНАЧЕ ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Упаковка
	               |	КОНЕЦ КАК Упаковка,
	               |	1 КАК КоличествоСтрок,
	               |	НормативыпоСпецификации.Норматив КАК Норматив,
	               |	ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Количество КАК КоличествоВЭтапе,
	               |	ВЫБОР
	               |		КОГДА ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.ВариантОбеспечения = ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.РезервироватьПоМереПоступления)
				   |			ИЛИ ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.ВариантОбеспечения = ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.КОбеспечению)
	               |			ТОГДА ЕСТЬNULL(ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Количество, 0)
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК Обеспечить,
	               |	ВЫБОР
	               |		КОГДА ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.ВариантОбеспечения = ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.Отгрузить)
	               |			ТОГДА ЕСТЬNULL(ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Количество, 0)
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК Отгрузить,
	               |	ВЫБОР
	               |		КОГДА ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.ВариантОбеспечения = ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.СоСклада)
	               |			ТОГДА ЕСТЬNULL(ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Количество, 0)
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК Зарезервировать,
	               |	0 КАК Остаток,
	               |	ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.ВариантОбеспечения КАК ВариантОбеспечения,
	               |	ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Склад КАК Склад,
	               |	ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Назначение КАК Назначение,
	               |	НормативыпоСпецификации.СтатьяКалькуляции КАК СтатьяКалькуляции,
	               |	НормативыпоСпецификации.ВыходноеИзделие КАК ВыходноеИзделие,
	               |	НормативыпоСпецификации.Спецификация КАК Спецификация
	               |ПОМЕСТИТЬ ПредварительныеДанные
	               |ИЗ
	               |	Документ.ЭтапПроизводства2_2.ОбеспечениеМатериаламиИРаботами КАК ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами
	               |		ЛЕВОЕ СОЕДИНЕНИЕ НормативыпоСпецификации КАК НормативыпоСпецификации
	               |		ПО (ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Номенклатура = ЕСТЬNULL(НормативыпоСпецификации.Номенклатура, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)))
	               |			И ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Ссылка.Спецификация = НормативыпоСпецификации.Спецификация
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ЗначенияДополнительногоРеквизита КАК ЗначенияДополнительногоРеквизита
	               |		ПО (ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Номенклатура = ЕСТЬNULL(ЗначенияДополнительногоРеквизита.СсылкаНаНоменклатуру, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)))
	               |ГДЕ
	               |	ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Ссылка В
	               |			(ВЫБРАТЬ
	               |				Т.ЭтапПроизводства
	               |			ИЗ
	               |				Таб_ЭтапыДляОбработки КАК Т)";
	Запрос.Текст = Запрос.Текст + "
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
				   |ВЫБРАТЬ
	               |	ПредварительныеДанные.КатегорияМатериала КАК КатегорияМатериала,
	               |	ПредварительныеДанные.ВидНоменклатуры КАК ВидНоменклатуры,
	               |	ПредварительныеДанные.Номенклатура КАК Номенклатура,
	               |	ПредварительныеДанные.ЭтапПроизводства КАК ЭтапПроизводства,
	               |	ПредварительныеДанные.Упаковка КАК Упаковка,
	               |	ПредварительныеДанные.КоличествоСтрок КАК КоличествоСтрок,  //**//
				   |	ПредварительныеДанные.Количествоэтапов КАК КоличествоЭтапов,
	               |	ПредварительныеДанные.Норматив КАК Норматив,
	               |	ПредварительныеДанные.КоличествоВЭтапе КАК КоличествоВЭтапе,
	               |	ПредварительныеДанные.Обеспечить КАК Обеспечить,
	               |	ПредварительныеДанные.Отгрузить КАК Отгрузить,
	               |	ПредварительныеДанные.Зарезервировать КАК Зарезервировать,
	               |	ПредварительныеДанные.Остаток КАК Остаток,
	               |	ПредварительныеДанные.ВариантОбеспечения КАК ВариантОбеспечения,
	               |	ПредварительныеДанные.Склад КАК Склад,
	               |	ПредварительныеДанные.Назначение КАК Назначение,
	               |	ПредварительныеДанные.Спецификация КАК Спецификация,
				   |	ПредварительныеДанные.СтатьяКалькуляции КАК СтатьяКалькуляции,
				   |	ПредварительныеДанные.ВыходноеИзделие КАК ВыходноеИзделие,
	               |	ПредварительныеДанные.Отгрузить + ПредварительныеДанные.Зарезервировать КАК Расход
	               |ИЗ
	               |	ПредварительныеДанные КАК ПредварительныеДанные
	               |ГДЕ %ТекстЗапросаУсловие
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Номенклатура, ЭтапПроизводства 
	               |ИТОГИ
				   |	СУММА(КоличествоСтрок),
	               |	МАКСИМУМ(ВидНоменклатуры),
	               |	СУММА(Норматив),
	               |	СУММА(Обеспечить),
	               |	СУММА(Отгрузить),
	               |	СУММА(Зарезервировать),
	               |	СРЕДНЕЕ(Остаток),
	               |	МАКСИМУМ(Склад),
	               |	МАКСИМУМ(Назначение),
	               |	МАКСИМУМ(Спецификация),
	               |	СУММА(Расход)
	               |ПО
	               |	Номенклатура
	               |АВТОУПОРЯДОЧИВАНИЕ";

	Запрос.УстановитьПараметр("ТабЭтапы", ТаблицаЭтапов);	
	Запрос.УстановитьПараметр("ДатаОстатков",ДатаОстатков);
	Запрос.УстановитьПараметр("Свойство",Объект.ДР_КатегорияМатериала);
	
	Если ТекстЗапросаУсловие <> "" Тогда 
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"%ТекстЗапросаУсловие",ТекстЗапросаУсловие);
		Если СтрНайти(ТекстЗапросаУсловие,"&КатегорияМатериала") > 0 Тогда  
			Запрос.УстановитьПараметр("КатегорияМатериала", ОтборКатегорияМатериала);
		КонецЕсли;
	Иначе 
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"ГДЕ %ТекстЗапросаУсловие","");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Склад", Склад);
	РезультатЗапроса = Запрос.Выполнить();
	Возврат РезультатЗапроса;
	
КонецФункции

&НаСервере     
//Исправила Списание/Резерв
Функция СформироватьТекстУсловияДляЗапроса(ОтборПоВариантамОбеспечения, Списание)
	
	ТекстЗапросаУсловие = "";
	Если ЗначениеЗаполнено(ОтборКатегорияМатериала) Тогда 
		Если ТекстЗапросаУсловие <> "" Тогда
			ТекстЗапросаУсловие = ТекстЗапросаУсловие + Символы.ПС + " И ";
		КонецЕсли;
		ТекстЗапросаУсловие = ТекстЗапросаУсловие + " ПредварительныеДанные.КатегорияМатериала = &КатегорияМатериала"; // + Символы.ПС;
	КонецЕсли;
	Если ОтборПоВариантамОбеспечения = 1 Тогда  //Необеспеченные
		Если ТекстЗапросаУсловие <> "" Тогда
			ТекстЗапросаУсловие = ТекстЗапросаУсловие + Символы.ПС + " И ";
		КонецЕсли;
		ТекстЗапросаУсловие = ТекстЗапросаУсловие + " ПредварительныеДанные.ВариантОбеспечения = Значение(перечисление.ВариантыОбеспечения.КОбеспечению) ";
	ИначеЕсли ОтборПоВариантамОбеспечения = 3 Тогда  //Мягкий резерв
		Если ТекстЗапросаУсловие <> "" Тогда
			ТекстЗапросаУсловие = ТекстЗапросаУсловие + Символы.ПС + " И ";
		КонецЕсли;
		ТекстЗапросаУсловие = ТекстЗапросаУсловие + " ПредварительныеДанные.ВариантОбеспечения = Значение(перечисление.ВариантыОбеспечения.РезервироватьПоМереПоступления) ";
	ИначеЕсли ОтборПоВариантамОбеспечения = 4 Тогда  //Зарезервированные
		Если ТекстЗапросаУсловие <> "" Тогда
			ТекстЗапросаУсловие = ТекстЗапросаУсловие + Символы.ПС + " И ";
		КонецЕсли;
		ТекстЗапросаУсловие = ТекстЗапросаУсловие + " ПредварительныеДанные.ВариантОбеспечения = Значение(перечисление.ВариантыОбеспечения.СоСклада) ";
	ИначеЕсли ОтборПоВариантамОбеспечения = 5 Тогда //Отгруженные
		Если ТекстЗапросаУсловие <> "" Тогда
			ТекстЗапросаУсловие = ТекстЗапросаУсловие + Символы.ПС + " И ";
		КонецЕсли;
		ТекстЗапросаУсловие = ТекстЗапросаУсловие + " ПредварительныеДанные.ВариантОбеспечения = Значение(перечисление.ВариантыОбеспечения.Отгрузить) "; 
	КонецЕсли;
	Возврат ТекстЗапросаУсловие;
	
КонецФункции

