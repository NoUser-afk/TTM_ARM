&НаКлиенте
Процедура ВыборНоменклатурыПродолжение(РезультатЗакрытия,ДопПараметры) Экспорт
	Если РезультатЗакрытия <> Неопределено Тогда 
		//Если РезультатЗакрытия.Свойство("Номенклатура") Тогда  
		ПараметрыОткрытияФормы = Новый Структура;
			   
		//ПараметрыОткрытияФормы.Вставить("ИмяДерева", ДопПараметры.ИмяДерева);
		ПараметрыОткрытияФормы.Вставить("Номенклатура", РезультатЗакрытия);	
		ПараметрыОткрытияФормы.Вставить("ЭтоСписание", ДопПараметры.ЭтоСписание);
		ПараметрыОткрытияФормы.Вставить("МассивЭтапов", ДопПараметры.МассивЭтапов);
		ПараметрыОткрытияФормы.Вставить("ДР_КатегорияМатериала", ДопПараметры.ДР_КатегорияМатериала);
		ПараметрыОткрытияФормы.Вставить("Склад", ДопПараметры.Склад);   
		ПараметрыОткрытияФормы.Вставить("КлючСвязиСпецификация", ДопПараметры.КлючСвязиСпецификация);
		ПараметрыОткрытияФормы.Вставить("ДатаОтгрузки",ДопПараметры.ДатаОтгрузки);                   
		
		СписокКолонок = "ЭтапПроизводства,Спецификация";
		АдресХранилищаТабЭтапы = ПолучитьАдресТабЭтапы(СписокКолонок);
		ПараметрыОткрытияФормы.Вставить("АдресХранилищаТабЭтапы", АдресХранилищаТабЭтапы);
		
		//ПараметрыОткрытияФормы.Вставить("СохранитьИзменения", Ложь);
		ОповещениеОДобавленииНоменклатуры = Новый ОписаниеОповещения("ДобавлениеНоменклатурыЗавершение", ЭтаФорма);
		ОткрытьФорму(
			"Обработка.ТТМ_АРМ_Резервирование_Списание_Материалов_2_2.Форма.ФормаДобавленияНоменклатуры", 
			ПараметрыОткрытияФормы,
			ЭтаФорма,,,,
			ОповещениеОДобавленииНоменклатуры
		);
		//КонецЕсли;
	КонецЕсли;
КонецПроцедуры 

&НаСервере
Функция ПолучитьАдресТабЭтапы(СписокКолонок)
	
	ПараметрыПоиска = Новый Структура("Обрабатывать", Истина);
	ТабЭтапы = Этапы.Выгрузить(ПараметрыПоиска,СписокКолонок);
	Возврат ПоместитьВоВременноеХранилище(ТабЭтапы,УникальныйИдентификатор);
	
КонецФункции

&НаКлиенте
Процедура ДобавлениеНоменклатурыЗавершение(РезультатЗакрытия,ДопПараметры) Экспорт
	
	Если РезультатЗакрытия = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(РезультатЗакрытия) = Тип("Структура") Тогда 
		Если РезультатЗакрытия.Свойство("Номенклатура") Тогда 
			ТекущаяНоменклатура = РезультатЗакрытия.Номенклатура;
		КонецЕсли;
		
		Если РезультатЗакрытия.Свойство("ЗаписатьСтрокиВРегистр") И РезультатЗакрытия.ЗаписатьСтрокиВРегистр Тогда  
			ТекущаяНоменклатура = РезультатЗакрытия.МассивСтрок[0].Номенклатура;
			Для Каждого СтрТаб Из РезультатЗакрытия.МассивСтрок Цикл  
				ДобавитьСтрокуВРегистр(СтрТаб, РезультатЗакрытия.ЭтоСписание, Объект.ПериодОтгрузки);      
			КонецЦикла; 		
		КонецЕсли;        
				
		ПоЭтапам = Ложь;
		ЗаполнитьМатериалыСпецификации(ПоЭтапам); 
		
		ПараметрыОтбора = Новый Структура("Номенклатура",ТекущаяНоменклатура); 
		Если Объект.МатериалыСпецификации.НайтиСтроки(ПараметрыОтбора).Количество() > 0 Тогда 
			ТекСтрока = Объект.МатериалыСпецификации.НайтиСтроки(ПараметрыОтбора)[0]; 
			Элементы.МатериалыСпецификации.ТекущаяСтрока = ТекСтрока.ПолучитьИдентификатор();
		КонецЕсли;
		
		УстановитьУсловноеОформлениеМатериаловСпецификации();
		//ОбновитьДанныеПоМатериаламНаСервере(РезультатЗакрытия.ИмяДерева,Ложь);   
		////ОбновитьИдентификаторыСтрокДерева(РезультатЗакрытия.ИмяДерева);
		//ВосстановитьСостояниеДерева(РезультатЗакрытия.ИмяДерева);
	КонецЕсли;                        
		
КонецПроцедуры

