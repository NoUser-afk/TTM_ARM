Процедура ЗаполнитьЗначенияСпискаВыбораВариантОбеспечения(ИмяСписка)
	
	Элементы[ИмяСписка].СписокВыбора.Очистить();
	//Элементы.ВариантОбеспеченияРезервирование.СписокВыбора.Добавить(1,"Необеспеченные");
	Элементы[ИмяСписка].СписокВыбора.Добавить(1,"К Обеспечению"); 	  // Требуется    //// Обособленно
