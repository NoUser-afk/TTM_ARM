&НаКлиенте
Функция ЗаполнитьМатериалыЭтапаПоДаннымРегистра_Новая(ЭтапПроизводства,ЭтоСписание)
	
		СтруктураКлючФормы = Новый Структура("Ключ",ЭтапПроизводства);
		Форма = ПолучитьФорму("Документ.ЭтапПроизводства2_2.ФормаОбъекта",СтруктураКлючФормы);
		ТЧОбеспечение = Форма.Объект.ОбеспечениеМатериаламиИРаботами;
		ТЧОбеспечение.Очистить();
		ПереченьКолонок = ПолучитьПереченьКолонокТЧМатериалыЭтапа();   
		//ТабМатериалы = 
		//ПеренестиКорректировкиВТЧ(не Объект.Резерв, ЭтапПроизводства, ПереченьКолонок);
		ПеренестиКорректировкиВТЧ(ЭтоСписание, ЭтапПроизводства, ПереченьКолонок);
		//ТЧОбеспечение.Загрузить(ТабМатериалы.Выгрузить()); //**Метод недоступен на клиенте**// 
		Если ЭтоСписание Тогда 
			ИмяТаблицыДанных = "МатериалыСписание";
		Иначе
			ИмяТаблицыДанных = "МатериалыРезервирование";
		КонецЕсли;
		
		ЕстьРезервИлиМягкийРезерв = Ложь;
		
		Для Каждого Стр из Объект[ИмяТаблицыДанных] Цикл //МатериалыСпецификации Цикл 
			НоваяСтрока = ТЧОбеспечение.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока,Стр);   
			НоваяСтрока.ДатаОтгрузки = Объект.ПериодОтгрузки;  
			Если НоваяСтрока.ВариантОбеспечения = ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.СоСклада")
				ИЛИ НоваяСтрока.ВариантОбеспечения = ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.РезервироватьПоМереПоступления") 
				ИЛИ НоваяСтрока.ВариантОбеспечения = ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.Отгрузить") Тогда 
				ЕстьРезервИлиМягкийРезерв = Истина;
			КонецЕсли;
		КонецЦикла;  
		//Форма.Объект.ОбеспечениеМатериаламиИРаботами = ТЧОбеспечение;
		Форма.Объект.НеОтгружатьЧастями = Истина;             
		Форма.Объект.ДатаОтгрузки = Объект.ПериодОтгрузки;
		
		//++Дарвин А.А. 12.12.2023		
		Если Форма.Объект.КоличествоУпаковокФакт < ПроцентВыполнения Тогда	
			Если ЕстьРезервИлиМягкийРезерв Тогда
				Форма.Объект.КоличествоУпаковокФакт = ПроцентВыполнения;
			КонецЕсли;
		КонецЕсли;
		//Дарвин А.А.
		
		//Если ЭтоСписание Тогда 
		//	Форма.Объект.ДатаОтгрузки = Объект.ПериодОтгрузки;
		////Иначе 
		////	Форма.Объект.ДатаОтгрузки = ТекущаяДатаСеанса();
		//КонецЕсли;
		Попытка
			Форма.Записать();
			Возврат Истина;
		Исключение
			Сообщить("Ошибка записи " + Стр.ЭтапПроизводства + "  " + ОписаниеОшибки());
			Возврат Ложь;
		КонецПопытки;
	//КонецЦикла;
	
КонецФункции

