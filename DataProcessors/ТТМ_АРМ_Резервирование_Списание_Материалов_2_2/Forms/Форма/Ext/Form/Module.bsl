&НаКлиенте
Процедура ВыполнитьРезервированиеПодтверждение(Команда)
	ЗапроситьРазрешениеНаУстановкуПривилегированногоРежима();
	
	Оповещение = Новый ОписаниеОповещения("ПослеПредоставленияРазрешения",ЭтаФорма);
	МассивИДРазрешений = ПолучитьМассивИдентификаторовРазрешений(СписокИДЗапросовРазрешений);
	РаботаВБезопасномРежимеКлиент.ПрименитьЗапросыНаИспользованиеВнешнихРесурсов(МассивИДРазрешений, ЭтаФорма, Оповещение);
	ЗаполнитьРеквизитыРФ_УстановитьПривилегированныйРежим(Истина);  
	
	/////////////////////////////////////////////////////////////////	         
	ОтборСтрок = Новый Структура("Обрабатывать",Истина);
	МассивЭтаповДляОбработки = Этапы.НайтиСтроки(ОтборСтрок);	
	МассивЭтаповКИзменению = Новый Массив;
	
	Для Каждого СтрЭтап из МассивЭтаповДляОбработки Цикл //ТабЭтапы  
		Этап = СтрЭтап.ЭтапПроизводства;          
		
		ДанныеЭтапа = ПолучитьДанныеЭтапа(Этап);
		Если ДанныеЭтапа.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтаповПроизводства2_2.Завершен") Или ДанныеЭтапа.КолСтрРасход > 0 Тогда 
			ЭтапОтменен = ОтменитьРасходМатериаловВЭтапе(Этап);  
			Если ЭтапОтменен Тогда 
				УдалитьСвязанныеПередачиМатериалов(Этап);
			КонецЕсли;
		КонецЕсли; 
		
		ЭтоСписание = Ложь;
		МассивЭтаповКИзменению.Добавить(Этап);
	КонецЦикла;
	
	//Параметры для длительной операции
	ДлительнаяОперация = НачатьВыполнениеФоновогоЗаданияСписаниеИРезервирование(МассивЭтаповКИзменению, ЭтоСписание);
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.Заголовок = "Резервирование материалов...";
	ПараметрыОжидания.ВыводитьПрогрессВыполнения = Истина;
	ПараметрыОжидания.ВыводитьСообщения = Истина;
	ПараметрыОжидания.ПолучатьРезультат = Истина;
	 	 
	Оповещение = Новый ОписаниеОповещения("ПриЗавершенииОбработкиФоновойОперации", ЭтотОбъект, Команда);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, Оповещение, ПараметрыОжидания);
	ЗаполнитьРеквизитыРФ_УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

&НаСервере
Процедура ПеренестиКорректировкиВТЧ(ЭтоСписание, ЭтапПроизводства, ПереченьКолонок)	
	Если ЭтоСписание Тогда 
		ТабМатериалы = Объект.МатериалыСписание;
	Иначе 
		ТабМатериалы = Объект.МатериалыРезервирование;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаДанныхРегистра();
	Запрос.УстановитьПараметр("ЭтапПроизводства", ЭтапПроизводства);
	Запрос.УстановитьПараметр("ЭтоСписание", не Объект.Резерв);  
	Запрос.УстановитьПараметр("Пользователь", Пользователи.АвторизованныйПользователь());
	ТЗ = Запрос.Выполнить().Выгрузить();
		
	ТЗСкорректирвоанныеСтрокиЭтапа = ТЗ.Скопировать(,ПереченьКолонок);
	ТЗСкорректирвоанныеСтрокиЭтапа.Сортировать("Номенклатура Возр");  
	ТабМатериалы.Загрузить(ТЗСкорректирвоанныеСтрокиЭтапа);   

КонецПроцедуры    

&НаСервере
Функция ПолучитьДанныеЭтапа(Этап)
	
	ДанныеЭтапа = Новый Структура("Статус, КолСтрРасход",Этап.Статус,Этап.РасходМатериаловИРабот.Количество());
	Возврат ДанныеЭтапа;
	
КонецФункции

&НаСервере
Процедура УдалитьСвязанныеПередачиМатериалов(Этап)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ Разрешенные
		|	СвязанныеДокументы.Ссылка КАК Ссылка
		|ИЗ
		|	КритерийОтбора.СвязанныеДокументы(&Этап) КАК СвязанныеДокументы
		|ГДЕ
		|	СвязанныеДокументы.Ссылка.Проведен = ИСТИНА
		|	И СвязанныеДокументы.Ссылка ССЫЛКА Документ.ДвижениеПродукцииИМатериалов
		|	И СвязанныеДокументы.Ссылка.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПередачаМатериаловВПроизводство)";
	
	Запрос.УстановитьПараметр("Этап", Этап);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ОбъектПередачаМатериалов = Выборка.Ссылка.ПолучитьОбъект();
		Попытка
			ОбъектПередачаМатериалов.УстановитьПометкуУдаления(Истина);
		Исключение
			Сообщить("Не удалось пометить связанный документ " + ОбъектПередачаМатериалов + Этап);
		КонецПопытки;
	КонецЦикла;	
		
КонецПроцедуры

&НаСервере
Функция НачатьВыполнениеФоновогоЗаданияСписаниеИРезервирование(МассивЭтаповКИзменению, ЭтоСписание)
	
	ПараметрыДляОбработки = Новый Структура;
	ПараметрыДляОбработки.Вставить("МассивЭтаповКИзменению", МассивЭтаповКИзменению);
	ПараметрыДляОбработки.Вставить("ЭтоСписание", ЭтоСписание);
	ПараметрыДляОбработки.Вставить("ПериодОтгрузки", Объект.ПериодОтгрузки);
	ПараметрыДляОбработки.Вставить("ПроцентВыполнения", ПроцентВыполнения);
	ПараметрыДляОбработки.Вставить("Резерв", Объект.Резерв);
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
				
	 Возврат ДлительныеОперации.ВыполнитьФункцию(
	 	ПараметрыВыполнения, 
	    "ТТМ_ДанныеВыбораСервер.ЗафиксироватьКорректировкиВЭтапахСписаниеИРезервированиеВФоне", 
	 	ПараметрыДляОбработки);
КонецФункции

&НаКлиенте
функция ПолучитьМассивСтруктурВыбранныхСтрокДляОбработки(СписокВариантовОбеспечения, ИмяДерева, ЭтоСписание)
	
	МассивСтрок = Элементы[ИмяДерева].ВыделенныеСтроки;
	МассивОбрабатываемыхСтрок = Новый Массив;
	Для Каждого Стр из МассивСтрок Цикл  
		ОтменаРезерва = не МассивОбрабатываемыхСтрок.Найти(ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.СоСклада")) = Неопределено;
		Если ЭтаФорма[ИмяДерева].НайтиПоИдентификатору(Стр).Остаток = 0 и не ОтменаРезерва Тогда
			Продолжить;
		КонецЕсли;
		Если ЭтаФорма[ИмяДерева].НайтиПоИдентификатору(Стр) <> Неопределено Тогда 
			ДочерниеСтроки = ЭтаФорма[ИмяДерева].НайтиПоИдентификатору(Стр).ПолучитьЭлементы();
			Если ДочерниеСтроки.Количество() <> 0 Тогда 
				Для Каждого НСтр из ДочерниеСтроки Цикл 
					МассивОбрабатываемыхСтрок.Добавить(НСтр.ПолучитьИдентификатор());
				КонецЦикла;
			Иначе 
				МассивОбрабатываемыхСтрок.Добавить(Стр);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	МассивСтруктурОбрабатываемыхСтрок = Новый Массив;
	Для Каждого МСтр из МассивОбрабатываемыхСтрок Цикл 
		ТекСтрока = ЭтаФорма[ИмяДерева].НайтиПоИдентификатору(МСтр);
		ДанныеСтроки = Новый Структура("Номенклатура, ЭтапПроизводства, ВариантОбеспечения");
		Если ТекСтрока <> Неопределено Тогда        
			Если СписокВариантовОбеспечения.НайтиПоЗначению(Текстрока.ВариантОбеспечения) = Неопределено Тогда 
				Продолжить;
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(ДанныеСтроки,ТекСтрока);
			МассивСтруктурОбрабатываемыхСтрок.Добавить(ДанныеСтроки);
		КонецЕсли;
	КонецЦикла;                              
	
	Возврат МассивСтруктурОбрабатываемыхСтрок;
	
КонецФункции

