&НаКлиенте
Процедура СтраницыСписанияПриСменеСтраницы(Элемент, ТекущаяСтраница) 
		
	//++Дарвин А.А.
	КоличествоВыбранныхЭтапов = ПолучитьКоличествоВыбранныхЭтапов(, Истина);
	
	Если КоличествоВыбранныхЭтапов = 0 Тогда
		Возврат;
	КонецЕсли;
	//Дарвин А.А
		
	//УстановитьДанныеПартииПроизводства(Этап);  
	//Нормативы = ПолучитьИзВременногоХранилища(Этап);
	
	Если ТекущаяСтраница.Имя = "СтраницаЭтапы" Тогда
		ВопросПользователюПередВыполнениемОперации(Истина);	
	ИначеЕсли ТекущаяСтраница.Имя = "СтраницаМатериалыСпецификации" Тогда 
		ВопросПользователюПередВыполнениемОперации();		
	КонецЕсли;
	
КонецПроцедуры  

&НаСервере
//+ Ганьшина Е 20.08.2025    
// переделала
Функция ПолучитьКоличествоВыбранныхЭтапов(Знач ВыбратьОтмеченные = Ложь, Знач ПолучитьТолькоКоличество = Ложь, ВернутьМассивЭтапов = ложь)
	
	ПараметрыОтбора = Новый Структура("Обрабатывать", Истина); 
	
	
	ТабВсеЭтапы = Этапы.Выгрузить(); 
	КолонкиГруппировки = "Обрабатывать,  Статус, ЭтапПроизводства, КоличествоУпаковокФакт, ДатаПроизводства, Назначение, Номенклатура, Запланировано, Спецификация"; 
	ТабВсеЭтапы.Свернуть(КолонкиГруппировки);
	ТабЭтапы = Этапы.Выгрузить(ПараметрыОтбора);
	ТабОтмеченныеЭтапы = ТабЭтапы.Скопировать(); 
	ТабОтмеченныеЭтапы.Свернуть(КолонкиГруппировки);
	
	Если ПолучитьТолькоКоличество Тогда
		Возврат ТабОтмеченныеЭтапы.Количество();
	КонецЕсли;
		
	Если ВыбратьОтмеченные Тогда
		
		Если ВернутьМассивЭтапов Тогда 
			Возврат ТабОтмеченныеЭтапы.ВыгрузитьКолонку("ЭтапПроизводства");
		Иначе 
			Возврат ТабОтмеченныеЭтапы;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ВернутьМассивЭтапов Тогда
		Возврат ТабВсеЭтапы.ВыгрузитьКолонку("ЭтапПроизводства");
	Иначе 
		Возврат ТабВсеЭтапы;
	КонецЕсли;
	
КонецФункции

