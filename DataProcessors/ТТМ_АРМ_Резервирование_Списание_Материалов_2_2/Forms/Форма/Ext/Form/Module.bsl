	// 1. Изменение ТЧМатериалыСпецификации       
	Если ИзменяемыйРеквизит = "Номенклатура" Тогда 
		
		НоменклатураНовая = ТекСтрока.Номенклатура; 
		ТекущаяНоменклатура = НоменклатураНовая;
		
		Норматив = ПолучитьНормативПоНоменклатуре(НоменклатураНовая);
		Если Норматив = 0 Тогда
			Норматив = НормативТекущий;
		КонецЕсли;
		
		//НЗ.Отбор.ВариантОбеспечения.Установить(ТекстрокаРегистра.ВариантОбеспечения);
		НЗ.Прочитать();  
		
		НЗ1 = РегистрыСведений.ТТМ_АРМ_РезервированиеСписаниеМатериалов.СоздатьНаборЗаписей();
		НЗ1.Отбор.ЭтоСписание.Установить(ЭтоСписание);
		НЗ1.Отбор.Пользователь.Установить(Пользователи.АвторизованныйПользователь());
		НЗ1.Отбор.Номенклатура.Установить(НоменклатураНовая);
		НЗ1.Прочитать();
		
		Для Каждого СтрНЗ из НЗ Цикл    
			
			НоваяСтрока = НЗ1.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрНЗ);
			НоваяСтрока.Номенклатура = НоменклатураНовая; //ТекСтрока.Номенклатура; 
			НоваяСтрока.Норматив = Норматив; 
			
			//Рассчитаем остаток для измененной позиции спецификации
			
			//ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
			//НоваяСтрока.Остаток = ОбработкаОбъект.ПолучитьОстаток_2_5(НоменклатураНовая,Объект.Склад,Этапы.Выгрузить(,"ЭтапПроизводства"));	
			
			ПараметрыПоиска = Новый Структура("Обрабатывать",Истина);    
			ТабЭтапы = Этапы.Выгрузить(ПараметрыПоиска,"ЭтапПроизводства,Спецификация");
			НоваяСтрока.Остаток = ТТМ_ДанныеВыбораСервер.ПолучитьОстаток_2_5(НоменклатураНовая, Объект.Склад, ТабЭтапы.ВыгрузитьКолонку("ЭтапПроизводства"), ТабЭтапы, ЭтоСписание);	
			
		КонецЦикла; 
		
		НЗ1.Записать();
		НЗ.Очистить();  
		НЗ.Записать(); 
		ТекущаяНоменклатура = НоменклатураНовая;
		
	// 2. Изменение ТЧРаспределениеМатериалов
	Иначе
		
		Резерв = Текстрока.Резерв = Истина;
		МягкийРезерв = ТекСтрока.МягкийРезерв = Истина;
		Отгрузить = ТекСтрока.Отгрузить = Истина; 
		
		Если Резерв или МягкийРезерв или Отгрузить Тогда  
				
			Обособленно = Ложь;
			Назначение = ТекущийЭтап.НазначениеПродукция; //Справочники.Назначения.ПустаяСсылка();
			
			Если Резерв Тогда 
				ВариантобеспеченияНовый = Перечисления.ВариантыОбеспечения.СоСклада;
			ИначеЕсли МягкийРезерв Тогда
				ВариантобеспеченияНовый = Перечисления.ВариантыОбеспечения.РезервироватьПоМереПоступления;
			ИначеЕсли Отгрузить Тогда 
				ВариантобеспеченияНовый = Перечисления.ВариантыОбеспечения.Отгрузить;
			КонецЕсли;
		Иначе 
			Обособленно = Истина;
			ВариантобеспеченияНовый = Перечисления.ВариантыОбеспечения.КОбеспечению;
			Назначение = ТекущийЭтап.НазначениеПродукция;
		КонецЕсли;
		
		НЗ.Отбор.ЭтапПроизводства.Установить(ТекущийЭтап);
		
		//2.1. Изменение Отметки 
		#Область ИзменениеОтметки
		Если ИзменяемыйРеквизит = "Отметка" Тогда 
			
			Норматив = ПолучитьНормативПоНоменклатуре(Номенклатура);
			НЗ.Прочитать();
			
			Если не ТекСтрока.Отметка Тогда 
				//Удалить строку по отбору
				Для Каждого СтрНЗ из НЗ Цикл 
					НЗ.Удалить(СтрНЗ);
				КонецЦикла;    
				
				НЗ.Записать(); 
				
			Иначе 
				//Восстановим строку регистра 
				Если НЗ.Количество() = 0 Тогда 
					НоваяСтрока = НЗ.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока,ТекСтрока);  //+ Ганьшина Е 11.04.2025 // ТекСтрокаРегистра
					НоваяСтрока.ЭтапПроизводства = ТекСтрока.ЭтапПроизводства;                                  
					НоваяСтрока.Норматив = Норматив;
					Знаменатель = ?(ЗначениеЗаполнено(ТекСтрока.Упаковка.Знаменатель),ТекСтрока.Упаковка.Знаменатель,1);
					Числитель = ?(ЗначениеЗаполнено(ТекСтрока.упаковка.Числитель),ТекСтрока.Упаковка.Числитель,1);
					КоэффициентУпаковки = Знаменатель/Числитель;
					НоваяСтрока.Количество = ?(НоваяСтрока.Норматив = 0, 1, НоваяСтрока.Норматив*КоэффициентУпаковки);    
					НоваяСтрока.КоличествоУпаковок = ?(Норматив = 0, 1, Норматив);
					НоваяСтрока.Упаковка = ?(ЗначениеЗаполнено(ТекСтрока.Упаковка),ТекСтрока.Упаковка,ТекСтрока.Номенклатура.ЕдиницаИзмерения);
					НоваяСтрока.Номенклатура = Номенклатура; //ТекстрокаРегистра.Номенклатура; 
					Если не ЗначениеЗаполнено(НоваяСтрока.пользователь) Тогда 
						НоваяСтрока.Пользователь = Пользователи.АвторизованныйПользователь();
					КонецЕсли;
					НоваяСтрока.ЭтоСписание = ЭтоСписание;
					НоваяСтрока.ДатаОтгрузки = Объект.ПериодОтгрузки;
					НоваяСтрока.ЕдиницаИзмерения = Номенклатура.ЕдиницаИзмерения;
					НоваяСтрока.КатегорияМатериала = ТТМ_ДанныеВыбораСервер.ПолучитьКатегориюМатериала(ТекстрокаРегистра.Номенклатура,Объект.ДР_КатегорияМатериала);
					НоваяСтрока.ВариантОбеспечения = ВариантобеспеченияНовый;
					НоваяСтрока.Обособленно = Обособленно;
					НоваяСтрока.ОтборПоВариантамОбеспечения = 1;
					НоваяСтрока.Назначение = Назначение;      
					НоваяСтрока.НазначениеОбеспечения = Назначение;
					Если НоваяСтрока.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.КОбеспечению Тогда 
						НоваяСтрока.Обеспечить = НоваяСтрока.КоличествоУпаковок;
					КонецЕсли;                                                                                    
					ПараметрыПоиска = Новый Структура("Обрабатывать", Истина);  
					ТабЭтапы = Этапы.Выгрузить(ПараметрыПоиска,"ЭтапПроизводства,Спецификация");
					НоваяСтрока.Остаток = ТТМ_ДанныеВыбораСервер.ПолучитьОстаток_2_5(НоменклатураНовая,Объект.Склад,ТабЭтапы.ВыгрузитьКолонку("ЭтапПроизводства"),ТабЭтапы);	
					//НоваяСтрока.Остаток = ТТМ_ДанныеВыбораСервер.ПолучитьОстаток_2_5(ТекущаяНоменклатура,Объект.Склад,Этапы.Выгрузить(ПараметрыПоиска,"ЭтапПроизводства"));
					НоваяСтрока.Подразделение = Объект.Склад.Подразделение;
					НоваяСтрока.Склад = Объект.Склад;
					НоваяСтрока.Спецификация = Спецификация;
					НоваяСтрока.СпецификацияЭтапа = ЭтапПроизводства.Спецификация;
					НоваяСтрока.СтатьяКалькуляции = Объект.СтатьяКалькуляции;
					//+Ганьшина Е 09.04.2025
					НоваяСтрока.Запланировано = ЭтапПроизводства.КоличествоУпаковокПлан;
					//-Ганьшина Е 09.04.2025
				КонецЕсли;    
				
				НЗ.Записать();
				
			КонецЕсли;
		#КонецОбласти
		//2.2. ВариантОбеспечения
		#Область ИзменениеВариантаОбесппечения
		ИначеЕсли ИзменяемыйРеквизит = "ВариантОбеспечения" Тогда 
						
			СтруктуктураОтбора = Новый Структура("Номенклатура,ЭтапПроизводства");
			ЗаполнитьЗначенияСвойств(СтруктуктураОтбора,ТекСтрока);
			
			//ВариантОбеспеченияДо = ПолучитьВариантОбеспеченияИзРегистра(ТекстрокаРегистра.Номенклатура,ТекСтрока.ЭтапПроизводства);
			ВариантОбеспеченияДо = ТекстрокаРегистра.ВариантОбеспечения;
			
			УстановитьВариантОбеспеченияНовая(ВариантобеспеченияНовый, Обособленно, ЭтоСписание, СтруктуктураОтбора);
		#КонецОбласти	
		//2.3. Количество
		#Область ИзменениеКоличества
		ИначеЕсли ИзменяемыйРеквизит = "Количество" Тогда 
			//1. Изменение количества в ТЧ Распределение материала   
						
			Если ЗначениеЗаполнено(ЭтапПроизводства) Тогда 
				ИзменениеТЧРаспределение = Истина;
			КонецЕсли;
				
			Если ИзменениеТЧРаспределение Тогда 
				НЗ.Отбор.ВариантОбеспечения.Установить(ТекстрокаРегистра.ВариантОбеспечения); 	//+ Ганьшина Е 11.04.2025 ТекстрокаРегистра.ВариантОбеспечения);
				НЗ.Отбор.Обособленно.Установить(ТекстрокаРегистра.Обособленно);  //29.05.2025
				НЗ.Прочитать();
				Если НЗ.Количество() = 1 Тогда 
					Для Каждого СтрНЗ из НЗ Цикл
						СтрНЗ.КоличествоУпаковок = ТекСтрока.КоличествоУпаковок;
						Знаменатель = ?(ЗначениеЗаполнено(ТекСтрока.Упаковка.Знаменатель),ТекСтрока.Упаковка.Знаменатель,1);
						Числитель = ?(ЗначениеЗаполнено(ТекСтрока.упаковка.Числитель),ТекСтрока.Упаковка.Числитель,1);
						КоэффициентУпаковки = Знаменатель/Числитель;
						СтрНЗ.Количество = ТекСтрока.КоличествоУпаковок * КоэффициентУпаковки;
						Если СтрНЗ.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.КОбеспечению Тогда 
							СтрНЗ.Обеспечить = СтрНЗ.Количество;
						Иначе     
							СтрНЗ.Обеспечить = 0;
							//СтрНЗ.Обеспечить = СтрНЗ.Обеспечить - (ТекСтрока.Количество - ТекстрокаРегистра.Количество);
						КонецЕсли;
					КонецЦикла;   
					НЗ.Записать();
				ИначеЕсли НЗ.Количество() > 1 Тогда  
					Сообщить("Найдено более 1 записи регистра при изменении количества в  ТЧ РаспределениеМатериаловСпецификации", СтатусСообщения.Важное);
				Иначе 
					Сообщить("Не найдено записи регистра для изменения при изменении количества в  ТЧ РаспределениеМатериаловСпецификации", СтатусСообщения.Важное);
				КонецЕсли;
			//2. Изменение количества в ТЧ МатериалыСпецификации 
			Иначе
				НовоеКоличествоДляРаспределения = ТекСтрока.КоличествоУпаковок;
				//СписокКолонокРаспределениеМатериалов = "Отметка,ЭтапПроизводства,Норматив,Упаковка,Количество,КоличествоУпаковок,НомерЭтапа,ДатаЭтапа";
				РаспределитьКоличествоНаСервере(); //(СписокКолонокРаспределениеМатериалов);
			КонецЕсли;
		КонецЕсли;   
	    #КонецОбласти
	КонецЕсли;  
	
	поЭтапам = Ложь;
	ОбновитьМатериалыСпецификацииНаСервере(поЭтапам);  
		
	//ПараметрыПоиска = Новый Структура("Номенклатура",ТекущаяНоменклатура);
	//МассивСтрок = Объект.МатериалыСпецификации.НайтиСтроки(ПараметрыПоиска);
	//Элементы.МатериалыСпецификации.ТекущаяСтрока = МассивСтрок[0].ПолучитьИдентификатор();
	//
	////28.05.2025
	////ЗаполнитьТЧРаспределениеМатериалаПоДаннымРегистра(ТекСтрока.Номенклатура);
	//ЗаполнитьТЧРаспределениеМатериалаПоДаннымРегистра(ТекущаяНоменклатура);
		
	//ЗаполнитьТЧРаспределениеМатериалаПоДаннымРегистра(Номенклатура);   
	
	///////////////////////////////////////////////////////////////////////////////////////////////////
		
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТЧРаспределениеМатериалаПоДаннымРегистра(Номенклатура)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТЭтапы.ЭтапПроизводства КАК СсылкаНаЭтап,
	               |	ТЭтапы.Обрабатывать КАК Обрабатывать
	               |ПОМЕСТИТЬ ТЭтапы
	               |ИЗ
	               |	&ТЭтапы КАК ТЭтапы
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ИСТИНА КАК Отметка,
	               |	ВЫБОР
	               |		КОГДА ТТМ_АРМ_РезервированиеСписаниеМатериалов.ВариантОбеспечения = ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.СоСклада)
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК Резерв,
	               |	ВЫБОР
	               |		КОГДА ТТМ_АРМ_РезервированиеСписаниеМатериалов.ВариантОбеспечения = ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.РезервироватьПоМереПоступления)
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК МягкийРезерв,
	               |	ВЫБОР
	               |		КОГДА ТТМ_АРМ_РезервированиеСписаниеМатериалов.ВариантОбеспечения = ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.Отгрузить)
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК Отгрузить,
	               |	ТТМ_АРМ_РезервированиеСписаниеМатериалов.ЭтапПроизводства КАК ЭтапПроизводства,
	               |	ТТМ_АРМ_РезервированиеСписаниеМатериалов.Норматив КАК Норматив,
	               |	ТТМ_АРМ_РезервированиеСписаниеМатериалов.Количество КАК Количество,
	               |	ТТМ_АРМ_РезервированиеСписаниеМатериалов.КоличествоУпаковок КАК КоличествоУпаковок,
	               |	ТТМ_АРМ_РезервированиеСписаниеМатериалов.Упаковка КАК Упаковка,
	               |	ТТМ_АРМ_РезервированиеСписаниеМатериалов.ЭтапПроизводства.Номер КАК Номер,
	               |	ТТМ_АРМ_РезервированиеСписаниеМатериалов.ЭтапПроизводства.Дата КАК Дата,
	               |	ТТМ_АРМ_РезервированиеСписаниеМатериалов.ВариантОбеспечения КАК ВариантОбеспечения,
	               |	ТТМ_АРМ_РезервированиеСписаниеМатериалов.Обособленно КАК Обособленно,
	               |	ТТМ_АРМ_РезервированиеСписаниеМатериалов.Назначение КАК Назначение,
	               |	ТТМ_АРМ_РезервированиеСписаниеМатериалов.НазначениеОбеспечения КАК НазначениеОбеспечения,
	               |	ТТМ_АРМ_РезервированиеСписаниеМатериалов.ПодобраноНаТСД КАК ПодобраноНаТСД,
	               |	ТТМ_АРМ_РезервированиеСписаниеМатериалов.Номенклатура КАК Номенклатура,
	               |	ТТМ_АРМ_РезервированиеСписаниеМатериалов.Запланировано КАК Запланировано,
	               |	ТТМ_АРМ_РезервированиеСписаниеМатериалов.КлючСвязиНабор КАК КлючСвязиНабор,
	               |	ТТМ_АРМ_РезервированиеСписаниеМатериалов.КлючНоменклатура КАК КлючНоменклатура
	               |ПОМЕСТИТЬ ДанныеРегистра
	               |ИЗ
	               |	РегистрСведений.ТТМ_АРМ_РезервированиеСписаниеМатериалов КАК ТТМ_АРМ_РезервированиеСписаниеМатериалов
	               |ГДЕ
	               |	ТТМ_АРМ_РезервированиеСписаниеМатериалов.Номенклатура = &Номенклатура
	               |	И ТТМ_АРМ_РезервированиеСписаниеМатериалов.Пользователь = &ТекПользователь
	               |	И ТТМ_АРМ_РезервированиеСписаниеМатериалов.ЭтоСписание = &Списание
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВЫБОР
	               |		КОГДА ЕСТЬNULL(ДанныеРегистра.ЭтапПроизводства, ЗНАЧЕНИЕ(Документ.ЭтапПроизводства2_2.ПустаяСсылка)) = ТЭтапы.СсылкаНаЭтап
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК Отметка,
	               |	ДанныеРегистра.Резерв КАК Резерв,
	               |	ДанныеРегистра.МягкийРезерв КАК МягкийРезерв,
	               |	ДанныеРегистра.Отгрузить КАК Отгрузить,
	               |	ТЭтапы.СсылкаНаЭтап КАК ЭтапПроизводства,
	               |	ЕСТЬNULL(ДанныеРегистра.Норматив, 0) КАК Норматив,
	               |	ЕСТЬNULL(ДанныеРегистра.Упаковка, ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)) КАК Упаковка,
	               |	ДанныеРегистра.КоличествоУпаковок КАК КоличествоУпаковок,
	               |	ДанныеРегистра.Количество КАК Количество,
	               |	ЕСТЬNULL(ДанныеРегистра.ЭтапПроизводства.Номер, """") КАК НомерЭтапа,
	               |	ПРЕДСТАВЛЕНИЕ(ЕСТЬNULL(ДанныеРегистра.ЭтапПроизводства.Дата, """")) КАК ДатаЭтапа,
	               |	ДанныеРегистра.ВариантОбеспечения КАК ВариантОбеспечения,
	               |	ДанныеРегистра.Обособленно КАК Обособленно,
	               |	ДанныеРегистра.Назначение КАК Назначение,
	               |	ДанныеРегистра.НазначениеОбеспечения КАК НазначениеОбеспечения,
	               |	ДанныеРегистра.ПодобраноНаТСД КАК ПодобраноНаТСД,
	               |	ДанныеРегистра.Номенклатура КАК Номенклатура,
