&НаСервере
Функция ПолучитьСтруктуруДанныхСтрокиТЧРаспределениеМатериала()  
	СтруктураВозврата = Новый Структура;
	Для Каждого Колонка из Объект.РаспределениеМатериала.Выгрузить().Колонки Цикл 
		СтруктураВозврата.Вставить(Колонка.Имя);
	КонецЦикла; 
	Возврат СтруктураВозврата;
КонецФункции

&НаСервере
Функция ПолучитьВариантОбеспеченияИзРегистра(Номенклатура, ЭтапПроизводства)
	НЗ = РегистрыСведений.ТТМ_АРМ_РезервированиеСписаниеМатериалов.СоздатьНаборЗаписей();
	НЗ.Отбор.Пользователь.Установить(Пользователи.АвторизованныйПользователь());
	НЗ.Отбор.ЭтоСписание.Установить(Не Объект.Резерв);
	НЗ.Отбор.Номенклатура.Установить(Номенклатура);
	НЗ.Отбор.ЭтапПроизводства.Установить(ЭтапПроизводства);
	НЗ.Прочитать();
	Если НЗ.Количество() > 0 Тогда 
	//Для Каждого стрНЗ из НЗ Цикл 
		ВариантОбеспеченияДо = НЗ[0].ВариантОбеспечения;
	Иначе 
		ВариантОбеспеченияДо = Перечисления.ВариантыОбеспечения.КОбеспечению;
	КонецЕсли; 
	Возврат ВариантОбеспеченияДо;
КонецФункции

&НаКлиенте
Процедура МатериалыСпецификацииПередУдалением(Элемент, Отказ)
	//ИсходныеДанныеСтрокиМатериаловСпецификации   
	УдалитьСтрокиРегистраСОтбором(ИсходныеДанныеСтрокиМатериаловСпецификации.Номенклатура,,не Объект.Резерв);
КонецПроцедуры

&НаСервере
Процедура МатериалыСпецификацииУстановитьВариантОбеспечения(ВариантОбеспеченияНовый, Обособленно)
	Для Каждого СтрТЧ из Объект.МатериалыСпецификации Цикл 
		ТекНоменклатура = СтрТЧ.Номенклатура;
		ТекОстаток = СтрТЧ.Остаток;
		ОбрабатываемаяСтрока = ИсходныеДанныеСтрокиМатериаловСпецификации;
		ЗаполнитьЗначенияСвойств(ОбрабатываемаяСтрока,СтрТЧ);
		
		Если СтрТЧ.ВариантОбеспечения = ВариантОбеспеченияНовый Тогда
			Продолжить;
		Иначе   
			
			ДанныеСтроки = Новый Структура("Номенклатура, ЭтапПроизводства");
			ДанныеСтроки.Номенклатура = СтрТЧ.Номенклатура; 
			ДанныеПоНоменклатуре = ПолучитьДанныеРегистраПоНоменклатуре(СтрТЧ.Номенклатура);
			
			КоличествоРасход = ДанныеПоНоменклатуре.Расход; //Объект.РаспределениеМатериала.Итог("Количество");
			Если ТекОстаток - КоличествоРасход < 0 Тогда //СтрТЧ.Количество
				Сообщить("Номенклатура " + СтрТЧ.Номенклатура + " недостаточно остатка в наличии на складе для отгрузки!");
				Продолжить;
			КонецЕсли;  
			ТекОстаток = ТекОстаток-КоличествоРасход;
			
			//ДанныеСтроки = Новый Структура("Номенклатура, ЭтапПроизводства");
			////ЗаполнитьЗначенияСвойств(ДанныеСтроки, СтрТЧ);
			//ДанныеСтроки.Номенклатура = СтрТЧ.Номенклатура;  
			////ДанныеСтроки.ЭтапПроизводства = СтрТЧ.
			////Обособленно = Ложь;
			УстановитьВариантОбеспеченияНовая(ВариантОбеспеченияНовый,Обособленно,не Объект.Резерв,ДанныеСТроки);
		КонецЕсли;
	КонецЦикла; 
КонецПроцедуры

&НаСервере
Процедура УстановитьВариантОбеспеченияНовая(ВариантОбеспеченияНовый, Обособленно, ЭтоСписание, СтруктураОтбора)
	
	ВО_Зарезервировать = Перечисления.ВариантыОбеспечения.СоСклада;
	ВО_Отгрузить = Перечисления.ВариантыОбеспечения.Отгрузить;
	
	НЗ = РегистрыСведений.ТТМ_АРМ_РезервированиеСписаниеМатериалов.СоздатьНаборЗаписей();
	
	НЗ.Отбор.ЭтоСписание.Установить(ЭтоСписание);
	НЗ.Отбор.Пользователь.Установить(Пользователи.АвторизованныйПользователь());  
	Если СтруктураОтбора.свойство("Номенклатура") и ЗначениеЗаполнено(СтруктураОтбора.Номенклатура) Тогда 
		НЗ.Отбор.Номенклатура.Установить(СтруктураОтбора.Номенклатура);        
	КонецЕсли;
	Если СтруктураОтбора.Свойство("ЭтапПроизводства") и ЗначениеЗаполнено(СтруктураОтбора.ЭтапПроизводства) Тогда 
		НЗ.Отбор.ЭтапПроизводства.Установить(СтруктураОтбора.ЭтапПроизводства)
	КонецЕсли;
	НЗ.Прочитать();       
	ОстатокРасределения = 0;  
	МассивНоменклатурыБезОстатка = Новый Массив;
	Для Каждого СтрНЗ из НЗ Цикл   
		Если СтрНЗ.КоличествоУпаковок = 0 или СтрНЗ.Количество = 0 Тогда     
			Если ВариантОбеспеченияНовый = ВО_Отгрузить Тогда 
				СтрокаОкончание = " Материал не отгружен!";
			ИначеЕсли ВариантОбеспеченияНовый = ВО_Зарезервировать Тогда 
				СтрокаОкончание = " Материал не зарезервирован!";
			Иначе 
				СтрокаОкончание = "";
			КонецЕсли;
			Сообщить("Не указано количество материала "+СтрНЗ.Номенклатура + " по этапу " + СтрНЗ.ЭтапПроизводства + СтрокаОкончание);
			Если не СтрНЗ.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.КОбеспечению Тогда 
				СтрНЗ.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.КОбеспечению;
				СтрНЗ.Обособленно = Истина;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Если СтрНЗ.Остаток <= 0 Тогда 
			Если МассивНоменклатурыБезОстатка.Найти(СтрНЗ.Номенклатура) = Неопределено Тогда 
				МассивНоменклатурыБезОстатка.Добавить(СтрНЗ.Номенклатура);
			КонецЕсли;
			//Продолжить;
		КонецЕсли;
		Если ОстатокРасределения = 0 Тогда 
			ОстатокРасределения = СтрНЗ.Остаток;
		КонецЕсли;                   
		Числитель = ?(ЗначениеЗаполнено(СтрНЗ.Упаковка.Числитель),СтрНЗ.Упаковка.Числитель,1);
		Знаменатель = ?(ЗначениеЗаполнено(СтрНЗ.Упаковка.Знаменатель),СтрНЗ.Упаковка.Знаменатель,1);
		Если ОстатокРасределения < СтрНЗ.КоличествоУпаковок Тогда 
			//29.05.2025
			СтрНЗ.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.КОбеспечению;
			СтрНЗ.Обособленно = Истина;
			СтрНЗ.ОтборПоВариантамОбеспечения = 1;  
			Продолжить;
			//-
			
			//+Закомментировала 29.05.2025
			//СтрНЗ.КоличествоУпаковок = ОстатокРасределения;
			//Числитель = ?(ЗначениеЗаполнено(СтрНЗ.Упаковка.Числитель),СтрНЗ.Упаковка.Числитель,1);
			//Знаменатель = ?(ЗначениеЗаполнено(СтрНЗ.Упаковка.Знаменатель),СтрНЗ.Упаковка.Знаменатель,1);
			//СтрНЗ.Количество = СтрНЗ.КоличествоУпаковок * Числитель / Знаменатель;
			//-
		КонецЕсли;		
		Если СтруктураОтбора.Свойство("ПодборНаТСД") и ЗначениеЗаполнено(СтруктураОтбора.ПодборНаТСД) Тогда 
			Если не ЗначениеЗаполнено(СтрНЗ.ПодобраноНаТСД) Тогда  
				Продолжить;
			КонецЕсли;  
			Если СтрНЗ.ВариантОбеспечения = ВО_Зарезервировать или СтрНЗ.ВариантОбеспечения = ВО_Отгрузить Тогда 
				СтрНЗ.КоличествоУпаковок = СтрНЗ.КоличествоУпаковок + СтрНЗ.ПодобраноНаТСД;
			Иначе 
				СтрНЗ.КоличествоУпаковок = СтрНЗ.ПодобраноНаТСД;
			КонецЕсли;  
			СтрНЗ.ПодобраноНаТСД = 0;
			СтрНЗ.Количество = СтрНЗ.КоличествоУпаковок * Числитель / Знаменатель;
		КонецЕсли;      
		СтрНЗ.ВариантОбеспечения = ВариантОбеспеченияНовый;              
		СтрНЗ.Обособленно = Обособленно;
		Если ВариантОбеспеченияНовый = Перечисления.ВариантыОбеспечения.Отгрузить Тогда 
			СтрНЗ.ОтборПоВариантамОбеспечения = 5;
		ИначеЕсли ВариантОбеспеченияНовый = Перечисления.ВариантыОбеспечения.СоСклада Тогда
			СтрНЗ.ОтборПоВариантамОбеспечения = 4;
		ИначеЕсли ВариантОбеспеченияНовый = Перечисления.ВариантыОбеспечения.РезервироватьПоМереПоступления Тогда
			СтрНЗ.ОтборПоВариантамОбеспечения = 3;
		ИначеЕсли ВариантОбеспеченияНовый = Перечисления.ВариантыОбеспечения.КОбеспечению Тогда 
			СтрНЗ.ОтборПоВариантамОбеспечения = 1;
		КонецЕсли; 
		//Если не Обособленно Тогда         
		//	Назначение = Справочники.Назначения.ПустаяСсылка();
		//Иначе 
		//	Если не ЗначениеЗаполнено(СтрНЗ.Назначение) Тогда 
		//		Назначение = СтрНЗ.ЭтапПроизводства.НазначениеПродукция;
		//	КонецЕсли;
		//КонецЕсли;                                                      
		Назначение = СтрНЗ.ЭтапПроизводства.НазначениеПродукция;
		СтрНЗ.Назначение = Назначение;
		СтрНЗ.НазначениеОбеспечения = Назначение;
	КонецЦикла; 
	НЗ.Записать();
	
	Если МассивНоменклатурыБезОстатка.Количество() > 0 Тогда                                                
		ТекстСообщения = "";
		Для Каждого Номенклатура из МассивНоменклатурыБезОстатка Цикл  
			Если ВариантОбеспеченияНовый = Перечисления.ВариантыОбеспечения.СоСклада Тогда 
				ТекстСообщения = ТекстСообщения + "Остаток отсутствует! Не зарезервировано количество по номенклатуре "+ СтрНЗ.Номенклатура + Символы.ПС;
			ИначеЕсли ВариантОбеспеченияНовый = Перечисления.ВариантыОбеспечения.Отгрузить Тогда 
				ТекстСообщения = ТекстСообщения + "Остаток отсутствует! Не отгружено количество по номенклатуре "+ СтрНЗ.Номенклатура + Символы.ПС;
			КонецЕсли;
		КонецЦикла;     
		
		Если ЗначениеЗаполнено(ТекстСообщения) Тогда 
			Сообщить(ТекстСообщения);
		КонецЕсли;  
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере 
Функция ПолучитьДанныеРегистраПоНоменклатуре(Номенклатура)
	
	ДанныеРегистра = Новый Структура("Остаток,Расход,РасходПоТСД");
	НЗ = РегистрыСведений.ТТМ_АРМ_РезервированиеСписаниеМатериалов.СоздатьНаборЗаписей();
	НЗ.Отбор.Номенклатура.Установить(Номенклатура);
	НЗ.Отбор.ЭтоСписание.Установить(не Объект.Резерв);
	НЗ.Отбор.Пользователь.Установить(Пользователи.АвторизованныйПользователь());
	НЗ.Прочитать();
	ТЗ = НЗ.Выгрузить();                               
	Расход = ТЗ.Итог("Количество");
	РасходПоТСД = ТЗ.Итог("ПодобраноНаТСД");
	Остаток = ТЗ[0].Остаток;
	
	ДанныеРегистра.Остаток = Остаток;
	ДанныеРегистра.Расход = Расход;
	ДанныеРегистра.РасходПоТСД = РасходПоТСД;
	
	Возврат ДанныеРегистра;
	
КонецФункции

