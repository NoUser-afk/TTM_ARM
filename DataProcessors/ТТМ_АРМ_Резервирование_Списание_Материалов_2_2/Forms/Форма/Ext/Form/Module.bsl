&НаСервереБезКонтекста
Процедура ОчиститРегистрПолностью(ЭтоСписание)
	Пользователь = Пользователи.АвторизованныйПользователь();
	НЗ = РегистрыСведений.ТТМ_АРМ_РезервированиеСписаниеМатериалов.СоздатьНаборЗаписей();
	НЗ.Отбор.Пользователь.Установить(Пользователь);
	НЗ.Отбор.ЭтоСписание.Установить(ЭтоСписание); 
	//НЗ.Отбор.ЭтапПроизводства.Установить(СсылкаНаЭтап);
	НЗ.Прочитать();  
	НЗ.Очистить();  
	НЗ.Записать();
КонецПроцедуры

&НаСервере
Функция ЗаполнитьРегистрПоСпецификациям(ТаблицаДанных, СсылкаНаЭтап, ЭтоСписание)
	
	СтруктураРезультата = Новый Структура("Результат,МассивЗадвоеннойНоменклатуры");
	Результат = Ложь;
	
	ТабМатериалы = ТаблицаДанных.Выгрузить();
	
	Пользователь = Пользователи.АвторизованныйПользователь();
	НЗ = РегистрыСведений.ТТМ_АРМ_РезервированиеСписаниеМатериалов.СоздатьНаборЗаписей();
	НЗ.Отбор.Пользователь.Установить(Пользователь);
	НЗ.Отбор.ЭтоСписание.Установить(ЭтоСписание); 
	НЗ.Отбор.ЭтапПроизводства.Установить(СсылкаНаЭтап);
	НЗ.Прочитать();      
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	МатериалыЭтапа.НомерСтроки КАК НомерСтроки,
	               |	МатериалыЭтапа.Номенклатура КАК Номенклатура,
	               |	МатериалыЭтапа.Характеристика КАК Характеристика,
	               |	МатериалыЭтапа.Серия КАК Серия,
	               |	МатериалыЭтапа.Упаковка КАК Упаковка,
	               |	МатериалыЭтапа.КоличествоУпаковок КАК КоличествоУпаковок,
	               |	МатериалыЭтапа.Количество КАК Количество,
	               |	МатериалыЭтапа.ВариантОбеспечения КАК ВариантОбеспечения,
	               |	МатериалыЭтапа.ДатаОтгрузки КАК ДатаОтгрузки,
	               |	МатериалыЭтапа.Склад КАК Склад,
	               |	МатериалыЭтапа.Производится КАК Производится,
	               |	МатериалыЭтапа.Назначение КАК Назначение,
	               |	МатериалыЭтапа.НазначениеОбеспечения КАК НазначениеОбеспечения,
	               |	МатериалыЭтапа.СтатусУказанияСерий КАК СтатусУказанияСерий,
	               |	МатериалыЭтапа.СтатусУказанияСерийОтправитель КАК СтатусУказанияСерийОтправитель,
	               |	МатериалыЭтапа.СтатусУказанияСерийПолучатель КАК СтатусУказанияСерийПолучатель,
	               |	МатериалыЭтапа.КодСтроки КАК КодСтроки,
	               |	МатериалыЭтапа.ИспользуетсяАвтовыбор КАК ИспользуетсяАвтовыбор,
	               |	МатериалыЭтапа.СведенияАвтовыбора КАК СведенияАвтовыбора,
	               |	МатериалыЭтапа.ПрименениеМатериала КАК ПрименениеМатериала,
	               |	МатериалыЭтапа.КлючСвязиСпецификация КАК КлючСвязиСпецификация,
	               |	МатериалыЭтапа.СтатьяКалькуляции КАК СтатьяКалькуляции,
	               |	МатериалыЭтапа.Обособленно КАК Обособленно,
	               |	МатериалыЭтапа.Отменено КАК Отменено,
	               |	МатериалыЭтапа.ПричинаОтмены КАК ПричинаОтмены,
	               |	МатериалыЭтапа.Период КАК Период,
	               |	МатериалыЭтапа.АналитикаУчетаНоменклатуры КАК АналитикаУчетаНоменклатуры,
	               |	МатериалыЭтапа.КорАналитикаУчетаНоменклатуры КАК КорАналитикаУчетаНоменклатуры,
	               |	МатериалыЭтапа.ИдентификаторСтроки КАК ИдентификаторСтроки,
	               |	МатериалыЭтапа.Подразделение КАК Подразделение,
	               |	МатериалыЭтапа.КлючСвязиНабор КАК КлючСвязиНабор,
	               |	МатериалыЭтапа.КлючНоменклатура КАК КлючНоменклатура,
	               |	МатериалыЭтапа.Количество КАК Обеспечить,
	               |	МатериалыЭтапа.Спецификация КАК Спецификация,
	               |	МатериалыЭтапа.Количество КАК Норматив,
	               |	1 КАК СтрокаМатериала
	               |ПОМЕСТИТЬ ТабМатериалыЭтапаБезОстатков
	               |ИЗ
	               |	&ТабМатериалы КАК МатериалыЭтапа
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ТабМатериалыЭтапаБезОстатков.Номенклатура КАК Номенклатура
	               |ПОМЕСТИТЬ СписокМатериалов
	               |ИЗ
	               |	ТабМатериалыЭтапаБезОстатков КАК ТабМатериалыЭтапаБезОстатков
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЕСТЬNULL(ЕСТЬNULL(ТоварыНаСкладахОстатки.Склад, ЗапасыИПотребностиОстатки.Склад), ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)) КАК Склад,
	               |	СписокМатериалов.Номенклатура КАК Номенклатура,
	               |	ЕСТЬNULL(ЕСТЬNULL(ТоварыНаСкладахОстатки.Характеристика, ЗапасыИПотребностиОстатки.Характеристика), ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) КАК Характеристика,
	               |	СУММА(ЕСТЬNULL(ТоварыНаСкладахОстатки.ВНаличииОстаток, 0)) КАК ВНаличии,
	               |	СУММА(ЕСТЬNULL(ЗапасыИПотребностиОстатки.РезервироватьНаСкладеОстаток, 0)) КАК Резерв,
	               |	СУММА(ЕСТЬNULL(ТоварыКОтгрузкеОстатки.КОтгрузкеОстаток, 0)) КАК Отгружается
	               |ПОМЕСТИТЬ ВТ_НовыеОстаткиИзЗапасов_v1
	               |ИЗ
	               |	СписокМатериалов КАК СписокМатериалов
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыНаСкладах.Остатки(, Склад В (&Склад)) КАК ТоварыНаСкладахОстатки
	               |		ПО (ЕСТЬNULL(ТоварыНаСкладахОстатки.Номенклатура, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) = ЕСТЬNULL(СписокМатериалов.Номенклатура, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)))
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗапасыИПотребности.Остатки(, Склад В (&Склад)) КАК ЗапасыИПотребностиОстатки
	               |		ПО (ЕСТЬNULL(СписокМатериалов.Номенклатура, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) = ЕСТЬNULL(ЗапасыИПотребностиОстатки.Номенклатура, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)))
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыКОтгрузке.Остатки(, Склад В (&Склад)) КАК ТоварыКОтгрузкеОстатки
	               |		ПО (ЕСТЬNULL(СписокМатериалов.Номенклатура, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) = ЕСТЬNULL(ТоварыКОтгрузкеОстатки.Номенклатура, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)))
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	СписокМатериалов.Номенклатура,
	               |	ЕСТЬNULL(ЕСТЬNULL(ТоварыНаСкладахОстатки.Склад, ЗапасыИПотребностиОстатки.Склад), ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)),
	               |	ЕСТЬNULL(ЕСТЬNULL(ТоварыНаСкладахОстатки.Характеристика, ЗапасыИПотребностиОстатки.Характеристика), ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка))
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Номенклатура КАК Номенклатура,
	               |	СУММА(ВЫБОР
	               |			КОГДА ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.ВариантОбеспечения = ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.СоСклада)
