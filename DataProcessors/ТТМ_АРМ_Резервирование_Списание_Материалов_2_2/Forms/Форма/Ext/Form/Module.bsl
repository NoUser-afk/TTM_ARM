&НаКлиенте
Процедура ЗаполнитьПоСпецификации(Команда)
	
	ТабВыбранныеЭтапы = ПолучитьКоличествоВыбранныхЭтапов(Истина,,Истина);
	ЭтоСписание = не Объект.Резерв;  
	
	МассивЗадвоеннойНоменклатуры = Новый Массив;
	ОчиститРегистрПолностью(не Объект.Резерв);
	
	Для Каждого ЭтапПроизводства из ТабВыбранныеЭтапы Цикл 
		ПараметрыФормы = Новый Структура("Ключ", ЭтапПроизводства);
		Форма = ПолучитьФорму("Документ.ЭтапПроизводства2_2.ФормаОбъекта",ПараметрыФормы);
		//Форма.Обеспечение_ЗаполнитьПоСпецификацииЗавершение(КодВозвратаДиалога.Да, Неопределено); 
		
		ПереченьДанных = Новый Структура("ОбеспечениеМатериаламиИРаботами");                         
		ДополнительныеПараметры = Новый Структура;
		Форма.Производство_ЗаполнитьПоСпецификацииЗавершение(ПереченьДанных,ДополнительныеПараметры);
		
		ТабМатериалы = Форма.Объект.ОбеспечениеМатериаламиИРаботами; 
		ПереченьКолонок = ПолучитьПереченьКолонокТЧМатериалыЭтапаДляСвертки();
		СтруктураВозврата = ЗаполнитьРегистрПоСпецификациям(ТабМатериалы, Форма.Объект.Ссылка, ЭтоСписание);
		
		Если СтруктураВозврата.МассивЗадвоеннойноменклатуры.Количество() > 0 Тогда 
			Для Каждого Задвоеннаяноменклатура из СтруктураВозврата.МассивЗадвоеннойноменклатуры Цикл 
				Если МассивЗадвоеннойноменклатуры.Найти(Задвоеннаяноменклатура) = Неопределено Тогда 
					МассивЗадвоеннойноменклатуры.Добавить(Задвоеннаяноменклатура);
				КонецЕсли;
			КонецЦикла; 
		КонецЕсли;
		
	КонецЦикла;  
		
	Если МассивЗадвоеннойНоменклатуры.Количество() <> 0 Тогда 
		ТекстСообщенияЗадвоеннаяноменклатура = "";
		Для Каждого Номенклатура из МассивЗадвоеннойНоменклатуры Цикл 
			ТекстСообщенияЗадвоеннаяноменклатура = ТекстСообщенияЗадвоеннаяноменклатура + Номенклатура + Символы.ПС;
		КонецЦикла;   
		Сообщить("В спецификации более 1 строки по номенклатуре:" + Символы.ПС + ТекстСообщенияЗадвоеннаяноменклатура);
	КонецЕсли;
	
	ПоЭтапам = Ложь;                              
	СписокНоменклатурыБезОстатка.Очистить();
	ЗаполнитьМатериалыСпецификации(ПоЭтапам);  
	
	Если СписокНоменклатурыБезОстатка.Количество() > 0 Тогда 
		ТекстСообщенияНоменклатураБезОстатка = "";
		Для Каждого Номенклатура из СписокНоменклатурыБезОстатка Цикл 
			ТекстСообщенияНоменклатураБезОстатка = ТекстСообщенияНоменклатураБезОстатка + Номенклатура + Символы.ПС;
		КонецЦикла;
		Сообщить("Нет остатка на складе по номенклатуре:" + Символы.ПС + ТекстСообщенияНоменклатураБезОстатка);
	КонецЕсли;
	
	УстановитьУсловноеОформлениеМатериаловСпецификации();
	Сообщить("Материалы этапов заполенны по спецификации!", СтатусСообщения.Важное);
    
КонецПроцедуры   

