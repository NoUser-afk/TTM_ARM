&НаКлиенте
Процедура ПериодОтгрузкиПриИзменении(Элемент) 
	Списание = не Объект.Резерв;
	ЗаполнитьЭтапыСВопросом(Списание);
КонецПроцедуры
   
&НаКлиенте
Процедура УдалениеЗаписейРегистраПродолжение(Результат,ДопПараметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда 
		УдалитьЗаписиРегистра(ДопПараметры.ЭтоСписание);
	Иначе 
		Объект.Номенклатура = ДопПараметры.Номенклатура;
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьКоличествоЗаписейРегистра(ЭтоСписание);
	
	НЗ = РегистрыСведений.ТТМ_АРМ_РезервированиеСписаниеМатериалов.СоздатьНаборЗаписей();
	НЗ.Отбор.ЭтоСписание.Установить(ЭтоСписание);
	НЗ.Отбор.Пользователь.Установить(Пользователи.АвторизованныйПользователь());
	НЗ.Прочитать();
	Возврат НЗ.Количество();
	
КонецФункции   

&НаСервереБезКонтекста
Процедура УдалитьЗаписиРегистра(ЭтоСписание);
	
	НЗ = РегистрыСведений.ТТМ_АРМ_РезервированиеСписаниеМатериалов.СоздатьНаборЗаписей();
	НЗ.Отбор.ЭтоСписание.Установить(ЭтоСписание);
	НЗ.Отбор.Пользователь.Установить(Пользователи.АвторизованныйПользователь());
	НЗ.Прочитать();
	НЗ.Очистить();
	НЗ.Записать();
	
КонецПроцедуры
	

