#Область РаботаНаСтраницеМатериалыСпецификации

&НаСервере   
//ТекСтрока данные строки на форме
//ТекстрокаРЕгистра - данные строкирегистра (еще не измененные)
Процедура ЗаписатьИзмененияВРегистрНоваяСтарая(ТекСтрока, ТекстрокаРегистра, ЭтапПроизводства = Неопределено) //, СтруктураОтбора = Новый Структура) //Номенклатура, ЭтапПроизводства, Отметка)
	
	ИзменениеКоличества = Ложь;
	ИзменениеОтметки = Ложь;
	ИзменениеНоменклатуры = Ложь;   
	ИзменениеТЧРаспределение = Ложь;
	ЭтоСписание = не Объект.Резерв;    
	
	//Получим норматив для измененной позиции спецификации 
	ПараметрыОтбора = Новый Структура("Обрабатывать",Истина);
	МассивЭтапов = Этапы.НайтиСтроки(ПараметрыОтбора);
	//Этап = МассивЭтапов[0].ЭтапПроизводства;   
	Если ЗначениеЗаполнено(ЭтапПроизводства) Тогда  
		ИзменениеТЧРаспределение = Истина;  
		Нормативы = ПолучитьНормативыИзВременногоХранилища(ЭтапПроизводства); //АдресХранилищаНормативы
	Иначе 
		Нормативы = ПолучитьНормативыИзВременногоХранилища(МассивЭтапов[0].ЭтапПроизводства);
	КонецЕсли;
	СтруктураПоиска = Новый Структура("Номенклатура",ТекстрокаРегистра.Номенклатура); //,КлючСвязиСпецификация,СтрНЗ.КлючСвязиСпецификация
	МассивНайденныхСтрок = Нормативы.ОбеспечениеМатериаламиИРаботами.НайтиСтроки(СтруктураПоиска);
	Если МассивНайденныхСтрок.Количество() > 1 Тогда 
		Сообщить("Норматив: найдено более 1 строки! " + ТекстрокаРегистра.Номенклатура);
	ИначеЕсли МассивНайденныхСтрок.Количество() = 1 Тогда 
		Норматив = МассивНайденныхСтрок[0].КоличествоУпаковок;
	Иначе   
		Норматив = 0;
	КонецЕсли;
	
	Если ИзменениеТЧРаспределение Тогда  //ЗначениеЗаполнено(ЭтапПроизводства) Тогда 
		//ИзменениеТЧРаспределение = Истина;  
		
		Резерв = Текстрока.Резерв = Истина;
		МягкийРезерв = ТекСтрока.МягкийРезерв = Истина;
		Отгрузить = ТекСтрока.Отгрузить = Истина;
		Если ТекСтрока.Отметка и (Резерв или МягкийРезерв или Отгрузить) Тогда  
			Обособленно = Ложь;
			Если Резерв Тогда 
				ВариантобеспеченияНовый = Перечисления.ВариантыОбеспечения.СоСклада;
			ИначеЕсли МягкийРезерв Тогда
				ВариантобеспеченияНовый = Перечисления.ВариантыОбеспечения.РезервироватьПоМереПоступления;
			ИначеЕсли Отгрузить Тогда 
				ВариантобеспеченияНовый = Перечисления.ВариантыОбеспечения.Отгрузить;
			КонецЕсли;       
		ИначеЕсли не ТекСтрока.Отметка Тогда  
			//Восстановление строки регистра с количество по нормативу
			ИзменениеОтметки = Истина;
			Обособленно = Истина;                               
			ВариантобеспеченияНовый = Перечисления.ВариантыОбеспечения.КОбеспечению;
		КонецЕсли; 
		//Получим норматив для измененной позиции спецификации 
		//Нормативы = ПолучитьНормативыИзВременногоХранилища(Этап);
		СтруктураПоиска = Новый Структура("Номенклатура",ТекстрокаРегистра.Номенклатура); //,КлючСвязиСпецификация,СтрНЗ.КлючСвязиСпецификация
		МассивНайденныхСтрок = Нормативы.ОбеспечениеМатериаламиИРаботами.НайтиСтроки(СтруктураПоиска);
		Если МассивНайденныхСтрок.Количество() > 1 Тогда 
			Сообщить("Норматив: найдено более 1 строки! " + ТекстрокаРегистра.Номенклатура);
		ИначеЕсли МассивНайденныхСтрок.Количество() = 1 Тогда 
			Норматив = МассивНайденныхСтрок[0].КоличествоУпаковок;
		Иначе   
			Норматив = 0;
		КонецЕсли;
		
		СтруктуктураОтбора = Новый Структура("Номенклатура,ЭтапПроизводства");
		ЗаполнитьЗначенияСвойств(СтруктуктураОтбора,ТекСтрока);
		
		ВариантОбеспеченияДо = ПолучитьВариантОбеспеченияИзРегистра(ТекстрокаРегистра.Номенклатура,ТекСтрока.ЭтапПроизводства);
		
		Если не ВариантобеспеченияНовый = ВариантОбеспеченияДо Тогда 
			УстановитьВариантОбеспеченияНовая(ВариантобеспеченияНовый,Обособленно,ЭтоСписание,СтруктуктураОтбора);
			Возврат;
		КонецЕсли;
	КонецЕсли; 
	
	НЗ = РегистрыСведений.ТТМ_АРМ_РезервированиеСписаниеМатериалов.СоздатьНаборЗаписей();   
	//!!!НЗ.Отбор.ЭтоСписание.Установить(ЭтоСписание);//!!!!!
	НЗ.Отбор.ЭтоСписание.Установить(ЭтоСписание);
	НЗ.Отбор.Пользователь.Установить(Пользователи.АвторизованныйПользователь());
	НЗ.Отбор.Номенклатура.Установить(ТекстрокаРегистра.Номенклатура);
	Если ИзменениеТЧРаспределение Тогда 
		НЗ.Отбор.ЭтапПроизводства.Установить(ЭтапПроизводства);	   
		//+Ганьшина Е 09.04.2025     
		НЗ.Прочитать();
		Если НЗ.Количество() = 0 Тогда 
			ИзменениеОтметки = Истина; 
