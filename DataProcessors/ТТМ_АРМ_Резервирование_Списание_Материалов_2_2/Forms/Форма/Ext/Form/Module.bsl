&НаСервере
Процедура СохранитьНастройкиНаСервере()
	КлючНастроек = "ТТМ_АРМ_Резервирование_Списание_Материалов_2_2" + ПараметрыСеанса.ТекущийПользователь;
	Настройки = Новый Соответствие;
	Настройки.Вставить("Выполнено", ПроцентВыполнения);
	Настройки.Вставить("КатегорияМатериала", Объект.ДР_КатегорияМатериала);
	Настройки.Вставить("ДокументПодбораМатериалов", Объект.ДокументПодбораМатериалов);
	Настройки.Вставить("СтатьяКалькуляции", Объект.СтатьяКалькуляции);
	    
	ОбщегоНазначения.ХранилищеОбщихНастроекСохранить("ТТМ_АРМ_Резервирование_Списание_Материалов_2_2", КлючНастроек, Настройки);	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьНастройкиНаСервере()
	КлючНастроек = "ТТМ_АРМ_Резервирование_Списание_Материалов_2_2" + ПараметрыСеанса.ТекущийПользователь;
	ЗначениеНастроек = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("ТТМ_АРМ_Резервирование_Списание_Материалов_2_2", КлючНастроек);
			
	Если ЗначениеНастроек = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru ='Не найден список настроек для данного поля'"),, "ПроцентВыполнения");
		Возврат;
	КонецЕсли;
			
	Если ТипЗнч(ЗначениеНастроек) = Тип("Соответствие") Тогда
		Для Каждого ТекНастройки Из ЗначениеНастроек Цикл
			Если ТекНастройки.Ключ = "Выполнено" Тогда  
				ПроцентВыполнения = ТекНастройки.Значение;
			ИначеЕсли ТекНастройки.Ключ = "КатегорияМатериала" Тогда  
				Объект.ДР_КатегорияМатериала = ТекНастройки.Значение;
			ИначеЕсли ТекНастройки.Ключ = "ДокументПодбораМатериалов" Тогда
				Объект.ДокументПодбораМатериалов = ТекНастройки.Значение;			
			ИначеЕсли ТекНастройки.Ключ = "СтатьяКалькуляции" Тогда
				Объект.СтатьяКалькуляции = ТекНастройки.Значение;
			КонецЕсли;
		КонецЦикла;	
	КонецЕсли;	
КонецПроцедуры

