&НаКлиенте
Процедура ОбновитьМатериалыСпецификации(ПоЭтапам)
	
	//Запомним Номенклатру текущей строки ТЧ МатериалыСпецификации     
	Если не Элементы.МатериалыСпецификации.ТекущаяСтрока = Неопределено Тогда 
		ТекСтрока = Объект.МатериалыСпецификации.НайтиПоИдентификатору(Элементы.МатериалыСпецификации.ТекущаяСтрока);
		ИндексТекСтроки = Объект.МатериалыСпецификации.Индекс(ТекСтрока);
		Номенклатура = ТекСтрока.Номенклатура;
	Иначе            
		Если Объект.МатериалыСпецификации.Количество() > 0 Тогда 
			ТекСтрока = Объект.МатериалыСпецификации.НайтиПоИдентификатору(0);
			ИндексТекСтроки = Объект.МатериалыСпецификации.Индекс(ТекСтрока);
			Номенклатура = ТекСтрока.Номенклатура;
		КонецЕсли;
	КонецЕсли;
	
	ОтборКатегорияМатериала = ОтборКатегорияМатериала;   
	//ОтборПоВариантамОбеспечения = ОтборВариантОбеспечения;
	ОбновитьМатериалыСпецификацииНаСервере(ПоЭтапам);
		
	//Восстановим ТекущуюСтроку ТЧ (по номенклатуре)          
	ПараметрыОтбора = Новый Структура("Номенклатура",Номенклатура);
	МассивСтрокПоНоменклатуре = Объект.МатериалыСпецификации.НайтиСтроки(ПараметрыОтбора); 
	Если МассивСтрокПоНоменклатуре.Количество() > 0 Тогда 
		ТекСтрока = Объект.МатериалыСпецификации.НайтиСтроки(ПараметрыОтбора)[0]; 
		Элементы.МатериалыСпецификации.ТекущаяСтрока = ТекСтрока.ПолучитьИдентификатор();
	Иначе 
		Элементы.МатериалыСпецификации.ТекущаяСтрока = 0;
	КонецЕсли;           
	Если Элементы.МатериалыСпецификации.ТекущиеДанные = Неопределено Тогда   
		Если Объект.МатериалыСпецификации.Количество() > 0 Тогда 
			ТекНоменклатура = Объект.МатериалыСпецификации[0].Номенклатура;
		Иначе 
			ТекНоменклатура = Неопределено;
		КонецЕсли;
	Иначе 
		ТекНоменклатура = Элементы.МатериалыСпецификации.ТекущиеДанные.Номенклатура;
	КонецЕсли;
	
	//Заполним ТЧ РаспределениеМатериала
	Если не ТекНоменклатура = Неопределено Тогда 
		ЗаполнитьТЧРаспределениеМатериалаПоДаннымРегистра(ТекНоменклатура);
	КонецЕсли;
	РасходВсего = Объект.РаспределениеМатериала.Итог("КоличествоУпаковок");
	КоличествоОтмеченныхЭтапов = Объект.РаспределениеМатериала.Количество();
		
КонецПроцедуры	
	
