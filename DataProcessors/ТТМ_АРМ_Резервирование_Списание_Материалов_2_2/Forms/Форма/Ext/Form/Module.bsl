			Элементы.МатериалыСпецификации.ТекущаяСтрока = ТекСтрока.ПолучитьИдентификатор();
		КонецЕсли; 
		
		ОбновлениеДанныхФормы = Ложь; 
		Возврат;
	КонецЕсли;  							//- Ганьшина Е 14.04.2025
	
	Если Элемент.ТекущиеДанные = Неопределено и не ЗначениеЗаполнено(Элемент.ТекущаяСтрока) Тогда 
		//Элемент.ТекущаяСтрока = 0; 
		Возврат;  //+ Ганьшина Е 14.04.2025 //-
	ИначеЕсли не ЗначениеЗаполнено(Элемент.ТекущаяСтрока) Тогда 
		//Элемент.ТекущаяСтрока = 0;
		//Возврат; //+ Ганьшина Е 14.04.2025 //29.05.2025 закомментировала
	КонецЕсли;
	
	ТекСтрокаМатериалы = Элемент.ТекущиеДанные;
	
	Попытка
		ТекМатериал = ТекСтрокаМатериалы.Номенклатура;    
		ТекущаяНоменклатура = ТекМатериал;
	Исключение               
		Возврат; //+ Ганьшина Е 14.04.2025
	КонецПопытки;
	ЗаполнитьТЧРаспределениеМатериалаПоДаннымРегистра(ТекМатериал); 
	Элементы.РаспределениеМатериала.ТекущаяСтрока = 0;
	Попытка                  

	Исключение
	КонецПопытки;
	РасходВсего = Объект.РаспределениеМатериала.Итог("КоличествоУпаковок");
	//ПараметрыОтбора = Новый Структура("Отметка",Истина);
	//МассивОтмеченныхСтрок = Объект.РаспределениеМатериала.Выгрузить(ПараметрыОтбора,"Отметка");
	КоличествоОтмеченныхЭтапов = ПолучитьКоличествоОтмеченныхЭтапов();//МассивОтмеченныхСтрок.Количество();
	//КоличествоОтмеченныхЭтапов = Объект.РаспределениеМатериала.Количество();    
	
	ЗаполнитьЗначенияСвойств(ИсходныеДанныеСтрокиМатериаловСпецификации, ТекСтрокаМатериалы);  
	
	Если Элементы.РаспределениеМатериала.ТекущиеДанные = Неопределено Тогда  
		Если Объект.РаспределениеМатериала.Количество() > 0 Тогда 
			ЭтапПроизводства = Объект.РаспределениеМатериала[0].ЭтапПроизводства;
			КоличествоУпаковок = Объект.РаспределениеМатериала[0].КоличествоУпаковок; 
			Количество = Объект.РаспределениеМатериала[0].Количество; ///??Закомментировать и проверить
		Иначе 
			ЭтапПроизводства = ПредопределенноеЗначение("Документ.ЭтапПроизводства2_2.ПустаяСсылка");
			КоличествоУпаковок = 0; 
			Количество = 0;
		КонецЕсли; 
	Иначе 
		ЭтапПроизводства = ПредопределенноеЗначение("Документ.ЭтапПроизводства2_2.ПустаяСсылка");
		КоличествоУпаковок = 0; 
		Количество = 0;
	КонецЕсли;
	
	//ЗаполнитьЗначенияСвойств(ИсходныеДанныеСтрокиМатериаловСпецификации,
	ИсходныеДанныеСтрокиМатериаловСпецификации.ЭтапПроизводства = ЭтапПроизводства;
	ИсходныеДанныеСтрокиМатериаловСпецификации.КоличествоУпаковок = КоличествоУпаковок;    
	ИсходныеДанныеСтрокиМатериаловСпецификации.Номенклатура = ТекущаяНоменклатура;   
	
	СтруктураКоэффициента = ПолучитьКоэффициентУпаковки(ИсходныеДанныеСтрокиМатериаловСпецификации);
	КоэффициентУпаковки = СтруктураКоэффициента.Знаменатель / СтруктураКоэффициента.Числитель; 
	ИсходныеДанныеСтрокиМатериаловСпецификации.Количество = КоличествоУпаковок * КоэффициентУпаковки;
	
	ОбновлениеДанныхФормы = Ложь;
	
