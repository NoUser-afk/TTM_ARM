	ЭтапПроизводства = ТекСтрока.ЭтапПроизводства;
	ИДТекСтроки = Элементы.РаспределениеМатериала.ТекущиеДанные.ПолучитьИдентификатор();
	Если не ТекСтрока.Отметка Тогда 
		КоличествоОтмеченныхЭтапов = КоличествоОтмеченныхЭтапов - 1;
		РасходВсего = РасходВсего - ТекСтрока.КоличествоУпаковок;
	ИначеЕсли ТекСтрока.Отметка Тогда 
		КоличествоОтмеченныхЭтапов = КоличествоОтмеченныхЭтапов + 1;
		РасходВсего = РасходВсего + ТекСтрока.КоличествоУпаковок;
