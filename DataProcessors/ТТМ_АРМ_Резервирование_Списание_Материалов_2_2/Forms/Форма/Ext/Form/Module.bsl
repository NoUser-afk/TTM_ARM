#Область ЗаполнениеЭтаповНаСтраницеЭтапыКСписанию

&НаКлиенте
Процедура Новая_ЗаполнитьЭтапы(Команда)
	ПроверкаВыполнена = ПроверкаЗаполненияВажныхПолейФормы(Команда.Действие);
	
	Если Не ПроверкаВыполнена Тогда
		Возврат;
	КонецЕсли;
	
	Новая_ЗаполнитьЭтапыНаСервере();
КонецПроцедуры

&НаКлиенте
Функция ПроверкаЗаполненияВажныхПолейФормы(ТекущаяКоманда, Знач ПроверкаВыполнена = Истина)
	Если ТекущаяКоманда = "Новая_ЗаполнитьЭтапы" Тогда
		Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не заполнено поле организация'"),, "Объект.Организация");	
			ПроверкаВыполнена = Ложь;
		ИначеЕсли Не ЗначениеЗаполнено(Объект.ПериодОтгрузки) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не выбрана дата'"),, "Объект.ПериодОтгрузки");	
			ПроверкаВыполнена = Ложь;			
		ИначеЕсли Не ЗначениеЗаполнено(Объект.Номенклатура) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не заполнено поле продукция'"),, "Объект.Номенклатура");
			ПроверкаВыполнена = Ложь;			
		КонецЕсли;		
	КонецЕсли;
	
	Если ТекущаяКоманда = "РаспределитьКоличество" Тогда
		Если НовоеКоличествоДляРаспределения = 0 Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Количество не может быть нулевым'"),, "НовоеКоличествоДляРаспределения");
			ПроверкаВыполнена = Ложь;
		КонецЕсли;
	КонецЕсли;
		
	Если ТекущаяКоманда = "ЗафиксироватьКорректировкиНовая" Тогда
		Если ПроцентВыполнения = 0 Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Значение не может быть нулевым'"),, "ПроцентВыполнения");
			ПроверкаВыполнена = Ложь;
		ИначеЕсли Не Объект.Резерв И Не ЗначениеЗаполнено(Объект.ПериодОтгрузки) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Заполните дату отгрузки!'"),, "Объект.ПериодОтгрузки");
			ПроверкаВыполнена = Ложь;
		КонецЕсли;
		
		ПараметрыПоска = Новый Структура("Количество",0);
		МассивСтрокСНУлевымКоличеством = Объект.РаспределениеМатериала.НайтиСтроки(ПараметрыПоска);
		Если МассивСтрокСНУлевымКоличеством.Количество() > 0 Тогда 
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Количество не может быть нулевым!'"),, "РаспределениеМатералов.Количество");
			ПроверкаВыполнена = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТекущаяКоманда = "ЗагрузитьПодобранныеМатериалы" Тогда
		Если Не ЗначениеЗаполнено(Объект.ДокументПодбораМатериалов) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Укажите номер документ в настройках'"),, "Объект.ДокументПодбораМатериалов");
			ПроверкаВыполнена = Ложь;
		КонецЕсли;
	КонецЕсли; 
 
	Возврат ПроверкаВыполнена; 
КонецФункции

&НаСервере
Процедура Новая_ЗаполнитьЭтапыНаСервере()
	ПеремЭтапы = Этапы;       
	Списание = Не Объект.Резерв;
	ЗаполнитьЭтапыНаСервере(ПеремЭтапы, Списание);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЭтапыНаСервере(перемЭтапы,Списание); 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЭтапПроизводства2_2ВыходныеИзделия.Ссылка КАК Ссылка,
	               |	СУММА(ЭтапПроизводства2_2ВыходныеИзделия.Количество) КАК Количество
	               |ПОМЕСТИТЬ ВТ_КоличествоПроизведено
	               |ИЗ
	               |	Документ.ЭтапПроизводства2_2.ВыходныеИзделия КАК ЭтапПроизводства2_2ВыходныеИзделия
	               |ГДЕ
	               |	ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.Проведен
	               |	И ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.Организация = &Организация ";
	Если Списание Тогда Запрос.Текст = Запрос.Текст + "
	               |	И ЭтапПроизводства2_2ВыходныеИзделия.Произведено ";
	КонецЕсли;
	Запрос.Текст = Запрос.Текст + "
	               |	И ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЭтаповПроизводства2_2.Начат)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЭтапПроизводства2_2ВыходныеИзделия.Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
				   |ВЫБРАТЬ
				   |	ТТМ_УчетСерийныхНомеровПродукции.Регистратор КАК Регистратор,
				   |	ТТМ_УчетСерийныхНомеровПродукции.Номенклатура КАК Номенклатура,
				   |	ТТМ_УчетСерийныхНомеровПродукции.СерийныйНомер КАК СерийныйНомер
				   |ПОМЕСТИТЬ ВТ_СерийныеНомера
			       |ИЗ
				   |	РегистрНакопления.ТТМ_УчетСерийныхНомеровПродукции КАК ТТМ_УчетСерийныхНомеровПродукции
				   |ГДЕ
				   |	ТТМ_УчетСерийныхНомеровПродукции.Регистратор ССЫЛКА Документ.ЭтапПроизводства2_2";
			Если ЗначениеЗаполнено(Объект.Номенклатура)  Тогда //или ЗначениеЗаполнено(Объект.НоменклатураРезервирование)
				Запрос.Текст = Запрос.Текст + "
				   |	И ТТМ_УчетСерийныхНомеровПродукции.Номенклатура = &Номенклатура";
			КонецЕсли;
			Запрос.Текст = Запрос.Текст + "
				   |;
				   |
				   |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ      
				   |	1 КАК НомерСтроки,
	               |	ЛОЖЬ КАК Обрабатывать,
	               |	ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.Статус КАК Статус,
				   |	ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.Номер КАК Номер,
				   |	ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.ДатаПроизводства КАК ДатаПроизводства,
	               |	ЭтапПроизводства2_2ВыходныеИзделия.Ссылка КАК ЭтапПроизводства,
				   |	ЕСТЬNULL(ВТ_СерийныеНомера.СерийныйНомер, """") КАК СерийныйНомер,
	               |	ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.КоличествоУпаковокФакт КАК КоличествоУпаковокФакт,
				   |	ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.КоличествоУпаковокПлан КАК Запланировано,
	               |	ЭтапПроизводства2_2ВыходныеИзделия.Назначение КАК Назначение,
				   |	ЭтапПроизводства2_2ВыходныеИзделия.Номенклатура КАК Номенклатура,
	               |	ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.Спецификация КАК Спецификация
	               |ИЗ
	               |	Документ.ЭтапПроизводства2_2.ВыходныеИзделия КАК ЭтапПроизводства2_2ВыходныеИзделия
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_КоличествоПроизведено КАК ВТ_КоличествоПроизведено
	               |		ПО ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.Ссылка = ВТ_КоличествоПроизведено.Ссылка";                       
	Если Списание Тогда Запрос.Текст = Запрос.Текст + "			   
	               |			И ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.КоличествоУпаковокПлан = ВТ_КоличествоПроизведено.Количество";
	КонецЕсли;
	Запрос.Текст = Запрос.Текст + " 
				   |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СерийныеНомера КАК ВТ_СерийныеНомера
			       |		ПО (ЭтапПроизводства2_2ВыходныеИзделия.Ссылка = ВТ_СерийныеНомера.Регистратор)
				   |			И (ЭтапПроизводства2_2ВыходныеИзделия.Номенклатура = ВТ_СерийныеНомера.Номенклатура)
	               |ГДЕ
	               |	ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.Проведен
	               |	И ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.Организация = &Организация
	               
	               |	И ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЭтаповПроизводства2_2.Начат)";
	               
	Если Списание Тогда 
		Запрос.Текст = Запрос.Текст + "
		            |	И ЭтапПроизводства2_2ВыходныеИзделия.Произведено";
					//|	И НАЧАЛОПЕРИОДА(ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.ДатаПроизводства, ДЕНЬ) = &Период
					//|	И НЕ ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЭтаповПроизводства2_2.Завершен)
					//|	И ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.КоличествоУпаковокФакт = 0.5";  
		Если ЗначениеЗаполнено(Объект.Номенклатура)  Тогда //или ЗначениеЗаполнено(Объект.НоменклатураРезервирование)
			Запрос.Текст = Запрос.Текст + "
	               |	И ЭтапПроизводства2_2ВыходныеИзделия.Номенклатура = &Номенклатура";
		КонецЕсли;
		Если ЗначениеЗаполнено(Объект.ПериодОтгрузки)  Тогда //или ЗначениеЗаполнено(Объект.НоменклатураРезервирование)
			Запрос.Текст = Запрос.Текст + "
	               |	И НАЧАЛОПЕРИОДА(ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.ДатаПроизводства, ДЕНЬ) = &Период";
		КонецЕсли;
	Иначе 
		Запрос.Текст = Запрос.Текст + "
					//|	И НАЧАЛОПЕРИОДА(ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.ФактическоеНачалоЭтапа, ДЕНЬ) = &Период
		           	|	И ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.КоличествоУпаковокФакт < 0.5";
		Если ЗначениеЗаполнено(Объект.Номенклатура)  Тогда 
			Запрос.Текст = Запрос.Текст + "
	               |	И ЭтапПроизводства2_2ВыходныеИзделия.Номенклатура = &Номенклатура";
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.НомерЗаказа) Тогда  //или ЗначениеЗаполнено(Объект.НомерЗаказаРезервирование)
		Запрос.Текст = Запрос.Текст + "	
	               |	И ЭтапПроизводства2_2ВыходныеИзделия.Назначение = &НомерЗаказа";
	КонецЕсли;    
	
	Запрос.Текст = Запрос.Текст + "	
	               |	УПОРЯДОЧИТЬ ПО Номер, КоличествоУпаковокФакт";
		
	Запрос.УстановитьПараметр("Организация", Объект.Организация);  
	Запрос.УстановитьПараметр("Период", Объект.ПериодОтгрузки);
	Запрос.УстановитьПараметр("Номенклатура", Объект.Номенклатура);
	Запрос.УстановитьПараметр("НомерЗаказа", Объект.НомерЗаказа);
		
	ТабЭтапы = Запрос.Выполнить().Выгрузить();
	ОбъектСравнения = Новый СравнениеЗначений;
	ТабЭтапы.Сортировать("ЭтапПроизводства", ОбъектСравнения);
	
	//Заполним номера строк
	Счетчик = 0;
	Для Каждого СтрЭтап из ТабЭтапы Цикл 
		Счетчик = Счетчик + 1;
		СтрЭтап.НомерСтроки = Счетчик;
	КонецЦикла; 
	
	/////////////////////////////////////////////////////////////////////////////////////////
	// Очистим данные регистра	
	УдалитьЗаписиРегистра(Списание);
	/////////////////////////////////////////////////////////////////////////////////////////
	
	ЗначениеВДанныеФормы(ТабЭтапы,перемЭтапы);
	
	//11.06.2025
	КопироватьДанныеФормы(перемЭтапы,Этапы);
	//Если Списание Тогда 
	//	КопироватьДанныеФормы(перемЭтапы,Этапы);
	//Иначе 
	//	КопироватьДанныеФормы(перемЭтапы,ЭтапыРезервирование);
	//КонецЕсли;     
	//-
	
КонецПроцедуры

