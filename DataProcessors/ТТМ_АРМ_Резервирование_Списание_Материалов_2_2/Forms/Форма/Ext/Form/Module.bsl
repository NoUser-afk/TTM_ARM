&НаКлиенте
Функция ЗапомнитьИсходныеДанныеСтроки()
	
	Если ТекСтраница = "Списание" Тогда 
		ИмяДерева = "ДеревоМатериалов";
		ИмяТаблицыИдентификаторов = "ИдентификаторыРаскрытыхСтрокДереваМатериалов";
		ЭтоСписание = Истина;  
		ДанныеТекСтроки = Элементы[ИмяДерева].ТекущиеДанные;
		ИДТекСтроки = ДанныеТекСтроки.ПолучитьИдентификатор();
		ЗаполнитьЗначенияСвойств(ИсходныеДанныеСтрокиДереваМатериалов, ДанныеТекСтроки);
		//ОбновитьИДТекущейСтроки(ИмяДерева, ИмяТаблицыИдентификаторов,ДанныеТекСтроки.Номенклатура, ДанныеТекСтроки.ЭтапПроизводства, ИДТекСтроки);
		Возврат ИсходныеДанныеСтрокиДереваМатериалов;
	ИначеЕсли ТекСтраница = "резервирование" Тогда 
		ИмяДерева = "ДеревоМатериаловРезервирование";    
		ИмяТаблицыИдентификаторов = "ИдентификаторыРаскрытыхСтрокДереваМатериаловРезервирование";
		ЭтоСписание = Ложь; 
		ДанныеТекСтроки = Элементы[ИмяДерева].ТекущиеДанные;
		ИДТекСтроки = ДанныеТекСтроки.ПолучитьИдентификатор();
		ЗаполнитьЗначенияСвойств(ИсходныеДанныеСтрокиДереваМатериаловРезервирование, ДанныеТекСтроки);
		//ОбновитьИДТекущейСтроки(ИмяДерева, ИмяТаблицыИдентификаторов,ДанныеТекСтроки.Номенклатура, ДанныеТекСтроки.ЭтапПроизводства, ИДТекСтроки);
		Возврат ИсходныеДанныеСтрокиДереваМатериаловРезервирование;
	КонецЕсли;
	
КонецФункции

&НаСервере
//НЕ ИСПОЛЬЗУЕТСЯ
//Делаем отбор по старой номенклатуре (НЗ) и по новой (НЗ1). Затем добавляем строку в новый набор и заполняем по старой номенклатуре. Старый набор очищаем, Новый записываем
//
//
Процедура ЗаменаМатериалаВРегистре(МассивСтруктурОбрабатываемыхСтрок, ТекСтрока, ЭтоСписание)
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Пользователь = Пользователи.АвторизованныйПользователь(); 
	Для Каждого Стр из МассивСтруктурОбрабатываемыхСтрок Цикл 
		НЗ=РегистрыСведений.ТТМ_АРМ_РезервированиеСписаниеМатериалов.СоздатьНаборЗаписей();
		НЗ.Отбор.ЭтоСписание.Установить(ЭтоСписание);
		НЗ.Отбор.Пользователь.Установить(Пользователь);
		НЗ.Отбор.Номенклатура.Установить(Стр.Номенклатура); 
		Если ЗначениеЗаполнено(Стр.ЭтапПроизводства) Тогда 
			НЗ.Отбор.ЭтапПроизводства.Установить(Стр.ЭтапПроизводства);
		КонецЕсли;
		Если ЗначениеЗаполнено(Стр.ВариантОбеспечения) Тогда 
			НЗ.Отбор.ВариантОбеспечения.Установить(Стр.ВариантОбеспечения); 
		КонецЕсли;
		Если ЗначениеЗаполнено(Стр.Спецификация) Тогда 
			НЗ.Отбор.СпецификацияЭтапа.Установить(Стр.Спецификация);      
		КонецЕсли;
		НЗ.Прочитать();
		//Стр = НЗ[0];  
		
		НЗ1=РегистрыСведений.ТТМ_АРМ_РезервированиеСписаниеМатериалов.СоздатьНаборЗаписей();
		НЗ1.Отбор.ЭтоСписание.Установить(ЭтоСписание);
		НЗ1.Отбор.Пользователь.Установить(Пользователь);
		НЗ1.Отбор.Номенклатура.Установить(ТекСтрока.Номенклатура);
		НЗ1.Прочитать();
		
		Для Каждого СтрНЗ из НЗ Цикл 
			//Сообщить(Строка(НЗ.Количество()) + " строк будет удалено из регистра."); 
			//Стр.Номенклатура = ТекСтрока.Номенклатура;
			
			ЕдиницаИзмерения = ТекСтрока.Номенклатура.ЕдиницаИзмерения; 
						
			НоваяСтрока = НЗ1.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрНЗ);  
			НоваяСтрока.Номенклатура = ТекСтрока.Номенклатура;
			НоваяСтрока.Упаковка = ЕдиницаИзмерения;
			НоваяСтрока.ЕдиницаИзмерения = ЕдиницаИзмерения;
			//НоваяСтрока.ИсходнаяНоменклатура = ТекСтрока.ИсходнаяНоменклатура;
			НоваяСтрока.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.РезервироватьПоМереПоступления;  //.УдалитьОбособленно
			//+22.08.22
			НоваяСтрока.ДатаОтгрузки = Объект.ПериодОтгрузки;   
			НоваяСтрока.ПериодЗатрат = КонецМесяца(Объект.ПериодОтгрузки);
			//-22.08.22
			НоваяСтрока.ОтборПоВариантамОбеспечения = 1;                                                       
			НоваяСтрока.Обособленно = Истина;
			НоваяСтрока.Норматив = 0;
			//НоваяСтрока.Количество = 0;
			НоваяСтрока.КоличествоУпаковок = НоваяСтрока.Количество * НоваяСтрока.Упаковка.Числитель / НоваяСтрока.Упаковка.Знаменатель;
			НоваяСтрока.Обеспечить = СтрНЗ.Норматив; // - СтрНЗ.Количество;
			НоваяСтрока.КатегорияМатериала = ОбработкаОбъект.ПолучитьКатегориюМатериала(ТекСтрока.Номенклатура);
			//НоваяСтрока.Остаток = ОбработкаОбъект.ПолучитьОстаток_2_5(ТекСтрока.Номенклатура,ТекСтрока.Склад,Этапы.Выгрузить(,"ЭтапПроизводства"));   
			
			ПараметрыПоиска = Новый Структура("Обрабатывать", Истина);
			ТабЭтапы = Этапы.Выгрузить(ПараметрыПоиска,);
			НоваяСтрока.Остаток = ТТМ_ДанныеВыбораСервер.ПолучитьОстаток_2_5(ТекСтрока.Номенклатура, ТекСтрока.Склад, Этапы.Выгрузить(,"ЭтапПроизводства"), ТабЭтапы, Объект.Резерв);    
			
			Если НЗ1.Количество() > 0 Тогда 
				КлючСвязи = НЗ1[0].КлючСвязиСпецификация;
				НоваяСтрока.КлючСвязиСпецификация = КлючСвязи;
			Иначе 
				КлючСвязи = Новый УникальныйИдентификатор();
			КонецЕсли;
			
			//??НоваяСтрока.АналитикаУчетаНоменклатуры = Справочники.КлючиАналитикиУчетаНоменклатуры.ПустаяСсылка();
			//??НоваяСтрока.КорАналитикаУчетаНоменклатуры = Справочники.КлючиАналитикиУчетаНоменклатуры.ПустаяСсылка();  
		КонецЦикла;
		
		НЗ.Очистить();
		НЗ.Записать();
		
		НЗ1.Записать();  
		
	КонецЦикла;
	
КонецПроцедуры

