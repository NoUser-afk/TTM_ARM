
///////////////////////////////////////////////////////////////////////////
#Область ТТМ_АРМ_ПроцессСогласования_ГлобальныеПеременные

&НаКлиенте
Перем ФормаМенеджера;

&НаКлиенте
Перем ФормаКонструкторов;

&НаКлиенте
Перем ФормаСнабжения;

&НаКлиенте
Перем КэшированныеДанныеСтроки;

#КонецОбласти


///////////////////////////////////////////////////////////////////////////
#Область ПроверкаПодразделенияИРолиДоступа

&НаКлиенте
Процедура ПриОткрытии(Отказ)	            
	
	УстановитьОтветственногоНаСервере();
	//Объект.Ответственный = ПользователиКлиент.ТекущийПользователь();	
	ТекущаяРольДоступна = ПроверкаРолиДоступа(Объект.Ответственный);
	ОчиститьСообщения();
	
	Если Не ТекущаяРольДоступна Тогда  
		Предупреждение(НСтр("ru = 'Текущая роль недоступна для данного пользователя: '") + Объект.Ответственный, 0, "ТТМ АРМ Процесс согласования");
		Возврат;
	КонецЕсли;
	
	ИсполнителиИРоли = ПолучитьПодразделениеОтветственногоСотрудника(Объект.Ответственный);
	РольИсполнителя = ИсполнителиИРоли["РольИсполнителя"];
	МассивРолей = ИсполнителиИРоли["МассивРолей"];
	
	Если РольИсполнителя = Неопределено Тогда
		Объект.Подразделение = ПредопределенноеЗначение("Справочник.РолиИсполнителей.ПустаяСсылка");
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Подразделение для текущего пользователя не найдено'"),, "Объект.Подразделение");
	Иначе
		Объект.Подразделение = РольИсполнителя;
	
		Если МассивРолей[0] = РольИсполнителя Тогда
			ФормаМенеджера = Истина;
			ФормаКонструкторов = Ложь;
			ФормаСнабжения = Ложь;
			
			Элементы.СтраницаПроверкиЗаказаКонструктор.Видимость = Ложь;
			СформироватьСписокЗаказовДляОтделаПоРаботеСКлиентами();
			ФормаПодразделения = ИнформацияЭтаФормаПодразделения();
			ПолучитьНастройкиИзХранилища(ФормаПодразделения);		
			НастройкиСохраненыМенеджер = Истина;
		ИначеЕсли МассивРолей[1] = РольИсполнителя Тогда
			ФормаМенеджера = Ложь;
			ФормаКонструкторов = Истина;
			ФормаСнабжения = Ложь;
			
			Элементы.СтраницаПроверкиЗаказаМенеджер.Видимость = Ложь;
			СформироватьСписокЗаказовДляОтделаКонструкторов();
			ФормаПодразделения = ИнформацияЭтаФормаПодразделения();
			ПолучитьНастройкиИзХранилища(ФормаПодразделения);
			НастройкиСохраненыКонструктор = Истина;
		ИначеЕсли МассивРолей[2] = РольИсполнителя Тогда
			ФормаМенеджера = Ложь;
			ФормаКонструкторов = Ложь;
			ФормаСнабжения = Истина;
		КонецЕсли;

	КонецЕсли;
	
	ПолучитьГрафическуюСхему();
	ФормаПодразделения = ИнформацияЭтаФормаПодразделения();
	
	Если СхемаЗагружена Тогда
		ОтрисоватьТекущийЭтапПроизводства(ФормаПодразделения, Истина);
	КонецЕсли;
	
	Если Объект.АвтоматическоеОбновлениеСписка Тогда
		ПодключитьОбработчикОжидания("АвтообновлениеСпискаЗаказов", 300);
	Иначе
		ОтключитьОбработчикОжидания("АвтообновлениеСпискаЗаказов");
	КонецЕсли;

КонецПроцедуры      

&НаСервере
Процедура УстановитьОтветственногоНаСервере()
	
	УстановитьПривилегированныйРежим(Истина);
	Объект.Ответственный = Пользователи.АвторизованныйПользователь();
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры


&НаСервереБезКонтекста
Функция ПроверкаРолиДоступа(ТекущийПользователь)	
	Возврат Пользователи.РолиДоступны(
		"ТТМ_ПроцессСогласованияМенеджер,
		|ТТМ_ПроцессСогласованияКонструктор,
		|ТТМ_ПроцессСогласованияСнабжение,
		|ТТМ_НазначениеИсполнителяКонструктор",
		ТекущийПользователь);	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьПодразделениеОтветственногоСотрудника(ТекущийСотрудник)
	МассивРолей = Новый Массив;			
	МассивРолей.Добавить(Справочники.РолиИсполнителей.НайтиПоНаименованию("Согласование отдела по работе с клиентами"));
	МассивРолей.Добавить(Справочники.РолиИсполнителей.НайтиПоНаименованию("Согласование отдела конструкторов"));
	МассивРолей.Добавить(Справочники.РолиИсполнителей.НайтиПоНаименованию("Согласование отдела снабжения"));
		
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИсполнителиЗадач.РольИсполнителя КАК РольИсполнителя
	               |ИЗ
	               |	РегистрСведений.ИсполнителиЗадач КАК ИсполнителиЗадач
	               |ГДЕ
	               |	ИсполнителиЗадач.Исполнитель = &Исполнитель
	               |	И НЕ ИсполнителиЗадач.РольИсполнителя.ПометкаУдаления
	               |	И ИсполнителиЗадач.РольИсполнителя В (&МассивРолей)";
	
	Запрос.УстановитьПараметр("Исполнитель", ТекущийСотрудник);
	Запрос.УстановитьПараметр("МассивРолей", МассивРолей);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
			
	ИсполнителиИРоли = Новый Структура;
	ИсполнителиИРоли.Вставить("МассивРолей", МассивРолей);
	ИсполнителиИРоли.Вставить("РольИсполнителя", Выборка.РольИсполнителя); 	
	
	Возврат ИсполнителиИРоли;
	
КонецФункции

&НаСервере
Процедура ПолучитьГрафическуюСхему()
	ГрафСхемаСсылка = Справочники.ТТМ_ГрафическиеСхемы.НайтиПоНаименованию("ТТМ бизнес процесс производства");
	
	Если ГрафСхемаСсылка.Пустая() Тогда
		СхемаЗагружена = Ложь;
		Возврат;
	КонецЕсли;
	
	ГрафСхема = РегистрыСведений.ТТМ_РегистрГрафическиеСхемы.СоздатьМенеджерЗаписи();
	ГрафСхема.ГрафическаяСхема = ГрафСхемаСсылка;
	ГрафСхема.Прочитать();
	
	Если ГрафСхема.Выбран() Тогда
		ЗагруженнаяСхема = ГрафСхема.ФайлДанных.Получить();
		Объект.СхемаПроизводства = ЗагруженнаяСхема;
		АдресВоВременномХранилище = ПоместитьВоВременноеХранилище(ЗагруженнаяСхема, ЭтаФорма.УникальныйИдентификатор);
		Объект.АдресВХранилище = АдресВоВременномХранилище;	
	КонецЕсли;
	
	СхемаЗагружена = Истина;
КонецПроцедуры

&НаСервере
Процедура ОтрисоватьТекущийЭтапПроизводства(ФормаПодразделения, Знач ОткрытиеФормы = Ложь, Знач ПослеВнесенияИзменений = Ложь)
	ЭлементыГрафСхемы = Объект.СхемаПроизводства.ЭлементыГрафическойСхемы;	
	ШрифтПройденныхЭтапов = Новый Шрифт("Arial", 8, Истина,,, Истина);
	ШрифтТекущихЭтапов = Новый Шрифт("Arial", 8, Истина,, Истина); 
	ЦветФонаТекущегоЭтапа = WebЦвета.БледноЗеленый; 
	
	Если ОткрытиеФормы Тогда
		ПолеСтарта = ЭлементыГрафСхемы.Найти("Старт");
		Если ПолеСтарта <> Неопределено Тогда
			ПолеСтарта.Шрифт = ШрифтПройденныхЭтапов;
		КонецЕсли;
		
		ПолеЗагрузкаЗаказа =  ЭлементыГрафСхемы.Найти("АРМ_ЗагрузкаЗаказа");
		Если ПолеЗагрузкаЗаказа <> Неопределено Тогда
			ПолеЗагрузкаЗаказа.Шрифт = ШрифтПройденныхЭтапов;
		КонецЕсли;
		
		ПолеЖелаемаяДатаПроизводства = ЭлементыГрафСхемы.Найти("ЖелаемаяДатаПроизводства");
		Если ПолеЖелаемаяДатаПроизводства <> Неопределено Тогда
			ПолеЖелаемаяДатаПроизводства.Шрифт = ШрифтПройденныхЭтапов;
		КонецЕсли;

		ПолеСогласования = ЭлементыГрафСхемы.Найти("АРМ_СогласованиеЗаказа");
		Если ПолеСогласования <> Неопределено Тогда			
			ПолеСогласования.Шрифт = ШрифтТекущихЭтапов;
			
			Если ФормаПодразделения.ФормаМенеджеров Тогда
				ПолеСогласования.Элементы.СогласованиеМенеджер.ЦветФона = ЦветФонаТекущегоЭтапа;
			ИначеЕсли ФормаПодразделения.ФормаКонструкторов Тогда
				ПолеСогласования.Элементы.СогласованиеКонструктор.ЦветФона = ЦветФонаТекущегоЭтапа;
			ИначеЕсли ФормаПодразделения.ФормаСнабжения Тогда
				ПолеСогласования.Элементы.СогласованиеСнабжение.ЦветФона = ЦветФонаТекущегоЭтапа;
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


///////////////////////////////////////////////////////////////////////////
#Область ПриИзмененииПолейФормыОбщие

&НаКлиенте
Процедура ОбновитьСписокЗаказов(Команда)
	
	ФормаПодразделения = ИнформацияЭтаФормаПодразделения();
	ОчиститьСообщения();
	
	Если ФормаПодразделения.ФормаМенеджеров Тогда 
		СформироватьСписокЗаказовДляОтделаПоРаботеСКлиентами();
	ИначеЕсли ФормаПодразделения.ФормаКонструкторов Тогда
		СформироватьСписокЗаказовДляОтделаКонструкторов();
	ИначеЕсли ФормаПодразделения.ФормаСнабжения Тогда
		//Если потребуется доп разработка для снабжения
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсеТовары(Команда)
	ФормаПодразделения = ИнформацияЭтаФормаПодразделения();
	УстановитьИлиСнятьФлагОтметки(ФормаПодразделения, Истина);
КонецПроцедуры

&НаКлиенте
Процедура СнятьОтметкуПоВсемТоварам(Команда)
	ФормаПодразделения = ИнформацияЭтаФормаПодразделения();
	УстановитьИлиСнятьФлагОтметки(ФормаПодразделения);
КонецПроцедуры

&НаСервере
Процедура УсловныйОтборВидимости(СтруктураОтбора, ФормаПодразделения, Знач ЭлементУО_Изменен = Ложь)
	
	//------------------------Условное оформление менеджер-----------------------------------------
	Если ФормаПодразделения.ФормаМенеджеров Тогда
		НовыйОтбор = Новый Структура;
		НовыйОтбор.Вставить("ЗаказКлиента", СтруктураОтбора["ЗаказКлиента"]);
		НовыйОтбор.Вставить("ЕстьОтказ", Истина);
		
		МассивНайденныхСтрок = СписокЗаказовМенеджер.НайтиСтроки(НовыйОтбор);
		ОтобразитьДопПоляПриОтказе = ?(МассивНайденныхСтрок.Количество() = 0, Ложь, Истина);
		Элементы.ДопПоляСпискаЗаказов.Видимость = ОтобразитьДопПоляПриОтказе;	
	КонецЕсли;
	
	//------------------------Условное оформление конструктор-----------------------------------------
	Если ФормаПодразделения.ФормаКонструкторов Тогда
		НовыйОтбор = Новый Структура;
		НовыйОтбор.Вставить("ЗаказКлиента", СтруктураОтбора["ЗаказКлиента"]);
		НовыйОтбор.Вставить("Статус", Перечисления.СтатусыСпецификаций.ВРазработке);
		
		//Проверка по отбору, если имеются несколько активных спецификаций для одного изделия
		СписокВРазработке = ТоварыЗаказаСоСпецификацией.НайтиСтроки(НовыйОтбор);
		НовыйОтбор["Статус"] = Перечисления.СтатусыСпецификаций.Действует;
		СписокДействует = ТоварыЗаказаСоСпецификацией.НайтиСтроки(НовыйОтбор);
		
		Если СписокВРазработке.Количество() <> 0 Или СписокДействует.Количество() <> 0 Тогда			
			
			Для Каждого ТекТоварДействует Из СписокДействует Цикл
				СовпадениеНайдено = Ложь;
				
				Для Каждого ТекТоварВРазработке Из СписокВРазработке Цикл 
					Если ТекТоварДействует.Номенклатура = ТекТоварВРазработке.Номенклатура Тогда
						НоменклатураКОформлению = ТекТоварВРазработке.Номенклатура;
						СовпадениеНайдено = Истина;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				 				
				Если СовпадениеНайдено Тогда						
					НовыйЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
					ОформлениеЦветФона = НовыйЭлементУсловногоОформления.Оформление.Элементы.Найти("ЦветФона");
					ОформлениеЦветФона.Значение = WebЦвета.БледноЛиловый;
					ОформлениеЦветФона.Использование = Истина;
					
					НастройкаОтбора = НовыйЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
					НастройкаОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТоварыЗаказаСоСпецификацией.Номенклатура");
					НастройкаОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
					НастройкаОтбора.ПравоеЗначение = НоменклатураКОформлению;
					
					ОформляемоеПоле = НовыйЭлементУсловногоОформления.Поля.Элементы.Добавить();
					ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ТоварыЗаказаСоСпецификацией");
					ОформляемоеПоле.Использование = Истина;
					
					ЭлементУО_Изменен = Истина;	
				КонецЕсли;					
			КонецЦикла;
						
			Если ЭлементУО_Изменен Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru ='У некоторых товаров есть 2 или более спецификаций.'"),, "ТоварыЗаказаСоСпецификацией");
			КонецЕсли;
		КонецЕсли;		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокОтмеченныхТоваров(ФормаПользователя, Знач ПолучитьКоличество = Ложь, Знач ПолучитьДанныеПоНоменклатуре = Ложь)
	
	Если ФормаПользователя.ФормаМенеджеров Тогда 
		МассивОтмеченных = ТоварыЗаказа.НайтиСтроки(Новый Структура("Подтверждено", Истина));
	ИначеЕсли ФормаПользователя.ФормаКонструкторов Тогда
		МассивОтмеченных = ТоварыЗаказаСоСпецификацией.НайтиСтроки(Новый Структура("Подтверждено", Истина));
	КонецЕсли;		
	
	Если ПолучитьКоличество Тогда
		ПолученныйРезультат = МассивОтмеченных.Количество();
	ИначеЕсли ПолучитьДанныеПоНоменклатуре Тогда
		ПолученныйРезультат = Новый Соответствие;

		Для Каждого Товар Из МассивОтмеченных Цикл
			ПолученныйРезультат.Вставить(Товар.Номенклатура, Товар.Количество); 
		КонецЦикла;			
	КонецЕсли;
				
	Возврат ПолученныйРезультат;
КонецФункции

&НаСервере
Процедура УстановитьИлиСнятьФлагОтметки(ФормаПодразделения, Знач ФлагОтметки = Ложь)
	
	Если ФормаПодразделения.ФормаМенеджеров Тогда 		
		Для Каждого ТекТовар Из ТоварыЗаказа Цикл
			ТекТовар.Подтверждено = ФлагОтметки;
		КонецЦикла;	
	ИначеЕсли ФормаПодразделения.ФормаКонструкторов Тогда
		Для Каждого ТекТовар Из ТоварыЗаказаСоСпецификацией Цикл
			ТекТовар.Подтверждено = ФлагОтметки;
		КонецЦикла;
	ИначеЕсли ФормаПодразделения.ФормаСнабжения Тогда
		//Если потребуется разобработка доп. формы для снабжения
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Функция ИнформацияЭтаФормаПодразделения()
	
	ФормаПользователя = Новый Структура;
	ФормаПользователя.Вставить("ФормаМенеджеров", ФормаМенеджера);
	ФормаПользователя.Вставить("ФормаКонструкторов", ФормаКонструкторов);
	ФормаПользователя.Вставить("ФормаСнабжения", ФормаСнабжения);
	
	Возврат ФормаПользователя; 
КонецФункции

&НаКлиенте
Функция ПолучитьСтруктуруОтбораПриАктивизацииСтроки(ВыбраннаяСтрока, ФормаПодразделения)
	
	СтруктураОтбора = Новый Структура;
	
	Если ФормаПодразделения.ФормаМенеджеров Тогда 
		СтруктураОтбора.Вставить("ЗаказКлиента", ВыбраннаяСтрока.ЗаказКлиента);
		СтруктураОтбора.Вставить("Назначение", ВыбраннаяСтрока.Назначение);
		СтруктураОтбора.Вставить("Подразделение", Объект.Подразделение);	
		СтруктураОтбора.Вставить("СтатусСогласования", ПредопределенноеЗначение("Перечисление.ТТМ_СтатусыПроверокПроцессСогласования.Согласовано"));
	ИначеЕсли ФормаПодразделения.ФормаКонструкторов Тогда
		СтруктураОтбора.Вставить("ЗаказКлиента", ВыбраннаяСтрока.ЗаказКлиента);
		СтруктураОтбора.Вставить("Статус", ПредопределенноеЗначение("Перечисление.СтатусыСпецификаций.Закрыта"));
		СтруктураОтбора.Вставить("НачалоДействия", Дата(1, 1, 1));
	ИначеЕсли ФормаПодразделения.ФормаСнабжения Тогда
		//Если потребуется доп. разработка для снабжения
	КонецЕсли;
	
	Возврат СтруктураОтбора; 
КонецФункции

//Обработчик оповещения при вызове из других форм 
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
		   		
	Если ИмяСобытия = "ЗакрытиеЗаказов" Тогда
		ФормаПодразделения = ИнформацияЭтаФормаПодразделения();
		ТекущаяКоманда = "ОбработкаОповещенияПриЗакрытии";
		
		Если ФормаПодразделения.ФормаМенеджеров Тогда
			ВыбраннаяСтрока = Элементы.СписокЗаказов.ТекущиеДанные;
			
			СтруктураДанных = Новый Структура;
			СтруктураДанных.Вставить("Команда", ТекущаяКоманда); 
			СтруктураДанных.Вставить("КоличествоОтмеченных", ПолучитьСписокОтмеченныхТоваров(ФормаПодразделения, Истина));
			СтруктураДанных.Вставить("ДанныеПоНоменклатуре", ПолучитьСписокОтмеченныхТоваров(ФормаПодразделения, Ложь, Истина));	
			СтруктураДанных.Вставить("ВыбраннаяСтрока", ВыбраннаяСтрока);
			СтруктураДанных.Вставить("Отказ", Отказ);
			СтруктураДанных.Вставить("ПричинаОтказа", ПричинаОтказа);
			СтруктураДанных.Вставить("СписокАдресовДляРассылки", СписокАдресовДляРассылки);
			
			ДатаОкончания = ?(Объект.СтатусПроверкиМенеджер = ПредопределенноеЗначение("Перечисление.ТТМ_СтатусыПроверокПроцессСогласования.Отказ"), ТекущаяДата(), Дата(1, 1, 1));
			ДополнитьСтруктуруДанныхПередЗаписьюВРегистр(СтруктураДанных,, ДатаОкончания);
			ОтправитьПочтовоеСообщение(СтруктураДанных);

			СформироватьСписокЗаказовДляОтделаПоРаботеСКлиентами();
			ОповеститьПользователя(ТекущаяКоманда);
		КонецЕсли;		
	КонецЕсли;
	
	Если ИмяСобытия = "ПослеВыбораСвязаннойСпецификации" Или ИмяСобытия = "ПослеВыбораИсполнителя" Тогда
		ФормаПодразделения = ИнформацияЭтаФормаПодразделения();
		
		Если ФормаПодразделения.ФормаКонструкторов Тогда
			ТекущаяСтрока = Элементы.ТоварыЗаказаСоСпецификацией.ТекущиеДанные;
						
			Если ТекущаяСтрока.ЗаказКлиента = Неопределено Тогда
				ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Номер заказа не определен'"),, "ТоварыЗаказаСоСпецификацией");
				Возврат;
			ИначеЕсли ТекущаяСтрока.Спецификация = Неопределено Тогда
				ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Спецификация отсутствует или не была выбрана'"),, "ТоварыЗаказаСоСпецификацией");
				Возврат;				
			КонецЕсли;
			
			СвязанныеДанные = ПолучитьСвязанныеДанныеСТекущейСпецификацией(ТекущаяСтрока.ЗаказКлиента, Параметр.Спецификация);

			Если СвязанныеДанные.Количество() = 0 Или  СвязанныеДанные = Неопределено Тогда
				Возврат;
			КонецЕсли;
			
			Если ИмяСобытия = "ПослеВыбораСвязаннойСпецификации" Тогда
				ТекущаяСтрока.Спецификация = Параметр.Спецификация;
				ТекущаяСтрока.Статус = Параметр.Статус;
				ТекущаяСтрока.Исполнитель = СвязанныеДанные.Исполнитель;
			ИначеЕсли ИмяСобытия = "ПослеВыбораИсполнителя" Тогда
				ТекущаяСтрока.Исполнитель = Параметр.Пользователь;
			КонецЕсли;
						
			ТекущаяСтрока.НачалоДействия = СвязанныеДанные.НачалоДействия;
			
			Если Не ЗначениеЗаполнено(ТекущаяСтрока.СрокиРазработки) Тогда
				ТекущаяСтрока.СрокиРазработки = СвязанныеДанные.СрокиРазработки;
				ТекущаяСтрока.СрокиПереноса = СвязанныеДанные.СрокиПереноса;
			КонецЕсли;
			
			Если ТекущаяСтрока.Подтверждено Тогда
				ОбработатьСтрокиТоваровСоСпецификацийПриИзменении();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ИмяСобытия = "ПослеВыбораЗаказаСОтказомМенеджер" Тогда
		ФормаПодразделения = ИнформацияЭтаФормаПодразделения();
		ТекущаяКоманда = "ВернутьЗаказНаСогласование";
		МассивЗаказовСОтказом = Параметр;
		
		Если ФормаПодразделения.ФормаМенеджеров Тогда
			Если МассивЗаказовСОтказом.Количество() = 0 Или МассивЗаказовСОтказом = Неопределено Тогда
				ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Нет заказов для обработки'"));
				Возврат;
			КонецЕсли;
			
			РезультатВыполнения = Ложь;
			
			Попытка
				ВернутьЗаказНаСогласованиеОбщее(МассивЗаказовСОтказом, ФормаПодразделения);
				КоличествоОбработанных = ОбщегоНазначенияУТВызовСервера.УстановитьСтатусДокументов(МассивЗаказовСОтказом, "НеСогласован");
				
				Если КоличествоОбработанных > 0 Тогда
					ВнесеныИзменения = ОбработатьСтрокиТабличногоДокументаВЗаказеКлиента(МассивЗаказовСОтказом[0],,,,, Истина);
					РезультатВыполнения = ВнесеныИзменения;
				ИначеЕсли КоличествоОбработанных = 0 Тогда
					ОчиститьСообщения();
					РезультатВыполнения = Истина;
				КонецЕсли;
			Исключение
				РезультатВыполнения = Ложь;
				ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Ошибка записи данных: '") + ОписаниеОшибки());
			КонецПопытки;
			
			Если РезультатВыполнения Тогда
				СформироватьСписокЗаказовДляОтделаПоРаботеСКлиентами();
				ОповеститьПользователя(ТекущаяКоманда);
			Иначе
				ПоказатьПредупреждение(, "Выполнены не все действия после отмены заказа: " + МассивЗаказовСОтказом[0], 60, "Отмена действий согласования"); 				
			КонецЕсли;
		КонецЕсли;		
	КонецЕсли;                           
		
	Если ИмяСобытия = "ПослеВыбораЗаказаСОтказомКонструктор" Тогда
		ФормаПодразделения = ИнформацияЭтаФормаПодразделения();
		ТекущаяКоманда = "ВернутьЗаказНаСогласование";
		МассивЗаказовСОтказом = Параметр;
		
		Если ФормаПодразделения.ФормаКонструкторов Тогда 
			Если МассивЗаказовСОтказом.Количество() = 0 Или МассивЗаказовСОтказом = Неопределено Тогда
				ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Нет заказов для обработки'"));
				Возврат;
			КонецЕсли;
			
			Попытка
				ВернутьЗаказНаСогласованиеОбщее(МассивЗаказовСОтказом, ФормаПодразделения);
				РезультатВыполнения = Истина;
			Исключение
				РезультатВыполнения = Ложь;
	            ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Ошибка записи данных: '") + ОписаниеОшибки());
			КонецПопытки;
			
			Если РезультатВыполнения Тогда
				СформироватьСписокЗаказовДляОтделаКонструкторов();
				ОповеститьПользователя(ТекущаяКоманда);	
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ИмяСобытия = "ТТМ_ОбработкаЗагрузкиЗаказовКлиента" Тогда		
		ТекущаяКоманда = "ЗагрузкаНовыхЗаказов";
		
		Если Параметр.ДокументыСформированы И Параметр.НовыйЗагруженныйЗаказ Тогда
			ОчиститьСообщения();
            ФормаПодразделения = ИнформацияЭтаФормаПодразделения();
						
			Если ФормаПодразделения.ФормаМенеджеров Тогда
				ЗадатьДополнительныйВопросПользователю(ФормаПодразделения, ТекущаяКоманда, Параметр.СсылкаНаОбработанныйЗаказ);	
			ИначеЕсли ФормаПодразделения.ФормаКонструкторов Тогда
				ЗадатьДополнительныйВопросПользователю(ФормаПодразделения, ТекущаяКоманда, Параметр.СсылкаНаОбработанныйЗаказ);
			ИначеЕсли ФормаПодразделения.ФормаСнабжения Тогда
				//Если потребуется доп разработка для снабжения	
			КонецЕсли;		
		КонецЕсли;
		
	КонецЕсли;
	
		
КонецПроцедуры

&НаКлиенте
Процедура АвтообновлениеСпискаЗаказов()
	ФормаПодразделения = ИнформацияЭтаФормаПодразделения();	
	КоличествоЗаказовКОбновлению = ПроверкаИзмененныхИНовыхЗаказов(ФормаПодразделения);
	
	Если КоличествоЗаказовКОбновлению = 0 Тогда
		Возврат;
	КонецЕсли;
		
	ЗаголовокВопроса = НСтр("ru = 'Обновление по заказам'");
	ТекстВопроса = НСтр("ru = 'Есть новые или измененые заказы, обновить список?'");
	Кнопки =  РежимДиалогаВопрос.ДаНет;
	Таймаут = 20;
	
	ОповещениеЗагрузкиНовыхЗаказов = Новый ОписаниеОповещения("ЗагрузкаНовыхЗаказовПодтверждение", ЭтотОбъект, ФормаПодразделения);
	ПоказатьВопрос(ОповещениеЗагрузкиНовыхЗаказов, ЗаголовокВопроса, Кнопки, Таймаут,, ЗаголовокВопроса); 
КонецПроцедуры

&НаСервере
Функция ПроверкаИзмененныхИНовыхЗаказов(ФормаПодразделения);
	
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	
	Если ФормаПодразделения.ФормаМенеджеров Тогда
		 Выборка = ОбъектОбработки.ПроверитьНовыеЗаказыМенеджер(СписокЗаказовМенеджер.Выгрузить());
	ИначеЕсли ФормаПодразделения.ФормаКонструкторов Тогда
		Выборка = ОбъектОбработки.ПроверитьНовыеЗаказыКонструктор(СписокЗаказовКонструктор.Выгрузить());
	КонецЕсли;
			
	Возврат Выборка.Количество();
КонецФункции

&НаКлиенте
Процедура ЗагрузкаНовыхЗаказовПодтверждение(ОтветПользователя, ДополнительныеПараметры) Экспорт
	Если ОтветПользователя = КодВозвратаДиалога.Нет Или ОтветПользователя = КодВозвратаДиалога.Таймаут Тогда
		Возврат;
	КонецЕсли;
	
	Если ДополнительныеПараметры.ФормаМенеджеров Тогда
		ОчиститьСообщения();
		СформироватьСписокЗаказовДляОтделаПоРаботеСКлиентами();
	ИначеЕсли ДополнительныеПараметры.ФормаКонструкторов Тогда
		ОчиститьСообщения();
		СформироватьСписокЗаказовДляОтделаКонструкторов();
	КонецЕсли;
	
	ОповеститьПользователя("ЗагрузкаНовыхЗаказов");
КонецПроцедуры
	
#КонецОбласти


///////////////////////////////////////////////////////////////////////////
#Область РаботаНаСтраницеМенеджеровПриИзмененииПолейФормы

 &НаКлиенте
Процедура СостояниеЗаказа(Команда)
	ВыбраннаяСтрока = Элементы.СписокЗаказов.ТекущиеДанные;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗаказКлиента", ВыбраннаяСтрока.ЗаказКлиента);
	ОткрытьФорму("Обработка.ТТМ_АРМ_ПроцессСогласования.Форма.ФормаОтчета", ПараметрыФормы);
КонецПроцедуры

&НаСервере
Процедура СформироватьСписокЗаказовДляОтделаПоРаботеСКлиентами()
			
	Запрос = Новый Запрос;	
	Запрос.Текст = "ВЫБРАТЬ
					|	Док_ЗаказКлиента.Ссылка КАК ЗаказКлиента,
					|	Док_ЗаказКлиента.Назначение КАК Назначение,
					|	Док_ЗаказКлиента.Дата КАК ДатаЗаказа,
					|	Док_ЗаказКлиента.Организация КАК Организация,
					|	Док_ЗаказКлиента.СуммаДокумента КАК СуммаЗаказа,
					|	Док_ЗаказКлиента.Статус КАК Статус
					|ПОМЕСТИТЬ ВТ_ЗаказКлиента
					|ИЗ
					|	Документ.ЗаказКлиента КАК Док_ЗаказКлиента
					|ГДЕ
					|	Док_ЗаказКлиента.Статус = &Статус
					|	И НЕ Док_ЗаказКлиента.ПометкаУдаления
					|	И НЕ Док_ЗаказКлиента.Назначение.ПометкаУдаления
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ
					|	ВТ_ЗаказКлиента.ЗаказКлиента КАК ЗаказКлиента,
					|	ВТ_ЗаказКлиента.Назначение КАК Назначение,
					|	ВТ_ЗаказКлиента.ДатаЗаказа КАК ДатаЗаказа,
					|	ВТ_ЗаказКлиента.Организация КАК Организация,
					|	ВТ_ЗаказКлиента.СуммаЗаказа КАК СуммаЗаказа,
					|	ВТ_ЗаказКлиента.Статус КАК Статус,
					|	ЕСТЬNULL(ТТМ_СогласованиеСводнаяИнформация.ПричинаОтказа, &ПустаяСтрока) КАК ПричинаОтказа
					|ПОМЕСТИТЬ ВТ_СобранныеЗаказы
					|ИЗ
					|	ВТ_ЗаказКлиента КАК ВТ_ЗаказКлиента
					|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТТМ_СогласованиеСводнаяИнформация КАК ТТМ_СогласованиеСводнаяИнформация
					|		ПО (ВТ_ЗаказКлиента.ЗаказКлиента = ТТМ_СогласованиеСводнаяИнформация.ЗаказКлиента
					|				И ВТ_ЗаказКлиента.Назначение = ТТМ_СогласованиеСводнаяИнформация.Назначение)
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ
					|	ВТ_СобранныеЗаказы.ЗаказКлиента КАК ЗаказКлиента,
					|	ВТ_СобранныеЗаказы.Назначение КАК Назначение,
					|	ВТ_СобранныеЗаказы.ДатаЗаказа КАК ДатаЗаказа,
					|	ВТ_СобранныеЗаказы.Организация КАК Организация,
					|	ВТ_СобранныеЗаказы.СуммаЗаказа КАК СуммаЗаказа,
					|	ВТ_СобранныеЗаказы.Статус КАК Статус,
					|	ВЫБОР
					|		КОГДА ПОДСТРОКА(ВТ_СобранныеЗаказы.ПричинаОтказа, 0, 1) = &ПустаяСтрока
					|			ТОГДА ЛОЖЬ
					|		ИНАЧЕ ИСТИНА
					|	КОНЕЦ КАК ЕстьОтказ,
					|	ВТ_СобранныеЗаказы.ПричинаОтказа КАК ПричинаОтказа
					|ИЗ
					|	ВТ_СобранныеЗаказы КАК ВТ_СобранныеЗаказы";
	
	Запрос.УстановитьПараметр("Статус", Перечисления.СтатусыЗаказовКлиентов.НеСогласован);
	Запрос.УстановитьПараметр("ПустаяСтрока", "");	
	Выборка = Запрос.Выполнить().Выбрать();
	
	СписокЗаказовМенеджер.Очистить();
	ТоварыЗаказа.Очистить();
		
	Пока Выборка.Следующий() Цикл
		ТекущийЗаказ = СписокЗаказовМенеджер.Добавить();
		ЗаполнитьЗначенияСвойств(ТекущийЗаказ, Выборка);			 
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокЗаказовПриАктивизацииСтроки(Элемент)

	ВыбраннаяСтрока = Элементы.СписокЗаказов.ТекущиеДанные;	
	Объект.СтатусПроверкиМенеджер = ПредопределенноеЗначение("Перечисление.ТТМ_СтатусыПроверокПроцессСогласования.ПустаяСсылка");
	ОчиститьСообщения();
	ПричинаОтказа = "";
	Отказ = Ложь;
		
	Если ВыбраннаяСтрока <> Неопределено Тогда
		ФормаПодразделения = ИнформацияЭтаФормаПодразделения();
		СтруктураОтбора = ПолучитьСтруктуруОтбораПриАктивизацииСтроки(ВыбраннаяСтрока, ФормаПодразделения);
			
		Если ФормаПодразделения.ФормаМенеджеров Тогда
			ПолучитьСписокТоваровДляОтделаПоРаботеСКлиентами(СтруктураОтбора);
			УсловныйОтборВидимости(СтруктураОтбора, ФормаПодразделения); 
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьСписокТоваровДляОтделаПоРаботеСКлиентами(СтруктураОтбора, Знач ДетальныеЗаписи = Неопределено)
	
	Если Объект.ТаблицаОтбораЦен.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru ='Необходимо заполнить список отбора цен'"),, "Объект.ТаблицаОтбораЦен");
		Возврат;
	КонецЕсли;
			
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               |	ТТМ_СогласованиеЗаказовМенеджер.ЗаказКлиента КАК ЗаказКлиента,
	               |	ТТМ_СогласованиеЗаказовМенеджер.Изделие КАК Изделие,
	               |	ВЫБОР
	               |		КОГДА ТТМ_СогласованиеЗаказовМенеджер.СтатусСогласования = &СтатусСогласования
