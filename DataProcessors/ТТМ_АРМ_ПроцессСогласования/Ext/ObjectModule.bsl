#Область АРМ_ПроцессСогласованияФормированиеМакетов

Функция СформироватьОтчетСостояниеВыполнения(ДокументОтчета) Экспорт
	
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.Очистить();
	
	МакетОтчета = ПолучитьМакет("СостояниеВыполненияДокумента_MXL");
	
	ОбластьЗаголовок = МакетОтчета.ПолучитьОбласть("Заголовок");
	ОбластьЗаголовок.Параметры.ИмяДокумента = ДокументОтчета.Назначение;
	ТабДок.Вывести(ОбластьЗаголовок);
		
	ОбластьЗаголовокТаблицы = МакетОтчета.ПолучитьОбласть("ЗаголовокТаблицы");
	ОбластьЗаголовокТаблицы.Параметры.Заголовок = "Обеспечение";
	ТабДок.Вывести(ОбластьЗаголовокТаблицы);
	
	ОбластьШапкаТаблицыОбеспечение = МакетОтчета.ПолучитьОбласть("ШапкаТаблицыОбеспечение");
	ТабДок.Вывести(ОбластьШапкаТаблицыОбеспечение);
	
	ОбластьСтрокаТаблицыОбеспечение = МакетОтчета.ПолучитьОбласть("СтрокаТаблицыОбеспечение");
	ОбластьПодвалИтогиОбеспечение = МакетОтчета.ПолучитьОбласть("ПодвалИтогиОбеспечение");
		
	Для Каждого ТекДанные Из ДокументОтчета.Товары Цикл
		ОбластьСтрокаТаблицыОбеспечение.Параметры.НомерСтроки = ТекДанные.НомерСтроки;
		ОбластьСтрокаТаблицыОбеспечение.Параметры.Товар = ТекДанные.Номенклатура;
		ОбластьСтрокаТаблицыОбеспечение.Параметры.Действие = ТекДанные.ВариантОбеспечения;
		ОбластьСтрокаТаблицыОбеспечение.Параметры.ДатаОтгрузки = ТекДанные.ДатаОтгрузки;
		ОбластьСтрокаТаблицыОбеспечение.Параметры.Количество = ТекДанные.КоличествоУпаковок;
		ОбластьСтрокаТаблицыОбеспечение.Параметры.Упаковка = ТекДанные.Упаковка;
		ОбластьСтрокаТаблицыОбеспечение.Параметры.Сумма = ТекДанные.Сумма;
		ТабДок.Вывести(ОбластьСтрокаТаблицыОбеспечение);
	КонецЦикла;
	
	ОбластьПодвалИтогиОбеспечение.Параметры.СуммаИтоги = ДокументОтчета.СуммаДокумента;
	ТабДок.Вывести(ОбластьПодвалИтогиОбеспечение);
	
	ТабДок.АвтоМасштаб = Истина;
	ТабДок.ОтображатьСетку = Ложь;
	ТабДок.ОтображатьЗаголовки = Ложь;
	ТабДок.ЗакончитьАвтоГруппировкуСтрок();
	
	Возврат ТабДок;
	
КонецФункции

Функция ПодготовитьТабличныйДокументДляОтправкиРассылки(СтруктураДанных) Экспорт
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.Очистить();
	
	МакетРассылки = ПолучитьМакет("РассылкаПриОтказе_MXL");
	ОбластьШапкиРассылки = МакетРассылки.ПолучитьОбласть("ШапкаРассылки");
	ТабДок.Вывести(ОбластьШапкиРассылки);
	
	ОбластьРеквизитыТаблицыРассылки = МакетРассылки.ПолучитьОбласть("РеквизитыТаблицыРассылки");
	ТабДок.Вывести(ОбластьРеквизитыТаблицыРассылки);
	
	ОбластьЗначенияРеквизитовТаблицыРассыки = МакетРассылки.ПолучитьОбласть("ЗначенияРеквизитовТаблицыРассыки");
	ТабДок.НачатьАвтогруппировкуСтрок();
	
	Для Каждого ТекДанные Из СтруктураДанных["ДанныеПоНоменклатуре"] Цикл
		ОбластьЗначенияРеквизитовТаблицыРассыки.Параметры.Назначение = СтруктураДанных["ЗаказКлиента"].НомерПоДаннымКлиента;
		ОбластьЗначенияРеквизитовТаблицыРассыки.Параметры.ЗаказКлиента = СтруктураДанных["ЗаказКлиента"];
		ОбластьЗначенияРеквизитовТаблицыРассыки.Параметры.ДатаЗаказа = Формат(СтруктураДанных["ДатаНачала"], "ДЛФ=DD");
		ОбластьЗначенияРеквизитовТаблицыРассыки.Параметры.Организация = СтруктураДанных["Организация"];
		ОбластьЗначенияРеквизитовТаблицыРассыки.Параметры.Изделие = ТекДанные.Ключ;
		ОбластьЗначенияРеквизитовТаблицыРассыки.Параметры.Количество = ТекДанные.Значение;
		ОбластьЗначенияРеквизитовТаблицыРассыки.Параметры.Подразделение = СтруктураДанных["Подразделение"];
		ОбластьЗначенияРеквизитовТаблицыРассыки.Параметры.Исполнитель = СтруктураДанных["Исполнитель"];
		ОбластьЗначенияРеквизитовТаблицыРассыки.Параметры.ДатаОтказа = СтруктураДанных["ДатаОкончания"];	
		ОбластьЗначенияРеквизитовТаблицыРассыки.Параметры.ПричинаОтказа = СтруктураДанных["ПричинаОтказа"];
		ОбластьЗначенияРеквизитовТаблицыРассыки.Параметры.СтатусСогласования = СтруктураДанных["СтатусСогласования"];
		
		ТабДок.Вывести(ОбластьЗначенияРеквизитовТаблицыРассыки);
	КонецЦикла;
	
	ТабДок.АвтоМасштаб = Истина;
	ТабДок.ОтображатьСетку = Ложь;
	ТабДок.ОтображатьЗаголовки = Ложь;
	ТабДок.ЗакончитьАвтоГруппировкуСтрок();
	
	Возврат ТабДок;

КонецФункции

#КонецОбласти


