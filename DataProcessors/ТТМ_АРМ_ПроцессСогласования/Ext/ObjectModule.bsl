Функция ОбработатьЗаписиПередЗаполнением(ВыгруженныйСписок)
	
	УникальныеЗначения = Новый ТаблицаЗначений;
	УникальныеЗначения.Колонки.Добавить("ЗаказКлиента", Новый ОписаниеТипов("ДокументСсылка.ЗаказКлиента"));
	УникальныеЗначения.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(15, 3)));	
	УникальныеЗначения.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	УникальныеЗначения.Колонки.Добавить("Подтверждено", Новый ОписаниеТипов("Булево"));
	УникальныеЗначения.Колонки.Добавить("ПодтверждениеКБ", Новый ОписаниеТипов("Булево"));
	УникальныеЗначения.Колонки.Добавить("СрокиРазработкиКБ", Новый ОписаниеТипов("Дата"));
	УникальныеЗначения.Колонки.Добавить("ЕдиницаИзмерения", Новый ОписаниеТипов("СправочникСсылка.УпаковкиЕдиницыИзмерения"));
	УникальныеЗначения.Колонки.Добавить("ВидЦены", Новый ОписаниеТипов("СправочникСсылка.ВидыЦен"));
	УникальныеЗначения.Колонки.Добавить("Цена", Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(15, 2)));
	УникальныеЗначения.Колонки.Добавить("Себестоимость", Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(15, 2)));
	УникальныеЗначения.Колонки.Добавить("СтавкаНДС", Новый ОписаниеТипов("СправочникСсылка.СтавкиНДС"));
	УникальныеЗначения.Колонки.Добавить("СуммаНДС", Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(15, 2)));
	УникальныеЗначения.Колонки.Добавить("ИтоговаяСумма", Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(15, 2)));
	УникальныеЗначения.Колонки.Добавить("ЖелаемаяДатаПроизводства", Новый ОписаниеТипов("Дата"));
	
	Для Каждого ТекДанные Из ВыгруженныйСписок Цикл
		ПоискУникальных = УникальныеЗначения.Найти(ТекДанные.Номенклатура, "Номенклатура");
		
		Если ПоискУникальных = Неопределено Тогда
			НоваяСтрока = УникальныеЗначения.Добавить();
            ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекДанные); 						
		КонецЕсли;	
	КонецЦикла;
	
	Для Каждого Значение Из УникальныеЗначения Цикл
		НоменклатураНайдена = Ложь;
		
		Для Каждого СтрокаВыгрузки Из ВыгруженныйСписок  Цикл
			Если Значение.Номенклатура = СтрокаВыгрузки.Номенклатура Тогда
				ПолученнаяСтрока = СтрокаВыгрузки;
				НоменклатураНайдена = Истина;
				Прервать;
			КонецЕсли;		
		КонецЦикла;
		
		Если НоменклатураНайдена Тогда
			Если ПолученнаяСтрока.СрокиРазработкиКБ <> Дата(1, 1, 1) Тогда
				Значение.СрокиРазработкиКБ = ПолученнаяСтрока.СрокиРазработкиКБ;
			КонецЕсли;
		КонецЕсли;		
	КонецЦикла;
	
	Возврат УникальныеЗначения;
КонецФункции

#КонецОбласти


///////////////////////////////////////////////////////////////////////////
#Область АРМ_ПроцессСогласованияАвтообновлениеСпискаЗаказов

Функция ПроверитьНовыеЗаказыМенеджер(ТекущиеЗаказы) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
				|	ВыгруженныеЗаказы.ЗаказКлиента КАК ЗаказКлиента,
				|	ВыгруженныеЗаказы.Назначение КАК Назначение
				|ПОМЕСТИТЬ ВТ_ТекущиеЗаказы
				|ИЗ
				|	&ТекущиеЗаказы КАК ВыгруженныеЗаказы
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	ЗаказКлиента.Ссылка КАК ЗаказКлиента,
				|	ЗаказКлиента.Назначение КАК Назначение,
				|	ЗаказКлиента.Дата КАК ДатаЗаказа,
				|	ЗаказКлиента.Организация КАК Организация,
				|	ЗаказКлиента.СуммаДокумента КАК СуммаЗаказа,
				|	ЗаказКлиента.Статус КАК Статус
				|ПОМЕСТИТЬ ВТ_ЗаказыДокумента
				|ИЗ
				|	Документ.ЗаказКлиента КАК ЗаказКлиента
				|ГДЕ
				|	ЗаказКлиента.Статус = &Статус
				|	И НЕ ЗаказКлиента.ПометкаУдаления
				|	И НЕ ЗаказКлиента.Назначение.ПометкаУдаления
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗЛИЧНЫЕ
				|	ВТ_ЗаказыДокумента.ЗаказКлиента КАК ЗаказКлиента,
				|	ВТ_ЗаказыДокумента.Назначение КАК Назначение,
				|	ВТ_ЗаказыДокумента.ДатаЗаказа КАК ДатаЗаказа,
				|	ВТ_ЗаказыДокумента.Организация КАК Организация,
				|	ВТ_ЗаказыДокумента.СуммаЗаказа КАК СуммаЗаказа,
				|	ВТ_ЗаказыДокумента.Статус КАК Статус
				|ПОМЕСТИТЬ ВТ_НовыеЗаказы
				|ИЗ
				|	ВТ_ТекущиеЗаказы КАК ВТ_ТекущиеЗаказы,
				|	ВТ_ЗаказыДокумента КАК ВТ_ЗаказыДокумента
				|ГДЕ
				|	НЕ ВТ_ЗаказыДокумента.ЗаказКлиента В
				|				(ВЫБРАТЬ
				|					ВТ_ТекущиеЗаказы.ЗаказКлиента
				|				ИЗ
				|					ВТ_ТекущиеЗаказы)
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|УНИЧТОЖИТЬ ВТ_ЗаказыДокумента
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	ВТ_НовыеЗаказы.ЗаказКлиента КАК ЗаказКлиента,
				|	ВТ_НовыеЗаказы.Назначение КАК Назначение,
				|	ВТ_НовыеЗаказы.ДатаЗаказа КАК ДатаЗаказа,
				|	ВТ_НовыеЗаказы.Организация КАК Организация,
				|	ВТ_НовыеЗаказы.СуммаЗаказа КАК СуммаЗаказа,
				|	ВТ_НовыеЗаказы.Статус КАК Статус,
				|	ЕСТЬNULL(ТТМ_СогласованиеСводнаяИнформация.ПричинаОтказа, &ПустаяСтрока) КАК ПричинаОтказа
				|ПОМЕСТИТЬ ВТ_СобранныеЗаказы
				|ИЗ
				|	ВТ_НовыеЗаказы КАК ВТ_НовыеЗаказы
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТТМ_СогласованиеСводнаяИнформация КАК ТТМ_СогласованиеСводнаяИнформация
				|		ПО (ВТ_НовыеЗаказы.ЗаказКлиента = ТТМ_СогласованиеСводнаяИнформация.ЗаказКлиента
				|				И ВТ_НовыеЗаказы.Назначение = ТТМ_СогласованиеСводнаяИнформация.Назначение)
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	ВТ_СобранныеЗаказы.ЗаказКлиента КАК ЗаказКлиента,
				|	ВТ_СобранныеЗаказы.Назначение КАК Назначение,
				|	ВТ_СобранныеЗаказы.ДатаЗаказа КАК ДатаЗаказа,
				|	ВТ_СобранныеЗаказы.Организация КАК Организация,
				|	ВТ_СобранныеЗаказы.СуммаЗаказа КАК СуммаЗаказа,
				|	ВТ_СобранныеЗаказы.Статус КАК Статус,
				|	ВЫБОР
				|		КОГДА ПОДСТРОКА(ВТ_СобранныеЗаказы.ПричинаОтказа, 0, 1) = &ПустаяСтрока
				|			ТОГДА ЛОЖЬ
				|		ИНАЧЕ ИСТИНА
				|	КОНЕЦ КАК ЕстьОтказ,
				|	ВТ_СобранныеЗаказы.ПричинаОтказа КАК ПричинаОтказа
				|ИЗ
				|	ВТ_СобранныеЗаказы КАК ВТ_СобранныеЗаказы";
	
	Запрос.УстановитьПараметр("ТекущиеЗаказы", ТекущиеЗаказы);
	Запрос.УстановитьПараметр("Статус", Перечисления.СтатусыЗаказовКлиентов.НеСогласован);
	Запрос.УстановитьПараметр("ПустаяСтрока", "");
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Количество() = 0 Тогда
		Выборка = ПроверитьЗаказыСОтказомОбщее(ТекущиеЗаказы);
	КонецЕсли;

	Возврат Выборка;
КонецФункции

