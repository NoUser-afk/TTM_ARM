Функция ПроверитьЗаказыСОтказомОбщее(ТекущиеЗаказы)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
			               |	ТекущиеЗаказы.Назначение КАК Назначение,
			               |	ТекущиеЗаказы.ЗаказКлиента КАК ЗаказКлиента
			               |ПОМЕСТИТЬ ВТ_ТекущиеЗаказы
			               |ИЗ
			               |	&ТекущиеЗаказы КАК ТекущиеЗаказы
			               |;
			               |
			               |////////////////////////////////////////////////////////////////////////////////
			               |ВЫБРАТЬ
			               |	ВТ_ТекущиеЗаказы.Назначение КАК Назначение,
			               |	ВТ_ТекущиеЗаказы.ЗаказКлиента КАК ЗаказКлиента,
			               |	ЕСТЬNULL(ТТМ_СогласованиеСводнаяИнформация.ПричинаОтказа, &ПустаяСтрока) КАК ПричинаОтказа
			               |ПОМЕСТИТЬ ВТ_ЗаказыСОтказом
			               |ИЗ
			               |	ВТ_ТекущиеЗаказы КАК ВТ_ТекущиеЗаказы
			               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТТМ_СогласованиеСводнаяИнформация КАК ТТМ_СогласованиеСводнаяИнформация
			               |		ПО ВТ_ТекущиеЗаказы.Назначение = ТТМ_СогласованиеСводнаяИнформация.Назначение
			               |			И ВТ_ТекущиеЗаказы.ЗаказКлиента = ТТМ_СогласованиеСводнаяИнформация.ЗаказКлиента
			               |;
			               |
			               |////////////////////////////////////////////////////////////////////////////////
			               |ВЫБРАТЬ
			               |	ВТ_ЗаказыСОтказом.Назначение КАК Назначение,
			               |	ВТ_ЗаказыСОтказом.ЗаказКлиента КАК ЗаказКлиента,
			               |	ВТ_ЗаказыСОтказом.ПричинаОтказа КАК ПричинаОтказа,
			               |	ВЫБОР
			               |		КОГДА ПОДСТРОКА(ВТ_ЗаказыСОтказом.ПричинаОтказа, 0, 1) <> &ПустаяСтрока
			               |			ТОГДА ИСТИНА
			               |		ИНАЧЕ ЛОЖЬ
			               |	КОНЕЦ КАК ЕстьОтказ
			               |ПОМЕСТИТЬ ВТ_СобранныеДанные
			               |ИЗ
			               |	ВТ_ЗаказыСОтказом КАК ВТ_ЗаказыСОтказом
			               |;
			               |
			               |////////////////////////////////////////////////////////////////////////////////
			               |ВЫБРАТЬ
			               |	ВТ_СобранныеДанные.Назначение КАК Назначение,
			               |	ВТ_СобранныеДанные.ЗаказКлиента КАК ЗаказКлиента,
			               |	ВТ_СобранныеДанные.ПричинаОтказа КАК ПричинаОтказа
			               |ИЗ
			               |	ВТ_СобранныеДанные КАК ВТ_СобранныеДанные
			               |ГДЕ
			               |	ВТ_СобранныеДанные.ЕстьОтказ";
	
	Запрос.УстановитьПараметр("ТекущиеЗаказы", ТекущиеЗаказы);
	Запрос.УстановитьПараметр("ПустаяСтрока", "");		
	
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат Выборка;
КонецФункции

#КонецОбласти