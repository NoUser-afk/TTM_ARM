#Область АРМ_ПроцессСогласованияПолучениеСебестоимости

&НаСервере
Функция ПолучитьСписокТоваровССебестоимостьюДляОтделаПоРаботеСКлиентами(СтруктураОтбора, Знач ДетальныеЗаписи = Неопределено) Экспорт
	
	//Если Объект.ТаблицаОтбораЦен.Количество() = 0 Тогда
	//	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru ='Необходимо заполнить список отбора цен'"),, "Объект.ТаблицаОтбораЦен");
	//	Возврат ;
	//КонецЕсли;
		
	ВидПродукцияРоболабс = Справочники.ВидыНоменклатуры.НайтиПоНаименованию("Продукция Роболабс");
	ВидЦены = Справочники.ВидыЦен.НайтиПоНаименованию("Фоб", Истина);
	СвойствоДопРеквизита = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию("Код комплекта ТТМ");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
					|	ТТМ_СогласованиеЗаказовМенеджер.ЗаказКлиента КАК ЗаказКлиента,
					|	ТТМ_СогласованиеЗаказовМенеджер.Изделие КАК Изделие,
					|	ВЫБОР
					|		КОГДА ТТМ_СогласованиеЗаказовМенеджер.СтатусСогласования = &СтатусСогласования
					|			ТОГДА ИСТИНА
					|		ИНАЧЕ ЛОЖЬ
					|	КОНЕЦ КАК Подтверждено
					|ПОМЕСТИТЬ ВТ_РегистрТТМПроцессПроизводства
					|ИЗ
					|	РегистрСведений.ТТМ_СогласованиеЗаказовМенеджер КАК ТТМ_СогласованиеЗаказовМенеджер
					|ГДЕ
					|	ТТМ_СогласованиеЗаказовМенеджер.ЗаказКлиента = &ЗаказКлиента
					|	И ТТМ_СогласованиеЗаказовМенеджер.Подразделение = &Подразделение
					|	И ТТМ_СогласованиеЗаказовМенеджер.Назначение = &Назначение
					|
					|СГРУППИРОВАТЬ ПО
					|	ТТМ_СогласованиеЗаказовМенеджер.Изделие,
					|	ТТМ_СогласованиеЗаказовМенеджер.ЗаказКлиента,
					|	ВЫБОР
					|		КОГДА ТТМ_СогласованиеЗаказовМенеджер.СтатусСогласования = &СтатусСогласования
					|			ТОГДА ИСТИНА
					|		ИНАЧЕ ЛОЖЬ
					|	КОНЕЦ
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ РАЗЛИЧНЫЕ
					|	ЗаказКлиентаТовары.НомерСтроки КАК НомерСтроки,
					|	ЕСТЬNULL(ВТ_РегистрТТМПроцессПроизводства.Подтверждено, ЛОЖЬ) КАК Подтверждено,
					|	ЗаказКлиентаТовары.Ссылка КАК ЗаказКлиента,
					|	ЗаказКлиентаТовары.Номенклатура КАК Номенклатура,
					|	ЗаказКлиентаТовары.Упаковка КАК ЕдиницаИзмерения,
					|	СУММА(ЗаказКлиентаТовары.КоличествоУпаковок) КАК Количество,
					|	ЗаказКлиентаТовары.ВидЦены КАК ВидЦены,
					|	ЗаказКлиентаТовары.Цена КАК Цена,
					|	ЗаказКлиентаТовары.СтавкаНДС КАК СтавкаНДС,
					|	ЗаказКлиентаТовары.СуммаНДС КАК СуммаНДС,
					|	ЗаказКлиентаТовары.СуммаСНДС КАК ИтоговаяСумма,
					|	ЗаказКлиентаТовары.ДатаОтгрузки КАК ЖелаемаяДатаПРоизводства
					|ПОМЕСТИТЬ ВТ_ТоварыЗаказаКлиентаМП
					|ИЗ
					|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
					|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_РегистрТТМПроцессПроизводства КАК ВТ_РегистрТТМПроцессПроизводства
					|		ПО ЗаказКлиентаТовары.Ссылка = ВТ_РегистрТТМПроцессПроизводства.ЗаказКлиента
					|			И ЗаказКлиентаТовары.Номенклатура = ВТ_РегистрТТМПроцессПроизводства.Изделие
					|ГДЕ
					|	ЗаказКлиентаТовары.Ссылка = &ЗаказКлиента
					|
					|СГРУППИРОВАТЬ ПО
					|	ЗаказКлиентаТовары.Номенклатура,
					|	ЗаказКлиентаТовары.Ссылка,
					|	ЗаказКлиентаТовары.Упаковка,
					|	ЗаказКлиентаТовары.ВидЦены,
					|	ЗаказКлиентаТовары.Цена,
					|	ЗаказКлиентаТовары.СтавкаНДС,
					|	ЗаказКлиентаТовары.СуммаНДС,
					|	ЗаказКлиентаТовары.СуммаСНДС,
					|	ЗаказКлиентаТовары.ДатаОтгрузки,
					|	ЗаказКлиентаТовары.НомерСтроки,
					|	ЕСТЬNULL(ВТ_РегистрТТМПроцессПроизводства.Подтверждено, ЛОЖЬ)
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|УНИЧТОЖИТЬ ВТ_РегистрТТМПроцессПроизводства
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ РАЗЛИЧНЫЕ
					|	ВТ_ТоварыЗаказаКлиентаМП.НомерСтроки КАК НомерСтроки,
					|	ВТ_ТоварыЗаказаКлиентаМП.Подтверждено КАК Подтверждено,
					|	ВЫБОР
					|		КОГДА ТТМ_СогласованиеЗаказовКонструктор.СтатусСогласования = &СтатусСогласования
					|			ТОГДА ИСТИНА
					|		ИНАЧЕ ЕСТЬNULL(ТТМ_СогласованиеЗаказовКонструктор.СтатусСогласования, ЛОЖЬ)
					|	КОНЕЦ КАК ПодтверждениеКБ,
					|	ВТ_ТоварыЗаказаКлиентаМП.ЗаказКлиента КАК ЗаказКлиента,
					|	ВТ_ТоварыЗаказаКлиентаМП.Номенклатура КАК Номенклатура,
					|	ВТ_ТоварыЗаказаКлиентаМП.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
					|	ВТ_ТоварыЗаказаКлиентаМП.Количество КАК Количество,
					|	ВТ_ТоварыЗаказаКлиентаМП.ВидЦены КАК ВидЦены,
					|	ВТ_ТоварыЗаказаКлиентаМП.Цена КАК Цена,
					|	ВТ_ТоварыЗаказаКлиентаМП.СтавкаНДС КАК СтавкаНДС,
					|	ВТ_ТоварыЗаказаКлиентаМП.СуммаНДС КАК СуммаНДС,
					|	ВТ_ТоварыЗаказаКлиентаМП.ИтоговаяСумма КАК ИтоговаяСумма,
					|	ВТ_ТоварыЗаказаКлиентаМП.ЖелаемаяДатаПРоизводства КАК ЖелаемаяДатаПРоизводства
					|ПОМЕСТИТЬ ВТ_СписокТоваровСПодтверждениемКБ
					|ИЗ
					|	ВТ_ТоварыЗаказаКлиентаМП КАК ВТ_ТоварыЗаказаКлиентаМП
					|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТТМ_СогласованиеЗаказовКонструктор КАК ТТМ_СогласованиеЗаказовКонструктор
					|		ПО ВТ_ТоварыЗаказаКлиентаМП.ЗаказКлиента = ТТМ_СогласованиеЗаказовКонструктор.ЗаказКлиента
					|			И ВТ_ТоварыЗаказаКлиентаМП.Номенклатура = ТТМ_СогласованиеЗаказовКонструктор.Изделие
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|УНИЧТОЖИТЬ ВТ_ТоварыЗаказаКлиентаМП
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ
					|	ЕСТЬNULL(РесурсныеСпецификации.Ссылка, ЗНАЧЕНИЕ(Справочник.РесурсныеСпецификации.ПустаяСсылка)) КАК Спецификация,
					|	ВТ_СписокТоваровСПодтверждениемКБ.НомерСтроки КАК НомерСтроки,
					|	ВТ_СписокТоваровСПодтверждениемКБ.Подтверждено КАК Подтверждено,
					|	ВТ_СписокТоваровСПодтверждениемКБ.ПодтверждениеКБ КАК ПодтверждениеКБ,
					|	ВТ_СписокТоваровСПодтверждениемКБ.ЗаказКлиента КАК ЗаказКлиента,
					|	ВТ_СписокТоваровСПодтверждениемКБ.Номенклатура КАК Номенклатура,
					|	ВТ_СписокТоваровСПодтверждениемКБ.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
					|	ВТ_СписокТоваровСПодтверждениемКБ.Количество КАК Количество,
					|	ВТ_СписокТоваровСПодтверждениемКБ.ВидЦены КАК ВидЦены,
					|	ВТ_СписокТоваровСПодтверждениемКБ.Цена КАК Цена,
					|	ВТ_СписокТоваровСПодтверждениемКБ.СтавкаНДС КАК СтавкаНДС,
					|	ВТ_СписокТоваровСПодтверждениемКБ.СуммаНДС КАК СуммаНДС,
					|	ВТ_СписокТоваровСПодтверждениемКБ.ИтоговаяСумма КАК ИтоговаяСумма,
					|	ВТ_СписокТоваровСПодтверждениемКБ.ЖелаемаяДатаПРоизводства КАК ЖелаемаяДатаПРоизводства
					|ПОМЕСТИТЬ ВТ_СписокСоСвязаннымиСпецификациями
					|ИЗ
					|	ВТ_СписокТоваровСПодтверждениемКБ КАК ВТ_СписокТоваровСПодтверждениемКБ
					|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.РесурсныеСпецификации КАК РесурсныеСпецификации
					|		ПО ВТ_СписокТоваровСПодтверждениемКБ.Номенклатура = РесурсныеСпецификации.ОсновноеИзделиеНоменклатура
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|УНИЧТОЖИТЬ ВТ_СписокТоваровСПодтверждениемКБ
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ РАЗЛИЧНЫЕ
					|	ЕСТЬNULL(ТТМ_ИсполнителиСпецификаций.СрокиРазработки, ДАТАВРЕМЯ(1, 1, 1)) КАК СрокиРазработки,
					|	ВТ_СписокСоСвязаннымиСпецификациями.Спецификация КАК Спецификация,
					|	ВТ_СписокСоСвязаннымиСпецификациями.НомерСтроки КАК НомерСтроки,
					|	ВТ_СписокСоСвязаннымиСпецификациями.Подтверждено КАК Подтверждено,
					|	ВТ_СписокСоСвязаннымиСпецификациями.ПодтверждениеКБ КАК ПодтверждениеКБ,
					|	ВТ_СписокСоСвязаннымиСпецификациями.ЗаказКлиента КАК ЗаказКлиента,
					|	ВТ_СписокСоСвязаннымиСпецификациями.Номенклатура КАК Номенклатура,
					|	ВТ_СписокСоСвязаннымиСпецификациями.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
					|	ВТ_СписокСоСвязаннымиСпецификациями.Количество КАК Количество,
					|	ВТ_СписокСоСвязаннымиСпецификациями.ВидЦены КАК ВидЦены,
					|	ВТ_СписокСоСвязаннымиСпецификациями.Цена КАК Цена,
					|	ВТ_СписокСоСвязаннымиСпецификациями.СтавкаНДС КАК СтавкаНДС,
					|	ВТ_СписокСоСвязаннымиСпецификациями.СуммаНДС КАК СуммаНДС,
					|	ВТ_СписокСоСвязаннымиСпецификациями.ИтоговаяСумма КАК ИтоговаяСумма,
					|	ВТ_СписокСоСвязаннымиСпецификациями.ЖелаемаяДатаПРоизводства КАК ЖелаемаяДатаПРоизводства
					|ПОМЕСТИТЬ ВТ_ИтоговыеДанные
					|ИЗ
