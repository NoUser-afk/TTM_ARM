			|		И ПланВыпуска.Изделие = ВыпущенныеПартии.Изделие
			|		И ПланВыпуска.Назначение = ВыпущенныеПартии.Назначение
			|		И ПланВыпуска.Спецификация = ВыпущенныеПартии.Спецификация
			//--//**************************************************************************************************
			//****14.08.2024****************************************************************************************
			|	ЛЕВОЕ СОЕДИНЕНИЕ КоличествоОперацийПоСпецификации КАК КоличествоОперацийПоСпецификации
			|	ПО (ПланВыпуска.Спецификация = КоличествоОперацийПоСпецификации.Спецификация)
			//******************************************************************************************************                
			//**22.10.2024******************************************************************************************
			|ЛЕВОЕ СОЕДИНЕНИЕ ИсполнителиПартийВыпуска КАК ИсполнителиПартийВыпуска
			|		ПО (ПланВыпуска.ДатаВыпускаПлановая = ЕСТЬNULL(ИсполнителиПартийВыпуска.ДатаВыпуска, ДАТАВРЕМЯ(1, 1, 1)))
			|			И (ПланВыпуска.Изделие = ЕСТЬNULL(ИсполнителиПартийВыпуска.Изделие, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяССылка)))
			|			И (ПланВыпуска.Назначение = ЕСТЬNULL(ИсполнителиПартийВыпуска.Назначение, ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка)))
			//******************************************************************************************************
			|
			|СГРУППИРОВАТЬ ПО
			|	ПланВыпуска.Упаковка,
			|	ПланВыпуска.ДатаВыпускаПлановая,
			|	ПланВыпуска.Изделие,
			|	ПланВыпуска.Назначение,
			|	ПланВыпуска.Назначение.Заказ.НомерПоДаннымКлиента,
			|	ПланВыпуска.Комментарий,
			|	ПланВыпуска.КоличествоУпаковок,
			//|	ПланВыпуска.Количество,
			|	ПланВыпуска.Спецификация,        
			//**22.10.2024******************************************************************************************
			|	ИсполнителиПартийВыпуска.Исполнитель,
			//++//**************************************************************************************************
			|	ВЫБОР
			|		КОГДА ЕСТЬNULL(ВыпущенныеПартии.КоличествоЭтаповПартии, 0) = ЕСТЬNULL(ВыпущенныеПартии.КоличествоВыпущенныхЭтапов, 0)  и ЕСТЬNULL(ВыпущенныеПартии.КоличествоЭтаповПартии,0) <> 0
			|			ТОГДА ИСТИНА
			|		ИНАЧЕ ЛОЖЬ
			|	КОНЕЦ,    
			//--//*************************************************************************************************
			//****14.08.2024***************************************************************************************
			|	ЕСТЬNULL(КоличествоОперацийПоСпецификации.КоличествоОпераций, 0)" + ?(МассивВРЦ.Количество() >0,", ","") + "
			//*****************************************************************************************************
			|	&ТекстПолейГруппировки
			|
			|УПОРЯДОЧИТЬ ПО
			|	ДатаВыпускаПлановая,
			|	Изделие
			|ИТОГИ ПО
			|	ДатаВыпускаПлановая
			|АВТОУПОРЯДОЧИВАНИЕ";
	
	//КолонкиВРЦ = "";           
	//Счетчик = 1;         
	ТекстЗапросаПолейПоВРЦ = "";
	ТекстСозданияВТПоВРЦ = "";    
	ТекстСвязиВтПоВРЦСПланом = "";   
	ТекстПолейГруппировки = "";
	Для Каждого ВРЦ из МассивВРЦ Цикл   
		//Если ВРЦ.наименование = "Технолог" тогда 
		//	Продолжить; 
		//КонецЕсли;
		ЗаголовокКолонки = ВРЦ.Наименование;
		ИмяКолонки = СтрЗаменить(ЗаголовокКолонки," ","");
		//КолонкиВРЦ = ?(КолонкиВРЦ = "","",Символы.ПС) + ИмяКолонки + " КАК " + Заголовок + ","
		//КолонкиВРЦ = КолонкиВРЦ + ?(КолонкиВРЦ = "","",Символы.ПС) + "ЛОЖЬ  КАК " + ИмяКолонки + ",";
		
		ТекстЗапросаКолонки = ПолучитьТекстзапросаПолейВТПоВРЦ(ИмяКолонки);
		ТекстЗапросаПолейПоВРЦ = ТекстЗапросаПолейПоВРЦ + ?(ТекстЗапросаКолонки = "","",Символы.ПС) + ТекстЗапросаКолонки;
		//?(ТекстЗапросаКолонки = "","",Символы.ПС) + " КАК " + ИмяКолонки + ", ";
		ТекстЗапросаВТ = ПолучитьТекстСозданияВТПоВРЦ(ИмяКолонки);
		ТекстСозданияВТПоВРЦ = ТекстСозданияВТПоВРЦ + ?(ТекстЗапросаВТ = "","",Символы.ПС) + ТекстЗапросаВТ;
		ТекстЗапросаСвязи = ПолучитьТекстСвязиВТПоВРЦСПланом(ИмяКолонки);
		ТекстСвязиВтПоВРЦСПланом = ТекстСвязиВтПоВРЦСПланом + ?(ТекстЗапросаСвязи = "","",Символы.ПС) + ТекстЗапросаСвязи;
		ТекстГруппировки = ПолучитьТекстПолейГруппировки(ИмяКолонки);
		ТекстПолейГруппировки = ТекстПолейГруппировки + ?(ТекстГруппировки = "","",Символы.ПС) + ТекстГруппировки;
		
		//Счетчик = Счетчик + 1;  
	КонецЦикла;
	//КолонкиВРЦ = Лев(КолонкиВРЦ,СтрДлина(КолонкиВРЦ)-1);   
	ТекстЗапросаПолейПоВРЦ = Лев(ТекстЗапросаПолейПоВРЦ,СтрДлина(ТекстЗапросаПолейПоВРЦ)-1);   	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"&ТекстЗапросаПолейПоВРЦ КАК ТекстЗапросаПолейПоВРЦ",ТекстЗапросаПолейПоВРЦ); 
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"ВЫБРАТЬ &ТекстВыбораПолейВременныхТаблицПоВРЦ",ТекстСозданияВТПоВРЦ);
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"&ТекстСоединенияВТПоВРЦСпланом",ТекстСвязиВтПоВРЦСПланом);
	
	ТекстПолейГруппировки = Лев(ТекстПолейГруппировки,СтрДлина(ТекстПолейГруппировки)-1);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"&ТекстПолейГруппировки",ТекстПолейГруппировки);
	
	////////////////////////////////////////////////////////////////////////
	//Отборы    
	
	ТекстОтбораПоНазначению = "";
	ТекстОтбораДатаНачала = "";
	ТекстОтбораДатаОкончания = "";  
	ТекстОтбораИзделие = "";
	
	Если ЗначениеЗаполнено(Объект.ОтборПериод.ДатаНачала) Тогда 
		ТекстОтбораДатаНачала = " И ЭтапПроизводства2_2ВыходныеИзделия.датаПроизводства >= &ОтборДатаНачала";
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ОтборПериод.ДатаОкончания) Тогда 
		ТекстОтбораДатаОкончания = " И ЭтапПроизводства2_2ВыходныеИзделия.датаПроизводства <= &ОтборДатаОкончания";
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ОтборНазначение) Тогда 
		ТекстОтбораПоНазначению = " И ЭтапПроизводства2_2ВыходныеИзделия.Назначение В (&ОтборНазначение)";
	КонецЕсли;        
	Если ЗначениеЗаполнено(Объект.ОтборИзделие) Тогда 
		ТекстОтбораИзделие = " И ЭтапПроизводства2_2ВыходныеИзделия.Номенклатура В (&ОтборИзделие)";
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"&ТекстОтбораДатаНачала", ТекстОтбораДатаНачала);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"&ТекстОтбораДатаОкончания", ТекстОтбораДатаОкончания);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"&ТекстОтбораПоНазначению",ТекстОтбораПоНазначению);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"&ТекстОтбораИзделие",ТекстОтбораИзделие);
	
	////////////////////////////////////////////////////////////////////////
		
	Возврат ТекстЗапроса;
	
КонецФункции        

&НаСервере
Функция ПолучитьТекстСозданияВТПоВРЦ(ИмяКолонки) 
	
	ТекстВыборки ="ВЫБРАТЬ
			|	ЭтапыПланаВыпуска.ДатаВыпускаПлановая КАК ДатаВыпускаПлановая,
			|	ЭтапыПланаВыпуска.Изделие КАК Изделие,
			|	ЭтапыПланаВыпуска.Назначение КАК Назначение,
			|	СУММА(ЭтапыПланаВыпуска.КоличествоУпаковок) КАК КоличествоУпаковок,
			|	ЭтапыПланаВыпуска.Упаковка КАК Упаковка,
			|	СУММА(ЭтапыПланаВыпуска.Количество) КАК Количество,
			|	ЭтапыПланаВыпуска.Спецификация КАК Спецификация,
			|	ТТМ_ИсполнениеТехПроцесса.ТехОперация КАК ТехОперация,
			|	ТТМ_ИсполнениеТехПроцесса.ВидРабочегоЦентра КАК ВидРабочегоЦентра
			|ПОМЕСТИТЬ ВТ" + ИмяКолонки + "
			|ИЗ
			|	РегистрСведений.ТТМ_ИсполнениеТехПроцесса КАК ТТМ_ИсполнениеТехПроцесса
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ЭтапыПланаВыпуска КАК ЭтапыПланаВыпуска
			|		ПО (ТТМ_ИсполнениеТехПроцесса.ЭтапПроизводства = ЭтапыПланаВыпуска.ЭтапПроизводства)
			|ГДЕ
			|	ТТМ_ИсполнениеТехПроцесса.ВидРабочегоЦентра.Наименование ПОДОБНО """ + ИмяКолонки + """
			|
			|СГРУППИРОВАТЬ ПО
			|	ЭтапыПланаВыпуска.ДатаВыпускаПлановая,
			|	ЭтапыПланаВыпуска.Изделие,
			|	ЭтапыПланаВыпуска.Назначение,
			|	ЭтапыПланаВыпуска.Упаковка,
			|	ЭтапыПланаВыпуска.Спецификация,
			|	ТТМ_ИсполнениеТехПроцесса.ТехОперация,
			|	ТТМ_ИсполнениеТехПроцесса.ВидРабочегоЦентра
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|";
			
	Возврат ТекстВыборки;
	
КонецФункции

&НаСервере
Функция ПолучитьТекстСвязиВТПоВРЦСПланом(ИмяКолонки) 
	
	ТекстВыборки = " ЛЕВОЕ СОЕДИНЕНИЕ ВТ" + Имяколонки + " КАК ВТ" + ИмяКолонки + "
			|		ПО (ПланВыпуска.ДатаВыпускаПлановая = ВТ" + Имяколонки + ".ДатаВыпускаПлановая)
			|			И (ПланВыпуска.Изделие = ВТ" + Имяколонки + ".Изделие)
			|			И (ПланВыпуска.Назначение = ВТ" + Имяколонки + ".Назначение)
			|			И (ПланВыпуска.Спецификация = ВТ" + Имяколонки + ".Спецификация)";
			
	Возврат ТекстВыборки;
	
КонецФункции

&НаСервере
Функция ПолучитьТекстЗапросаПолейВТПоВРЦ(ИмяКолонки) 
	
	ТекстВыборки = "ВЫБОР
			|		КОГДА ЕСТЬNULL(ВТ" + ИмяКолонки + ".ВидРабочегоЦентра, ЛОЖЬ) = ЛОЖЬ
			|			ТОГДА ЛОЖЬ
			|		ИНАЧЕ ИСТИНА
			|	КОНЕЦ КАК " + ИмяКолонки + ",";
			
	Возврат ТекстВыборки;
	
КонецФункции

&НаСервере
Функция ПолучитьТекстПолейГруппировки(ИмяКолонки) 
	
	ТекстВыборки = "ВЫБОР
			|		КОГДА ЕСТЬNULL(ВТ" + ИмяКолонки + ".ВидРабочегоЦентра, ЛОЖЬ) = ЛОЖЬ
			|			ТОГДА ЛОЖЬ
			|		ИНАЧЕ ИСТИНА
			|	КОНЕЦ,";
			
	Возврат ТекстВыборки;
	
КонецФункции

&НаСервере
Функция ПолучитьТекстЗапросаПланВыпуска()
	
	ТекстЗ = "ВЫБРАТЬ
	         |	ТТМ_УчетСерийныхНомеровПродукции.Регистратор КАК ЭтапПроизводства,
	         |	ТТМ_УчетСерийныхНомеровПродукции.Номенклатура КАК Номенклатура,
	         |	ТТМ_УчетСерийныхНомеровПродукции.СерийныйНомер КАК СерийныйНомер,
	         |	ТТМ_УчетСерийныхНомеровПродукции.Количество КАК Количество
	         |ПОМЕСТИТЬ СерийныеНомераВПроизводстве
	         |ИЗ
	         |	РегистрНакопления.ТТМ_УчетСерийныхНомеровПродукции КАК ТТМ_УчетСерийныхНомеровПродукции
	         |ГДЕ
	         |	ТТМ_УчетСерийныхНомеровПродукции.Регистратор ССЫЛКА Документ.ЭтапПроизводства2_2
	         |	И НЕ ТТМ_УчетСерийныхНомеровПродукции.Произведено
	         |;
	         |
	         |////////////////////////////////////////////////////////////////////////////////
	         |ВЫБРАТЬ
	         |	ДополнительныеСведения.Объект КАК Объект,
	         |	ДополнительныеСведения.Значение КАК Значение
	         |ПОМЕСТИТЬ КодыТМноменклатуры
	         |ИЗ
	         |	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
	         |ГДЕ
	         |	ДополнительныеСведения.Свойство = &СвойствоКодТМ
	         |	И ДополнительныеСведения.Объект ССЫЛКА Справочник.Номенклатура
	         |;
	         |
	         |////////////////////////////////////////////////////////////////////////////////
	         |ВЫБРАТЬ
	         |	ИСТИНА КАК Отметка,
	         |	ЭтапПроизводства2_2ВыходныеИзделия.Ссылка КАК ЭтапПроизводства,
	         |	ЭтапПроизводства2_2ВыходныеИзделия.ДатаПроизводства КАК ДатаВыпускаПлановая,
	         |	ЭтапПроизводства2_2ВыходныеИзделия.Номенклатура КАК Изделие,
	         |	ЕСТЬNULL(КодыТМноменклатуры.Значение, """") КАК КодТМ,
	         |	ЕСТЬNULL(СерийныеНомераВПроизводстве.СерийныйНомер, """") КАК СерийныйНомер,
	         |	ЭтапПроизводства2_2ВыходныеИзделия.Назначение КАК Назначение,
	         |	СУММА(ЭтапПроизводства2_2ВыходныеИзделия.КоличествоУпаковок) КАК КоличествоУпаковок,
	         |	ВЫБОР
	         |		КОГДА ЕСТЬNULL(ЭтапПроизводства2_2ВыходныеИзделия.Упаковка, ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
	         |			ТОГДА ЭтапПроизводства2_2ВыходныеИзделия.Номенклатура.ЕдиницаИзмерения
	         |		ИНАЧЕ ЭтапПроизводства2_2ВыходныеИзделия.Упаковка
	         |	КОНЕЦ КАК Упаковка,
	         |	СУММА(ЭтапПроизводства2_2ВыходныеИзделия.Количество) КАК Количество,
	         |	ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.Спецификация КАК Спецификация,
	         |	ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.КоличествоУпаковокФакт КАК Выполнено
	         |ИЗ
	         |	Документ.ЭтапПроизводства2_2.ВыходныеИзделия КАК ЭтапПроизводства2_2ВыходныеИзделия
	         |		ЛЕВОЕ СОЕДИНЕНИЕ СерийныеНомераВПроизводстве КАК СерийныеНомераВПроизводстве
	         |		ПО ЭтапПроизводства2_2ВыходныеИзделия.Ссылка = СерийныеНомераВПроизводстве.ЭтапПроизводства
	         |		ЛЕВОЕ СОЕДИНЕНИЕ КодыТМноменклатуры КАК КодыТМноменклатуры
	         |		ПО ЭтапПроизводства2_2ВыходныеИзделия.Номенклатура = КодыТМноменклатуры.Объект
	         |ГДЕ
	         |	ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.Проведен
	         |	И ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЭтаповПроизводства2_2.Начат)
	         |	И ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.Подразделение = &Подразделение
	         |	И НЕ ЭтапПроизводства2_2ВыходныеИзделия.Произведено
	         |	И НЕ ЭтапПроизводства2_2ВыходныеИзделия.Отменено 
			 |	&ТекстОтбораПоНазначению
			 |	&ТекстОтбораДатаНачала
			 |	&ТекстОтбораДатаОкончания
			 |	&ТекстОтбораИзделие
	         |
	         |СГРУППИРОВАТЬ ПО
	         |	ЭтапПроизводства2_2ВыходныеИзделия.ДатаПроизводства,
	         |	ЭтапПроизводства2_2ВыходныеИзделия.Номенклатура,
	         |	ЭтапПроизводства2_2ВыходныеИзделия.Назначение,
	         |	ЭтапПроизводства2_2ВыходныеИзделия.Упаковка,
	         |	ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.Спецификация,
	         |	ВЫБОР
	         |		КОГДА ЕСТЬNULL(ЭтапПроизводства2_2ВыходныеИзделия.Упаковка, ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
	         |			ТОГДА ЭтапПроизводства2_2ВыходныеИзделия.Номенклатура.ЕдиницаИзмерения
	         |		ИНАЧЕ ЭтапПроизводства2_2ВыходныеИзделия.Упаковка
	         |	КОНЕЦ,
	         |	ЭтапПроизводства2_2ВыходныеИзделия.Ссылка,
	         |	ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.КоличествоУпаковокФакт,
	         |	ЕСТЬNULL(СерийныеНомераВПроизводстве.СерийныйНомер, """"),
	         |	ЕСТЬNULL(КодыТМноменклатуры.Значение, """")";
	
	////////////////////////////////////////////////////////////////////////
	//Отборы    
	
	ТекстОтбораПоНазначению = "";
	ТекстОтбораДатаНачала = "";
	ТекстОтбораДатаОкончания = ""; 
	ТекстОтбораИзделие = "";
	
	Если ЗначениеЗаполнено(Объект.ОтборПериод.ДатаНачала) Тогда 
		ТекстОтбораДатаНачала = " И ЭтапПроизводства2_2ВыходныеИзделия.датаПроизводства >= &ОтборДатаНачала";
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ОтборПериод.ДатаОкончания) Тогда 
		ТекстОтбораДатаОкончания = " И ЭтапПроизводства2_2ВыходныеИзделия.датаПроизводства <= &ОтборДатаОкончания";
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ОтборНазначение) Тогда 
		ТекстОтбораПоНазначению = " И ЭтапПроизводства2_2ВыходныеИзделия.Назначение В (&ОтборНазначение)";
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ОтборИзделие) Тогда 
		ТекстОтбораИзделие = " И ЭтапПроизводства2_2ВыходныеИзделия.Номенклатура В (&ОтборИзделие)";
	КонецЕсли;
	
	ТекстЗ = СтрЗаменить(ТекстЗ,"&ТекстОтбораДатаНачала", ТекстОтбораДатаНачала);
	ТекстЗ = СтрЗаменить(ТекстЗ,"&ТекстОтбораДатаОкончания", ТекстОтбораДатаОкончания);
	ТекстЗ = СтрЗаменить(ТекстЗ,"&ТекстОтбораПоНазначению",ТекстОтбораПоНазначению);
	ТекстЗ = СтрЗаменить(ТекстЗ,"&ТекстОтбораИзделие",ТекстОтбораИзделие);
	
	////////////////////////////////////////////////////////////////////////
	
	Возврат ТекстЗ;			   
	
КонецФункции

