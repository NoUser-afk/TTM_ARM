&НаСервере
Процедура ЗаполнитьСерийныеНомераТабПлана(ТабПлан)
	
	Если ТабПлан = Неопределено Или ТабПлан.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если ТабПлан.Колонки.Найти("СерийныйНомер") = Неопределено Тогда
		ТабПлан.Колонки.Добавить("СерийныйНомер", Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(16, ДопустимаяДлина.Фиксированная)));
	КонецЕсли;
	
	МассивЭтапов = Новый Массив;
	Для Каждого СтрокаПлана Из ТабПлан Цикл
		СтрокаПлана.СерийныйНомер = "";
		Если ЗначениеЗаполнено(СтрокаПлана.ЭтапПроизводства) Тогда
			МассивЭтапов.Добавить(СтрокаПлана.ЭтапПроизводства);
		КонецЕсли;
	КонецЦикла;
	
	Если МассивЭтапов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТТМ_УчетСерийныхНомеровПродукции.Регистратор КАК ЭтапПроизводства,
	               |	МАКСИМУМ(ТТМ_УчетСерийныхНомеровПродукции.СерийныйНомер) КАК СерийныйНомер
	               |ИЗ
	               |	РегистрНакопления.ТТМ_УчетСерийныхНомеровПродукции КАК ТТМ_УчетСерийныхНомеровПродукции
	               |ГДЕ
	               |	ТТМ_УчетСерийныхНомеровПродукции.Регистратор В (&МассивЭтапов)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ТТМ_УчетСерийныхНомеровПродукции.Регистратор";
	Запрос.УстановитьПараметр("МассивЭтапов", МассивЭтапов);
	
	СерийныеНомераЭтапов = Запрос.Выполнить().Выгрузить();
	СоответствиеСерийныхНомеров = Новый Соответствие;
	
	Для Каждого СтрокаСерийногоНомера Из СерийныеНомераЭтапов Цикл
		СоответствиеСерийныхНомеров.Вставить(СтрокаСерийногоНомера.ЭтапПроизводства, СтрокаСерийногоНомера.СерийныйНомер);
	КонецЦикла;
	
	Для Каждого СтрокаПлана Из ТабПлан Цикл
		СерийныйНомер = СоответствиеСерийныхНомеров.Получить(СтрокаПлана.ЭтапПроизводства);
		Если СерийныйНомер <> Неопределено Тогда
			СтрокаПлана.СерийныйНомер = СерийныйНомер;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКодТМДляСтрокПланаВыпуска(ДеревоПлана)
	
	Если ДеревоПлана = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ДеревоПлана.Колонки.Найти("КодТМ") = Неопределено Тогда
		ДеревоПлана.Колонки.Добавить("КодТМ", Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(100, ДопустимаяДлина.Переменная)));
	КонецЕсли;
	
	СведениеКодТМ = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("Имя", "КодТМ_ТТМ");
	Если СведениеКодТМ = Неопределено Или СведениеКодТМ.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	СоответствиеНоменклатуры = Новый Соответствие;
	СобратьНоменклатуруИзСтрокПланаВыпуска(ДеревоПлана.Строки, СоответствиеНоменклатуры);
	
	Если СоответствиеНоменклатуры.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	МассивНоменклатуры = Новый Массив;
	Для Каждого ЭлементНоменклатуры Из СоответствиеНоменклатуры Цикл
		МассивНоменклатуры.Добавить(ЭлементНоменклатуры.Ключ);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ДополнительныеСведения.Объект КАК Изделие,
	               |	ДополнительныеСведения.Значение КАК КодТМ
	               |ИЗ
	               |	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
	               |ГДЕ
	               |	ДополнительныеСведения.Объект ССЫЛКА Справочник.Номенклатура
	               |	И ДополнительныеСведения.Объект В (&МассивНоменклатуры)
	               |	И ДополнительныеСведения.Свойство = &СведениеКодТМ";
	Запрос.УстановитьПараметр("МассивНоменклатуры", МассивНоменклатуры);
	Запрос.УстановитьПараметр("СведениеКодТМ", СведениеКодТМ);
	
	СоответствиеКодовТМ = Новый Соответствие;
	Для Каждого СтрокаКодаТМ Из Запрос.Выполнить().Выгрузить() Цикл
		ЗначениеКодТМ = "";
		Если СтрокаКодаТМ.КодТМ <> Неопределено Тогда
			ЗначениеКодТМ = Строка(СтрокаКодаТМ.КодТМ);
		КонецЕсли;
		СоответствиеКодовТМ.Вставить(СтрокаКодаТМ.Изделие, ЗначениеКодТМ);
	КонецЦикла;
	
	Если СоответствиеКодовТМ.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьКодТМВСтрокахПланаВыпуска(ДеревоПлана.Строки, СоответствиеКодовТМ);
	
КонецПроцедуры

&НаСервере
Процедура СобратьНоменклатуруИзСтрокПланаВыпуска(СтрокиПлана, СоответствиеНоменклатуры)
	
	Для Каждого СтрокаПлана Из СтрокиПлана Цикл
		СтрокаПлана.КодТМ = "";
		
		Если ЗначениеЗаполнено(СтрокаПлана.Изделие)
			И СоответствиеНоменклатуры.Получить(СтрокаПлана.Изделие) = Неопределено Тогда
			СоответствиеНоменклатуры.Вставить(СтрокаПлана.Изделие, Истина);
		КонецЕсли;
		
		Если СтрокаПлана.Строки.Количество() > 0 Тогда
			СобратьНоменклатуруИзСтрокПланаВыпуска(СтрокаПлана.Строки, СоответствиеНоменклатуры);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьКодТМВСтрокахПланаВыпуска(СтрокиПлана, СоответствиеКодовТМ)
	
	Для Каждого СтрокаПлана Из СтрокиПлана Цикл
		Если ЗначениеЗаполнено(СтрокаПлана.Изделие) Тогда
			КодТМ = СоответствиеКодовТМ.Получить(СтрокаПлана.Изделие);
			Если КодТМ <> Неопределено Тогда
				СтрокаПлана.КодТМ = КодТМ;
			КонецЕсли;
		КонецЕсли;
		
		Если СтрокаПлана.Строки.Количество() > 0 Тогда
			УстановитьКодТМВСтрокахПланаВыпуска(СтрокаПлана.Строки, СоответствиеКодовТМ);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

