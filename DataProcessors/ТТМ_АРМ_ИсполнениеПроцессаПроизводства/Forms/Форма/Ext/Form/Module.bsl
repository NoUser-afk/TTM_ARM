	//+Комментарий 18.12.2024
	МассивИзменяемыхРеквизитов.Добавить(Новый РеквизитФормы("Комментарий",Новый ОписаниеТипов("Строка",,,,новый КвалификаторыСтроки(100,ДопустимаяДлина.Переменная)),ИмяДерева,"Комментарий",Ложь));
	//-Комментарий 18.12.2024
	
	//МассивИзменяемыхРеквизитов.Добавить(Новый РеквизитФормы("Количество",Новый ОписаниеТипов("Число",,,,новый КвалификаторыЧисла(15,3,ДопустимыйЗнак.Неотрицательный)),ИмяДерева,"Количество",Ложь));
	//Количество показывает КоличествоУпаковок
	МассивИзменяемыхРеквизитов.Добавить(Новый РеквизитФормы("Количество",Новый ОписаниеТипов("Число",,,,новый КвалификаторыЧисла(15,3,ДопустимыйЗнак.Неотрицательный)),ИмяДерева,"Количество",Ложь));
	МассивИзменяемыхРеквизитов.Добавить(Новый РеквизитФормы("Упак",Новый ОписаниеТипов("СправочникСсылка.УпаковкиЕдиницыИзмерения"),ИмяДерева,"Упаковка",Ложь));
	МассивИзменяемыхРеквизитов.Добавить(Новый РеквизитФормы("Исполнитель",Новый ОписаниеТипов("СправочникСсылка.РабочиеЦентры"),ИмяДерева,"Исполнитель",Ложь));
	МассивИзменяемыхРеквизитов.Добавить(Новый РеквизитФормы("Спецификация",Новый ОписаниеТипов("СправочникСсылка.РесурсныеСпецификации"),ИмяДерева,"Спецификация",Ложь));
	МассивИзменяемыхРеквизитов.Добавить(Новый РеквизитФормы("ИзделиеВыпущено",Новый ОписаниеТипов("Булево"),ИмяДерева,"Изделие выпущено",Ложь));
