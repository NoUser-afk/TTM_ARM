&НаСервере
Функция ВыполнениеОперацииНаСервере(ТекСтрока, ИмяОперации, СтруктураОтбораПартии, ПоВсемОперациям)
	
	Исполнитель = Справочники.РабочиеЦентры.НайтиПоНаименованию(ТекСтрока.Исполнитель);
	Если Исполнитель = Неопределено Тогда 
		Сообщить("не удалось определить Рабочий центр");
		Возврат Ложь;   
	Иначе 
		ФЛИсполнитель = ПолучитьИсполнителляРЦ(Исполнитель);
		Если ФЛИсполнитель = Неопределено Тогда 
			Сообщить("Не заполнен ответственный исполнитель для рабочего центра " + Исполнитель);
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	ПараметрыОтбора = Новый Структура("ДатаВыпускаПлановая,Изделие,Назначение");
	ЗаполнитьЗначенияСвойств(ПараметрыОтбора,СтруктураОтбораПартии); 
	ТабПлан = ТабПланПроизводства.Выгрузить(ПараметрыОтбора,"ЭтапПроизводства");
	ТабПлан.Свернуть("ЭтапПроизводства");
	МассивЭтапов = ТабПлан.ВыгрузитьКолонку("ЭтапПроизводства");    
	//Убрать отбор по Спецификации, оставить только по этапам
	ТабПлан = ТабПланПроизводства.Выгрузить(ПараметрыОтбора,"Спецификация");
	ТабПлан.Свернуть("Спецификация");
	МассивСпецификаций = ТабПлан.ВыгрузитьКолонку("Спецификация");
	
	Запрос = Новый Запрос;                      
	Запрос.Текст = ПолучитьТекстЗапросаОперацийПоЭатпам();
	//Запрос получает данные для звгрузки в регистр ТТМ_ИсполнениеТехПроцесса 
	//невыполненные операции по спецификации
	
	Запрос.УстановитьПараметр("МассивСпецификаций", МассивСпецификаций);
	Запрос.УстановитьПараметр("ДатаВыпускаПлановая",СтруктураОтбораПартии.ДатаВыпускаПлановая);
	Запрос.УстановитьПараметр("Ответственный",Пользователи.АвторизованныйПользователь());
	Запрос.УстановитьПараметр("ТекущаяДата",ТекущаяДатаСеанса());  
	Запрос.УстановитьПараметр("ПоВсемОперациям",ПоВсемОперациям); 
	Запрос.УстановитьПараметр("ИмяКолонки",ИмяОперации);	
	Запрос.УстановитьПараметр("МассивЭтапов",МассивЭтапов);	                
	//Если ЗначениеЗаполнено(ТекСтрока.Исполнитель) Тогда 
	//	НазначенныйИсполнитель = Справочники.РабочиеЦентры.НайтиПоНаименованию(ТекСтрока.Исполнитель);
	//Иначе 
	//	НазначенныйИсполнитель = Справочники.РабочиеЦентры.ПустаяСсылка();
	//КонецЕсли;                                                       
	
	//Исполнителя заполним при заполнении строки регистра только для операции Сборка 
	НазначенныйИсполнитель = Справочники.РабочиеЦентры.ПустаяСсылка(); 
	Запрос.УстановитьПараметр("Исполнитель",НазначенныйИсполнитель); //ТекСтрока.Исполнитель);
	//СтруктураПараметров = Запрос.НайтиПараметры();
	
	//Параметр ПоВсемОперациям = 1 для записи выполнения по всем операциям спецификации
	//иначе только по той колонке в которой отметка
	
	ЭтапыПроизводства = Запрос.Выполнить().Выгрузить();    
	
	Если ЭтапыПроизводства.Количество() = 0 Тогда 
		Сообщить("Данная операция не определена для спецификации!");
		Возврат Ложь;
	КонецЕсли;
	
	ЭтоПоследняяОперация = Ложь;
	Если ЭтапыПроизводства[0].ОсталосьВыполнить = 1 
		и ЭтапыПроизводства[0].ТехОперация.РабочийЦентр.Наименование = ИмяОперации Тогда 
		
		ЭтоПоследняяОперация = Истина;
		
	КонецЕсли;
	
	НачатьТранзакцию();
	
	НЗ = РегистрыСведений.ТТМ_ИсполнениеТехПроцесса.СоздатьНаборЗаписей();        
	УстановитьОтметкуИзделиеВыпущено = Ложь;   
	
	Для Каждого СтрЭтап из ЭтапыПроизводства Цикл 
		
		НЗ.Отбор.ЭтапПроизводства.Установить(СтрЭтап.ЭтапПроизводства);
		НЗ.Отбор.Изделие.Установить(СтрЭтап.Изделие);
		НЗ.Отбор.Назначение.Установить(СтрЭтап.Назначение);
		НЗ.Прочитать();        
		
		КоличествоВыполненыхОпераций = НЗ.Количество();
		
		НЗ.Отбор.ТехОперация.Установить(СтрЭтап.ТехОперация);
		НЗ.Прочитать(); 
		
		Если НЗ.Количество() = 0 Тогда 
			НоваяСтрока = НЗ.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрЭтап);  
			Если ЗначениеЗаполнено(ТекСтрока.Исполнитель) и СтрЭтап.РабочийЦентр.Наименование = "Сборка" Тогда 
				НоваяСтрока.Исполнитель = Исполнитель; //Справочники.РабочиеЦентры.НайтиПоНаименованию(ТекСтрока.Исполнитель);
				НоваяСтрока.ОтветственыйИсполнитель = ФЛИсполнитель;
			КонецЕсли;
			
			Попытка                                                
				НЗ.Записать(); 
			Исключение   
				Сообщить("Ощибка при записи данных о выполнении операции в регистр! Данные не записаны!");
				ОтменитьТранзакцию();
			КонецПопытки;
		Иначе 
			Сообщить("Результат отбора не пустой, операция уже была выполнена ранее!");
		КонецЕсли;     
		
	КонецЦикла;                   
	
	Если ЭтоПоследняяОперация или ПоВсемОперациям Тогда
		
		НЗ.Отбор.Сбросить();    
		Для Каждого ЭтапПроизводства из ЭтапыПроизводства Цикл 
			
			НЗ.Отбор.ЭтапПроизводства.Установить(ЭтапПроизводства.ЭтапПроизводства);
			НЗ.Отбор.Изделие.Установить(ЭтапПроизводства.Изделие);
			НЗ.Отбор.Назначение.Установить(ЭтапПроизводства.Назначение);
			НЗ.Прочитать();
			Для Каждого СтрНЗ из НЗ Цикл 
				СтрНЗ.ИзделиеВыпущено = Истина;
			КонецЦикла; 
			Попытка
				НЗ.Записать(); 
			Исключение
				Сообщить("Ошибка при установке признака Изделие выпущено! Данные о выполнении операции не записаны!");
				ОтменитьТранзакцию();
			КонецПопытки;  
			
		КонецЦикла; 

	КонецЕсли;      
	
	ЗафиксироватьТранзакцию();
	Возврат Истина; 
	
КонецФункции

&НаСервере
Функция ОтменитьВыполнениеОперацииНаСервере(ИмяОперации, СтруктураОтбораПартии, ПоВсемОперациям);
	
	ПараметрыОтбора = Новый Структура("ДатаВыпускаПлановая,Изделие,Назначение");
	ЗаполнитьЗначенияСвойств(ПараметрыОтбора,СтруктураОтбораПартии); 
	ТабПлан = ТабПланПроизводства.Выгрузить(ПараметрыОтбора,"ЭтапПроизводства");
	ТабПлан.Свернуть("ЭтапПроизводства");
	МассивЭтапов = ТабПлан.ВыгрузитьКолонку("ЭтапПроизводства");    
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
						|	ТТМ_ИсполнениеТехПроцесса.ЭтапПроизводства КАК ЭтапПроизводства,
						|	ТТМ_ИсполнениеТехПроцесса.Изделие КАК Изделие,
						|	ТТМ_ИсполнениеТехПроцесса.Назначение КАК Назначение,
						|	ТТМ_ИсполнениеТехПроцесса.ТехОперация КАК ТехОперация,
						|	ТТМ_ИсполнениеТехПроцесса.ВидРабочегоЦентра КАК ВидРабочегоЦентра,
						|	ТТМ_ИсполнениеТехПроцесса.РабочийЦентр КАК РабочийЦентр,
						|	ТТМ_ИсполнениеТехПроцесса.ДатаНачала КАК ДатаНачала,
						|	ТТМ_ИсполнениеТехПроцесса.ДатаОкончания КАК ДатаОкончания,
						|	ТТМ_ИсполнениеТехПроцесса.ВремаОперацииПоСпецификацииВСекундах КАК ВремаОперацииПоСпецификацииВСекундах,
						|	ТТМ_ИсполнениеТехПроцесса.ВремаОперацииФактическоеВСекундах КАК ВремаОперацииФактическоеВСекундах,
						|	ТТМ_ИсполнениеТехПроцесса.Исполнитель КАК Исполнитель,
						|	ТТМ_ИсполнениеТехПроцесса.Ответственный КАК Ответственный
						|ИЗ
						|	РегистрСведений.ТТМ_ИсполнениеТехПроцесса КАК ТТМ_ИсполнениеТехПроцесса
						|ГДЕ
						|	ТТМ_ИсполнениеТехПроцесса.ЭтапПроизводства В (&МассивЭтапов)
						|	И ВЫБОР
						|			КОГДА &ПоВсемОперациям = 1
						|				ТОГДА ТТМ_ИсполнениеТехПроцесса.ВидРабочегоЦентра.Наименование ПОДОБНО ""%""
						|			ИНАЧЕ ТТМ_ИсполнениеТехПроцесса.ВидРабочегоЦентра.Наименование ПОДОБНО &ИмяОперации
						|		КОНЕЦ";
	Запрос.УстановитьПараметр("ИмяОперации",ИмяОперации);
	Запрос.УстановитьПараметр("МассивЭтапов",МассивЭтапов);
	Запрос.УстановитьПараметр("ПоВсемОперациям",ПоВсемОперациям);
	//Выборка = Запрос.Выполнить().Выбрать();
	ТабВРЦ = Запрос.Выполнить().Выгрузить();
	ТабВРЦ.Свернуть("ВидРабочегоЦентра");
	
	Попытка
		//Пока Выборка.Следующий() Цикл 
		Для Каждого ЭтапПроизводства из МассивЭтапов Цикл 
			НЗ = РегистрыСведений.ТТМ_ИсполнениеТехПроцесса.СоздатьНаборЗаписей();
			НЗ.Отбор.ЭтапПроизводства.Установить(ЭтапПроизводства);  
			НЗ.Прочитать(); 
			Если НЗ.Количество() <> 0 Тогда 
				ИзделиеВыпущено = НЗ[0].ИзделиеВыпущено;
			Иначе 
				ИзделиеВыпущено = Ложь;
			КонецЕсли;
			
			Если ИзделиеВыпущено Тогда //установим признак Изделие выпущено = ЛОЖЬ для всех операций этапа
				Для Каждого СтрНЗ из НЗ Цикл 
					СтрНЗ.ИзделиеВыпущено = Ложь;
				КонецЦикла;
			КонецЕсли; 
			НЗ.Записать();
			Если не ПоВсемОперациям Тогда 
				НЗ.Отбор.ВидРабочегоЦентра.Установить(ТабВРЦ[0].ВидРабочегоЦентра); 
			КонецЕсли;   
			НЗ.Прочитать();
			НЗ.Очистить();
			НЗ.Записать();    
			//Если ИзделиеВыпущено и не ПоВсемОперациям Тогда 
			//	Для Каждого СтрЭтап из МассивЭтапов Цикл 
			//		НЗ.Отбор.Сбросить();
			//		НЗ.Отбор.ЭтапПроизводства.Установить(СтрЭтап);
			//		НЗ.Прочитать();
			//		Для Каждого СтрНЗ из НЗ Цикл 
			//			СтрНЗ.ИзделиеВыпущено = Ложь;
			//		КонецЦикла; 
			//		НЗ.Записать();
			//	КонецЦикла;  
			//КонецЕсли;
		КонецЦикла; 
		Возврат Истина;
	Исключение      
		Если ПоВсемОперациям = 1 Тогда 
			ТекстСообщения = "Не удалось отменить выполнение операций!";
		Иначе 
			ТекстСообщения = "Не удалось отменить выполнение операции!";
		КонецЕсли;
		Сообщить(ТекстСообщения + Символы.ПС + ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

&НаСервере
Функция ПолучитьТекстЗапросаОперацийПоЭатпам() 
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗЛИЧНЫЕ
|	ЕСТЬNULL(ТехнологическиеОперации.Ссылка, ЗНАЧЕНИЕ(Справочник.ТехнологическиеОперации.ПустаяСсылка)) КАК ТехОперация,
|	ЕСТЬNULL(ТехнологическиеОперации.РабочийЦентр, ЗНАЧЕНИЕ(Справочник.РабочиеЦентры.ПустаяСсылка)) КАК РабочийЦентр,
|	ЕСТЬNULL(ТехнологическиеОперации.РабочийЦентр, ЗНАЧЕНИЕ(Справочник.РабочиеЦентры.ПустаяСсылка)) КАК Исполнитель,
|	ВЫБОР
|		КОГДА ТИПЗНАЧЕНИЯ(ЕСТЬNULL(ТехнологическиеОперации.РабочийЦентр, ЗНАЧЕНИЕ(справочник.ВидыРабочихЦентров.ПустаяСсылка))) = ТИП(Справочник.ВидыРабочихЦентров)
|			ТОГДА ЕСТЬNULL(ТехнологическиеОперации.РабочийЦентр, ЗНАЧЕНИЕ(Справочник.ВидыРабочихЦентров.ПустаяСсылка))
|		ИНАЧЕ ЕСТЬNULL(ТехнологическиеОперации.РабочийЦентр.ВидРабочегоЦентра, ЗНАЧЕНИЕ(Справочник.ВидыРабочихЦентров.ПустаяСсылка))
|	КОНЕЦ КАК ВидРабочегоЦентра,
|	&Ответственный КАК Ответственный,
|	&ТекущаяДата КАК ДатаНачала,
|	&ТекущаяДата КАК ДатаОкончания,
|	0 КАК ВремаОперацииПоСпецификацииВСекундах,
|	0 КАК ВремяОперацииФактическоеВСекундах,
|	ЕСТЬNULL(ТехнологическиеОперации.ВремяШтучное, 0) КАК ВремяШтучное,
|	ЕСТЬNULL(ТехнологическиеОперации.ВремяШтучноеЕдИзм, ЗНАЧЕНИЕ(перечисление.ЕдиницыИзмеренияВремени.ПустаяСсылка)) КАК ВремяШтучноеЕдИзм
|ПОМЕСТИТЬ ТехОперацииПоСпецификациямЭтапов
|ИЗ
|	Справочник.ТехнологическиеОперации КАК ТехнологическиеОперации
|ГДЕ
|	НЕ ЕСТЬNULL(ТехнологическиеОперации.ПометкаУдаления, ЛОЖЬ)
|	И ТехнологическиеОперации.Спецификация В(&МассивСпецификаций)
|;
|
|////////////////////////////////////////////////////////////////////////////////
|ВЫБРАТЬ РАЗЛИЧНЫЕ
|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЕСТЬNULL(ТехнологическиеОперации.Ссылка, ЗНАЧЕНИЕ(Справочник.ТехнологическиеОперации.ПустаяСсылка))) КАК КоличествоОпераций,
|	ТехнологическиеОперации.Спецификация КАК Спецификация
|ПОМЕСТИТЬ КоличествоОперацийПоСпецификации
|ИЗ
|	Справочник.ТехнологическиеОперации КАК ТехнологическиеОперации
|ГДЕ
|	НЕ ЕСТЬNULL(ТехнологическиеОперации.ПометкаУдаления, ЛОЖЬ)
|	И ТехнологическиеОперации.Спецификация В(&МассивСпецификаций)
|
|СГРУППИРОВАТЬ ПО
|	ТехнологическиеОперации.Спецификация
|;
|
|////////////////////////////////////////////////////////////////////////////////
|ВЫБРАТЬ РАЗЛИЧНЫЕ
|	ЕСТЬNULL(ЭтапПроизводства2_2ВыходныеИзделия.Ссылка, ЗНАЧЕНИЕ(Документ.ЭтапПРоизводства2_2.ПустаяСсылка)) КАК ЭтапПроизводства,
|	ЕСТЬNULL(ЭтапПроизводства2_2ВыходныеИзделия.Номенклатура, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяССылка)) КАК Изделие,
|	ЕСТЬNULL(ЭтапПроизводства2_2ВыходныеИзделия.Назначение, ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка)) КАК Назначение,
|	ЕСТЬNULL(ТехОперацииПоСпецификациямЭтапов.ТехОперация, ЗНАЧЕНИЕ(Справочник.ТехнологическиеОперации.ПустаяСсылка)) КАК ТехОперация,
|	ЕСТЬNULL(ТехОперацииПоСпецификациямЭтапов.РабочийЦентр, ЗНАЧЕНИЕ(Справочник.РабочиеЦентры.ПустаяСсылка)) КАК РабочийЦентр,
