	               |	ВТ_ИтоговыеДанные.Изделие,
	               |	ВТ_ИтоговыеДанные.Спецификация"; 
	
	 Запрос.УстановитьПараметр("ВыгруженныеДанные", ВыгруженнаяТаблицаПлана);
	 Запрос.УстановитьПараметр("ДопСвойствоЭтапа", ДопСвойствоИсполнительЭтапа);
	 
	 Выборка = Запрос.Выполнить().Выбрать();
	 
	 Пока Выборка.Следующий() Цикл
		 
		 Для Каждого СтрокаВерхнегоУровня Из ВерхниеСтрокиДерева Цикл
			 ПодчиненныеСтроки = СтрокаВерхнегоУровня.ПолучитьЭлементы();
		 
			 Для Каждого СтрокаНижнегоУровня Из ПодчиненныеСтроки Цикл
				 Если Выборка.Назначение = СтрокаНижнегоУровня.Назначение
					 И Выборка.Изделие = СтрокаНижнегоУровня.Изделие
					 И Выборка.Спецификация = СтрокаНижнегоУровня.Спецификация Тогда
					 
					 СтрокаНижнегоУровня.Исполнитель = Выборка.Исполнитель;	 
				КонецЕсли;
			 КонецЦикла;
	 	КонецЦикла;
		 
	 КонецЦикла;
	 
КонецПроцедуры

#КонецОбласти

