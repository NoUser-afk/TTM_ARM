&НаСервере
Процедура ДобавитьЭлементКолонкиДерева(ЗаголовокКолонки, ТипКолонки, РодительскийЭлемент, ВидПоля, ШиринаКолонки = 0, ДобавитьДействие = 0)
	
	ИмяКолонки = СтрЗаменить(ЗаголовокКолонки," ","");
	ЭлементКол = Элементы.Добавить(ИмяКолонки,ТипКолонки,РодительскийЭлемент);
	ЭлементКол.ПутьКДанным = РодительскийЭлемент.Имя + "." + ИмяКолонки;
	ЭлементКол.Вид = ВидПоля;                                    
	ЭлементКол.Заголовок = ЗаголовокКолонки;  
	ЭлементКол.ТолькоПросмотр = Истина;  
	Если ВидПоля = ВидПоляФормы.ПолеФлажка Тогда 
		ЭлементКол.ШиринаЭлемента = ШиринаКолонки;
		//ЭлементКол.ТриСостояния = Истина;
	Иначе 
		ЭлементКол.Ширина = ШиринаКолонки; 
	КонецЕсли;
	
	Если ДобавитьДействие = 1 Тогда 
		ЭлементКол.УстановитьДействие("ПриИзменении","ВыполнениеОперации");
	ИначеЕсли ДобавитьДействие = 2 Тогда 
		ЭлементКол.УстановитьДействие("ПриИзменении","ИзменитьПлановуюДатуВыпускаВЭтапах");
	КонецЕсли;
	
	Если ЭлементКол.Имя = "Назначение" Тогда 
		ЭлементКол.Видимость = Ложь;
	КонецЕсли;   
	
	Если ЭлементКол.Имя = "Упак" Тогда 
		ЭлементКол.Видимость = Ложь;
	КонецЕсли;
	
	Если ЭлементКол.Имя = "Исполнитель" Тогда 

		СписокСборочныхБригад = ПолучитьСписокСборочныхБригад();   
		ЭлементКол.ИсторияВыбораПриВводе = ИсторияВыбораПриВводе.НеИспользовать;
		ЭлементКол.СписокВыбора.ЗагрузитьЗначения(СписокСборочныхБригад);  
		ЭлементКол.ТолькоПросмотр = Ложь; 
		ЭлементКол.УстановитьДействие("ПриИзменении", "ДеревоВыпускаИсполнительПриИзменении");
		
	КонецЕсли; 
	
	Если  ЭлементКол.Имя = "Комментарий" Тогда 
		  
		ЭлементКол.ТолькоПросмотр = Ложь; 
		ЭлементКол.УстановитьДействие("ПриИзменении", "ДеревоВыпускаКомментарийПриИзменении");
		
	КонецЕсли; 
	
	Если ЭлементКол.Имя = "Датавыпускаплановая" Тогда 
		ЭлементКол.ТолькоПросмотр = Ложь;
		ЭлементКол.УстановитьДействие("ПриИзменении", "ИзменитьПлановуюДатуВыпускаВЭтапах");
	КонецЕсли;
	
	Если ВидПоля = ВидПоляФормы.ПолеФлажка Тогда 
		ЭлементКол.ТолькоПросмотр = Ложь;	
	КонецЕсли;
	
КонецПроцедуры       

&НаСервере
Функция ПолучитьСписокСборочныхБригад()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	РабочиеЦентры.Ссылка КАК РабочийЦентр
	               |ИЗ
	               |	Справочник.РабочиеЦентры КАК РабочиеЦентры
	               |ГДЕ
	               |	РабочиеЦентры.ВидРабочегоЦентра.Наименование = ""Сборка""";
	МассивРЦ = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("РабочийЦентр");
	
	Возврат МассивРЦ;
	
КонецФункции

