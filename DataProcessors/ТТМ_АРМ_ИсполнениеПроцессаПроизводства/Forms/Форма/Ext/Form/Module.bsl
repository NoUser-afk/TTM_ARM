&НаКлиенте
Процедура ВыполнениеОперацииПродолжение(Элемент)  
	
	ТекСтрока = Элементы.ДеревоВыпуска.ТекущиеДанные; 
	ТекСтрокаСтруктура = ПолучитьСтруктуруТекущейСтроки();
	ЗаполнитьЗначенияСвойств(ТекСтрокаСтруктура,ТекСтрока);
	СтруктураОтбораПартии = Элементы.ТабПланПроизводства.ОтборСтрок;
	ИмяОперации = Элемент.Имя;
	
	
	//++Дарвин А.А. 03.07.2024
	ТекущаяКоманда = "ОтменаИПодтверждениеОпераций";
	ОчиститьСообщения();
	//Дарвин А.А.
	
	Если Элемент.Родитель.ТекущиеДанные[Элемент.Имя] Тогда 
		ЭтоВыполнениеОпераций = Истина;
	Иначе // отмена выполнения операций
		ЭтоВыполнениеОпераций = Ложь; 
	КонецЕсли;
	Если Врег(ИмяОперации) = Врег("ИзделиеВыпущено") Тогда   //ВыполнитьВсеОперации
		ПоВсемОперациям = 1
	Иначе 
		ПоВсемОперациям = 0;
	КонецЕсли;
	Если ЭтоВыполнениеОпераций и (СтрНайти(ВРЕГ(ИмяОперации),ВРег("Сборка")) > 0 или ПоВсемОперациям = 1) Тогда  
		Если не ЗначениеЗаполнено(ТекСтрока.Исполнитель) Тогда 
			ТекСтрока[ИмяОперации] = не ТекСтрока[ИмяОперации];
			Сообщить("Укажите исполнителя операции для данной партии!" + Символы.ПС + "Данные не записаны");
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	//++Дарвин А.А. 03.07.2024		
	Если Элемент.Родитель.ТекущиеДанные[Элемент.Имя] = Ложь Тогда
		//ЗаписиОбновлены = ВыполнениеОперацииНаСервере(ТекСтрокаСтруктура, ИмяОперации, СтруктураОтбораПартии, ВыполнитьВсеОперации, Истина);		
		Если ПоВсемОперациям = 1 Тогда           
			ТекстВопроса = "Вы действительно хотите очистить историю выполнения операций по партии?";
		Иначе 
			ТекстВопроса = "Вы действительно хотите удалить историю выполнения операции по партии?";
		КонецЕсли;
		ДопПараметры = ТекСтрокаСтруктура;       
		ДопПараметры.Вставить("ПоВсемОперациям",ПоВсемОперациям);
		ДопПараметры.Вставить("ИмяОперации",ИмяОперации);
		ОповещениеОбУдаленииВсехОперацийПоПартии = Новый ОписаниеОповещения("УдалениеОперацийПоПартииПродолжение", ЭтаФорма, ДопПараметры);
		ПоказатьВопрос(ОповещениеОбУдаленииВсехОперацийПоПартии,ТекстВопроса,РежимДиалогаВопрос.ДаНет);
	Иначе   
		ЗаписиОбновлены = ВыполнениеОперацииНаСервере(ТекСтрокаСтруктура, ИмяОперации, СтруктураОтбораПартии, ПоВсемОперациям);  		
		//Установить галочки по всем операциям
		
		Если ЗаписиОбновлены Тогда  
			СнятьУстановитьОтметкуВыполненияОперации(ПоВсемОперациям, ИмяОперации, Истина);
		Иначе 
			ТекСтрока[ИмяОперации] = не ТекСтрока[ИмяОперации];
		КонецЕсли;
		
		//ОбновитьДанныеПланаПроизводства(Объект.ПроизводственноеПодразделение);
		//РазвернутьСвернутьПодчиненныеСтрокиДерева("РазвернутьСтрокиДереваВыпуска");
	КонецЕсли;
	
	//Если Не ЗаписиОбновлены Тогда 
	//	Элемент.Родитель.ТекущиеДанные[Элемент.Имя] = Ложь;
	//	Возврат;
	//КонецЕсли; 
		
	//СформироватьОповещениеДляПользователя(ТекущаяКоманда);
	//Дарвин А.А.
КонецПроцедуры

