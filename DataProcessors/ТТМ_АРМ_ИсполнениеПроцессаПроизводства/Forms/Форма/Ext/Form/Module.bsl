#Область ОформлениеВыпуска

&НаКлиенте
Процедура ОформитьВыпуск(Команда)
	
	ТекСтрока = Элементы.ДеревоВыпуска.ТекущиеДанные;
	Если не ЗначениеЗаполнено(ТекСтрока.Изделие) Тогда
		Сообщить("не выбрана партия выпуска!");
		Возврат;
	КонецЕсли;
	
	Если не ЗначениеЗаполнено(ТекСтрока.Исполнитель) Тогда 
		Сообщить("Невозможно оформить выпуск партии, не выбран Исполнитель");
		Возврат;
	КонецЕсли;  
	
	КоличествоОперацийСпецификации = ПроверитьОперацииПоСпецификации(ТекСтрока.Спецификация);
	Если не ЗначениеЗаполнено(Объект.ШаблонТехПроцесса) и КоличествоОперацийСпецификации = 0 Тогда 
		Сообщить("В спецификации отсутствуют операции и шаблон тех. процесса не заполнен!");
		Возврат;
	КонецЕсли;
	
	Если Команда.Действие = "ОформитьВыпуск" Тогда
		ТекстВопроса = НСтр("ru = 'Сформировать выпуск по партии?'");
		ЗаголовокВопроса = НСтр("ru = 'Формирование выпуска'");
	КонецЕсли;                   
	
	ДопПараметры = Новый Структура("Команда, ЗаполнитьОперацииСпецификации", Команда, КоличествоОперацийСпецификации = 0);
	
	
	
	Оповещение = Новый ОписаниеОповещения("ПослеВопроса", ЭтотОбъект, ДопПараметры);     
    ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 0,, ЗаголовокВопроса);
		
КонецПроцедуры  

&НаСервере
Функция ПроверитьОперацииПоСпецификации(Спецификация)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТехнологическиеОперации.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.ТехнологическиеОперации КАК ТехнологическиеОперации
	               |ГДЕ
	               |	ТехнологическиеОперации.Владелец = &Владелец
	               |	И НЕ ТехнологическиеОперации.ПометкаУдаления"; 
	
	ЭтапСпецификации = ПолучитьЭтапСпецификации(Спецификация); 
	
	Если ЭтапСпецификации = Неопределено Тогда 
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Владелец", ЭтапСпецификации);
	КоличествоОперацийСпецификации = Запрос.Выполнить().Выгрузить().Количество(); 
	Если не ЗначениеЗаполнено(КоличествоОперацийСпецификации) Тогда 
		КоличествоОперацийСпецификации =0;
	КонецЕсли;
	
	Возврат КоличествоОперацийСпецификации;
	
КонецФункции

&НаСервере
Функция ПолучитьЭтапСпецификации(Спецификация)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЭтапыПроизводства.Ссылка КАК ЭтапСпецификации
	               |ИЗ
	               |	Справочник.ЭтапыПроизводства КАК ЭтапыПроизводства
	               |ГДЕ
	               |	ЭтапыПроизводства.Владелец = &Спецификация";
	Запрос.УстановитьПараметр("Спецификация",Спецификация);
	ТабЭтап = Запрос.Выполнить().Выгрузить();
	Если ТабЭтап.Количество() > 1 Тогда 
		Сообщить("Не удалось однозначно определить Этап производства по спецификации " + Спецификация);
		Возврат Неопределено;
	Иначе 
		Возврат ТабЭтап[0].ЭтапСпецификации;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ПослеВопроса(Результат,ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда 
		Сообщить("");
		Возврат;
	КонецЕсли;
	
	ТекущееДействиеКоманды = ДополнительныеПараметры.Команда.Действие;
	РезультатВыполнения = Ложь; 
		
	Если ТекущееДействиеКоманды = "ОформитьВыпуск" Тогда
		
		ТекСтрока = Элементы.ДеревоВыпуска.ТекущиеДанные; 
		ТекСтрокаСтруктура = ПолучитьСтруктуруТекущейСтроки();
		ЗаполнитьЗначенияСвойств(ТекСтрокаСтруктура,ТекСтрока);
		
		Если ДополнительныеПараметры.ЗаполнитьОперацииСпецификации Тогда 
			//Заполнить
			ОперацииЗаполнены = ЗаполнениеОперацийНаСервере(ТекСтрокаСтруктура.Спецификация, Объект.ШаблонТехПроцесса);
		КонецЕсли;
		
		СтруктураОтбораПартии = Новый Структура("ДатаВыпускаПлановая, Изделие, Назначение");
		ЗаполнитьЗначенияСвойств(СтруктураОтбораПартии,Элементы.ТабПланПроизводства.ОтборСтрок);
		
		////////////////////////////////////////////////////////////////////////
		ЗапроситьРазрешениеНаУстановкуПривилегированногоРежима();
	
		Оповещение = Новый ОписаниеОповещения("ПослеПредоставленияРазрешения",ЭтаФорма);
		МассивИДРазрешений = ПолучитьМассивИдентификаторовРазрешений(СписокИДЗапросовРазрешений);
		РаботаВБезопасномРежимеКлиент.ПрименитьЗапросыНаИспользованиеВнешнихРесурсов(МассивИДРазрешений, ЭтаФорма, Оповещение);
		
		ЗаполнитьРеквизитыРФ_УстановитьПривилегированныйРежим(Истина);
		////////////////////////////////////////////////////////////////////////
		
		СтруктураВозврата = ОформитьВыпускНаСервере(СтруктураОтбораПартии, ТекСтрокаСтруктура);       
		
		////////////////////////////////////////////////////////////////////////
		ЗаполнитьРеквизитыРФ_УстановитьПривилегированныйРежим(Ложь);
		////////////////////////////////////////////////////////////////////////
		
		Если не СтруктураВозврата.ВыпускСформирован и СтруктураВозврата.Свойство("СтруктураОтбораПартии") Тогда 
			//Заказ клиента закрыт, можно пометить этапы производства на удаление
			Оповещение  = Новый ОписаниеОповещения("УдалениеЛишнихЭтапов",ЭтотОбъект,СтруктураОтбораПартии);
			ПоказатьВопрос(Оповещение,"Заказ клиента закрыт, пометить Этапы партии на удаление?",РежимДиалогаВопрос.ДаНет);
		КонецЕсли;
		
		Если СтруктураВозврата.ВыпускСформирован Тогда
			ОбновитьДанныеПланаПроизводства(Объект.ПроизводственноеПодразделение, СтруктураОтбораПартии);
			РазвернутьСвернутьПодчиненныеСтрокиДерева("РазвернутьСтрокиДереваВыпуска");
			ОповеститьПользователя(ТекущееДействиеКоманды);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры        

