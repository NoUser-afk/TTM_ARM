	ЗаписьОбновлена = ЗаписатьКоммментарий(ВыбраннаяСтрока.Комментарий, ЭтапыДляОбработки);	
		
	Если Не ЗаписьОбновлена Тогда
		ВыбраннаяСтрока.Комментарий = ИсполнительПередИзменением;
		Возврат;
	КонецЕсли;
	
	//СформироватьОповещениеДляПользователя(ТекущаяКоманда);
	
КонецПроцедуры  

&НаСервереБезКонтекста
Функция ЗаписатьИсполниетляВДопСвойстваЭтапов(Исполнитель, МассивЭтапов)
	                                                                                                               
	//ДопСвойствоИсполнительЭтапа = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("Имя","ОтветственныйСотрудник_cd8e5a889b84479689186f49871bc700"); //Test_Lena
	ДопСвойствоИсполнительЭтапа = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("Имя","ОтветственныйСотрудник_62538974ec0a491d811c29d4c48914c6"); //Рабочая
	
	Если ДопСвойствоИсполнительЭтапа.Пустая() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не найден дополнительный реквизит ''Исполнитель тех. процесса'' '"));
		Возврат Ложь;
	КонецЕсли;                
	
	РЦ = Справочники.РабочиеЦентры.НайтиПоНаименованию(Исполнитель);
	ФЛИсполнитель = ПолучитьИсполнителляРЦ(РЦ);
	
	Если ФЛИсполнитель = Неопределено Тогда 
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не задан ответственный исполнитель для рабочего центра " + Исполнитель +"! '") + ОписаниеОшибки());
		Возврат Ложь;
		
	КонецЕсли;
	
	Для Каждого ЭтапПроизводства Из МассивЭтапов Цикл    
		
		ВладелецСвойств = ЭтапПроизводства;
		ЗаписьОбновлена = Ложь;     
		
		НачатьТранзакцию();
		
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ДополнительныеСведения");
		ЭлементБлокировки.УстановитьЗначение("Объект", ВладелецСвойств);
		ЭлементБлокировки.УстановитьЗначение("Свойство", ДопСвойствоИсполнительЭтапа);
		Блокировка.Заблокировать();
		
		МенеджерЗаписи = РегистрыСведений.ДополнительныеСведения.СоздатьМенеджерЗаписи();
		
		МенеджерЗаписи.Объект = ВладелецСвойств;
		МенеджерЗаписи.Свойство = ДопСвойствоИсполнительЭтапа;
		МенеджерЗаписи.Значение = ФЛИсполнитель;
		
		Попытка
			МенеджерЗаписи.Записать(Истина);   
			//ЗаписьОбновлена = Истина;
			
			//ЗафиксироватьТранзакцию();
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Ошибка во время записи доп. сведений для этапов: '") + ОписаниеОшибки());
			ЗаписатьРезультатыОшибокВЖурналРегистрации();
			
			ОтменитьТранзакцию();
		КонецПопытки;  
		
		//проверить записи в регистре ТТМ_Исполнение тех. процесса
		//НЗ1 = РегистрыСведений.ABCXYZКлассификацияКлиентов.СоздатьНаборЗаписей();
		НЗ = РегистрыСведений.ТТМ_ИсполнениеТехПроцесса.СоздатьНаборЗаписей();
		НЗ.Отбор.ЭтапПроизводства.Установить(ЭтапПроизводства); 
		ВРЦ_Сборка = Справочники.ВидыРабочихЦентров.НайтиПоНаименованию("Сборка"); 
		Если не ВРЦ_Сборка = Неопределено Тогда  
			НЗ.Отбор.ВидРабочегоЦентра.Установить(ВРЦ_Сборка);
			НЗ.Прочитать();     
			
			//РЦ = Справочники.РабочиеЦентры.НайтиПоНаименованию(Исполнитель);
			Если не РЦ = Неопределено Тогда 
				Для Каждого СтрНЗ из НЗ Цикл 
					Если СтрНЗ.Исполнитель <> РЦ или СтрНЗ.ОтветственыйИсполнитель <> ФЛИсполнитель Тогда 
						СтрНЗ.Исполнитель = РЦ;
						СтрНЗ.ОтветственыйИсполнитель = ФЛИсполнитель;
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Исполнитель по Этапу изменен: " + ЭтапПроизводства +": '") + ОписаниеОшибки());
					КонецЕсли;
				КонецЦикла;  
			Иначе 
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не найден рабочий центр "+ Исполнитель +": '") + ОписаниеОшибки());
				ЗаписатьРезультатыОшибокВЖурналРегистрации();
				ОтменитьТранзакцию();
			КонецЕсли;
		Иначе 
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не найден вид рабочего центра ""сборка"": '") + ОписаниеОшибки());
			ЗаписатьРезультатыОшибокВЖурналРегистрации();
			ОтменитьТранзакцию();
		КонецЕсли;
		
		Попытка
			НЗ.Записать();
			ЗафиксироватьТранзакцию();
			ЗаписьОбновлена = Истина;
		Исключение     
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Ошибка при записи исполниетля в регистр сведений: '") + ОписаниеОшибки());
			ЗаписатьРезультатыОшибокВЖурналРегистрации();
			ОтменитьТранзакцию();
		КонецПопытки;
	КонецЦикла;
	
	Возврат ЗаписьОбновлена;
	
КонецФункции

&НаСервереБезКонтекста
Функция ЗаписатьКоммментарий(Комментарий, МассивЭтапов)
	
	//ДопСвойствоКомментарийЭтапа = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("Имя","ТТМКомментарийКЭтапу_b08d8ab178a947f4a2fe40f66f6d146d");  //Test_Lena
	ДопСвойствоКомментарийЭтапа = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("Имя","ТТМКомментарийКЭтапу_53d161b8457f4c33972f8c3f5f7fc5d1");  //Рабочая
	
	Если ДопСвойствоКомментарийЭтапа.Пустая() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не найден дополнительный реквизит ''Комментарий'' '"));
		Возврат Ложь;
	КонецЕсли;     
	
	
	
	Для Каждого ЭтапПроизводства из МассивЭтапов Цикл 
		
		ВладелецСвойств = ЭтапПроизводства;
		ЗаписьОбновлена = Ложь;     
		
		НачатьТранзакцию();
		
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ДополнительныеСведения");
		ЭлементБлокировки.УстановитьЗначение("Объект", ВладелецСвойств);
		ЭлементБлокировки.УстановитьЗначение("Свойство", ДопСвойствоКомментарийЭтапа);
		Блокировка.Заблокировать();
		
		МенеджерЗаписи = РегистрыСведений.ДополнительныеСведения.СоздатьМенеджерЗаписи();
		
		МенеджерЗаписи.Объект = ВладелецСвойств;
		МенеджерЗаписи.Свойство = ДопСвойствоКомментарийЭтапа;
		МенеджерЗаписи.Значение = Комментарий;
		
		Попытка
			МенеджерЗаписи.Записать(Истина);   
			//ЗаписьОбновлена = Истина;
			//ЗафиксироватьТранзакцию();
			//Возврат ЗаписьОбновлена;
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Ошибка при записи доп. сведения Комментарий для этапов: '") + ОписаниеОшибки());
			ЗаписатьРезультатыОшибокВЖурналРегистрации();
			ЗаписьОбновлена = Ложь;
			ОтменитьТранзакцию();    
			Возврат ЗаписьОбновлена;
			
		КонецПопытки;  
		
		НЗ = РегистрыСведений.ТТМ_ИсполнениеТехПроцесса.СоздатьНаборЗаписей();
		НЗ.Отбор.ЭтапПроизводства.Установить(ЭтапПроизводства);
		НЗ.Прочитать();
	
		Для Каждого СтрНЗ из НЗ Цикл 
			СтрНЗ.Комментарий = Комментарий;
		КонецЦикла;
		
		Попытка
			НЗ.Записать();
			ЗаписьОбновлена = Истина;
			ЗафиксироватьТранзакцию();
			//Возврат ЗаписьОбновлена;
		Исключение 
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Ошибка записи комментария в регистр: '") + ОписаниеОшибки());
			ЗаписатьРезультатыОшибокВЖурналРегистрации();
			ЗаписьОбновлена = Ложь;   
			ОтменитьТранзакцию();
			Возврат ЗаписьОбновлена;
		КонецПопытки;
		
	КонецЦикла;  
	Возврат ЗаписьОбновлена;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьИсполнителляРЦ(Исполнитель)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДополнительныеСведения.Объект КАК РЦ,
	               |	ДополнительныеСведения.Свойство КАК Свойство,
	               |	ДополнительныеСведения.Значение КАК ФЛИсполнитель
	               |ИЗ
	               |	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
	               |ГДЕ
	               |	ДополнительныеСведения.Объект = &РЦ
	               |	И ДополнительныеСведения.Свойство = &ДопСвойствоИсполнитель";
	Запрос.УстановитьПараметр("РЦ",Исполнитель);
	//Запрос.УстановитьПараметр("ДопСвойствоИсполнитель", ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("Имя", "ОтветственныйСотрудник_cd8e5a889b84479689186f49871bc700")); //Test_Lena
	Запрос.УстановитьПараметр("ДопСвойствоИсполнитель", ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("Имя", "ОтветственныйСотрудник_62538974ec0a491d811c29d4c48914c6")); //Рабочая
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		Возврат Выборка.ФЛИсполнитель;
	Иначе 
		Возврат Неопределено;
	КонецЕсли;
		
КонецФункции

