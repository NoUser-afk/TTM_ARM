&НаКлиенте
Процедура ДеревоВыпускаИсполнительПриИзменении(Элемент)
			
	ВыбраннаяСтрока = Элементы.ДеревоВыпуска.ТекущиеДанные;
	ТекущаяКоманда = "ПриИзмененииПоляИсполнителя";
	
	Если ВыбраннаяСтрока = Неопределено Или ТабПланПроизводства.Количество() = 0 Тогда 
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ВыбраннаяСтрока.Изделие) Или Не ЗначениеЗаполнено(ВыбраннаяСтрока.НомерЗаказаДР) Тогда
		ВыбраннаяСтрока.Исполнитель = ИсполнительПередИзменением;
		Возврат;
	КонецЕсли;
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("ДатаВыпускаПлановая", ВыбраннаяСтрока.ДатаВыпускаПлановая);
	СтруктураОтбора.Вставить("Назначение", ВыбраннаяСтрока.Назначение);
	СтруктураОтбора.Вставить("Изделие", ВыбраннаяСтрока.Изделие);
	
	МассивНайденныхСтрок = ТабПланПроизводства.НайтиСтроки(СтруктураОтбора);
	
	Если МассивНайденныхСтрок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЭтапыДляОбработки = Новый Массив;
	Для Каждого Стр из МассивНайденныхСтрок Цикл 
		ЭтапыДляОбработки.Добавить(Стр.ЭтапПроизводства);
	КонецЦикла; 
	Если Элемент.СписокВыбора.НайтиПоЗначению(ВыбраннаяСтрока.Исполнитель) = Неопределено Тогда 
		РЦ = ВыбраннаяСтрока.Исполнитель;
	    Элемент.СписокВыбора.Добавить(РЦ,Строка(РЦ));
	КонецЕсли;
	
	ЗаписьОбновлена = ЗаписатьИсполниетляВДопСвойстваЭтапов(ВыбраннаяСтрока.Исполнитель, ЭтапыДляОбработки);	
		
	Если Не ЗаписьОбновлена Тогда
		ВыбраннаяСтрока.Исполнитель = ИсполнительПередИзменением;
		Возврат;
	КонецЕсли;
	
	//СформироватьОповещениеДляПользователя(ТекущаяКоманда);
	
КонецПроцедуры  

