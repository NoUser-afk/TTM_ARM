&НаСервере
функция ОформитьВыпускНаСервере(СтруктураОтбораПартии, ТекСтрокаСтруктура)
	
	СтруктураВозврата = Новый Структура("ВыпускСформирован");
	ВыпускСформирован = Ложь;
	
	ЗаказКлиента = СтруктураОтбораПартии.Назначение.Заказ;
	Если ТипЗнч(ЗаказКлиента) <> Тип("ДокументСсылка.ЗаказКлиента") Или ЗаказКлиента.Проведен = Ложь Тогда 
		Сообщить("Не удалось определить Заказ клиента по Назначению!");
		СтруктураВозврата.ВыпускСформирован = ВыпускСформирован;
		Возврат СтруктураВозврата;
	КонецЕсли;       
	
	ТабЭтапы = ТабПланПроизводства.Выгрузить(СтруктураОтбораПартии,"ЭтапПроизводства,Количество");
	КоличествоВыпуска = ТабЭтапы.Итог("Количество");   
	МассивЭтапов = ТабЭтапы.ВыгрузитьКолонку("ЭтапПроизводства");
	
	Если ЗаказКлиента.Статус = Перечисления.СтатусыЗаказовКлиентов.Закрыт Тогда
		
		Сообщить("Заказ клиента закрыт! Выпуск по нему не требуется!");    
	    СтруктураОтбораПартии.Вставить("МассивЭтапов", МассивЭтапов);
		СтруктураВозврата.ВыпускСформирован = ВыпускСформирован;
		СтруктураВозврата.Вставить("СтруктураОтбораПартии", СтруктураОтбораПартии);
		Возврат СтруктураВозврата;
		
	КонецЕсли;
	
	ИзделиеПоЗаказу = ЗаказКлиента.Товары.Выгрузить(Новый Структура("Номенклатура, ВариантОбеспечения", СтруктураОтбораПартии.Изделие, Перечисления.ВариантыОбеспечения.КОбеспечению));
	КоличествоПоЗаказуКОбеспечению =  ИзделиеПоЗаказу.Итог("Количество");
	
	ИзделиеПоЗаказу = ЗаказКлиента.Товары.Выгрузить(Новый Структура("Номенклатура, ВариантОбеспечения", СтруктураОтбораПартии.Изделие, Перечисления.ВариантыОбеспечения.РезервироватьПоМереПоступления));
	КоличествоПоЗаказуРезервПоМереПоступления =  ИзделиеПоЗаказу.Итог("Количество");	
	
	КоличествоПоЗаказу = КоличествоПоЗаказуКОбеспечению + КоличествоПоЗаказуРезервПоМереПоступления;
	
	/////////////////////////////////////////////////////////////////////////////////////
			
			
	//Если ЗначениеЗаполнено(Элементы.ДеревоВыпуска.ТекущиеДанные.Номенклатура) Тогда 		
	
	Если КоличествоВыпуска > КоличествоПоЗаказу Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Количество выпуска превышает количество по заказу'"));
	Иначе
		//Если Объект.Количество > КоличествоВыпуска Тогда
		//	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Количество выпуска превышает количество в этапах. Обработано '") + Строка(КоличествоВыпуска));
		//КонецЕсли; 
		ИзменитьЭтапы(МассивЭтапов, СтруктураОтбораПартии, КоличествоВыпуска,ТекСтрокаСтруктура);
	КонецЕсли;
		
	//ОбновитьДанныеПланаПроизводства(Объект.ПроизводственноеПодразделение, СтруктураОтбораПартии); 
	ВыпускСформирован = Истина;
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Формирование выпуска завершено'"));		 
	
	Если ВыпускСформирован Тогда 
		//Установим строки Заказа клиента КОтгрузке
		ЗаказОбъект = ЗаказКлиента.ПолучитьОбъект();
		
		//+проверить
		//04.12.2024 закомментитровала
		
		//ПереченьВариантов = Новый Массив();
		//ПереченьВариантов.Добавить(ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.Отгрузить"));  
		//
		//Результат = Новый Структура("ПереченьВариантов, ЗаполнятьЦелымиУпаковками");
		//Результат.ПереченьВариантов = ПереченьВариантов;
		//Результат.ЗаполнятьЦелымиУпаковками = Ложь;
		
		//04.12.2024
		//-проверить
				
		ПараметрыВстраивания = Документы.ЗаказКлиента.ДоступныеОстаткиПараметрыВстраивания();

		МассивДок = Новый Массив();
		МассивДок.Добавить(ЗаказОбъект.Ссылка);
		
		ПараметрыПроцедуры = Новый Структура();
		
		ПараметрыПроцедуры.Вставить("КодДействия", "ДЕЙСТВИЕ_ОТГРУЗИТЬ");
		ПараметрыЗаполнения = Новый Структура();
		ПараметрыЗаполнения.Вставить("СнятьФлагОтгружатьОднойДатой", Истина);  
		ПараметрыЗаполнения.Вставить("ЗаполнитьДатуОтгрузкиОднойДатой", Ложь );
		ПараметрыПроцедуры.Вставить("ПараметрыЗаполнения", ПараметрыЗаполнения);        
		
		ПараметрыПроцедуры.Вставить("Заказы", МассивДок);  
		ПараметрыПроцедуры.Вставить("ПараметрыВстраивания", ПараметрыВстраивания); 
		РезультатВыполненияДействий = ОбеспечениеВДокументахСервер.ВыполнитьДействиеДляЗаказовПослеВопроса(ПараметрыПроцедуры);
			
		Если Не РезультатВыполненияДействий.СписокОшибок.Количество() = 0 Тогда
			Сообщить("Не удалось проставить действике ""Отгрузить"" в строках Заказа клиента: " + ЗаказОбъект);
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Выполнение операции'"), УровеньЖурналаРегистрации.Ошибка,,, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецЕсли;
		
	КонецЕсли;
	
	СтруктураВозврата.ВыпускСформирован = ВыпускСформирован;
	Возврат СтруктураВозврата;

КонецФункции

&НаСервере
Процедура ИзменитьЭтапы(ДокЭтапы, СтруктураОтбораПатии,КоличествоВыпуска,ТекСтрокаСтруктура)
	
	ОсталосьВыпустить = КоличествоВыпуска;
	КОтгрузке = 0;
	
	Для каждого Док из ДокЭтапы Цикл
		
		ДокОбъект = Док.Ссылка.ПолучитьОбъект();
		ДокОбъект.КоличествоУпаковокФакт  = 0.5;
		НайденныеСтроки = ДокОбъект.ВыходныеИзделия.НайтиСтроки(Новый Структура("Номенклатура", СтруктураОтбораПатии.Изделие));
		
		Для Каждого Стр из НайденныеСтроки Цикл
			Если ОсталосьВыпустить >= Стр.Количество Тогда
				Стр.Произведено = Истина;
				Стр.ДатаПроизводства = ТекущаяДатаСеанса(); //СтруктураОтбораПатии.ДатаВыпускаПлановая;
				ОсталосьВыпустить = ОсталосьВыпустить - Стр.Количество;
			Иначе
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		ЭтапОбновлен = Ложь;
		Попытка
			//УстановитьПривилегированныйРежим(Истина); 
			//ДокОбъект = документы.ЭтапПроизводства2_2.СоздатьДокумент();
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
			//УстановитьПривилегированныйРежим(Ложь);
			ЭтапОбновлен = Истина;
		Исключение
			Сообщить("Не удалось изменить документ " + ДокОбъект.Номер + " от " + ДокОбъект.Дата);
			
			// Запись события в журнал регистрации для системного администратора.
	    	ЗаписьЖурналаРегистрации(
				НСтр("ru = 'Выполнение операции'"),
				УровеньЖурналаРегистрации.Ошибка,,, 
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	    	ВызватьИсключение;
		КонецПопытки;
		
		Если ЭтапОбновлен Тогда          
			//ТекСтрока = Элементы.ДеревоВыпуска.ТекущиеДанные; 
			//ТекСтрокаСтруктура = ПолучитьСтруктуруТекущейСтроки();
			//ЗаполнитьЗначенияСвойств(ТекСтрокаСтруктура,ТекСтрока);          
			ВыполнениеОперацииНаСервере(ТекСтрокаСтруктура,"ИзделиеВыпущено",СтруктураОтбораПатии,1);
			ПереданоКОтгрузке = СоздатьПередачуПродукцииНаСклад(ДокОбъект);
			//Если ПереданоКОтгрузке > 0 Тогда 
			КОтгрузке = КОтгрузке + ПереданоКОтгрузке;
		КонецЕсли;
		
		Если ОсталосьВыпустить <= 0 Тогда
			Прервать;
		КонецЕсли
	КонецЦикла;
	
КонецПроцедуры    

&НаСервере
Функция СоздатьПередачуПродукцииНаСклад(Этап)
	
	МассивСсылок = Новый Массив();
	МассивСсылок.Добавить(Этап.Ссылка);
	ПараметрыОткрытия = СозданиеНаОснованииУТВызовСервера.ПараметрыОткрытияФормыНакладнойНаОснованииЗаказа(МассивСсылок,
		"ДвижениеПродукцииИМатериалов", ПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.ПередачаПродукцииИзПроизводства"));
	ДанныеЗаполнения = ПараметрыОткрытия.ПараметрыФормы.Основание;
	
	Документ = Документы.ДвижениеПродукцииИМатериалов.СоздатьДокумент();
	Документ.Заполнить(ДанныеЗаполнения);
	Документ.Дата = НачалоДня(ТекущаяДатаСеанса()); //Объект.ДатаВыпуска;
	
	Попытка
		НачатьТранзакцию();
		Документ.Записать(РежимЗаписиДокумента.Проведение);
		ЗафиксироватьТранзакцию();
		
		Возврат Документ.Товары.Итог("Количество");
	Исключение
		ОтменитьТранзакцию();
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("'Ошибка во время проведения документа: '") + Документ + " " + ОписаниеОшибки());
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Выполнение операции'"), УровеньЖурналаРегистрации.Ошибка,,, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
		Возврат 0;
	КонецПопытки;
	
КонецФункции

&НаКлиенте
Процедура УдалениеЛишнихЭтапов(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда 
		Возврат;
	КонецЕсли;    
	УдалитьЭтапыНаСервере(ДополнительныеПараметры);
	
КонецПроцедуры 

&НаСервере
Процедура УдалитьЭтапыНаСервере(ДополнительныеПараметры)
	Для Каждого ЭтапПроизводства из ДополнительныеПараметры.МассивЭтапов Цикл 
		ЭтапОбъект = ЭтапПроизводства.ПолучитьОбъект();
		ЭтапОбъект.Пометкаудаления = Истина;
		Попытка                
			//ЭтапОбъект = Документы.ЭтапПроизводства2_2.СоздатьДокумент();
			ЭтапОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			ОбновитьДанныеПланаПроизводства(Объект.ПроизводственноеПодразделение, Новый Структура);
		Исключение
			Сообщить("Не удалось установить пометку удаления " + ЭтапПроизводства + символы.ПС + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ОповеститьПользователя(ТекущаяКоманда)
	Если ТекущаяКоманда = "Выпуск" Тогда
		ПоказатьОповещениеПользователя(
			НСтр("ru = 'АРМ Выпуск и реализация'"),, 
			НСтр("ru = 'Формирование выпуска завершено'"), 
			БиблиотекаКартинок.Информация, 
			СтатусОповещенияПользователя.Информация
		);
	КонецЕсли;
	
КонецПроцедуры

