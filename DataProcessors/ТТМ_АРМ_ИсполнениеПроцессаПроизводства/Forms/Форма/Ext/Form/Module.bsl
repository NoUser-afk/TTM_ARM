
////////////////////////////////////////////////////////////////////
#Область ТТМ_АРМ_ТехпроцессГлобальныеПеременные

&НаКлиенте
Перем ТекСтрокаСтруктура;  

&НаСервере
Перем КОтгрузке;

#КонецОбласти


////////////////////////////////////////////////////////////////////
#Область ТТМ_АРМ_ТехпроцессРаботаСДеревом

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьУсловноеОформление();
	
	Если ЗначениеЗаполнено(Объект.ПроизводственноеПодразделение) Тогда				
		ИмяДерева = "ДеревоВыпуска";
		МассивВРЦ = ПолучитьВидыРабочихЦентров(Объект.ПроизводственноеПодразделение);  
		
		СоздатьРеквизитФормыДеревоВыпуска(ИмяДерева, МассивВРЦ);
		СоздатьЭлементыДереваНаФорме(МассивВРЦ);
	КонецЕсли;    
	Элементы.ОформитьВыпуск.Видимость = РольДоступна("АРМ_Выпуск_Реализация");
	
КонецПроцедуры   

&НаКлиенте
Процедура ПриОткрытии(Отказ, СтандартнаяОбработка)
	
	ПроизводственноеПодразделениеТТМ = ПолучитьСсылкуНаПроизводственноеПодразделениеТТМ();
	
	Если ПроизводственноеПодразделениеТТМ = Неопределено Тогда
		Объект.ПроизводственноеПодразделение = ПредопределенноеЗначение("Справочник.СтруктураПредприятия.ПустаяСсылка");
		Возврат;
	Иначе
		Объект.ПроизводственноеПодразделение = ПроизводственноеПодразделениеТТМ;	
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ПроизводственноеПодразделение) Или Объект.ПроизводственноеПодразделение = Неопределено Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Выберите подразделение'"),, "Объект.ПроизводственноеПодразделение");
		Возврат;
	КонецЕсли;    
	
	ИсполнительПередИзменением = ПредопределенноеЗначение("Справочник.ФизическиеЛица.ПустаяСсылка");
	КомментарийДоИзменения = "";
		
	ОбновитьДанныеПланаПроизводства(Объект.ПроизводственноеПодразделение, Новый Структура);
	РазвернутьСвернутьПодчиненныеСтрокиДерева("РазвернутьСтрокиДереваВыпуска");
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСсылкуНаПроизводственноеПодразделениеТТМ()
	
	ПроизводственноеПодразделениеТТМ = Справочники.СтруктураПредприятия.НайтиПоНаименованию("Производственное подразделение ТТМ");
	
	Если ПроизводственноеПодразделениеТТМ.Пустая() Тогда
		ПроизводственноеПодразделениеТТМ = Неопределено;
	КонецЕсли;
	
	Возврат ПроизводственноеПодразделениеТТМ;
	
КонецФункции

&НаСервере
Функция ПолучитьВидыРабочихЦентров(ПроизводственноеПодразделение)
		
	Запрос = Новый Запрос; 
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВЫБОР
	               |		КОГДА ТИПЗНАЧЕНИЯ(ТехнологическиеОперации.РабочийЦентр) = ТИП(Справочник.РабочиеЦентры)
	               |			ТОГДА ТехнологическиеОперации.РабочийЦентр.ВидРабочегоЦентра
	               |		ИНАЧЕ ТехнологическиеОперации.РабочийЦентр
	               |	КОНЕЦ КАК ВидыРабочихЦентров
	               |ИЗ
	               |	Документ.ЭтапПроизводства2_2 КАК ЭтапПроизводства2_2
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ТехнологическиеОперации КАК ТехнологическиеОперации
	               |		ПО ЭтапПроизводства2_2.Спецификация = ТехнологическиеОперации.Спецификация
	               |ГДЕ
	               |	НЕ ТехнологическиеОперации.ПометкаУдаления
	               |	И ЭтапПроизводства2_2.Проведен
	               |	И ЭтапПроизводства2_2.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЭтаповПроизводства2_2.Начат)
	               |	И ЭтапПроизводства2_2.Подразделение = &Подразделение
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ТехнологическиеОперации.НомерОперации,
	               |	ВЫБОР
	               |		КОГДА ТИПЗНАЧЕНИЯ(ТехнологическиеОперации.РабочийЦентр) = ТИП(Справочник.РабочиеЦентры)
	               |			ТОГДА ТехнологическиеОперации.РабочийЦентр.ВидРабочегоЦентра
	               |		ИНАЧЕ ТехнологическиеОперации.РабочийЦентр
	               |	КОНЕЦ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ТехнологическиеОперации.НомерОперации";
	Запрос.УстановитьПараметр("Подразделение",ПроизводственноеПодразделение);   
	ТЗ_ВРЦ = Запрос.Выполнить().Выгрузить();
	ТЗ_ВРЦ.Свернуть("ВидыРабочихЦентров");                                    
	//СтруктураСтроки = Новый Структура("ВидыРабочихЦентров");
	//МассивСтрокТЗВРЦ = Новый Массив;
	//Для Каждого Стр из ТЗ_ВРЦ Цикл 
	//	ЗаполнитьЗначенияСвойств(СтруктураСтроки,Стр);
	//	МассивСтрокТЗВРЦ.Добавить(СтруктураСтроки);
	//КонецЦикла;
	
	//МассивВидовРабочихЦентров = ТЗ_ВРЦ.ВыгрузитьКолонку("ВидыРабочихЦентров");
	
	
	//ЗначениеВРеквизитФормы(ТЗ_ВРЦ,"ТабВидыРабочихЦентров");
	Возврат ТЗ_ВРЦ.ВыгрузитьКолонку("ВидыРабочихЦентров");
	
КонецФункции  

&НаСервере
Процедура ПолучитьВидыРабочихЦентровВТЗ(ПроизводственноеПодразделение)
		
	Запрос = Новый Запрос; 
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТехнологическиеОперации.РабочийЦентр КАК ВидыРабочихЦентров
	               |ИЗ
	               |	Документ.ЭтапПроизводства2_2 КАК ЭтапПроизводства2_2
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ТехнологическиеОперации КАК ТехнологическиеОперации
	               |		ПО ЭтапПроизводства2_2.Спецификация = ТехнологическиеОперации.Спецификация
	               |ГДЕ
	               |	НЕ ТехнологическиеОперации.ПометкаУдаления
	               |	И ЭтапПроизводства2_2.Проведен
	               |	И ЭтапПроизводства2_2.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЭтаповПроизводства2_2.Начат)
				   |	И ЭтапПроизводства2_2.Подразделение = &Подразделение
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ТехнологическиеОперации.РабочийЦентр,
	               |	ТехнологическиеОперации.НомерОперации
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ТехнологическиеОперации.НомерОперации";
	Запрос.УстановитьПараметр("Подразделение",ПроизводственноеПодразделение);   
	ТЗ_ВРЦ = Запрос.Выполнить().Выгрузить();
	ТЗ_ВРЦ.Свернуть("ВидыРабочихЦентров");                                    
	//СтруктураСтроки = Новый Структура("ВидыРабочихЦентров");
	//МассивСтрокТЗВРЦ = Новый Массив;
	//Для Каждого Стр из ТЗ_ВРЦ Цикл 
	//	ЗаполнитьЗначенияСвойств(СтруктураСтроки,Стр);
	//	МассивСтрокТЗВРЦ.Добавить(СтруктураСтроки);
	//КонецЦикла;
	
	//МассивВидовРабочихЦентров = ТЗ_ВРЦ.ВыгрузитьКолонку("ВидыРабочихЦентров");
	
	
	ЗначениеВРеквизитФормы(ТЗ_ВРЦ,"ТабВидыРабочихЦентров");
	//Возврат ТЗ_ВРЦ;
	
КонецПроцедуры
	
&НаСервере
//БезКонтекста      
Процедура ОбновитьДанныеПланаПроизводства(ПроизводственноеПодразделение, ДополнительныеПараметры)
	
	МассивВРЦ = ПолучитьВидыРабочихЦентров(Объект.ПроизводственноеПодразделение);
	
	ЗапросИсполнениеПлана = Новый Запрос;
	ТекстЗапроса = ПолучитьТекстЗапросаИсполнениеПлана(МассивВРЦ);
	
	ЗапросИсполнениеПлана.Текст = ТекстЗапроса;
	ЗапросИсполнениеПлана.УстановитьПараметр("Подразделение", ПроизводственноеПодразделение);	
	//ЗапросИсполнениеПлана.УстановитьПараметр("ДопСвойствоИсполнитель", ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("Имя","ОтветственныйСотрудник_cd8e5a889b84479689186f49871bc700"));  //Test_erp
	//ЗапросИсполнениеПлана.УстановитьПараметр("ДопСвойствоИсполнитель", ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("Имя","ОтветственныйСотрудник_48e5aa6132c14318829fa01aa2d6db36")); //Test_Lena
	ЗапросИсполнениеПлана.УстановитьПараметр("ДопСвойствоИсполнитель", ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("Имя","ОтветственныйСотрудник_62538974ec0a491d811c29d4c48914c6")); //Раброчая
	
	//ЗапросИсполнениеПлана.УстановитьПараметр("ДопСвойствоКомментарий", ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("Имя","ТТМКомментарийКЭтапу_b08d8ab178a947f4a2fe40f66f6d146d")); //Test_Lena
	ЗапросИсполнениеПлана.УстановитьПараметр("ДопСвойствоКомментарий", ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("Имя","ТТМКомментарийКЭтапу_53d161b8457f4c33972f8c3f5f7fc5d1")); //Рабочая
	//ЗапросИсполнениеПлана.УстановитьПараметр("ИмяКолонки","Технолог");
	
	////////////////////////////////////////////////////////////////////////
	//Отборы   
	
	Если Объект.ОтборПериод.ДатаНачала <> Дата(1, 1, 1) Тогда
		ЗапросИсполнениеПлана.УстановитьПараметр("ОтборДатаНачала", Объект.ОтборПериод.ДатаНачала);
	КонецЕсли;
	
	Если Объект.ОтборПериод.ДатаОкончания <> Дата(1, 1, 1) Тогда 
		ЗапросИсполнениеПлана.УстановитьПараметр("ОтборДатаОкончания", Объект.ОтборПериод.ДатаОкончания);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ОтборНазначение) Тогда 
		ЗапросИсполнениеПлана.УстановитьПараметр("ОтборНазначение", Объект.ОтборНазначение);
	КонецЕсли;     
	
	Если ЗначениеЗаполнено(Объект.ОтборИзделие) Тогда 
		ЗапросИсполнениеПлана.УстановитьПараметр("ОтборИзделие", Объект.ОтборИзделие);
	КонецЕсли;
		
	////////////////////////////////////////////////////////////////////////
	
	РезультатЗапроса = ЗапросИсполнениеПлана.Выполнить(); //ВыполнитьПакет();
	ДЗПланПроизводства = РезультатЗапроса.Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);     
	
	ПроверитьУдалитьРеквизитыФормфы();
	
	ИмяДерева = "ДеревоВыпуска";
	СоздатьРеквизитФормыДеревоВыпуска(ИмяДерева, МассивВРЦ);    
	СоздатьЭлементыДереваНаФорме(МассивВРЦ);
	//ЗаполнитьКодТМДляСтрокПланаВыпуска(ДЗПланПроизводства);
	
	УстановитьУсловноеОформлениеДерева(ДЗПланПроизводства, ИмяДерева);
	
	ЗначениеВРеквизитФормы(ДЗПланПроизводства,"ДеревоВыпуска");    
	
	Если ДополнительныеПараметры.Свойство("СтруктураОтбораПартии") <> Неопределено Тогда 
		УстановитьТекущуюСтрокуДереваВыпуска(ДополнительныеПараметры);	
	КонецЕсли;
	
	///////////////////////////////
	//Заполним таблицу этапов
	
	ТекстЗапросаПлан = ПолучитьТекстЗапросаПланВыпуска();
	ЗапросПлан = Новый Запрос;
	ЗапросПлан.Текст = ТекстЗапросаПлан;
	ЗапросПлан.УстановитьПараметр("Подразделение", ПроизводственноеПодразделение);
	ЗапросПлан.УстановитьПараметр("СвойствоКодТМ",ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("Имя","КодТМ_ТТМ"));
	
	////////////////////////////////////////////////////////////////////////
	//Отборы   
	Если Объект.ОтборПериод.ДатаНачала <> Дата(1, 1, 1) Тогда
		ЗапросПлан.УстановитьПараметр("ОтборДатаНачала", Объект.ОтборПериод.ДатаНачала);
	КонецЕсли;
	Если Объект.ОтборПериод.ДатаОкончания <> Дата(1, 1, 1) Тогда 
		ЗапросПлан.УстановитьПараметр("ОтборДатаОкончания", Объект.ОтборПериод.ДатаОкончания);
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ОтборНазначение) Тогда 
		ЗапросПлан.УстановитьПараметр("ОтборНазначение", Объект.ОтборНазначение);
	КонецЕсли;     
	Если ЗначениеЗаполнено(Объект.ОтборИзделие) Тогда 
		ЗапросПлан.УстановитьПараметр("ОтборИзделие", Объект.ОтборИзделие);
	КонецЕсли;
	////////////////////////////////////////////////////////////////////////
	
	ТабПлан = ЗапросПлан.Выполнить().Выгрузить();
	//ЗаполнитьСерийныеНомераТабПлана(ТабПлан);
	
	ЗначениеВРеквизитФормы(ТабПлан, "ТабПланПроизводства");
	ПолучитьЗначениеРеквизитаДопСведений();
	
КонецПроцедуры   

&НаСервере
Процедура ПроверитьУдалитьРеквизитыФормфы()
	
	МассивРеквизитовФормы = ПолучитьРеквизиты(); //ЭтаФорма.ПолучитьРеквизиты();   
	МассивУдаляемыхРеквизитов = Новый Массив;
	Для Каждого РФ из МассивРеквизитовФормы Цикл 
		Если РФ.Имя = "ДеревоВыпуска" Тогда 
			МассивУдаляемыхРеквизитов.Добавить(РФ.Имя);
			ЭФ = Элементы.Найти("ДеревоВыпуска");  
			Если не ЭФ = Неопределено Тогда 
				Элементы.Удалить(ЭФ);
			КонецЕсли;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	ИзменитьРеквизиты(,МассивУдаляемыхРеквизитов); 
	
		
КонецПроцедуры

&НаСервере
Функция ПолучитьТекстЗапросаИсполнениеПлана(МассивВРЦ) 
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	ДополнительныеСведения.Объект КАК ЭтапПроизводства,
			|	ДополнительныеСведения.Значение КАК Комментарий
			|ПОМЕСТИТЬ КомментарииЭтапов
			|ИЗ
			|	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
			|ГДЕ
			|	ДополнительныеСведения.Объект ССЫЛКА Документ.ЭтапПроизводства2_2
			|	И ДополнительныеСведения.Свойство = &ДопСвойствоКомментарий
			|
			|СГРУППИРОВАТЬ ПО
			|	ДополнительныеСведения.Объект,
			|	ДополнительныеСведения.Значение
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ЭтапПроизводства2_2ВыходныеИзделия.ДатаПроизводства КАК ДатаВыпускаПлановая,
			|	ЭтапПроизводства2_2ВыходныеИзделия.Номенклатура КАК Изделие,
			|	ЭтапПроизводства2_2ВыходныеИзделия.Назначение КАК Назначение,
			|	ЕСТЬNULL(КомментарииЭтапов.Комментарий, """") КАК Комментарий,
			|	СУММА(ЭтапПроизводства2_2ВыходныеИзделия.КоличествоУпаковок) КАК КоличествоУпаковок,
			|	ВЫБОР
			|		КОГДА ЕСТЬNULL(ЭтапПроизводства2_2ВыходныеИзделия.Упаковка, ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
			|			ТОГДА ЭтапПроизводства2_2ВыходныеИзделия.Номенклатура.ЕдиницаИзмерения
			|		ИНАЧЕ ЭтапПроизводства2_2ВыходныеИзделия.Упаковка
			|	КОНЕЦ КАК Упаковка,
			|	СУММА(ЭтапПроизводства2_2ВыходныеИзделия.Количество) КАК Количество,
			|	ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.Спецификация КАК Спецификация
			|ПОМЕСТИТЬ ПланВыпуска
			|ИЗ
			|	Документ.ЭтапПроизводства2_2.ВыходныеИзделия КАК ЭтапПроизводства2_2ВыходныеИзделия
			|		ЛЕВОЕ СОЕДИНЕНИЕ КомментарииЭтапов КАК КомментарииЭтапов
			|		ПО (ЭтапПроизводства2_2ВыходныеИзделия.Ссылка = КомментарииЭтапов.ЭтапПроизводства)
			|ГДЕ
			|	ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.Проведен
			|	И ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЭтаповПроизводства2_2.Начат)
			|	И ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.Подразделение = &Подразделение
			|	И НЕ ЭтапПроизводства2_2ВыходныеИзделия.Отменено
			|	И НЕ ЭтапПроизводства2_2ВыходныеИзделия.Произведено  
			|	&ТекстОтбораПоНазначению
			|	&ТекстОтбораДатаНачала
			|	&ТекстОтбораДатаОкончания
