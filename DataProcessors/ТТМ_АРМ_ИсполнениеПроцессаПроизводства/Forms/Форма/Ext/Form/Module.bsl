//Процедура события ПриИзменении для колоноки по ПлановыаяДатаВыпуска
Процедура ИзменитьПлановуюДатуВыпускаВЭтапах(Элемент)
	
	СтруктураОтбораПартии = Новый Структура("Датавыпускаплановая, Изделие, Назначение");
	ЗаполнитьЗначенияСвойств(СтруктураОтбораПартии,Элементы.ТабПланПроизводства.ОтборСтрок);             
	
	Если Элемент.Родитель.ТекущиеДанные.Изделие = ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка") Тогда   
		//Это строка 1-го уровня, вернем значение до изменения                          
		Элемент.Родитель.ТекущиеДанные[Элемент.Имя] = СтруктураОтбораПартии[Элемент.Имя];
		Возврат;
	КонецЕсли;
	
	//Если Элемент.Родитель.ТекущиеДанные[Элемент.Имя] Тогда 
	//	ЭтоВыполненияОпераций = Истина;
	//Иначе // отмена выполнения операций
	//	ЭтоВыполненияОпераций = Ложь; 
	//КонецЕсли;
	
	//ДатаВыпускаИсходная, ДатаВыпускаНовая)
	
	
	
	ДатаВыпускаНовая = Элемент.Родитель.ТекущиеДанные[Элемент.Имя]; //ТекущаяДата();
	ДопПараметры = Новый Структура("ДатаИсходная, ДатаНовая, СтруктураОтбораПартии", СтруктураОтбораПартии.ДатаВыпускаПлановая, ДатаВыпускаНовая, СтруктураОтбораПартии);
	ОповещениеОбИзмененииПлановойДатыПроизводства = Новый ОписаниеОповещения("ИзменитьПлановуюДатуВыпускаВЭтапахПродолжение", ЭтаФорма, ДопПараметры); 	
	ПоказатьВопрос(ОповещениеОбИзмененииПлановойДатыПроизводства,"Изменить плановую дату выпуска для всех подчиненных этапов?",РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры        

&НаКлиенте
Процедура ИзменитьПлановуюДатуВыпускаВЭтапахПродолжение(Ответ, ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда 
		ОбновитьДанныеПланаПроизводства(Объект.ПроизводственноеПодразделение,ДопПараметры.СтруктураОтбораПартии);
	Иначе 
		ИзменитьПлановуюДатуВыпускаВЭтапахНаСервере(ДопПараметры.ДатаИсходная, ДопПараметры.ДатаНовая, ДопПараметры.СтруктураОтбораПартии);
		ДопПараметры.СтруктураОтбораПартии.Датавыпускаплановая = ДопПараметры.ДатаНовая;
		ОбновитьДанныеПланаПроизводства(Объект.ПроизводственноеПодразделение,ДопПараметры.СтруктураОтбораПартии);
		РазвернутьСвернутьПодчиненныеСтрокиДерева("РазвернутьСтрокиДереваВыпуска");
		//Спозиционируемся на новой строке
		//Элементы.ДеревоВыпуска. 
		Если ДопПараметры.Свойство("СтруктураОтбораПартии") <> Неопределено Тогда 
			УстановитьТекущуюСтрокуДереваВыпуска(ДопПараметры);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ИзменитьПлановуюДатуВыпускаВЭтапахНаСервере(ДатаВыпускаИсходная, ДатаВыпускаНовая, СтруктураОтбораПартии)
	
	МассивСтрокДляОбработки = ТабПланПроизводства.НайтиСтроки(СтруктураОтбораПартии);
	Для Каждого Стр из МассивСтрокДляОбработки Цикл   
		Если не Стр.Отметка Тогда 
			Продолжить;
		КонецЕсли;
		ЭтапОбъект = Стр.ЭтапПроизводства.ПолучитьОбъект();
		Для Каждого СтрТЧ из ЭтапОбъект.ВыходныеИзделия Цикл 
			Если СтрТЧ.ДатаПроизводства <> ДатаВыпускаНовая Тогда 
				СтрТЧ.ДатаПроизводства = ДатаВыпускаНовая;
			КонецЕсли;
		КонецЦикла;   
		Попытка
			ЭтапОбъект.Записать();
		Исключение
			Сообщить("Ошибка при изменении Даты производства!" + Символы.ПС + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла; 
	
КонецПроцедуры

&НаКлиенте
Процедура УдалениеОперацийПоПартииПродолжение(Результат, ДопПараметры)	Экспорт
	
	Если не Результат = КодВозвратаДиалога.Да Тогда 
		ТекСтрока = Элементы.ДеревоВыпуска.ТекущиеДанные; 
		Если не ТекСтрока = Неопределено Тогда 
			Текстрока[ДопПараметры.ИмяОперации] = не ТекСтрока[ДопПараметры.ИмяОперации];
		КонецЕсли;
		Возврат;
	Иначе 
		ЗаписиОбновлены = ОтменитьВыполнениеОперацииНаСервере(ДопПараметры.ИмяОперации, ДопПараметры, ДопПараметры.ПоВсемОперациям);
		
		Если ЗаписиОбновлены Тогда                                                                                      
			
			СнятьУстановитьОтметкуВыполненияОперации(ДопПараметры.ПоВсемОперациям, ДопПараметры.ИмяОперации, Ложь);
			
			//Если ДопПараметры.ПоВсемОперациям = 1 Тогда 
			//	СнятьУстановитьОтметкуВыполненияОперации(ДопПараметры.ПоВсемОперациям, ДопПараметры.ИмяОперации, Ложь);
			//Иначе 
			//	Текстрока[ДопПараметры.ИмяОперации] = не ТекСтрока[ДопПараметры.ИмяОперации];
			//КонецЕсли;
		Иначе                  
			Если не ТекСтрока = Неопределено Тогда 
				ТекСтрока[ДопПараметры.ИмяОперации] = не ТекСтрока[ДопПараметры.ИмяОперации];
			КонецЕсли;
		КонецЕсли;
		//ОбновитьДанныеПланаПроизводства(Объект.ПроизводственноеПодразделение);
	КонецЕсли;
	
КонецПроцедуры	    

&НаКлиенте
Процедура СнятьУстановитьОтметкуВыполненияОперации(ПоВсемОперациям, ИмяОперации, Выполнено)
	
	ТекСтрока = Элементы.ДеревоВыпуска.ТекущиеДанные;
	 
	МассивВРЦ = ПолучитьВидыРабочихЦентров(Объект.ПроизводственноеПодразделение);  
	Если ПоВсемОперациям = 1 Тогда  
		Для Каждого ВРЦ из МассивВРЦ Цикл 
		
			Попытка
				ТекСтрока[Строка(ВРЦ)] = Выполнено;   
				ТекСтрока.ИзделиеВыпущено = Выполнено;
			Исключение
				Сообщить("Отсутствует колонка " + ВРЦ.Имя);
			КонецПопытки; 

		КонецЦикла;  
	Иначе 
		Текстрока[ИмяОперации] = Выполнено; // не ТекСтрока[ИмяОперации];
		СчетсикОпераций = 0;
		Для Каждого ВРЦ из МассивВРЦ Цикл 
			Если ТекСтрока[Строка(ВРЦ)] = Выполнено Тогда 
				СчетсикОпераций = СчетсикОпераций + 1;
			КонецЕсли;
		КонецЦикла;                                   
		Если Выполнено Тогда 
			Если СчетсикОпераций = МассивВРЦ.Количество() Тогда 
				ТекСтрока.ИзделиеВыпущено = Выполнено;     
			Иначе 
				ТекСтрока.ИзделиеВыпущено = не Выполнено;
			КонецЕсли;
		Иначе 
			Если ТекСтрока.ИзделиеВыпущено Тогда 
				ТекСтрока.ИзделиеВыпущено = Выполнено;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;   
	//Если ПоВсемОперациям = 1 Тогда 
	//	ТекСтрока.ИзделиеВыпущено = Выполнено
	//ИначеЕсли не Выполнено Тогда 
	//	//Если партия выпущена, тогда тменить выпуск
	//	//Если партия не выпущена и это посл
	//КонецЕсли;
	
	//следующая строка вызывает ошибку с завершением работы 1С
	//ОбновитьДанныеПланаПроизводства(Объект.ПроизводственноеПодразделение);
	
