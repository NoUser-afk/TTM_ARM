	//КоличествоОперацийСпецификации = ПроверитьОперацииПоСпецификации(ПараметрыЗаполненияОпераций.Спецификация);
	Если Результат = КодВозвратаДиалога.Да Тогда //и КоличествоОперацийСпецификации = 0
		ОперацииЗаполнены = ЗаполнениеОперацийНаСервере(ПараметрыЗаполненияОпераций.Спецификация, ПараметрыЗаполненияОпераций.ШаблонТехПроцесса);
		Если ОперацииЗаполнены Тогда 
			ВыполнениеОперацииПродолжение(ПараметрыЗаполненияОпераций.Элемент);
		КонецЕсли;
	Иначе    
		//очистить галку на форм                                                    
		//22.11.24 Ганьшина
		ИмяОперации = ПараметрыЗаполненияОпераций.Элемент.Имя;
