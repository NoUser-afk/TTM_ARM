	|	ТоварыПриемка.Ссылка = &Ссылка
	|	И &ЕстьПриемка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////";
	
	ТекстЗапроса = ТекстЗапроса + ТекстЗапросаЦены + "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТоварыНаСкладахОстатки.Номенклатура КАК Номенклатура,
