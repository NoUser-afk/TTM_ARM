	//ПРИ ЭТОМ МОГУТ БЫТЬ КАК ЛИШНИЕ МАРКИ, ТАК И ЛИШНИЕ ТОВАРЫ
	
	|////////////////////////////////////////////////////////////////////////////////
	//1) СОПОСТАВЛЕНО ПОЛНОСТЬЮ
