&НаСервере
Процедура УстановитьСтатусДокумента(ДокументВыгрузки, Статус)
	
	ДокОбъект = ДокументВыгрузки.ПолучитьОбъект();
	ДокОбъект.Статус = Статус;
	ДокОбъект.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьНаВсеТСД(КаталогФайлов, ИсхФайл, ТСДИсключение, ИмяНовФайла)  
	
	Для Каждого Элм Из СписокТСД Цикл
		Попытка
			Если Элм.ТСД = СтрЗаменить(ТСДИсключение, "\", "") Тогда
				Продолжить;	
			КонецЕсли;  			
			ПоискФайлов(ИсхФайл, КаталогФайлов + Элм.ТСД + РП + "in" + ИмяНовФайла);			
		Исключение    			
			Инф = ИнформацияОбОшибке(); 						
		КонецПопытки 		
	КонецЦикла;
	
КонецПроцедуры

