			ИначеЕсли ТипОбмена = "2" Тогда
					
				ИмяФайлаВыгрузки = Формат(Текущаядата(), "ДФ=ddMMyyyyHHmmss") + "_" + Сч + "v_83_Clients_.dm";
				ИмяФайла = КаталогВременныхФайлов() + ИмяФайлаВыгрузки;
