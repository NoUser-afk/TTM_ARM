				КонецЕсли;
				УдалитьФайлы(АдресВХ);
                УдалитьФайлы(ИмяФайла);		
			
		КонецЕсли;
		
		//ТТМ+ Ганьшина
		Если ТипЗнч(ДокументВыгрузки) = Тип("ДокументСсылка.ТТМ_ПодборМатериаловПоСпецификации") Тогда    
