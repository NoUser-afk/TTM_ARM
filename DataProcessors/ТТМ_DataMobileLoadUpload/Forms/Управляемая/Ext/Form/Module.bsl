		ИначеЕсли ТипОбмена = "2" Тогда
					
				ИмяФайлаВыгрузки = Формат(Текущаядата(), "ДФ=ddMMyyyyHHmmss") + "_" + Сч + "_v83_Doc_" + ЧистыйДокНомер + ".dm";
