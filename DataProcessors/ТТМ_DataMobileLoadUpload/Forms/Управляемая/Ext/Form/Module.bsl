		ИмяФайлаВыгрузкиДК = РП + Формат(Текущаядата(), "ДФ=ddMMyyyyHHmmss") + "_" + Сч + "_v83_Doc_"+ЧистыйДокНомер+".dm";
		
		
		Если ТипОбмена = "1" Тогда
			
			ОтправитьФайлНаFTP(тхт_док, Формат(ТекущаяДата(),"ДФ=ddMMyyyyHHmmss") + "_" + Сч + "_v83_Doc_"+ЧистыйДокНомер+".dm"+"temp");
			
		ИначеЕсли ТипОбмена = "0" Тогда	
			
			тхт_док.Записать(лКаталогОбмена+"DataMobile" + РП + ИДТСД + РП + "in" + ИмяФайлаВыгрузкиДК ,КодировкаТекста.UTF8);
