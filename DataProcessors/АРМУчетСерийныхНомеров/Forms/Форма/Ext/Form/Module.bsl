&НаКлиенте
Процедура ПослеВводаСтроки(Строка, ДопПараметры) Экспорт
	
	Если ЗначениеЗаполнено(Строка) Тогда //НЕ Строка = Неопределено Тогда  
		НовыйНомерЗаписан = ПроверитьЗаписатьНовыйномер(Строка, ДопПараметры);
	КонецЕсли;                
	
	Если НовыйНомерЗаписан = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Если НовыйНомерЗаписан Тогда 
		
		ЭтапыЗагружены = ОбновитьТаблицуЭтапов();      
		
		ПараметрыОтбора = Новый Структура("Номенклатура, ЭтапПроизводства", ДопПараметры.ДанныеТекущейСтроки.Номенклатура, ДопПараметры.МассивЭтапов[0]); 
		Если Объект.ТабЭтапы.НайтиСтроки(ПараметрыОтбора).Количество() > 0 Тогда 
			ТекСтрока = Объект.ТабЭтапы.НайтиСтроки(ПараметрыОтбора)[0]; 
			Элементы.ТабЭтапы.ТекущаяСтрока = ТекСтрока.ПолучитьИдентификатор();
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры   

