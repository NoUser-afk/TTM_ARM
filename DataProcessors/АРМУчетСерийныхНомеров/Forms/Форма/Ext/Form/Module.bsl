		МассивОбъектов = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Объект.Номенклатура);
		ИменаМакетов = "ЭтикеткаТовары"; //ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве("ЭтикеткаТовары");	
			
		УправлениеПечатьюКлиент.ВыполнитьКомандуПечати(
			"Обработка.ПечатьЭтикетокИЦенников",
			ИменаМакетов,
