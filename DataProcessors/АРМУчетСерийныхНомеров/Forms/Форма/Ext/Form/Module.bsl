&НаСервере
Процедура Группа6ПриСменеСтраницыНаСервере()
	
	//Таб = РеквизитФормыВЗначение("ДанныеОтгруженныхСерийныхНомеров",Тип("ТаблицаЗначений"));
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ТТМ_УчетСерийныхНомеровПродукции.СерийныйНомер КАК СерийныйНомер,
	               |	ТТМ_УчетСерийныхНомеровПродукции.Регистратор КАК Регистратор,
	               |	ТТМ_УчетСерийныхНомеровПродукции.Номенклатура КАК Номенклатура
	               |ПОМЕСТИТЬ ОтгруженныеСерийныеНомера
	               |ИЗ
	               |	РегистрНакопления.ТТМ_УчетСерийныхНомеровПродукции КАК ТТМ_УчетСерийныхНомеровПродукции
	               |ГДЕ
	               |	ТТМ_УчетСерийныхНомеровПродукции.Регистратор ССЫЛКА Документ.РеализацияТоваровУслуг
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ТТМ_УчетСерийныхНомеровПродукции.СерийныйНомер,
	               |	ТТМ_УчетСерийныхНомеровПродукции.Регистратор,
	               |	ТТМ_УчетСерийныхНомеровПродукции.Номенклатура
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ОтгруженныеСерийныеНомера.СерийныйНомер КАК СерийныйНомер,
	               |	ОтгруженныеСерийныеНомера.Номенклатура КАК Номенклатура,
	               |	ВЫРАЗИТЬ(ЕСТЬNULL(ТТМ_УчетСерийныхНомеровПродукции.Регистратор, ЗНАЧЕНИЕ(Документ.ЭтапПроизводства2_2.ПустаяСсылка)) КАК Документ.ЭтапПроизводства2_2) КАК ЭтапПроизводства,
	               |	ВЫРАЗИТЬ(ОтгруженныеСерийныеНомера.Регистратор КАК Документ.РеализацияТоваровУслуг) КАК Реализация
	               |ИЗ
	               |	ОтгруженныеСерийныеНомера КАК ОтгруженныеСерийныеНомера
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТТМ_УчетСерийныхНомеровПродукции КАК ТТМ_УчетСерийныхНомеровПродукции
	               |		ПО ОтгруженныеСерийныеНомера.СерийныйНомер = ТТМ_УчетСерийныхНомеровПродукции.СерийныйНомер
	               |			И ОтгруженныеСерийныеНомера.Номенклатура = ТТМ_УчетСерийныхНомеровПродукции.Номенклатура
	               |ГДЕ
	               |	ТТМ_УчетСерийныхНомеровПродукции.Регистратор ССЫЛКА Документ.ЭтапПроизводства2_2
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	СерийныйНомер";
	
	ТабОтгруженныеСерийныеНомера = Запрос.Выполнить().Выгрузить(); 
	ДанныеОтгруженныхСерийныхНомеров.Загрузить(ТабОтгруженныеСерийныеНомера);
	
	//АдресВоВременномХранилище = ПоместитьВоВременноеХранилище(ТабОтгруженныеСерийныеНомера, УникальныйИдентификатор);
	//Результат = ПолучитьИзВременногоХранилища(АдресВоВременномХранилище);
	//Если не Результат = Неопределено Тогда 
	//	ДанныеОтгруженныхСерийныхНомеров.Загрузить(Результат);
	//КонецЕсли;
	
	//ЗначениеВРеквизитФормы(Таб,"ДанныеОтгруженныхСерийныхНомеров");
	
КонецПроцедуры

