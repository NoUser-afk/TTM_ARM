	ВключенУчетСерийныхНомеров = ТТМ_СерийныйУчет.ПроверитьУстановитьУчетСерийныхНомеров(Номенклатура, ВключитьУчетПоСерийнымНомерам);	
		
	//2.    
	
	Если ВключенУчетСерийныхНомеров Тогда    
		//ДанныеЭтапа = ТТМ_СерийныйУчет.ПолучитьДанныеЭтапа(МассивЭтапов[0].ЭтапПроизводства);
		КоличествоЗаписанныхСерийныхномеров = 0;
		Для Каждого ЭтапПроизводства Из МассивЭтапов Цикл   
			НачальныйНомер = ?(ЗначениеЗаполнено(НачальныйНомер), НачальныйНомер + КоличествоЗаписанныхСерийныхномеров, 0);
			СерийныйНомерУстановлен = ТТМ_СерийныйУчет.ЗаписатьСерийныйНомерПродукцииПослеПроверки(ЭтапПроизводства,НачальныйНомер); //ПроверитьЗаписатьСерийныйНомерПродукцииПриВыпуске(ЭтапПроизводства);
			//ТТМ_СерийныйУчет.СгененироватьСерийныйНомер(Стр.Номенклатура, Стр.ДатаЗапуска, НачальныйНомер, 
			Если не СерийныйНомерУстановлен Тогда 
				Сообщить("Не удалось установить серийные номера для продукции " + Номенклатура + " по этапу " + ЭтапПроизводства, СтатусСообщения.Важное);
				Возврат Ложь; 
			КонецЕсли;
			КоличествоЗаписанныхСерийныхномеров = ЭтапПроизводства.КоличествоУпаковокПлан;
		КонецЦикла;
		Возврат Истина;
	Иначе  
		Сообщить("Не включен учет серийных номеров для продукции " + Номенклатура);
		Возврат Ложь;
	КонецЕсли;
	
