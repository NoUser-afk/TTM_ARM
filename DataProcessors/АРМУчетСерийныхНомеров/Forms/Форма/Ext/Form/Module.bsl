&НаКлиенте
Процедура ОтменитьЗаказ(Команда) 
	
	ДанныеОбработки = ОпределитьДанныедляОбработки();
	Если ДанныеОбработки = Неопределено Тогда 
		Возврат;
	КонецЕсли;
		
	//ДопПараметры = Новый Структура("МассивНоменклатуры, МассивЭтапов");
	//ЗаполнитьЗначенияСвойств(ДопПараметры,, ДанныеОбработки.МассивНоменклатуры, ДанныеОбработки.МассивЭтапов);
	ОповещениеОтменитьЗаказШильда = Новый ОписаниеОповещения("ОтменитьЗаказШильдаПродолжение", Этаформа, ДанныеОбработки);
	ПоказатьВопрос(ОповещениеОтменитьЗаказШильда, "Удалить серийный номер для " + ДанныеОбработки.Номенклатура + "?",РежимДиалогаВопрос.ДаНет);
		
КонецПроцедуры        

&НаКлиенте
Процедура ОтменитьЗаказШильдаПродолжение(Результат, ДопПараметры) Экспорт 
	
	//1. Проверим, что в регистре есть остаток по текущему серийномуНомеру
	
	Если Результат = КодВозвратаДиалога.Нет Тогда 
		//Отменяем только заказ шильда!!!          
		УдалятьСтроку = Ложь;
		ОтменаВыполнена = ОтменитьЗаказШильдаНаСервере(Доппараметры, УдалятьСтроку);
	Иначе 
		//Удалить строку из регистра
		УдалятьСтроку = Истина;
		ОтменаВыполнена = ОтменитьЗаказШильдаНаСервере(ДопПараметры, УдалятьСтроку);
	КонецЕсли;   
	
	Если ОтменаВыполнена Тогда 
		
		ЭтапыЗагружены = ОбновитьТаблицуЭтапов();  
		
		ПараметрыОтбора = Новый Структура("Номенклатура, ЭтапПроизводства", ДопПараметры.Номенклатура,ДопПараметры.МассивЭтапов[0]); 
		Если Объект.ТабЭтапы.НайтиСтроки(ПараметрыОтбора).Количество() > 0 Тогда 
			ТекСтрока = Объект.ТабЭтапы.НайтиСтроки(ПараметрыОтбора)[0]; 
			Элементы.ТабЭтапы.ТекущаяСтрока = ТекСтрока.ПолучитьИдентификатор();
		КонецЕсли; 
		
	КонецЕсли;
	

КонецПроцедуры

