	//Если МассивЭтапов.Количество() = 0 Тогда 
	//	//СтруктураСтроки = Новый Структура("Номенклатура, ЭтапПроизводства, Запланировано, СтарыйСерийныйномер");
	//	//ЗаполнитьЗначенияСвойств(СтруктураСтроки, Элементы.ТабЭтапы.ТекущиеДанные);
	//	МассивЭтапов.Добавить(Элементы.ТабЭтапы.ТекущиеДанные.ЭтапПроизводства);
