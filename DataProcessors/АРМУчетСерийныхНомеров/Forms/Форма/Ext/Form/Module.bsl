&НаСервере
Функция ПроверитьЗаписатьНовыйномер(Строка, ДопПараметры)
	
	НовыйНомер = Строка;
	Если СтрДлина(НовыйНомер) < 4 Тогда 
		Пока не СтрДлина(НовыйНомер) = 4 Цикл                                                               
			НовыйНомер = "0" + НовыйНомер;
		КонецЦикла;  
	КонецЕсли;
    //НовыйСерийныйНомер = ПолучитьКорректныйНовыйНомер(НовыйНомер, Параметры.ДанныеТекСтроки);
	НовыйСерийныйНомер = ТТМ_СерийныйУчет.ПроверитьКорректностьСерийногоНомера(НовыйНомер, ДопПараметры.ДанныеТекущейСтроки);
	Если НовыйСерийныйНомер <> Неопределено Тогда 
		НомерУспешноЗаписан = ТТМ_СерийныйУчет.ЗаписатьНовыйСерийныйНомер(НовыйСерийныйНомер, ДопПараметры.ДанныеТекущейСтроки, ДопПараметры.МассивЭтапов);
		Если не НомерУспешноЗаписан Тогда 
			Сообщить("Не удалось записать новый серийный номер " + Строка + " для номенклатуры " + ДопПараметры.ДанныеТекущейСтроки.Номенклатура);
			Возврат Ложь;
		Иначе 
			Возврат Истина
		КонецЕсли;
	Иначе 
		Сообщить("Введенный номер """ + Строка + """ не прошел проверку корректности!");
		Возврат Ложь;
	КонецЕсли;    
	
КонецФункции

&НаКлиенте
Процедура НачатьУчетСерийныхНомеровПродукции(Команда)
	
	Если не ЗначениеЗаполнено(НачальныйНомер) Тогда 
		Сообщить("Для начала учета серийных номеров укажите начальный серийный номер!");
		Возврат;
	КонецЕсли;
	
	ДанныеТекСтроки = Элементы.ТабЭтапы.ТекущиеДанные;
	Если не ЗначениеЗаполнено(Объект.Номенклатура) Тогда                                                   
		
		ДопПараметры = Новый Структура("Номенклатура", ДанныеТекСтроки.Номенклатура);
		ОповещениеПослеВопроса = Новый ОписаниеОповещения("ПослеВопросаНачатьУчетСерийныхномеров", ЭтаФорма, ДопПараметры);
		ПоказатьВопрос(ОповещениеПослеВопроса,"Начать учет по серийным номерам для продукции " +  ДанныеТекСтроки.Номенклатура + "?",РежимДиалогаВопрос.ДаНет);
		
	Иначе 
		
		//ДанныеТекСтроки = Новый Структура("Номенклатура, ЭтапПроизводства, Серийныйномер, СтарыйСерийныйНомер");
		МассивЭтапов = Новый Массив;
		Для Каждого СтрЭтапы из Объект.ТабЭтапы Цикл     
			Если Стрэтапы.Отметка Тогда 
				МассивЭтапов.Добавить(СтрЭтапы.ЭтапПроизводства);
			КонецЕсли;
		КонецЦикла;    
		Если МассивЭтапов.Количество() = 0 Тогда 
			МассивЭтапов.Добавить(Элементы.ТабЭтапы.ТекущиеДанные.ЭтапПроизводства);
		КонецЕсли;
		
		Успешно = НачатьУчетСерийныхномровНаСервере(Объект.Номенклатура, НачальныйНомер, МассивЭтапов);
		Если Успешно Тогда 
			НачальныйНомер = 0;
		КонецЕсли;
		
		ЭтапыЗагружены = ОбновитьТаблицуЭтапов();
		
		ПараметрыОтбора = Новый Структура("Номенклатура, ЭтапПроизводства", ДанныеТекСтроки.Номенклатура,МассивЭтапов[0]); 
		Если Объект.ТабЭтапы.НайтиСтроки(ПараметрыОтбора).Количество() > 0 Тогда 
			ТекСтрока = Объект.ТабЭтапы.НайтиСтроки(ПараметрыОтбора)[0]; 
			Элементы.ТабЭтапы.ТекущаяСтрока = ТекСтрока.ПолучитьИдентификатор();
		КонецЕсли;
	
	КонецЕсли;  
		
КонецПроцедуры  

&НаКлиенте
Процедура ПослеВопросаНачатьУчетСерийныхномеров(Результат, ДопПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда 
		Возврат;
	КонецЕсли;
	
	МассивЭтапов = Новый Массив;
	Для Каждого СтрЭтапы из Объект.ТабЭтапы Цикл     
		Если Стрэтапы.Отметка Тогда 
			МассивЭтапов.Добавить(СтрЭтапы.ЭтапПроизводства);
		КонецЕсли;
	КонецЦикла;    
	Если МассивЭтапов.Количество() = 0 Тогда 
		МассивЭтапов.Добавить(Элементы.ТабЭтапы.ТекущиеДанные.ЭтапПроизводства); 
	КонецЕсли; 
	
	Успешно = НачатьУчетСерийныхномровНаСервере(ДопПараметры.Номенклатура, НачальныйНомер, МассивЭтапов);
	Если Успешно Тогда 
		НачальныйНомер = 0;
	КонецЕсли;
	
	ЭтапыЗагружены = ОбновитьТаблицуЭтапов();  
	
	ПараметрыОтбора = Новый Структура("Номенклатура, ЭтапПроизводства", ДопПараметры.Номенклатура,МассивЭтапов[0]); 
	Если Объект.ТабЭтапы.НайтиСтроки(ПараметрыОтбора).Количество() > 0 Тогда 
		ТекСтрока = Объект.ТабЭтапы.НайтиСтроки(ПараметрыОтбора)[0]; 
		Элементы.ТабЭтапы.ТекущаяСтрока = ТекСтрока.ПолучитьИдентификатор();
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция НачатьУчетСерийныхномровНаСервере(Номенклатура, НачальныйНомер, МассивЭтапов)
	
	//1. Проверим/установим признак учета серийных номеров для продукции   
	
	ВключенУчетСерийныхНомеров = ТТМ_СерийныйУчет.ПроверитьУстановитьУчетСерийныхНомеров(Номенклатура, Истина);	
		
	//2.    
	
	Если ВключенУчетСерийныхНомеров Тогда    
		//ДанныеЭтапа = ТТМ_СерийныйУчет.ПолучитьДанныеЭтапа(МассивЭтапов[0].ЭтапПроизводства);
		НомерЭтапа = 0;
		Для Каждого ЭтапПроизводства Из МассивЭтапов Цикл  
			СерийныйНомерУстановлен = ТТМ_СерийныйУчет.ЗаписатьСерийныйНомерПродукцииПослеПроверки(ЭтапПроизводства, НачальныйНомер + НомерЭтапа);
			//ТТМ_СерийныйУчет.СгененироватьСерийныйНомер(Стр.Номенклатура, Стр.ДатаЗапуска, НачальныйНомер, 
			Если не СерийныйНомерУстановлен Тогда 
				Возврат Ложь;
				Сообщить("Не удалось установить серийные номера для продукции " + Номенклатура + " по этапу " + ЭтапПроизводства, СтатусСообщения.Важное);
			Иначе 
				НомерЭтапа = НомерЭтапа + 1;
			КонецЕсли;       		
		КонецЦикла; 
		
		Возврат Истина;
		
	Иначе   
		Возврат Ложь;
		Сообщить("Серийный номер не установлен!");
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ТабЭтапыОтметкаПриИзменении(Элемент)
	
	ТекСтрока = Элемент.Родитель.ТекущиеДанные;   // Элементы[Элемент.Родитель.Имя].ТекущиеДанные
	ПараметрыПоиска = Новый Структура("ЭтапПРоизводства",ТекСтрока.ЭтапПроизводства);
	МассивСтрокПоЭтапу = Объект.ТабЭтапы.НайтиСтроки(ПараметрыПоиска);
	Если МассивСтрокПоЭтапу.Количество() > 1 Тогда
		Для Каждого Стр из МассивСтрокПоЭтапу Цикл 
			Стр.Отметка = Истина;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

#Область СтраницаАмина

	&НаСервереБезКонтекста
Процедура ЗаполнитьРеализациюВСтрокеВыпускаНаСервере()
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	ТТМ_УчетСерийныхНомеровПродукции.СерийныйНомер КАК СерийныйНомер,
			|	ТТМ_УчетСерийныхНомеровПродукции.Регистратор КАК Регистратор,
			|	ТТМ_УчетСерийныхНомеровПродукции.Номенклатура КАК Номенклатура
			|ПОМЕСТИТЬ ОтгруженныеСерийныеНомера
			|ИЗ
			|	РегистрНакопления.ТТМ_УчетСерийныхНомеровПродукции КАК ТТМ_УчетСерийныхНомеровПродукции
			|ГДЕ
			|	ТТМ_УчетСерийныхНомеровПродукции.Регистратор ССЫЛКА Документ.РеализацияТоваровУслуг
			|
			|СГРУППИРОВАТЬ ПО
			|	ТТМ_УчетСерийныхНомеровПродукции.СерийныйНомер,
			|	ТТМ_УчетСерийныхНомеровПродукции.Регистратор,
			|	ТТМ_УчетСерийныхНомеровПродукции.Номенклатура
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	ОтгруженныеСерийныеНомера.СерийныйНомер КАК СерийныйНомер,
			|	ОтгруженныеСерийныеНомера.Номенклатура КАК Номенклатура,
			|	ЕСТЬNULL(ТТМ_УчетСерийныхНомеровПродукции.Регистратор, ЗНАЧЕНИЕ(Документ.ЭтапПроизводства2_2.ПустаяСсылка)) КАК ЭтапПроизводства,
			|	ОтгруженныеСерийныеНомера.Регистратор КАК Реализация
			|ИЗ
			|	ОтгруженныеСерийныеНомера КАК ОтгруженныеСерийныеНомера
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТТМ_УчетСерийныхНомеровПродукции КАК ТТМ_УчетСерийныхНомеровПродукции
			|		ПО (ОтгруженныеСерийныеНомера.СерийныйНомер = ТТМ_УчетСерийныхНомеровПродукции.СерийныйНомер)
			|			И (ОтгруженныеСерийныеНомера.Номенклатура = ТТМ_УчетСерийныхНомеровПродукции.Номенклатура)
			|ГДЕ
			|	ТТМ_УчетСерийныхНомеровПродукции.Регистратор ССЫЛКА Документ.ЭтапПроизводства2_2
			|
			|УПОРЯДОЧИТЬ ПО
			|	СерийныйНомер";   
                                  
	//СвойствоКддТМ = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("Имя","КодТМ_ТТМ");
	//УчетСерийныхНомеров = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("Имя","УчитываатьСерийныеНомераНоменклатуры_ТТМ");
	//Запрос.УстановитьПараметр("СвойствоКодТМ",СвойствоКддТМ);
	//Запрос.УстановитьПараметр("УчетСерийныхНомеров",УчетСерийныхНомеров);
	ТабДанныеПоОтгруженнымСН = Запрос.Выполнить().Выгрузить(); 
	
	Для Каждого Стр из ТабДанныеПоОтгруженнымСН Цикл 
		НЗ = РегистрыНакопления.ТТМ_УчетСерийныхНомеровПродукции.СоздатьНаборЗаписей();
		НЗ.Отбор.Регистратор.Установить(Стр.ЭтапПроизводства);
		НЗ.Прочитать();
		Если НЗ.Количество() > 1 Тогда 
			НЗ.Отбор.Серийныйномер.Установить(Стр.СерийныйНомер);
			НЗ.Прочитать();
			Если НЗ.Количество() = 1 Тогда 
				СтрокаРегистра = НЗ[0];
				СтрокаРегистра.Реализация = Стр.Реализация;
				НЗ.Записать();
			Иначе 
				Сообщить("Для Этапа " + Стр.ЭтапПроизводства + "найдено более 1 строки регистра - операция не выполнена!");
				Продолжить;
			КонецЕсли;
		ИначеЕсли НЗ.Количество() = 1 Тогда 
			СтрокаРегистра = НЗ[0];
			СтрокаРегистра.ДокументРеализации = Стр.Реализация;
			НЗ.Записать();
		Иначе
			Сообщить("Отсутствуют отгруженные серийные номера для этапа " + Стр.ЭтапПроизводства + " - операция не выполнена!");
			Продолжить;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

