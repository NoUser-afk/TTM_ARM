&НаСервере
Функция ПолучитьДанныеВыделенныхСтрок()
	
	ПараметрыПоиска = Новый Структура("отметка",Истина);
	ТЧ = Объект.ТабЭтапы.Выгрузить(ПараметрыПоиска,); 
	//МассивСтрок = Объект.ТабЭтапы.НайтиСтроки(ПараметрыПоиска);
	
	ТЭтапы = ТЧ.Скопировать();           
	
	ТЭтапы.Свернуть("ЭтапПроизводства, Запланировано");    
	КоличествоИзделий = ТЭтапы.Итог("Запланировано");
	МассивЭтапов = ТЭтапы.ВыгрузитьКолонку("ЭтапПроизводства");
	
	ТНоменклатура = ТЧ.Скопировать();
	ТНоменклатура.Свернуть("Номенклатура");
	МассивНоменклатуры = ТНоменклатура.ВыгрузитьКолонку("Номенклатура");
	
	ТСерийныеНомера = ТЧ.Скопировать();
	ТСерийныеНомера.Свернуть("СерийныйНомер");
	МассивСерийныхНомеров = ТСерийныеНомера.ВыгрузитьКолонку("СерийныйНомер"); 
	
	СтруктураВозврата = Новый Структура;
	//СтруктураВозврата.Вставить("МассивСтрок", МассивСтрок);
	СтруктураВозврата.Вставить("КоличествоИзделий", КоличествоИзделий);
	СтруктураВозврата.Вставить("МассивЭтапов", МассивЭтапов);               
	СтруктураВозврата.Вставить("МассивНоменклатуры", МассивНоменклатуры);
	СтруктураВозврата.Вставить("МассивСерийныхНомеров", МассивСерийныхНомеров);
	
	Возврат СтруктураВозврата;
		
КонецФункции

&НаКлиенте
Функция ПолучитьСтруктуруТекущейСтроки()
	Возврат Новый Структура("Номенклатура, ДатаЗапуска, ЭтапПроизводства, Назначение, Серийныйномер, Запланировано, ШильдЗаказан, КоличествоИзделий");
КонецФункции   

&НаСервере
Функция ОтменитьЗаказШильдаНаСервере(ДопПараметры, УдалитьСтроку = Ложь)
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТТМ_УчетСерийныхНомеровПродукцииОстаткиИОбороты.Склад КАК Склад,
	               |	ТТМ_УчетСерийныхНомеровПродукцииОстаткиИОбороты.Номенклатура КАК Номенклатура,
	               |	ТТМ_УчетСерийныхНомеровПродукцииОстаткиИОбороты.Назначение КАК Назначение,
	               |	ТТМ_УчетСерийныхНомеровПродукцииОстаткиИОбороты.СерийныйНомер КАК СерийныйНомер,
	               |	ТТМ_УчетСерийныхНомеровПродукцииОстаткиИОбороты.ШильдЗаказан КАК ШильдЗаказан,
	               |	СУММА(ТТМ_УчетСерийныхНомеровПродукцииОстаткиИОбороты.КоличествоКонечныйОстаток) КАК КоличествоОстаток,
	               |	ТТМ_УчетСерийныхНомеровПродукцииОстаткиИОбороты.Регистратор КАК Регистратор
	               |ИЗ
	               |	РегистрНакопления.ТТМ_УчетСерийныхНомеровПродукции.ОстаткиИОбороты(
	               |			,
	               |			,
	               |			Авто,
	               |			,
	               |			СерийныйНомер В (&МассивСерийныхНомеров)
	               |				И Номенклатура В (&МассивНоменклатуры)
	               |				И НЕ Произведено) КАК ТТМ_УчетСерийныхНомеровПродукцииОстаткиИОбороты
	               |ГДЕ
	               |	ТТМ_УчетСерийныхНомеровПродукцииОстаткиИОбороты.КоличествоКонечныйОстаток > 0
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ТТМ_УчетСерийныхНомеровПродукцииОстаткиИОбороты.Склад,
	               |	ТТМ_УчетСерийныхНомеровПродукцииОстаткиИОбороты.Номенклатура,
	               |	ТТМ_УчетСерийныхНомеровПродукцииОстаткиИОбороты.Назначение,
	               |	ТТМ_УчетСерийныхНомеровПродукцииОстаткиИОбороты.СерийныйНомер,
	               |	ТТМ_УчетСерийныхНомеровПродукцииОстаткиИОбороты.ШильдЗаказан,
	               |	ТТМ_УчетСерийныхНомеровПродукцииОстаткиИОбороты.Регистратор";
	
	Запрос.УстановитьПараметр("МассивСерийныхНомеров", ДопПараметры.МассивСерийныхНомеров);
	Запрос.УстановитьПараметр("МассивНоменклатуры", ДопПараметры.МассивНоменклатуры);
	Выборка = Запрос.Выполнить().Выбрать();   
	//ТЗ = Запрос.Выполнить().Выгрузить();  
	МожноОтменить = Запрос.Выполнить().Выгрузить().Итог("КоличествоОстаток");
	
	//МожноОтменить = Выборка.КоличествоОстаток; 
	НужноОтменить = ДопПараметры.КоличествоИзделий;
	Если НужноОтменить > МожноОтменить Тогда
		ТекстСообщения = "Недостаточно остатка неотгруженных изделий  для отмены";
		Если УдалитьСтроку Тогда 
			ТекстСообщения = ТекстСообщения + " серийных номеров!";
		Иначе 
			ТекстСообщения = ТекстСообщения + " заказаных шильдов!";
		КонецЕсли;
		Сообщить(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	Пока Выборка.Следующий() Цикл  
		//Есть остаток - можно заменить шильд   
				
		НЗ = РегистрыНакопления.ТТМ_УчетСерийныхНомеровПродукции.СоздатьНаборЗаписей();
		НЗ.Отбор.Регистратор.Установить(Выборка.Регистратор);
		НЗ.Прочитать();       
		
		ТЗ = НЗ.Выгрузить();
		МожноОтменить = ТЗ.Итог("Количество");   
		Если не ЗначениеЗаполнено(МожноОтменить) Тогда 
			Прервать;
		КонецЕсли;
		
		Для Каждого СтрНЗ из НЗ Цикл  
			КоличествоОтмены = НЗ.Выгрузить().Итог("Количество");
			Если КоличествоОтмены > МожноОтменить Тогда 
				Прервать;
			КонецЕсли;   
			Если СтрНЗ.СерийныйНомер = Выборка.СерийныйНомер Тогда
				Если УдалитьСтроку Тогда 
					НЗ.Удалить(СтрНЗ); //.Очистить();
				Иначе 
					КоличествоОтмены = СтрНЗ.Количество;
					СтрНЗ.ШильдЗаказан = Ложь;
				КонецЕсли;
			Иначе 
				Продолжить;
			КонецЕсли;
		КонецЦикла;
		Попытка
			НЗ.Записать();
			МожноОтменить = МожноОтменить - КоличествоОтмены;
		Исключение
			Сообщить("Ошибка при записи регистра " + ОписаниеОшибки());
			Возврат Ложь;
		КонецПопытки;
				
	КонецЦикла;    
	
	Возврат Истина;
	    
КонецФункции

