&НаКлиенте
Процедура НоменклатураПриИзменении(Элемент)
	
	НачальныйНомер = 0;
	ЭтапыЗагружены = ОбновитьТаблицуЭтапов();
	Если не ЭтапыЗагружены Тогда 
		Сообщить("Ошибка обновления таблицы этапов!");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
//БезКонтекста
Функция ОбновитьТаблицуЭтапов()
	
	СтруктураОтбора = Новый Структура;
	
	Если ЗначениеЗаполнено(Объект.Номенклатура) Тогда 
		СтруктураОтбора.Вставить("Номенклатура",Объект.Номенклатура);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ЗаказКлиента) Тогда  
		СтруктураОтбора.Вставить("ЗаказКлиента",Объект.ЗаказКлиента);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	НоменклатураДополнительныеРеквизиты.Ссылка КАК Ссылка,
	               |	НоменклатураДополнительныеРеквизиты.Свойство КАК Свойство,
	               |	НоменклатураДополнительныеРеквизиты.Значение КАК Значение
	               |ПОМЕСТИТЬ ВТ_УчетСН
	               |ИЗ
	               |	Справочник.Номенклатура.ДополнительныеРеквизиты КАК НоменклатураДополнительныеРеквизиты
	               |ГДЕ
	               |	НоменклатураДополнительныеРеквизиты.Свойство = &Свойство
	               |	И НоменклатураДополнительныеРеквизиты.Значение = ИСТИНА
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЛОЖЬ КАК Отметка,
	               |	ЭтапПроизводства2_2ВыходныеИзделия.Ссылка КАК ЭтапПроизводства,
	               |	ЕСТЬNULL(ВТ_УчетСН.Значение, ЛОЖЬ) КАК УчетСерийныхНомеров,
	               |	ВЫБОР
	               |		КОГДА ЕСТЬNULL(ВТ_УчетСН.Значение, ЛОЖЬ) = ЛОЖЬ
	               |			ТОГДА 0
	               |		ИНАЧЕ 1
	               |	КОНЕЦ КАК ИндексКартинки,
	               |	ЭтапПроизводства2_2ВыходныеИзделия.Номенклатура КАК Номенклатура,
	               |	ЭтапПроизводства2_2ВыходныеИзделия.Назначение КАК Назначение,
	               |	ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.ФактическоеНачалоЭтапа КАК ДатаЗапуска,
	               |	ЕСТЬNULL(ТТМ_УчетСерийныхНомеровПродукции.СерийныйНомер, """") КАК СерийныйНомер,
	               |	ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.КоличествоУпаковокПлан КАК Запланировано,
	               |	ЕСТЬNULL(ТТМ_УчетСерийныхНомеровПродукции.ШильдЗаказан, ЛОЖЬ) КАК ШильдЗаказан
	               |ИЗ
	               |	Документ.ЭтапПроизводства2_2.ВыходныеИзделия КАК ЭтапПроизводства2_2ВыходныеИзделия
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТТМ_УчетСерийныхНомеровПродукции КАК ТТМ_УчетСерийныхНомеровПродукции
	               |		ПО (ТТМ_УчетСерийныхНомеровПродукции.Регистратор = ЭтапПроизводства2_2ВыходныеИзделия.Ссылка)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_УчетСН КАК ВТ_УчетСН
	               |		ПО ЭтапПроизводства2_2ВыходныеИзделия.Номенклатура = ВТ_УчетСН.Ссылка
	               |ГДЕ
	               |	ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.Проведен
	               |	И НЕ ЭтапПроизводства2_2ВыходныеИзделия.Отменено
	               |	И ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.Статус В (ЗНАЧЕНИЕ(Перечисление.СтатусыЭтаповПроизводства2_2.Начат))
	               |	И НЕ ЭтапПроизводства2_2ВыходныеИзделия.Произведено
				   //|";
				   |	&УсловиеНоменклатура
				   |	&УсловиеЗаказКлиента  
				   |
	               |СГРУППИРОВАТЬ ПО
	               |	ЭтапПроизводства2_2ВыходныеИзделия.Ссылка,
	               |	ЕСТЬNULL(ВТ_УчетСН.Значение, ЛОЖЬ),
	               |	ВЫБОР
	               |		КОГДА ЕСТЬNULL(ВТ_УчетСН.Значение, ЛОЖЬ) = ЛОЖЬ
	               |			ТОГДА 0
	               |		ИНАЧЕ 1
	               |	КОНЕЦ,
	               |	ЭтапПроизводства2_2ВыходныеИзделия.Номенклатура,
	               |	ЭтапПроизводства2_2ВыходныеИзделия.Назначение,
	               |	ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.ФактическоеНачалоЭтапа,
	               |	ЕСТЬNULL(ТТМ_УчетСерийныхНомеровПродукции.СерийныйНомер, """"),
	               |	ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.КоличествоУпаковокПлан,
	               |	ЕСТЬNULL(ТТМ_УчетСерийныхНомеровПродукции.ШильдЗаказан, ЛОЖЬ)
				   |УПОРЯДОЧИТЬ ПО                     
				   |	ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.ФактическоеНачалоЭтапа,
				   |	ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.Дата,
				   |	ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.Номер,
	               |	ЕСТЬNULL(ТТМ_УчетСерийныхНомеровПродукции.СерийныйНомер, """")";
				 //|	ЭтапПроизводства2_2ВыходныеИзделия.Назначение";
				   
//|	И ЭтапПроизводства2_2ВыходныеИзделия.Номенклатура В(&Номенклатура)
//|	И ЭтапПроизводства2_2ВыходныеИзделия.Назначение.Заказ В(&Заказ)" 
	
	Если СтруктураОтбора.Свойство("Номенклатура") и ЗначениеЗаполнено(СтруктураОтбора.Номенклатура) Тогда 
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"&УсловиеНоменклатура"," И ЭтапПроизводства2_2ВыходныеИзделия.Номенклатура = &Номенклатура ");		
		Запрос.УстановитьПараметр("Номенклатура",Объект.Номенклатура);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"&УсловиеНоменклатура","");
	КонецЕсли;
	
	Если СтруктураОтбора.Свойство("ЗаказКлиента") и ЗначениеЗаполнено(СтруктураОтбора.ЗаказКлиента) Тогда 
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"&УсловиеЗаказКлиента"," И ЭтапПроизводства2_2ВыходныеИзделия.Назначение.Заказ = &Заказ ");
		Запрос.УстановитьПараметр("Заказ", Объект.ЗаказКлиента);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"&УсловиеЗаказКлиента","");
	КонецЕсли;  
	Запрос.УстановитьПараметр("Свойство", ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("Имя","УчитываатьСерийныеНомераНоменклатуры_ТТМ"));
	
	Попытка
		ТЗЭтапы = Запрос.Выполнить().Выгрузить();
		Объект.ТабЭтапы.Загрузить(ТЗЭтапы); 
		Возврат Истина;
	Исключение   
		Сообщить(ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

