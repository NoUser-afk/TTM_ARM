&НаКлиенте
Процедура ВосстановитьСостояниеДерева(ИмяДерева)
	
	//ЭтаФорма[ИияДерева].Сортировать("ТекущаяСтрока возр");
	//Элементы[ИмяДерева].Сортировать("ТекущаяСтрока возр");                 
	Если ТекСтраница = "Списание" Тогда 
		ИмяТаблицыИдентификаторов = "ИдентификаторыРаскрытыхСтрокДереваМатериалов";
	ИначеЕсли ТекСтраница = "Резервирование" Тогда 
		ИмяТаблицыИдентификаторов = "ИдентификаторыРаскрытыхСтрокДереваМатериаловРезервирование"
	КонецЕсли;
	//ИдентификаторыРаскрытыхСтрокДереваМатериаловРезервирование.Сортировать("ТекущаяСтрока возр");
	///ЭтаФорма[ИмяТаблицыИдентификаторов].Сортировать("ТекущаяСтрока возр");
	МассивУдаляемыхСтрок = Новый Массив;
	Для Каждого СтрТаб из ЭтаФорма[ИмяТаблицыИдентификаторов] Цикл 
		Если ЭтаФорма[ИмяДерева].НайтиПоИдентификатору(СтрТаб.Идентификатор) <> Неопределено Тогда
			Если СтрТаб.ТекущаяСтрока = Ложь Тогда 
			   Элементы[ИмяДерева].Развернуть(СтрТаб.Идентификатор);
			Иначе 
				Элементы[ИмяДерева].ТекущаяСтрока = СтрТаб.Идентификатор;
			КонецЕсли;
		Иначе 
			//удалим идентификатор из таблицы, так как строки с таким идентификатором больше нет в дереве
			МассивУдаляемыхСтрок.Добавить(СтрТаб);
		КонецЕсли;
	КонецЦикла;
	Для Каждого УдаляемаяСтрока из МассивУдаляемыхСтрок Цикл 
		ЭтаФорма[ИмяТаблицыИдентификаторов].Удалить(УдаляемаяСтрока);
	КонецЦикла;
			
КонецПроцедуры

&НаСервере
Функция ПолучитьМатериалыПоЭтапам(ОтборПоВариантамОбеспечения, ДатаОстатков, Склад, Списание)
	
	Если Списание тогда
		ТаблицаЭтапов = РеквизитФормыВЗначение("Этапы",Тип("ТаблицаЗначений"));
	Иначе 
		ТаблицаЭтапов = РеквизитФормыВЗначение("ЭтапыРезервирование",Тип("ТаблицаЗначений"));
	КонецЕсли;
	Если ТаблицаЭтапов.Количество() = 0 Тогда 
		Возврат Неопределено;
	КонецЕсли;
	
	ТекстЗапросаУсловие = СформироватьТекстУсловияДляЗапроса(ОтборПоВариантамОбеспечения, Списание);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТабЭтапы.Обрабатывать КАК Обрабатывать,
	               |	ТабЭтапы.Статус КАК Статус,
	               |	ТабЭтапы.ЭтапПроизводства КАК ЭтапПроизводства,
	               |	ТабЭтапы.КоличествоУпаковокФакт КАК КоличествоУпаковокФакт,
