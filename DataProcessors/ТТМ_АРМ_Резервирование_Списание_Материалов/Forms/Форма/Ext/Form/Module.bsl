&НаКлиенте
Процедура РазвернутьВсеСтрокидерева(Команда)
	
	Если ТекСтраница = "Списание" Тогда 
		ИмяДерева = "ДеревоМатериалов";        
		ИмяТаблицыИдентификаторов = "ИдентификаторыРаскрытыхСтрокДереваМатериалов";
		Строки1Уровня = ЭтаФорма.ДеревоМатериалов.ПолучитьЭлементы();
	ИначеЕсли ТекСтраница = "Резервирование" Тогда 
		ИмяДерева = "ДеревоМатериаловРезервирование";
		ИмяТаблицыИдентификаторов = "ИдентификаторыРаскрытыхСтрокДереваМатериаловРезервирование";
		Строки1Уровня = ЭтаФорма.ДеревоМатериаловРезервирование.ПолучитьЭлементы();
	КонецЕсли;                
	ДанныеТекущейСтроки = Элементы[ИмяДерева].ТекущиеДанные;                  
	ЭтаФорма[ИмяТаблицыИдентификаторов].Очистить();
	НовыйИД = ЭтаФорма[ИмяТаблицыИдентификаторов].Добавить();
	НовыйИД.ТекущаяСтрока = Ложь;//Истина;
	НовыйИД.Номенклатура = ДанныеТекущейСтроки.Номенклатура;
	НовыйИД.ИсходнаяНоменклатура = ДанныеТекущейСтроки.ИсходнаяНоменклатура;
	НовыйИД.ЭтапПроизводства = ДанныеТекущейСтроки.ЭтапПроизводства;
	НовыйИД.Идентификатор = ДанныеТекущейСтроки.ПолучитьИдентификатор();
	Для Стр = 0 по Строки1Уровня.Количество()-1 Цикл 
		ТекСтрока = Строки1Уровня.Получить(Стр);
		Элементы[ИмяДерева].Развернуть(ТекСтрока.ПолучитьИдентификатор()); 
		НоваяСтрока = ЭтаФорма[ИмяТаблицыИдентификаторов].Добавить();
		НоваяСтрока.ТекущаяСтрока = Ложь;
		НоваяСтрока.Номенклатура = ТекСтрока.Номенклатура;
		НоваяСтрока.ИсходнаяНоменклатура = ТекСтрока.ИсходнаяНоменклатура;
		НоваяСтрока.ЭтапПроизводства = ПредопределенноеЗначение("Документ.ЭтапПроизводства2_2.ПустаяСсылка");
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СвернутьВсеСтрокиДерева(Команда)
	
	Если ТекСтраница = "Списание" Тогда 
		ИмяДерева = "ДеревоМатериалов";   
		ИмяТаблицыИдентификаторов = "ИдентификаторыРаскрытыхСтрокДереваМатериалов";
	ИначеЕсли ТекСтраница = "Резервирование" Тогда 
		ИмяДерева = "ДеревоМатериаловРезервирование";  
		ИмяТаблицыИдентификаторов = "ИдентификаторыРаскрытыхСтрокДереваМатериаловРезервирование";
	КонецЕсли;     
	
	ДанныеТекущейСтроки = Элементы[ИмяДерева].ТекущиеДанные; 
	НовыйИД = ЭтаФорма[ИмяТаблицыИдентификаторов].Добавить();
	НовыйИД.ТекущаяСтрока = Истина;
	НовыйИД.Номенклатура = ДанныеТекущейСтроки.Номенклатура;
	НовыйИД.ИсходнаяНоменклатура = ДанныеТекущейСтроки.ИсходнаяНоменклатура;
	НовыйИД.ЭтапПроизводства = ПредопределенноеЗначение("Документ.ЭтапПроизводства2_2.ПустаяСсылка");
	НовыйИД.Идентификатор = ДанныеТекущейСтроки.ПолучитьИдентификатор();
	
	Строки1Уровня = ЭтаФорма[ИмяДерева].ПолучитьЭлементы();
	Для Стр = 0 по Строки1Уровня.Количество()-1 Цикл 
		ТекСтрока = Строки1Уровня.Получить(Стр);
		Элементы[ИмяДерева].Свернуть(ТекСтрока.ПолучитьИдентификатор());
	КонецЦикла;  
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЭтапыНаСервере(перемЭтапы,Списание); 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЭтапПроизводства2_2ВыходныеИзделия.Ссылка КАК Ссылка,
	               |	СУММА(ЭтапПроизводства2_2ВыходныеИзделия.Количество) КАК Количество
	               |ПОМЕСТИТЬ ВТ_КоличествоПроизведено
	               |ИЗ
	               |	Документ.ЭтапПроизводства2_2.ВыходныеИзделия КАК ЭтапПроизводства2_2ВыходныеИзделия
	               |ГДЕ
	               |	ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.Проведен
	               |	И ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.Организация = &Организация ";
	Если Списание Тогда Запрос.Текст = Запрос.Текст + "
	               |	И ЭтапПроизводства2_2ВыходныеИзделия.Произведено ";
	КонецЕсли;
	Запрос.Текст = Запрос.Текст + "
	               |	И ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЭтаповПроизводства2_2.Начат)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЭтапПроизводства2_2ВыходныеИзделия.Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ       
				   |	1 КАК НомерСтроки,
	               |	ИСТИНА КАК Обрабатывать,
	               |	ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.Статус КАК Статус,
	               |	ЭтапПроизводства2_2ВыходныеИзделия.Ссылка КАК ЭтапПроизводства,
	               |	ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.КоличествоУпаковокФакт КАК КоличествоУпаковокФакт,
	               |	ЭтапПроизводства2_2ВыходныеИзделия.Назначение КАК Назначение,
				   |	ЭтапПроизводства2_2ВыходныеИзделия.Номенклатура КАК Номенклатура,
	               |	ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.Спецификация КАК Спецификация
	               |ИЗ
	               |	Документ.ЭтапПроизводства2_2.ВыходныеИзделия КАК ЭтапПроизводства2_2ВыходныеИзделия
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_КоличествоПроизведено КАК ВТ_КоличествоПроизведено
	               |		ПО ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.Ссылка = ВТ_КоличествоПроизведено.Ссылка";                       
	Если Списание Тогда Запрос.Текст = Запрос.Текст + "			   
	               |			И ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.КоличествоУпаковокПлан = ВТ_КоличествоПроизведено.Количество";
	КонецЕсли;
	Запрос.Текст = Запрос.Текст + "
	               |ГДЕ
	               |	ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.Проведен
	               |	И ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.Организация = &Организация
	               
	               |	И ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЭтаповПроизводства2_2.Начат)";
	               
	Если Списание Тогда 
		Запрос.Текст = Запрос.Текст + "
		            |	И ЭтапПроизводства2_2ВыходныеИзделия.Произведено";
					//|	И НАЧАЛОПЕРИОДА(ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.ДатаПроизводства, ДЕНЬ) = &Период
					//|	И НЕ ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЭтаповПроизводства2_2.Завершен)
					//|	И ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.КоличествоУпаковокФакт = 0.5";  
		Если ЗначениеЗаполнено(Объект.Номенклатура)  Тогда //или ЗначениеЗаполнено(Объект.НоменклатураРезервирование)
			Запрос.Текст = Запрос.Текст + "
	               |	И ЭтапПроизводства2_2ВыходныеИзделия.Номенклатура = &Номенклатура";
		КонецЕсли;
		Если ЗначениеЗаполнено(Объект.ПериодОтгрузки)  Тогда //или ЗначениеЗаполнено(Объект.НоменклатураРезервирование)
			Запрос.Текст = Запрос.Текст + "
	               |	И НАЧАЛОПЕРИОДА(ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.ДатаПроизводства, ДЕНЬ) = &Период";
		КонецЕсли;
	Иначе 
		Запрос.Текст = Запрос.Текст + "
					//|	И НАЧАЛОПЕРИОДА(ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.ФактическоеНачалоЭтапа, ДЕНЬ) = &Период
		           	|	И ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.КоличествоУпаковокФакт <= 0.5";
		Если ЗначениеЗаполнено(Объект.НоменклатураРезервирование)  Тогда 
			Запрос.Текст = Запрос.Текст + "
	               |	И ЭтапПроизводства2_2ВыходныеИзделия.Номенклатура = &Номенклатура";
		КонецЕсли;
		Если ЗначениеЗаполнено(Объект.ДатаЗапуска)  Тогда //или ЗначениеЗаполнено(Объект.НоменклатураРезервирование)
			Запрос.Текст = Запрос.Текст + "
	               |	И НАЧАЛОПЕРИОДА(ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.ФактическоеНачалоЭтапа, ДЕНЬ) = &Период";
		КонецЕсли;
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.НомерЗаказа) или ЗначениеЗаполнено(Объект.НомерЗаказаРезервирование) Тогда 
		Запрос.Текст = Запрос.Текст + "	
	               |	И ЭтапПроизводства2_2ВыходныеИзделия.Назначение.Наименование ПОДОБНО ""%"" + &НомерЗаказа + ""%""";
	КонецЕсли;
	
	//Запрос.УстановитьПараметр("ТабЭтапы",перемЭтапы);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Если Не Списание Тогда 
		Запрос.УстановитьПараметр("Период",?(ЗначениеЗаполнено(Объект.ДатаЗапуска),Объект.ДатаЗапуска,ТекущаяДатаСеанса()));
		Запрос.УстановитьПараметр("Номенклатура",Объект.НоменклатураРезервирование);
		Запрос.УстановитьПараметр("НомерЗаказа",Объект.НомерЗаказаРезервирование);
	Иначе 
		Запрос.УстановитьПараметр("Период",?(ЗначениеЗаполнено(Объект.ПериодОтгрузки),Объект.ПериодОтгрузки,ТекущаяДатаСеанса()));
		Запрос.УстановитьПараметр("Номенклатура",Объект.Номенклатура);
		Запрос.УстановитьПараметр("НомерЗаказа",Объект.НомерЗаказа);
	КонецЕсли;
		
	ТабЭтапы = Запрос.Выполнить().Выгрузить();  
	
	//Заполним номера строк
	Счетчик = 0;
	Для Каждого СтрЭтап из ТабЭтапы Цикл 
		Счетчик = Счетчик + 1;
		СтрЭтап.НомерСтроки = Счетчик;
	КонецЦикла;
	
	ЗначениеВДанныеФормы(ТабЭтапы,перемЭтапы);
	Если Списание Тогда 
		КопироватьДанныеФормы(перемЭтапы,Этапы);
	Иначе 
		КопироватьДанныеФормы(перемЭтапы,ЭтапыРезервирование);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЭтапы(Команда)
	Если ТекСтраница = "Списание" Тогда 
		Списание = Истина;
	ИначеЕсли ТекСтраница = "Резервирование" Тогда 
		Списание = Ложь;
	КонецЕсли;
		
	ЗаполнитьЭтапыСВопросом(Списание);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЭтапыСВопросом(Списание)
	
	ДопПараметры = Новый Структура("Списание",Списание);
	ОповещениеПослеВопроса = Новый ОписаниеОповещения("ЗаполнитьЭтапыПродолжение",ЭтаФорма,ДопПараметры);
	ПоказатьВопрос(ОповещениеПослеВопроса,"Обновить список этапов?",РежимДиалогаВопрос.ДаНет,);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЭтапыПродолжение(Результат, ДопПараметры)  Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда 
		Если ДопПараметры.Списание Тогда 
			Этапы.Очистить();	
			ПеремЭтапы = Этапы;
			
			//КопироватьДанныеФормы(Этапы,перемЭтапы);
			ЗаполнитьЭтапыНаСервере(ПеремЭтапы, Истина);
		Иначе 
			ЭтапыРезервирование.Очистить();
			ПеремЭтапыР = ЭтапыРезервирование;
			//КопироватьДанныеФормы(Этапы,перемЭтапы);
			ЗаполнитьЭтапыНаСервере(ПеремЭтапыР, Ложь);
		КонецЕсли;
		
		
	КонецЕсли;                                              
	//УстановитьУсловноеОформлениеДереваМатериалов(
	//УстановитьУсловноеОформлениеСпискаЭтаповРезервирование();
	
КонецПроцедуры

&НаКлиенте
Процедура НомерЗаказаОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
	Текст = СокрЛП(Текст);
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьВыделениеВсехЭтапов(Команда)
	
	Если Элементы.Страницы.ТекущаяСтраница.Имя = "Списание" Тогда 
		Для Каждого СтрокаТЧ из Этапы Цикл 
			СтрокаТЧ.Обрабатывать = Ложь;
		КонецЦикла;
	ИначеЕсли Элементы.Страницы.ТекущаяСтраница.Имя = "Резервирование"  Тогда 
		Для Каждого СтрокаТЧ из ЭтапыРезервирование Цикл 
			СтрокаТЧ.Обрабатывать = Ложь;
		КонецЦикла;
	КонецЕсли;
	//КопироватьДанныеФормы(Этапы, Этапы);
КонецПроцедуры

&НаКлиенте
Процедура Группа1ПриСменеСтраницы(Элемент, ТекущаяСтраница)
	Если ТекущаяСтраница.Имя = "Списание" или ТекущаяСтраница.Имя = "СтраницаМатериалы" Тогда 
		//Переход на списание
		ТекСтраница = "Списание";
		ИмяДерева = Элементы.ДеревоМатериалов.Имя;                         
		Если Элементы.СтраницыРезервирования.ТекущаяСтраница.Имя = "МатериалыРезервирования" Тогда 
			СтраницаМатериалыРезервированиеАктивна = Истина;
		Иначе 
			СтраницаМатериалыРезервированиеАктивна = Ложь;
		КонецЕсли;
		Если ЕстьНесохраненныеДанныеРезервирования и СтраницаМатериалыРезервированиеАктивна Тогда  
			ДопПараметры = Новый Структура("ВернутьсяНаСтраницуМатериаловСписания", Ложь);
			ОповещениеОПродолженииПерехода = Новый ОписаниеОповещения("ПереходНаСПисаниеРезервированиеПродолжение",ЭтаФорма, ДопПараметры);
			ПоказатьВопрос(ОповещениеОПродолженииПерехода, "Есть несохраненные данные Списания, при переходе на Резервирование ни будут утеряны, продолжить?",РежимДиалогаВопрос.ДаНет,10) 
		КонецЕсли;
		//Элементы.СтраницыРезервирования.ТекущаяСтраница = Элементы.Найти("Этапы");
		//Если Элементы.СтраницыСписания.ТекущаяСтраница.Имя = "СтраницаМатериалы"  Тогда 
		//	УстановитьУсловноеОформлениеДереваМатериалов(ИмяДерева);
		//КонецЕсли;
	ИначеЕсли ТекущаяСтраница.Имя = "Резервирование" или ТекущаяСтраница.Имя = "МатериалыРезервирования" Тогда   
		//переход на резервирование
		ТекСтраница = "Резервирование";
		ИмяДерева = Элементы.ДеревоМатериаловРезервирование.Имя;    
		Если Элементы.СтраницыСписания.ТекущаяСтраница.Имя = "СтраницаМатериалы" Тогда 
			СтраницаМатериалыАктивна = Истина;
		Иначе 
			СтраницаМатериалыАктивна = Ложь;
		КонецЕсли;
		Если ЕстьНесохраненныеДанныеСписания и СтраницаМатериалыАктивна Тогда
			ДопПараметры = Новый Структура("ВернутьсяНаСтраницуМатериаловСписания", Истина);
			ОповещениеОПродолженииПерехода = Новый ОписаниеОповещения("ПереходНаСПисаниеРезервированиеПродолжение",ЭтаФорма, ДопПараметры);
