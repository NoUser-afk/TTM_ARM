&НаСервере
Процедура ОбновитьВариантОбеспеченияВСтрокеРегистра(СтрокаДерева, ЭтоСписание, ВариантОбеспеченияНовый, ОтборПоВариантуОбеспечения)
		
	НЗ = РегистрыСведений.ТТМ_АРМ_РезервированиеСписаниеМатериалов.СоздатьНаборЗаписей();
	НЗ.Отбор.Пользователь.Установить(Пользователи.АвторизованныйПользователь());
	НЗ.Отбор.ЭтоСПисание.Установить(ЭтоСписание);
	//НЗ.Отбор.ИдентификаторСтрокиРегистра.Установить(СтрокаДерева.ИдентификаторСтрокиРегистра);
	НЗ.Отбор.Номенклатура.Установить(СтрокаДерева.Номенклатура);
	НЗ.Отбор.ЭтапПРоизводства.Установить(СтрокаДерева.ЭтапПроизводства);
	НЗ.Отбор.ВариантОбеспечения.Установить(СтрокаДерева.ВариантОбеспечения);
	НЗ.Прочитать();
	Если НЗ.Количество() = 1 Тогда 
		//нашли единственную строку  //Добавить пропуск отгруженных строк
		НЗ[0].ВариантОбеспечения = ВариантОбеспеченияНовый; //Перечисления.ВариантыОбеспечения.СоСклада;
		НЗ[0].ОтборПоВариантамОбеспечения = ОтборПоВариантуОбеспечения; //4; 
		НЗ[0].ДатаОтгрузки = ?(ЭтоСписание,Объект.ПериодОтгрузки,СтрокаДерева.ЭтапПроизводства.ДатаОтгрузки); 
		//Если не НЗ[0].ВариантОбеспечения = Перечисления.ВариантыОбеспечения.УдалитьОбособленно Тогда 
		//	НЗ[0].Назначение = Справочники.Назначения.ПустаяСсылка();
		//КонецЕсли;
		Если НЗ[0].ВариантОбеспечения = Перечисления.ВариантыОбеспечения.СоСклада и НЗ[0].Обособленно Тогда 
			НЗ[0].Обособленно = Ложь; 
			НЗ[0].Назначение = Справочники.Назначения.ПустаяСсылка();
		ИначеЕсли НЗ[0].ВариантОбеспечения = Перечисления.ВариантыОбеспечения.РезервироватьПоМереПоступления Тогда  
			Если не НЗ[0].Обособленно Тогда 
				НЗ[0].Обособленно = Истина; 
				НЗ[0].Назначение = Справочники.Назначения.ПустаяСсылка(); //Проверить!!!!
			Иначе 
				НазначениеПродукции = СтрокаДерева.ЭтапПроизводства.ВыходныеИзделия[0].Назначение;
				НЗ[0].Назначение = НазначениеПродукции; //Проверить!!!!
			КонецЕсли;   
		ИначеЕсли НЗ[0].ВариантОбеспечения = Перечисления.ВариантыОбеспечения.КОбеспечению Тогда
			Если не НЗ[0].Обособленно Тогда 
				НЗ[0].Назначение = Справочники.Назначения.ПустаяСсылка(); //Проверить!!!!
			Иначе 
				НазначениеПродукции = СтрокаДерева.ЭтапПроизводства.ВыходныеИзделия[0].Назначение;
				НЗ[0].Назначение = НазначениеПродукции; //Проверить!!!!
			КонецЕсли;
		ИначеЕсли НЗ[0].ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Отгрузить Тогда 
			НЗ[0].Обособленно = Ложь;
			НЗ[0].Назначение = Справочники.Назначения.ПустаяСсылка();
		КонецЕсли;
	ИначеЕсли НЗ.Количество() > 1 Тогда 
		Сообщить("Найдено более 1 строки регистра для резервирования! Уточните параметры поиска!",СтатусСообщения.Важное);
	Иначе 
		Сообщить("Не найдено строки для корректировки данных! Уточните параметры поиска!", СтатусСообщения.Важное);
	КонецЕсли;
	НЗ.Отбор.Найти("ВариантОбеспечения").Использование = Ложь;
	НЗ.Записать();
	
КонецПроцедуры

