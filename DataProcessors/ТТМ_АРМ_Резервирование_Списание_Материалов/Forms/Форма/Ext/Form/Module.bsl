&НаКлиенте
Процедура СтраницыРезервированияПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	ИмяДерева = "ДеревоМатериаловРезервирование";         
	ИмяТаблицыИдентификаторов = "ИдентификаторыРаскрытыхСтрокДереваМатериаловРезервирование";
	Если ТекущаяСтраница.Имя = "МатериалыРезервирования" Тогда  
		ЗаполнитьСпецификациюПоВыбраннымЭтапам("ЭтапыРезервирование",Ложь);
		ОбновитьДанныеПоМатериаламНаСервере(ИмяДерева, Истина);  
		//ОбновитьИдентификаторыСтрокДерева(ИмяДерева);
		//ОбновитьИдентификаторыСтрокДереваНовая(ИмяДерева,ИмяТаблицыИдентификаторов, Элементы[ИмяДерева].ТекущиеДанные);
		ВосстановитьСостояниеДерева(ИмяДерева);      
		//УстановитьУсловноеОформлениеДереваМатериалов("ДеревоМатериаловРезервирование");
	ИначеЕсли ТекущаяСтраница.Имя = "ЭтапыРезервирования" Тогда  
		Если ДеревоМатериаловРезервирование.ПолучитьЭлементы().Количество() > 0 Тогда 
			ДопПарметры = Новый Структура;
			ДопПарметры.Вставить("ЭтоСписание",Ложь); 
			ДопПарметры.Вставить("ИмяДерева",ИмяДерева);
			ДопПарметры.Вставить("ИмяТаблицыИдентификаторов",ИмяТаблицыИдентификаторов);
			ОповещениеПриПереходеНаСтрЭтапы = Новый ОписаниеОповещения("ПереходНаСтрЭтапыПродолжение",ЭтаФорма,ДопПарметры);
			ПоказатьВопрос(ОповещениеПриПереходеНаСтрЭтапы,"Данные по корректировке материалов будут утеряны, продолжить?",РежимДиалогаВопрос.ДаНет, 300);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПереходНаСтрЭтапыПродолжение(Результат, ДопПараметры) Экспорт   
	
	Если Результат = КодВозвратаДиалога.Да Тогда 
		УдалитьМатериалыДляКорректирвокиИзРегистра(ДопПараметры.ЭтоСписание);
		ЭтаФорма[ДопПараметры.ИмяТаблицыИдентификаторов].Очистить();
	Иначе 
		Если Элементы.СтраницыСписания.ТекущаяСтраница.Имя = "СтраницаЭтапы" Тогда 
			Элементы.СтраницыСписания.ТекущаяСтраница = Элементы.СтраницаМатериалы;
		ИначеЕсли Элементы.СтраницыРезервирования.ТекущаяСтраница.Имя = "ЭтапыРезервирования" Тогда 
			Элементы.СтраницыРезервирования.ТекущаяСтраница = Элементы.МатериалыРезервирования;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура УдалитьМатериалыДляКорректирвокиИзРегистра (ЭтоСписание)
	НЗ = РегистрыСведений.ТТМ_АРМ_РезервированиеСписаниеМатериалов.СоздатьНаборЗаписей();
	НЗ.Отбор.Пользователь.Установить(Пользователи.АвторизованныйПользователь());
	НЗ.Отбор.этоСписание.Установить(ЭтоСписание);
	НЗ.Прочитать();
	НЗ.Очистить();
	НЗ.Записать();
КонецПроцедуры

