&НаСервере
Процедура УстановитьВариантОбеспеченияНаСервере(ИмяДерева,ЭтоСписание,ВариантОбеспеченияДо, ВариантОбеспеченияПосле)
	//////////1. Получим данные регистра с учетом отборов (Категория материала, ОтборПоВариантамОбеспечения, Пользователь, ЭтоСписание, ВариантОбеспечения (исходный))
	//////////2. Изменим данные в соответствии с данными дерева (синхронизация по полю ИдентификаторСтрокиРегистра)
	//////////3. Загрузить новые данные в регистр
	Дерево = РеквизитФормыВЗначение(ИмяДерева,Тип("ДеревоЗначений"));
	ТекНоменклатура = Справочники.Номенклатура.ПустаяСсылка();
	Для Каждого Строка из Дерево.Строки Цикл 
		Если ТекНоменклатура <> Строка.Номенклатура Тогда
			ТекНоменклатура = Строка.Номенклатура;
			ТекОстаток = Строка.Остаток;
		КонецЕсли;       
		НоменклатураБезОстатка = Новый ТаблицаЗначений;
		НоменклатураБезОстатка.Колонки.Добавить("Номенклатура",Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
		НоменклатураБезОстатка.Колонки.Добавить("Этап",Новый ОписаниеТипов("ДокументСсылка.ЭтапПроизводства2_2"));
		
		//ОстатокПослеРезервированияВсехСтрокПоНоменклатуре = ТекОстаток - Строка.Обеспечить;
		//ТекстНачалаСообщения = "Отсутствует остаток для резервирования по номенклатуре ";
		//ТекстСообщенияОтсутствуетОстаток = "";
		Для Каждого Стр из Строка.Строки Цикл 
			Если ТекНоменклатура = Стр.Номенклатура и (ВариантОбеспеченияПосле = Перечисления.ВариантыОбеспечения.СоСклада 
				или ВариантОбеспеченияПосле = Перечисления.ВариантыОбеспечения.Отгрузить) тогда
				ТекОстаток = ТекОстаток - Стр.Обеспечить;
				Если ТекОстаток < 0 Тогда 
					//Сообщить("Отсутствует остаток для резервирования по номенклатуре "+Стр.Номенклатура + ", " + Стр.ЭтапПроизводства + Символы.ПС,СтатусСообщения.Важное);
					//ТекстСообщенияОтсутствуетОстаток = ТекстНачалаСообщения + " " + Стр.Номенклатура + ", " + Стр.ЭтапПроизводства + Символы.ПС;
					ПараметрыПоиска = Новый Структура("Номенклатура,Этап");
					МассивСтрокБезОстатка = НоменклатураБезОстатка.НайтиСтроки(ПараметрыПоиска);
					Если МассивСтрокБезОстатка.Количество() = 0 Тогда 
						НоваяСтрока = НоменклатураБезОстатка.Добавить();
						НоваяСтрока.Номенклатура = Стр.Номенклатура ;
						НоваяСтрока.Этап = Стр.ЭтапПроизводства;     
					КонецЕсли;
					
					Продолжить;
					
				КонецЕсли;
			КонецЕсли;
