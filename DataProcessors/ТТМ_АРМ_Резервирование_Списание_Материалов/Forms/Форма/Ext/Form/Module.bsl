&НаКлиенте
Функция ЗапомнитьИсходныеДанныеСтроки()
	
	Если ТекСтраница = "Списание" Тогда 
		ИмяДерева = "ДеревоМатериалов";
		ИмяТаблицыИдентификаторов = "ИдентификаторыРаскрытыхСтрокДереваМатериалов";
		ЭтоСписание = Истина;  
		ДанныеТекСтроки = Элементы[ИмяДерева].ТекущиеДанные;
		ИДТекСтроки = ДанныеТекСтроки.ПолучитьИдентификатор();
		ЗаполнитьЗначенияСвойств(ИсходныеДанныеСтрокиДереваМатериалов, ДанныеТекСтроки);
		//ОбновитьИДТекущейСтроки(ИмяДерева, ИмяТаблицыИдентификаторов,ДанныеТекСтроки.Номенклатура, ДанныеТекСтроки.ЭтапПроизводства, ИДТекСтроки);
		Возврат ИсходныеДанныеСтрокиДереваМатериалов;
	ИначеЕсли ТекСтраница = "резервирование" Тогда 
		ИмяДерева = "ДеревоМатериаловРезервирование";    
		ИмяТаблицыИдентификаторов = "ИдентификаторыРаскрытыхСтрокДереваМатериаловРезервирование";
		ЭтоСписание = Ложь; 
		ДанныеТекСтроки = Элементы[ИмяДерева].ТекущиеДанные;
		ИДТекСтроки = ДанныеТекСтроки.ПолучитьИдентификатор();
		ЗаполнитьЗначенияСвойств(ИсходныеДанныеСтрокиДереваМатериаловРезервирование, ДанныеТекСтроки);
		//ОбновитьИДТекущейСтроки(ИмяДерева, ИмяТаблицыИдентификаторов,ДанныеТекСтроки.Номенклатура, ДанныеТекСтроки.ЭтапПроизводства, ИДТекСтроки);
		Возврат ИсходныеДанныеСтрокиДереваМатериаловРезервирование;
	КонецЕсли;
	
КонецФункции

&НаСервере
//
//Делаем отбор по старой номенклатуре (НЗ) и по новой (НЗ1). Затем добавляем строку в новый набор и заполняем по старой номенклатуре. Старый набор очищаем, Новый записываем
//
//
Процедура ЗаменаМатериалаВРегистре(МассивСтруктурОбрабатываемыхСтрок, ТекСтрока, ЭтоСписание)
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Пользователь = Пользователи.АвторизованныйПользователь(); 
	Для Каждого Стр из МассивСтруктурОбрабатываемыхСтрок Цикл 
		НЗ=РегистрыСведений.ТТМ_АРМ_РезервированиеСписаниеМатериалов.СоздатьНаборЗаписей();
		НЗ.Отбор.ЭтоСписание.Установить(ЭтоСписание);
		НЗ.Отбор.Пользователь.Установить(Пользователь);
		НЗ.Отбор.Номенклатура.Установить(Стр.Номенклатура); 
		Если ЗначениеЗаполнено(Стр.ЭтапПроизводства) Тогда 
			НЗ.Отбор.ЭтапПроизводства.Установить(Стр.ЭтапПроизводства);
		КонецЕсли;
		Если ЗначениеЗаполнено(Стр.ВариантОбеспечения) Тогда 
			НЗ.Отбор.ВариантОбеспечения.Установить(Стр.ВариантОбеспечения); 
		КонецЕсли;
		Если ЗначениеЗаполнено(Стр.Спецификация) Тогда 
			НЗ.Отбор.СпецификацияЭтапа.Установить(Стр.Спецификация);      
		КонецЕсли;
		НЗ.Прочитать();
		//Стр = НЗ[0];  
		
		НЗ1=РегистрыСведений.ТТМ_АРМ_РезервированиеСписаниеМатериалов.СоздатьНаборЗаписей();
		НЗ1.Отбор.ЭтоСписание.Установить(ЭтоСписание);
		НЗ1.Отбор.Пользователь.Установить(Пользователь);
		НЗ1.Отбор.Номенклатура.Установить(ТекСтрока.Номенклатура);
		НЗ1.Прочитать();
		
		Для Каждого СтрНЗ из НЗ Цикл 
			//Сообщить(Строка(НЗ.Количество()) + " строк будет удалено из регистра."); 
			//Стр.Номенклатура = ТекСтрока.Номенклатура;
			
			ЕдиницаИзмерения = ТекСтрока.Номенклатура.ЕдиницаИзмерения; 
						
			НоваяСтрока = НЗ1.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрНЗ);  
			НоваяСтрока.Номенклатура = ТекСтрока.Номенклатура;
			НоваяСтрока.Упаковка = ЕдиницаИзмерения;
			НоваяСтрока.ЕдиницаИзмерения = ЕдиницаИзмерения;
			//НоваяСтрока.ИсходнаяНоменклатура = ТекСтрока.ИсходнаяНоменклатура;
			НоваяСтрока.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.РезервироватьПоМереПоступления;  //.УдалитьОбособленно
			//+22.08.22
			НоваяСтрока.ДатаОтгрузки = Объект.ПериодОтгрузки;   
			НоваяСтрока.ПериодЗатрат = КонецМесяца(Объект.ПериодОтгрузки);
			//-22.08.22
			НоваяСтрока.ОтборПоВариантамОбеспечения = 1;                                                       
			НоваяСтрока.Обособленно = Истина;
			НоваяСтрока.Норматив = 0;
			//НоваяСтрока.Количество = 0;
			НоваяСтрока.КоличествоУпаковок = НоваяСтрока.Количество * НоваяСтрока.Упаковка.Числитель / НоваяСтрока.Упаковка.Знаменатель;
			НоваяСтрока.Обеспечить = СтрНЗ.Норматив; // - СтрНЗ.Количество;
			НоваяСтрока.КатегорияМатериала = ПолучитьКатегориюМатериала(ТекСтрока.Номенклатура);
			НоваяСтрока.Остаток = ОбработкаОбъект.ПолучитьОстаток_2_5(ТекСтрока.Номенклатура,ТекСтрока.Склад);    
			
			Если НЗ1.Количество() > 0 Тогда 
				КлючСвязи = НЗ1[0].КлючСвязиСпецификация;
				НоваяСтрока.КлючСвязиСпецификация = КлючСвязи;
			КонецЕсли;
			
			//??НоваяСтрока.АналитикаУчетаНоменклатуры = Справочники.КлючиАналитикиУчетаНоменклатуры.ПустаяСсылка();
			//??НоваяСтрока.КорАналитикаУчетаНоменклатуры = Справочники.КлючиАналитикиУчетаНоменклатуры.ПустаяСсылка();  
		КонецЦикла;
		
		НЗ.Очистить();
		НЗ.Записать();
		
		НЗ1.Записать();  
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере 
//Остаток получаем по регистру ТоварыНаСкладах.
//Этот регистр не учитывает "мягкий резерв", который формируется и распределяется 
//при выбранном варианте обеспечения  "КОбеспечению" (Требуется) и НЕ "Обособленно"!!!!
Функция ПолучитьОстаток(Номенклатура) 
	
	Запрос = Новый Запрос;      
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТоварыНаСкладахОстатки.Номенклатура КАК Номенклатура,
	               |	ТоварыНаСкладахОстатки.ВНаличииОстаток КАК Остаток
	               |ИЗ
	               |	РегистрНакопления.ТоварыНаСкладах.Остатки(
	               |			&Период,
	               |			Номенклатура = &Номенклатура
	               |				И Склад = &Склад) КАК ТоварыНаСкладахОстатки";
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Склад", Объект.Склад);
	Запрос.УстановитьПараметр("Период", КонецДня(ТекущаяДата()));
	Выборка = Запрос.Выполнить().Выбрать(); 
	Если Выборка.Количество() > 0 Тогда 
		Выборка.Следующий();
		Возврат Выборка.Остаток;
	Иначе 
		Возврат 0;
	КонецЕсли;
КонецФункции

&НаСервере
Функция  ЗаменаМатералаВДереве(ИмяДерева, ИДСтрокиДерева, ЭтоСписание, ДанныеИсходнойСтроки)
//Процедура	
	ТекСтрока = ЭтаФорма[ИмяДерева].НайтиПоИдентификатору(ИДСтрокиДерева);
	ИсходнаяНоменклатура = ДанныеИсходнойСтроки.Номенклатура;
	ДанныеСтроки = Новый Структура("Номенклатура, ИсходнаяНоменклатура, ЭтапПроизводства, ВариантОбеспечения, Спецификация, КлючСвязиСпецификация");  
	МассивСтруктурОбрабатываемыхСтрок = Новый Массив;
	
	Если ТекСтрока <> Неопределено Тогда 
		Если ЗначениеЗаполнено(ИсходнаяНоменклатура) и ТекСтрока.Номенклатура <> ИсходнаяНоменклатура Тогда 
			Если ДанныеИсходнойСтроки.Уровень = 1 Тогда     
				//Надо обработать все строки по номенклатуре    
				ДанныеСтроки.Номенклатура = ИсходнаяНоменклатура;
				//ДанныеСтроки.ИсходнаяНоменклатура = ИсходнаяНоменклатура; 
				МассивСтруктурОбрабатываемыхСтрок.Добавить(ДанныеСтроки);
				ЗаменаМатериалаВРегистре(МассивСтруктурОбрабатываемыхСтрок,ТекСтрока,ЭтоСписание);
			Иначе                                           
				//надо обработать только текущую строку, поэтому структура отбора по полным данным строки
				ЗаполнитьЗначенияСвойств(ДанныеСтроки,ДанныеИсходнойСтроки); 
				МассивСтруктурОбрабатываемыхСтрок.Добавить(ДанныеСтроки);
				ЗаменаМатериалаВРегистре(МассивСтруктурОбрабатываемыхСтрок,ТекСтрока,ЭтоСписание);
			КонецЕсли;
		КонецЕсли
	КонецЕсли;
	
	ОбновитьДанныеПоМатериаламНаСервере(ИмяДерева,Ложь); 
	
	ОбновитьИдентификаторыСтрокДереваПослеИзмененияНоменклатуры(ИмяДерева,ТекСтрока, ИсходнаяНоменклатура);
	//ИДТекСтроки = Элементы[ИмяДерева].ТекущиеДанные.ПолучитьИдентификатор();
	//СтруктураВозврата = Новый Структура("НоваяНоменклатура, ИДТекСтроки", ТекСтрока.Номенклатура);
	Возврат ТекСтрока.Номенклатура; //СтруктураВозврата
	
КонецФункции //Процедуры

&НаСервере
Процедура ОбновитьИдентификаторыСтрокДереваПослеИзмененияНоменклатуры(ИмяДерева,ТекСтрока, ИсходнаяНоменклатура);
		
КонецПроцедуры

&НаСервере
Процедура УдалитьСтрокуРегистра(МассивСтруктурОбрабатываемыхСтрок,ЭтоСписание)
	
	Для Каждого Стр из МассивСтруктурОбрабатываемыхСтрок Цикл 
		НЗ=РегистрыСведений.ТТМ_АРМ_РезервированиеСписаниеМатериалов.СоздатьНаборЗаписей();
		НЗ.Отбор.ЭтоСписание.Установить(ЭтоСписание);
		НЗ.Отбор.Пользователь.Установить(Пользователи.АвторизованныйПользователь());
		НЗ.Отбор.Номенклатура.Установить(Стр.Номенклатура);  
		Если ЗначениеЗаполнено(Стр.ЭтапПроизводства) Тогда 
			НЗ.Отбор.ЭтапПроизводства.Установить(Стр.ЭтапПроизводства);
		КонецЕсли;
		Если ЗначениеЗаполнено(Стр.ВариантОбеспечения) Тогда 
			НЗ.Отбор.ВариантОбеспечения.Установить(Стр.ВариантОбеспечения); 
		КонецЕсли;
		Если ЗначениеЗаполнено(Стр.Спецификация) Тогда 
			НЗ.Отбор.СпецификацияЭтапа.Установить(Стр.Спецификация);      
		КонецЕсли;
		НЗ.Прочитать();
		Сообщить(Строка(НЗ.Количество()) + " строк будет удалено из регистра.");
		НЗ.Очистить();
		НЗ.Записать();
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьСтрокуВРегистр(СтрокаДерева,ЭтоСписание,ДатаОтгрузки)
	
	Пользователь = Пользователи.АвторизованныйПользователь();
	НЗ = РегистрыСведений.ТТМ_АРМ_РезервированиеСписаниеМатериалов.СоздатьНаборЗаписей();
	НЗ.Отбор.Пользователь.Установить(Пользователь);
	НЗ.Отбор.ЭтоСписание.Установить(ЭтоСписание);
	НЗ.Отбор.Номенклатура.Установить(СтрокаДерева.Номенклатура);
	НЗ.Отбор.ЭтапПроизводства.Установить(СтрокаДерева.ЭтапПроизводства);
	НЗ.Отбор.ВариантОбеспечения.Установить(СтрокаДерева.ВариантОбеспечения); //??Почему устанавливается ВариантОбеспечения?? Д.б. "Требуется"!!!
	
	НЗ.Прочитать();
	НоваяСтрока = НЗ.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрокаДерева);
	НоваяСтрока.Пользователь = Пользователь;
	НоваяСтрока.ЭтоСписание = ЭтоСписание;  
	НоваяСтрока.Обеспечить = НоваяСтрока.Количество;     
	//+22.08.22
	НоваяСтрока.ДатаОтгрузки = ДатаОтгрузки;
	НоваяСтрока.ПериодЗатрат = КонецМесяца(ДатаОтгрузки);
	//-22.08.22
	////НоваяСтрока.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Обособленно;
	//??10.03.22 НоваяСтрока.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Требуется;
	//??10.03.22 НоваяСтрока.Обособленно = Истина;
	НоваяСтрока.ОтборПоВариантамОбеспечения = УстановитьЗначениеОтбораПоВариантамОбеспеченияВРегистре(НоваяСтрока.ВариантОбеспечения);
	НоваяСтрока.КлючСвязиСпецификация = СтрокаДерева.КлючСвязиСпецификация;
	
	НЗ.Записать();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция УстановитьЗначениеОтбораПоВариантамОбеспеченияВРегистре(ВариантОбеспечения)
	Если ВариантОбеспечения = Перечисления.ВариантыОбеспечения.РезервироватьПоМереПоступления
		ИЛИ ВариантОбеспечения = Перечисления.ВариантыОбеспечения.КОбеспечению Тогда  //УдалитьОбособленно
		Возврат 1;
	ИначеЕсли ВариантОбеспечения = Перечисления.ВариантыОбеспечения.СоСклада Тогда //или ВариантОбеспечения = Перечисления.ВариантыОбеспечения.УдалитьИзЗаказов
		Возврат 2;
	//ИначеЕсли ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Требуется Тогда 
	//	Возврат 3;	
	ИначеЕсли ВариантОбеспечения = Перечисления.ВариантыОбеспечения.НеТребуется Тогда 
		Возврат 4;
	ИначеЕсли ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Отгрузить Тогда //или ВариантОбеспечения = Перечисления.ВариантыОбеспечения.УдалитьОтгрузитьОбособленно
		Возврат 5;
	КонецЕсли;
КонецФункции
	
