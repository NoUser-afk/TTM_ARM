&НаКлиенте
Процедура ДеревоМатериаловПередУдалением(Элемент, Отказ) 
	
	//Запоминаем данные исходной строки дерева в реквизит формы ИсходныеДанныеСтрокиДереваМатериалов или ИсходныеДанныеСтрокиДереваМатериаловРезервирование
	ДанныеИсходнойСтроки =ЗапомнитьИсходныеДанныеСтроки();
	Если ТекСтраница = "Списание" Тогда 
		ИмяДерева = "ДеревоМатериалов";
		ЭтоСписание = Истина;
	ИначеЕсли ТекСтраница = "Резервирование" Тогда 
		ИмяДерева = "ДеревоМатериаловРезервирование";
		ЭтоСписание = Ложь;
	КонецЕсли;  
	
	
	
	ОчиститьЗаписиРегистраДляУдаления(ДанныеИсходнойСтроки,ЭтоСписание);
	ОбновитьДанныеПоМатериаламНаСервере(ИмяДерева,Ложь);
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьЗаписиРегистраДляУдаления(ДанныеУдаляемойСтроки, ЭтоСписание);
	
	НЗ = РегистрыСведений.ТТМ_АРМ_РезервированиеСписаниеМатериалов.СоздатьНаборЗаписей();
	НЗ.Отбор.Пользователь.Установить(Пользователи.АвторизованныйПользователь());
	НЗ.Отбор.ЭтоСписание.Установить(ЭтоСписание);
	НЗ.Отбор.Номенклатура.Установить(ДанныеУдаляемойСтроки.Номенклатура);    
	Если ЗначениеЗаполнено(ДанныеУдаляемойСтроки.ЭтапПроизводства) Тогда 
		НЗ.Отбор.ЭтапПроизводства.Установить(ДанныеУдаляемойСтроки.ЭтапПроизводства);
	КонецЕсли;
	Если ЗначениеЗаполнено(ДанныеУдаляемойСтроки.ВариантОбеспечения) Тогда 
		НЗ.Отбор.ВариантОбеспечения.Установить(ДанныеУдаляемойСтроки.ВариантОбеспечения);
	КонецЕсли;   
	Если ЗначениеЗаполнено(ДанныеУдаляемойСтроки.Спецификация) Тогда 
		НЗ.Отбор.СпецификацияЭтапа.Установить(ДанныеУдаляемойСтроки.Спецификация);      
	КонецЕсли;
	НЗ.Прочитать();
	НЗ.Очистить();
	НЗ.Записать();
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоМатериаловРезервированиеПередНачаломИзменения(Элемент, Отказ)
	
	ДанныеТекСтроки = ЗапомнитьИсходныеДанныеСтроки(); 
	Если ТекСтраница = "Списание" Тогда 
		ИмяДерева = "ДеревоМатериалов"; 
		ИмяТаблицыИдентификаторов = "ИдентификаторыРаскрытыхСтрокДереваМатериалов";
	ИначеЕсли ТекСтраница = "Резервирование" Тогда 
		ИмяДерева = "ДеревоМатериаловРезервирование"; 
		ИмяТаблицыИдентификаторов = "ИдентификаторыРаскрытыхСтрокДереваМатериаловРезервирование";
	КонецЕсли;
		
	ЗапишемДанныеТекущейСтрокиВТабИД(ИмяДерева,ИмяТаблицыИдентификаторов);
	
КонецПроцедуры


&НаКлиенте
Процедура ОтгрузитьВыбранныеСтроки(Команда)
	Если ТекСтраница = "Списание" Тогда 
		Если ЗначениеЗаполнено(ОтборВариантОбеспечения) Тогда 
			Если ОтборВариантОбеспечения = 3 Тогда 
				Возврат;
				Сообщить("Отгружать материалы не требуется!", СтатусСообщения.Важное);
			ИначеЕсли ОтборВариантОбеспечения = 5 Тогда 
				Возврат;
				Сообщить("Материалы уже отгружены!", СтатусСообщения.Важное);
			КонецЕсли;
		КонецЕсли;
		ЭтоСписание = Истина;
		ИмяДерева = "ДеревоМатериалов";  
		ИмяТаблицыИдентификаторов = "ИдентификаторыРаскрытыхСтрокДереваМатериалов";
	ИначеЕсли ТекСтраница = "Резервирование"  Тогда 
		ЭтоСписание = Ложь;
		ИмяДерева = "ДеревоМатериаловРезервирование";
		ИмяТаблицыИдентификаторов = "ИдентификаторыРаскрытыхСтрокДереваМатериаловРезервирование";
	КонецЕсли; 
		
	СписокВариантовОбеспечения = новый СписокЗначений;
	//СписокВариантовОбеспечения.Добавить(ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.УдалитьОбособленно"));
	СписокВариантовОбеспечения.Добавить(ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.СоСклада"));
	//СписокВариантовОбеспечения.Добавить(ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.УдалитьИзЗаказов"));
	СписокВариантовОбеспечения.Добавить(ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.КОбеспечению"));
	СписокВариантовОбеспечения.Добавить(ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.РезервироватьПоМереПоступления"));
	//СписокВариантовОбеспечения.Добавить(ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.НеТребуется"));
	
	МассивСтруктурОбрабатываемыхСтрок = ПолучитьМассивСтруктурВыбранныхСтрокДляОбработки(СписокВариантовОбеспечения, ИмяДерева, ЭтоСписание);
	ВариантОбеспеченияНовый = ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.Отгрузить");
	ОтборПоВариантуОбеспечения = 5;
	ЗаписатьДанныеВыделенныхСтрокВРегистр(МассивСтруктурОбрабатываемыхСтрок, ИмяДерева, ЭтоСписание, ВариантОбеспеченияНовый, ОтборПоВариантуОбеспечения);
	
	//ТекСтрока = Элементы[ИмяДерева].ТекущиеДанные;
	////ИДТекСтроки = Элемент.ТекущаяСтрока(); 
	//ИДТекСтроки = ТекСтрока.ПолучитьИдентификатор();
	//
	//ОбновитьИДТекущейСтроки(ИмяДерева,ИмяТаблицыИдентификаторов,ТекСтрока.Номенклатура, ТекСтрока.ЭтапПроизводства, ИДТекСтроки);
	ОбновитьДанныеПоМатериаламНаСервере(ИмяДерева,Ложь);
	//ОбновитьИдентификаторыСтрокДерева(ИмяДерева,Неопределено);
	ВосстановитьСостояниеДерева(ИмяДерева);
	
КонецПроцедуры

