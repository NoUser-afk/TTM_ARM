&НаКлиенте
Процедура ПереходНаСПисаниеРезервированиеПродолжение(Результат, ДопПараметры) Экспорт    
	
	Если ДопПараметры.ВернутьсяНаСтраницуМатериаловСписания Тогда 
		//Переход со Списания на Резервирвоание // Возврат на страницу Списание материалов
		Если Результат = КодВозвратаДиалога.Нет Тогда 
			//Отменить переход
			Элементы.Страницы.ТекущаяСтраница = Элементы.Найти("Списание"); // "СтраницаМатериалы"
		Иначе    
			//Переход на страницу Этапы раздела Резервирования
			Элементы.СтраницыРезервирования.ТекущаяСтраница = Элементы.Найти("ЭтапыРезервирования");
			ПеремЭтапы = ЭтапыРезервирование;
			Этапы.Очистить(); 
			Объект.Номенклатура = ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка"); 
			ЗаполнитьЭтапыНаСервере(ПеремЭтапы, Ложь);
			ИдентификаторыРаскрытыхСтрокДереваМатериалов.Очистить();
		КонецЕсли;
	Иначе            
		//Переход с Резервирвоания на Списание //Возврат к резервированию материалов
		Если Результат = КодВозвратаДиалога.Нет Тогда
			Элементы.Страницы.ТекущаяСтраница = Элементы.Найти("Резервирование"); // "МатериалыРезервирования"
		Иначе
			//Переход на страницу Этапы раздела Списание
			Элементы.СтраницыСписания.ТекущаяСтраница = Элементы.Найти("СтраницаЭтапы");  
			ПеремЭтапы = Этапы;
			ЭтапыРезервирование.Очистить();   
			Объект.НоменклатураРезервирование = ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка");
			ЗаполнитьЭтапыНаСервере(ПеремЭтапы, Истина);
			ИдентификаторыРаскрытыхСтрокДереваМатериаловРезервирование.Очистить();
		КонецЕсли;
	КонецЕсли;        
	
КонецПроцедуры

