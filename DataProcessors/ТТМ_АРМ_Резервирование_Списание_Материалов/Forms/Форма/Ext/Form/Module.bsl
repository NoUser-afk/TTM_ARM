&НаСервере
Функция ПолучитьНормативыПоСпецификации(ПолучатьМатериалыПоТребованию, Знач ПереченьДанных = Неопределено, ЭтапОбъект1)
	
	ДанныеПартииПроизводстваКопия = ОбщегоНазначения.СкопироватьРекурсивно(ДанныеПартииПроизводства, Ложь);
	КоэффициентПлан = Справочники.УпаковкиЕдиницыИзмерения.КоэффициентУпаковки
			(ЭтапОбъект1.УпаковкаПлан, Объект.Номенклатура);
	КоличествоПлан = ЭтапОбъект1.КоличествоУпаковокПлан * КоэффициентПлан;
	ДанныеПартииПроизводстваКопия.Количество = КоличествоПлан;	//КоличествоПлан;
	
	Возврат Документы.ЭтапПроизводства2_2.ПолучитьНормативыПоСпецификации(
		ДанныеПартииПроизводстваКопия,
		ПолучатьМатериалыПоТребованию,
		ПереченьДанных);//,
		//Новый Структура("Этап", ЭтапОбъект1)); //Объект.Этап));
	
КонецФункции

&НаСервере
Процедура ЗаполнитьТЧМатериалыПоРегистру (РезультатЗапроса, ИмяТЧ)
	ТабМАтериалы = РезультатЗапроса.Выбрать();//Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	ТЗМатериалы = РеквизитФормыВЗначение(ИмяТЧ,Тип("ТаблицаЗначений")); //"ДеревоМатериалов"
	ТЗМатериалы.Очистить();
		
	Для Каждого СтрНоменклатура из ТЗМатериалы Цикл 
		СтрНом = ТЗМатериалы.Добавить();
		ЗаполнитьЗначенияСвойств(СтрНом,СтрНоменклатура);
		СтрНом.Спецификация = СтрНоменклатура.СпецификацияЭтапа;
		СтрНом.Уровень = 1;
		СтрНом.КонтрольОстатка = СтрНом.Остаток -СтрНом.Обеспечить - СтрНом.Расход;
		СтрНом.ОстатокДляУО = СтрНом.Остаток - СтрНом.Обеспечить - СтрНом.Расход; // - СтрНом.КОбеспечению;
		РасходПоНоменклатуре = СтрНом.Расход;
		
		Для Каждого СтрЭтап из СтрНоменклатура.Строки Цикл 
			СтрДет = СтрНом.Строки.Добавить();
			ЗаполнитьЗначенияСвойств(СтрДет,СтрЭтап);
			СтрДет.Спецификация = СтрЭтап.СпецификацияЭтапа;
			СтрДет.КонтрольОстатка = СтрДет.Остаток - СтрДет.Обеспечить - СтрДет.Расход;
			СтрДет.ОстатокДляУО = СтрДет.Остаток - СтрДет.Обеспечить - СтрДет.Расход; // - СтрДет.КОбеспечению;
		КонецЦикла;                                                                                             
	КонецЦикла;
	ЗначениеВРеквизитФормы(ТЗМатериалы,ИмяТЧ);
КонецПроцедуры
	
&НаСервере
Процедура ЗаполнитьДеревоМатериаловпоРегистру (РезультатЗапроса, ИмяДерева)     
	
	Если ИмяДерева = "ДеревоМатериалов" Тогда 
		ИмяТаблицыИдентификаторов = "ИдентификаторыРаскрытыхСтрокДереваМатериалов";
	ИначеЕсли ИмяДерева = "ДеревоМатериаловРезервирование" Тогда 
		ИмяТаблицыИдентификаторов = "ИдентификаторыРаскрытыхСтрокДереваМатериаловРезервирование";
	КонецЕсли;                                       
	//СтруктураПоиска = Новый Структура("ТекущаяСтрока");
	//МассивТекСтрока = ЭтаФорма[ИмяТаблицыИдентификаторов].НайтиСтроки(СтруктураПоиска);
	//ТекСтрока = МассивТекСтрока[0]; 
	//Если не ЗначениеЗаполнено(ТекСтрока.ЭтапПроизводства) Тогда 
	//	ТекСтрокаУровень1 = Истина;
	//Иначе 
	//	ТекСтрокаУровень1 = Ложь;
	//КонецЕсли;
	
	//ТЗ_ИД_Дерева = РеквизитФормыВЗначение(ИмяТаблицыИдентификаторов,Тип("ТаблицаЗначений"));
	ТабМАтериалы = РезультатЗапроса.Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	ДерМатериалов = РеквизитФормыВЗначение(ИмяДерева,Тип("ДеревоЗначений")); //"ДеревоМатериалов"
	ДерМатериалов.Строки.Очистить();     
	
	
	//СтруктураПоискаИдентификатора = Новый Структура("Номенклатура, ЭтапПроизводства, ");
	
	НомерСтрокиНоменклатуры = 0;
	Для Каждого СтрНоменклатура из ТабМАтериалы.Строки Цикл 
		НомерСтрокиНоменклатуры = НомерСтрокиНоменклатуры + 1;
		СтрНом = ДерМатериалов.Строки.Добавить();             
		СтрНом.НомерСтрокиНоменклатуры = НомерСтрокиНоменклатуры;
		ЗаполнитьЗначенияСвойств(СтрНом,СтрНоменклатура); //Проверить значение ИсходнойНоменклатуры!!!!!!!
		СтрНом.Спецификация = СтрНоменклатура.СпецификацияЭтапа;
		СтрНом.Уровень = 1;        
		СтрНом.Расход = СтрНом.Зарезервировать + СтрНом.Отгрузить;
		СтрНом.КонтрольОстатка = СтрНом.Остаток - СтрНом.Обеспечить - СтрНом.Расход;
		СтрНом.ОстатокДляУО = СтрНом.Остаток - СтрНом.Обеспечить - СтрНом.Расход; // - СтрНом.КОбеспечению; 
		РасходПоНоменклатуре = СтрНом.Расход;    
		
		///////////////////////////////
		//Обновим идентификатор строки в ТаблицеИдентификаторов
		Если СтрНом.Номенклатура = ТекущаяНоменклатура Тогда                    
			СтруктураПоиска = Новый Структура("ТекущаяСтрока",Истина);
			МассивИДТекСтроки = ЭтаФорма[ИмяТаблицыИдентификаторов].НайтиСтроки(СтруктураПоиска);
			Если МассивИДТекСтроки.Количество() = 1 Тогда 
				МассивИДТекСтроки[0].Идентификатор = Элементы[ИмяДерева].ТекущаяСтрока;
			ИначеЕсли МассивИДТекСтроки.Количество() = 0 Тогда 
				ИДТекСтроки = ЭтаФорма[ИмяТаблицыИдентификаторов].Добавить();
				ИДТекСтроки.Идентификатор = Элементы[ИмяДерева].ТекущаяСтрока;
				ИДТекСтроки.Номенклатура = ТекущаяНоменклатура;
				ИДТекСтроки.ТекущаяСтрока = Истина;
				ИДТекСтроки.ИсходнаяНоменклатура = СтрНом.ИсходнаяНоменклатура;
				ИДТекСтроки.НомерСтрокиНоменклатуры = НомерСтрокиНоменклатуры;
			КонецЕсли;
		КонецЕсли;
		//Если ТекСтрокаУровень1 Тогда 
		//	Если ТекСтрока.ИсходнаяНоменклатура = СтрНом.ИсходнаяНоменклатура 
		/////////////////////////////////////   
		
		Для Каждого СтрЭтап из СтрНоменклатура.Строки Цикл 
			СтрДет = СтрНом.Строки.Добавить(); 
			ЗаполнитьЗначенияСвойств(СтрДет,СтрЭтап);             //Здесь ИсходнаяНоменклатура заполнена!!!
			СтрНом.НомерСтрокиНоменклатуры = НомерСтрокиНоменклатуры;
			СтрДет.Спецификация = СтрЭтап.СпецификацияЭтапа;
			СтрДет.КонтрольОстатка = СтрДет.Остаток - СтрДет.Обеспечить - СтрДет.Расход; 
			СтрДет.ОстатокДляУО = СтрДет.Остаток - СтрДет.Обеспечить - СтрДет.Расход; // - СтрДет.КОбеспечению; 
		КонецЦикла;                                                                                             
	КонецЦикла;
 	ЗначениеВРеквизитФормы(ДерМатериалов,ИмяДерева);    
	
	//Очистим старые идентификаторы строк
	//Для Каждого СтрТабИД из ТЗ_ИД_Дерева Цикл 
	//	СтрТабИД.Идентификатор = Неопределено;
	//КонецЦикла;
	//ОбновитьИдентификаторыСтрокДерева(ИмяДерева, );
	
	//ЗначениеВРеквизитФормы(ТЗ_ИД_Дерева, ИмяТаблицыИдентификаторов);
	
КонецПроцедуры     

&НаСервере
Процедура ОбновитьИдентификаторыСтрокДерева(ИмяДерева, ДанныеТекущейСтроки = Неопределено)
	
	СтрокиДерева = ЭтаФорма[ИмяДерева].ПолучитьЭлементы();
	
	//Очистим старые значения идентификаторов      
	Если ИмяДерева = "ДеревоМатериалов" Тогда 
		ИмяТаблицыИдентификаторов = "ИдентификаторыРаскрытыхСтрокДереваМатериалов";
	ИначеЕсли ИмяДерева = "ДеревоМатериаловРезервирование" Тогда
		ИмяТаблицыИдентификаторов = "ИдентификаторыРаскрытыхСтрокДереваМатериаловРезервирование"; 
	КонецЕсли; 
	
	Если ЭтаФорма[ИмяТаблицыИдентификаторов].Количество() = 0 Тогда 
		Возврат; //Ничего обновлять не надо. Нет ни одной раскрытой строки и ни одна строка не выделена
	КонецЕсли;
		
	СтруктураПоискаТекСтроки = Новый Структура("ТекущаяСтрока",Истина);
	МассивТекСтроки = ЭтаФорма[ИмяТаблицыИдентификаторов].НайтиСтроки(СтруктураПоискаТекСтроки);
	КоличествоТекущихСтрок = МассивТекСтроки.Количество();
	Если КоличествоТекущихСтрок > 1 Тогда 
		ИскатьТекущуюСтроку = Истина;
		Сообщить("Необходимо исправить запись в таблицу Идентификаторов. Сохранено несколько текущих строк.");
	ИначеЕсли КоличествоТекущихСтрок = 1 Тогда
		ИскатьТекущуюСтроку = Истина;
	Иначе 
		ИскатьТекущуюСтроку = Ложь;
	КонецЕсли;
	Если ИскатьТекущуюСтроку Тогда // и ТекСтрока = Неопределено Тогда 
		ТекСтрока = МассивТекСтроки[0];
	КонецЕсли;

	НашлиТекущуюСтроку = Ложь; 
	ИДТекущейСтроки = Неопределено;
	Для Каждого СтрокаДерева из СтрокиДерева Цикл 
		СтруктураПоиска = Новый Структура;         
		СтруктураПоиска.Вставить("Номенклатура", СтрокаДерева.Номенклатура);
		МассивНайденныхСтрок = ЭтаФорма[ИмяТаблицыИдентификаторов].НайтиСтроки(СтруктураПоиска);
		КоличествоНайденныхСтрок = МассивНайденныхСтрок.Количество();
		
		Если КоличествоНайденныхСтрок = 1 Тогда 
			СтрокаТаблицы = МассивНайденныхСтрок[0];
			СтрокаТаблицы.Идентификатор = СтрокаДерева.ПолучитьИдентификатор(); 
			Если СтрокаТаблицы.ТекущаяСтрока = Истина Тогда 
				ИскатьТекущуюСтроку = Ложь;
			КонецЕсли;
		ИначеЕсли КоличествоНайденныхСтрок > 1 Тогда 
			Для Каждого СтрокаТаблицы из МассивНайденныхСтрок Цикл 
				СтрокаТаблицы.Идентификатор = СтрокаДерева.ПолучитьИдентификатор();   
				Если СтрокаТаблицы.ТекущаяСтрока = Истина Тогда 
					ИскатьТекущуюСтроку = Ложь;
				КонецЕсли;
			КонецЦикла;
		Иначе 
			Продолжить;
		КонецЕсли;
		Если ИскатьТекущуюСтроку и не НашлиТекущуюСтроку Тогда   
			//Если выбрана строка 1 уровня         
			Если СтрокаДерева.Номенклатура = ТекСтрока.Номенклатура Тогда //СтрокаДерева.ИсходнаяНоменклатура = ТекСтрока.ИсходнаяНоменклатура Тогда // 
				Если не ЗначениеЗаполнено(ТекСтрока.ЭтапПроизводства) Тогда 
					ТекСтрока.Идентификатор = СтрокаДерева.ПолучитьИдентификатор();
					НашлиТекущуюСтроку = Истина;    
					ИДТекущейСтроки = ТекСтрока.Идентификатор;
				Иначе 
					//выполнить поиск по дочерним строкам
					ДочерниеСтроки = СтрокаДерева.ПолучитьЭлементы();
					Если ДочерниеСтроки.Количество() > 0 Тогда 
						Для Каждого ДочерняяСтрока из ДочерниеСтроки Цикл 
							//ОбновитьИдентификаторыСтрокДерева(СтрокаДерева);
							СтруктураПоиска = Новый Структура;
							СтруктураПоиска.Вставить("Номенклатура", ДочерняяСтрока.Номенклатура);
							СтруктураПоиска.Вставить("ЭтапПроизводства",ДочерняяСтрока.ЭтапПроизводства);
							СтруктураПоиска.Вставить("ТекущаяСтрока",Истина);
							МассивНайденныхСтрок = ЭтаФорма[ИмяТаблицыИдентификаторов].НайтиСтроки(СтруктураПоиска);
							КоличествоНайденныхСтрок = МассивНайденныхСтрок.Количество();
							
							Если КоличествоНайденныхСтрок = 1 Тогда 
								СтрокаТаблицы = МассивНайденныхСтрок[0];
								СтрокаТаблицы.Идентификатор = ДочерняяСтрока.ПолучитьИдентификатор();  
								НашлиТекущуюСтроку = Истина;     
								ИДТекущейСтроки = СтрокаТаблицы.Идентификатор;
							ИначеЕсли КоличествоНайденныхСтрок > 1 Тогда 
								Для Каждого СтрокаТаблицы из МассивНайденныхСтрок Цикл 
									//СтрокаТаблицы = МассивНайденныхСтрок[0];
									СтрокаТаблицы.Идентификатор = ДочерняяСтрока.ПолучитьИдентификатор(); 
									НашлиТекущуюСтроку = Истина;  
									ИДТекущейСтроки = СтрокаТаблицы.Идентификатор;
									//Сообщить("По номенклатуре "+СтрокаТаблицы.НоменклатураРодитель+" спецификации "+СтрокаТаблицы.Спецификация+" в дереве материалов найдено более 1 строки. Уточните условие поиска");
								КонецЦикла;
							Иначе 
								//Если ничего не нашли, то и обновлять нечего
								Продолжить;
							КонецЕсли;
						КонецЦикла;
					КонецЕсли;
				КонецЕсли; 				
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;    
	Элементы[ИмяДерева].ТекущаяСтрока = ИДТекущейСтроки;
	//Удалим строки, которых больше нет в дереве (например после Записи в регистр)
	Для Каждого СтрТабИД из ЭтаФорма[ИмяТаблицыИдентификаторов] Цикл 
		Если СтрТабИД.Идентификатор = Неопределено Тогда 
			ЭтаФорма[ИмяТаблицыИдентификаторов].Удалить(СтрТабИД);
		КонецЕсли;
	КонецЦикла; 
		
КонецПроцедуры

&НаСервере
Функция ПолучитьМатериалыПоРегистру(ОтборПоВариантамОбеспечения, ДатаОстатков, Склад, Списание)
	
	ТекстЗапросаУсловие = СформироватьТекстУсловияДляЗапроса(ОтборПоВариантамОбеспечения, Списание);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ТТМ_АРМ_РезервированиеСписаниеМатериалов.СпецификацияЭтапа КАК СпецификацияЭтапа
	               |ПОМЕСТИТЬ СпецификацииЭтапов
	               |ИЗ
	               |	РегистрСведений.ТТМ_АРМ_РезервированиеСписаниеМатериалов КАК ТТМ_АРМ_РезервированиеСписаниеМатериалов
	               |ГДЕ
	               |	НЕ ЕСТЬNULL(ТТМ_АРМ_РезервированиеСписаниеМатериалов.СпецификацияЭтапа, ЗНАЧЕНИЕ(Справочник.РесурсныеСпецификации.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.РесурсныеСпецификации.ПустаяСсылка)
	               |	И ТТМ_АРМ_РезервированиеСписаниеМатериалов.Пользователь = &Пользователь
	               |	И ТТМ_АРМ_РезервированиеСписаниеМатериалов.ЭтоСписание = &ЭтоСписание
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	РесурсныеСпецификацииМатериалыИУслуги.Номенклатура КАК Номенклатура,
	               |	СУММА(ВЫБОР
	               |			КОГДА ЕСТЬNULL(РесурсныеСпецификацииМатериалыИУслуги.Упаковка, ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
	               |				ТОГДА РесурсныеСпецификацииМатериалыИУслуги.КоличествоУпаковок
	               |			ИНАЧЕ РесурсныеСпецификацииМатериалыИУслуги.КоличествоУпаковок / РесурсныеСпецификацииМатериалыИУслуги.Упаковка.Числитель * РесурсныеСпецификацииМатериалыИУслуги.Упаковка.Знаменатель
	               |		КОНЕЦ) КАК Норматив,
	               |	ВЫБОР
	               |		КОГДА ЕСТЬNULL(РесурсныеСпецификацииМатериалыИУслуги.Упаковка, ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
	               |			ТОГДА РесурсныеСпецификацииМатериалыИУслуги.Номенклатура.ЕдиницаИзмерения
	               |		ИНАЧЕ РесурсныеСпецификацииМатериалыИУслуги.Упаковка
	               |	КОНЕЦ КАК Упаковка,
	               |	РесурсныеСпецификацииМатериалыИУслуги.Ссылка КАК Спецификация,
	               |	РесурсныеСпецификацииМатериалыИУслуги.СтатьяКалькуляции КАК СтатьяКалькуляции,
	               |	РесурсныеСпецификацииВыходныеИзделия.Номенклатура КАК ВыходноеИзделие
	               |ПОМЕСТИТЬ НормативыпоСпецификации
	               |ИЗ
	               |	Справочник.РесурсныеСпецификации.ВыходныеИзделия КАК РесурсныеСпецификацииВыходныеИзделия
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.РесурсныеСпецификации.МатериалыИУслуги КАК РесурсныеСпецификацииМатериалыИУслуги
	               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ СпецификацииЭтапов КАК СпецификацииЭтапов
	               |			ПО РесурсныеСпецификацииМатериалыИУслуги.Ссылка = СпецификацииЭтапов.СпецификацияЭтапа
	               |		ПО РесурсныеСпецификацииВыходныеИзделия.Ссылка = РесурсныеСпецификацииМатериалыИУслуги.Ссылка
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	РесурсныеСпецификацииМатериалыИУслуги.Номенклатура,
	               |	ВЫБОР
	               |		КОГДА ЕСТЬNULL(РесурсныеСпецификацииМатериалыИУслуги.Упаковка, ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
	               |			ТОГДА РесурсныеСпецификацииМатериалыИУслуги.Номенклатура.ЕдиницаИзмерения
	               |		ИНАЧЕ РесурсныеСпецификацииМатериалыИУслуги.Упаковка
	               |	КОНЕЦ,
	               |	РесурсныеСпецификацииМатериалыИУслуги.Ссылка,
	               |	РесурсныеСпецификацииМатериалыИУслуги.СтатьяКалькуляции,
	               |	РесурсныеСпецификацииВыходныеИзделия.Номенклатура
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Спецификация,
	               |	Номенклатура
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ТТМ_АРМ_РезервированиеСписаниеМатериалов.Номенклатура КАК СсылкаНаНоменклатуру
	               |ПОМЕСТИТЬ ВТ_Номенклатура
	               |ИЗ
	               |	РегистрСведений.ТТМ_АРМ_РезервированиеСписаниеМатериалов КАК ТТМ_АРМ_РезервированиеСписаниеМатериалов
	               |ГДЕ
	               |	ТТМ_АРМ_РезервированиеСписаниеМатериалов.Пользователь = &Пользователь
	               |	И ТТМ_АРМ_РезервированиеСписаниеМатериалов.ЭтоСписание = &ЭтоСписание
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	СсылкаНаНоменклатуру
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	НоменклатураДополнительныеРеквизиты.Ссылка КАК СсылкаНаНоменклатуру,
	               |	НоменклатураДополнительныеРеквизиты.Свойство КАК Свойство,
	               |	НоменклатураДополнительныеРеквизиты.Значение КАК Значение
	               |ПОМЕСТИТЬ ЗначенияДополнительногоРеквизита
	               |ИЗ
	               |	Справочник.Номенклатура.ДополнительныеРеквизиты КАК НоменклатураДополнительныеРеквизиты
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Номенклатура КАК ВТ_Номенклатура
	               |		ПО НоменклатураДополнительныеРеквизиты.Ссылка = ВТ_Номенклатура.СсылкаНаНоменклатуру
	               |ГДЕ
	               |	НоменклатураДополнительныеРеквизиты.Свойство = &Свойство
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	РаспределениеЗапасов.Номенклатура КАК Номенклатура,
	               |	РаспределениеЗапасов.Характеристика КАК Характеристика,
	               |	РаспределениеЗапасов.Склад КАК Склад,
	               |	РаспределениеЗапасов.ВНаличии КАК ВНаличии,
	               |	РаспределениеЗапасов.Резерв КАК ВРезервеСоСклада,
	               |	0 КАК КОтгрузке
	               |ПОМЕСТИТЬ ВТ_СвободныеОстатки
	               |ИЗ
	               |	РегистрСведений.РаспределениеЗапасов КАК РаспределениеЗапасов
	               |ГДЕ
	               |	РаспределениеЗапасов.Состояние = &Состояние
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ТоварыКОтгрузкеОстатки.Номенклатура,
	               |	ТоварыКОтгрузкеОстатки.Характеристика,
	               |	ТоварыКОтгрузкеОстатки.Склад,
	               |	0,
	               |	0,
	               |	ТоварыКОтгрузкеОстатки.КОтгрузкеОстаток
	               |ИЗ
	               |	РегистрНакопления.ТоварыКОтгрузке.Остатки(, ) КАК ТоварыКОтгрузкеОстатки
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_СвободныеОстатки.Номенклатура КАК Номенклатура,
	               |	ВТ_СвободныеОстатки.Характеристика КАК Характеристика,
	               |	ВТ_СвободныеОстатки.Склад КАК Склад,
	               |	СУММА(ВТ_СвободныеОстатки.ВНаличии) КАК ВНаличии,
	               |	СУММА(ВТ_СвободныеОстатки.ВРезервеСоСклада) КАК ВРезервеСоСклада,
	               |	ВЫБОР
	               |		КОГДА СУММА(ВТ_СвободныеОстатки.ВНаличии) >= СУММА(ВТ_СвободныеОстатки.КОтгрузке)
	               |			ТОГДА СУММА(ВТ_СвободныеОстатки.КОтгрузке)
	               |		ИНАЧЕ СУММА(ВТ_СвободныеОстатки.ВНаличии)
	               |	КОНЕЦ КАК КОтгрузке
	               |ПОМЕСТИТЬ ВТ_СвободныеОстаткиСгруппированные
	               |ИЗ
	               |	ВТ_СвободныеОстатки КАК ВТ_СвободныеОстатки
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТ_СвободныеОстатки.Номенклатура,
	               |	ВТ_СвободныеОстатки.Склад,
	               |	ВТ_СвободныеОстатки.Характеристика
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ТТМ_АРМ_РезервированиеСписаниеМатериалов.ЭтапПроизводства КАК ЭтапПроизводства
	               |ПОМЕСТИТЬ ВТ_Этапы
	               |ИЗ
	               |	РегистрСведений.ТТМ_АРМ_РезервированиеСписаниеМатериалов КАК ТТМ_АРМ_РезервированиеСписаниеМатериалов
	               |ГДЕ
	               |	ТТМ_АРМ_РезервированиеСписаниеМатериалов.Пользователь = &Пользователь
	               |	И ТТМ_АРМ_РезервированиеСписаниеМатериалов.ЭтоСписание = &ЭтоСписание
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ТТМ_АРМ_РезервированиеСписаниеМатериалов.ЭтапПроизводства
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Номенклатура КАК Номенклатура,
	               |	СУММА(ВЫБОР
