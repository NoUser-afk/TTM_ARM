	//ЭтапОбъект = Этапы.НайтиСтроки(ПараметрыПоиска)[0].ЭтапПроизводства;
	ДанныеПартииПроизводства = Документы.ЭтапПроизводства2_2.ДанныеПартииПроизводства(Этап.Распоряжение, Этап.НазначениеПродукция, Этап.ПартияПроизводства);
	
