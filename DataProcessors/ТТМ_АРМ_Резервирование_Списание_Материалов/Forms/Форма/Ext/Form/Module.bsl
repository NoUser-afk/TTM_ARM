					КонецЦикла;
					ЭлементОтбора = НЗ.Отбор.Найти("ОтборПоВариантамОбеспечения");
					Если не ЭлементОтбора = Неопределено Тогда 
						ЭлементОтбора.Использование = Ложь;
					КонецЕсли;
					//НЗ.Загрузить(ТЗ);
					НЗ.Записать();
				ИначеЕсли НЗ.Количество() > 1 Тогда 
					//Найти запись с нужным вариантом обеспечения
					Сообщить("Найдено более 1 строки в регистре, уточните условия поиска",СтатусСообщения.Важное);
				Иначе 
					Сообщить("Не найдена строка регистра для корректировки данных, "+стр.Номенклатура + " "+ Стр.ЭтапПроизводства,СтатусСообщения.Важное);
				КонецЕсли;
			Иначе               
				ПараметрыПоиска = Новый Структура("Номенклатура,Этап");
				МассивСтрокБезОстатка = НоменклатураБезОстатка.НайтиСтроки(ПараметрыПоиска);
				Если МассивСтрокБезОстатка.Количество() = 0 Тогда 
					НоваяСтрока = МассивСтрокБезОстатка.Добавить();
					НоваяСтрока.Номенклатура = Стр.Номенклатура ;
					НоваяСтрока.Этап = Стр.ЭтапПроизводства;     
				КонецЕсли;
				
			КонецЕсли;
		КонецЦикла;	       
		ТекстНачалаСообщения = "Отсутствует остаток для резервирования по номенклатуре ";
		ТекстСообщения = "";
		Для Каждого СтрТЗ из НоменклатураБезОстатка Цикл 
			ТекстСообщения = ТекстСообщения + ТекстНачалаСообщения + " " + СтрТЗ.Номенклатура + ", " + СтрТЗ.Этап + Символы.ПС;
		КонецЦикла;                           
		Сообщить(ТекстСообщения,СтатусСообщения.Важное);
	КонецЦикла;
	ОбновитьДанныеПоМатериаламНаСервере(ИмяДерева,Ложь);
	
	//ЭтапОбъект 
	//ДанныеСпецификации = ПолучитьНормативыПоСпецификации("МатериалыИУслуги,Трудозатраты", Истина, Ложь);
