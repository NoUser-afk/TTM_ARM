&НаКлиенте
Процедура ДеревоМатериаловРезервированиеЗарезервироватьПриИзменении(Элемент)

	//ИсходныеДанныеСтроки = ИсходныеДанныеСтрокиДереваМатериаловРезервирование;  
	Если ТекСтраница = "Списание" Тогда 
		ТекСтрока = Элементы.ДеревоМатериалов.ТекущиеДанные;  
		ИмяДерева = "ДеревоМатериалов";  
		ИмяТаблицыИдентификаторов = "ИдентификаторыРаскрытыхСтрокДереваМатериалов";
		//ЗаполнитьЗначенияСвойств(ИсходныеДанныеСтрокиДереваМатериалов,ТекСтрока);
		ДанныеСтроки = ИсходныеДанныеСтрокиДереваМатериалов;	
	ИначеЕсли ТекСтраница = "Резервирование" Тогда 
		ТекСтрока = Элементы.ДеревоМатериаловРезервирование.ТекущиеДанные;
		ИмяДерева = "ДеревоМатериаловРезервирование";
		ИмяТаблицыИдентификаторов = "ИдентификаторыРаскрытыхСтрокДереваМатериаловРезервирование";
		//ЗаполнитьЗначенияСвойств(ИсходныеДанныеСтрокиДереваМатериаловРезервирование,ТекСтрока);
		ДанныеСтроки = ИсходныеДанныеСтрокиДереваМатериаловРезервирование;
	КонецЕсли;    
	
	Если ТекСтрока.Уровень = 1 Тогда 
		ОбщееКоличествоОбеспечить = ?(ЗначениеЗаполнено(ТекСтрока.Обеспечить), ТекСтрока.Обеспечить, 0);
		ОбщееКоличествоРезервировать = ?(ЗначениеЗаполнено(ТекСтрока.Зарезервировать), ТекСтрока.Зарезервировать, 0);
		КоличествоПодчиненныхСтрок = ТекСтрока.ПолучитьЭлементы().Количество();   
		ОбработаноСтрок = 0;
		КоличествоЗарезервировано = 0;  
		ДопустимыйОстаток = ДанныеСтроки.Остаток/КоличествоПодчиненныхСтрок;
		Для Каждого ПодчиненнаяСтрока из ТекСтрока.ПолучитьЭлементы() Цикл   
			ЗаполнитьЗначенияСвойств(ДанныеСтроки,ПодчиненнаяСтрока);
			КоличествоИсходное = ПодчиненнаяСтрока.Количество;
			Если УпаковкаШтуки(ПодчиненнаяСтрока.Упаковка) Тогда 
				Если ОбработаноСтрок = КоличествоПодчиненныхСтрок - 1 Тогда 
					Количество = ОбщееКоличествоРезервировать - КоличествоЗарезервировано;
					КоличествоЗарезервировано = КоличествоЗарезервировано + Количество;
					//ПодчиненнаяСтрока.Резервировать = ОбщееКоличествоРезервировать;                      
					ИзменитьКоличествоВСтрокеРегистра(Количество, ДанныеСтроки, КоличествоИсходное,,Истина,ДопустимыйОстаток);
				Иначе                     
					Количество = Цел(ОбщееКоличествоРезервировать/КоличествоПодчиненныхСтрок);
					КоличествоЗарезервировано = КоличествоЗарезервировано + Количество;
					//ПодчиненнаяСтрока.Резервировать = Цел(ОбщееКоличествоРезервировать/КоличествоПодчиненныхСтрок);
					//ПодчиненнаяСтрока.Обеспечить = ПодчиненнаяСтрока.Обеспечить +  
					//ОбщееКоличествоРезервировать = ОбщееКоличествоРезервировать - ПодчиненнаяСтрока.Резервировать;
					ИзменитьКоличествоВСтрокеРегистра(Количество, ДанныеСтроки, КоличествоИсходное,,Истина, ДопустимыйОстаток);
					ОбработаноСтрок = ОбработаноСтрок + 1;
				КонецЕсли;  
			Иначе 
				Количество = ОбщееКоличествоРезервировать/КоличествоПодчиненныхСтрок;
				ИзменитьКоличествоВСтрокеРегистра(Количество, ДанныеСтроки, КоличествоИсходное,,Истина, ДопустимыйОстаток);
				КоличествоЗарезервировано = КоличествоЗарезервировано + Количество;
			КонецЕсли;
		КонецЦикла;
		ТекСтрока.Зарезервировать = КоличествоЗарезервировано; //ДанныеСтроки.Отгрузить;
	Иначе   
		ДопустимыйОстаток = ДанныеСтроки.Остаток;
		КоличествоОбеспечить = ?(ЗначениеЗаполнено(ТекСтрока.Обеспечить), ТекСтрока.Обеспечить, 0);
		КоличествоРезервировать = ?(ЗначениеЗаполнено(ТекСтрока.Зарезервировать), ТекСтрока.Зарезервировать, 0);
		Количество = КоличествоОбеспечить;
		ЗаполнитьЗначенияСвойств(ДанныеСтроки,ТекСтрока);
		КоличествоИсходное = ДанныеСтроки.Количество;
		ИзменитьКоличествоВСтрокеРегистра(Количество, ДанныеСтроки, КоличествоИсходное,,Истина, ДопустимыйОстаток);     
	КонецЕсли;   
	
	ЗапишемДанныеТекущейСтрокиВТабИД(ИмяДерева,ИмяТаблицыИдентификаторов);
		
	ОбновитьДанныеПоМатериаламНаСервере(ИмяДерева,Ложь, ДанныеСтроки);
	УстановитьУсловноеОформлениеДереваМатериалов(ИмяДерева);
	
	//ИДТекСтроки = Элементы[ИмяДерева].ТекущаяСтрока;
	//ОбновитьИДТекущейСтроки(ИмяДерева,ИмяТаблицыИдентификаторов,ТекСтрока.Номенклатура, ТекСтрока.ЭтапПроизводства, ИДТекСтроки);
	
	//ОбновитьИдентификаторыСтрокДерева(ИмяДерева,ДанныеСтроки);
	ВосстановитьСостояниеДерева(ИмяДерева);     
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапишемДанныеТекущейСтрокиВТабИД(ИмяДерева,ИмяТаблицыИдентификаторов)
	
	ДанныеТекСтроки = Элементы[ИмяДерева].ТекущиеДанные;
	ИДТекСтроки = Элементы[ИмяДерева].ТекущаяСтрока; 
	СтруктураПоиска = Новый Структура("ТекущаяСтрока", Истина);
	МассивТекСтр = ЭтаФорма[ИмяТаблицыИдентификаторов].НайтиСтроки(СтруктураПоиска);
	Если МассивТекСтр.Количество() = 1 Тогда 
		ТекстрокаИД = МассивТекСтр[0];
		ЗаполнитьЗначенияСвойств(ТекстрокаИД,ДанныеТекСтроки);
		ТекстрокаИД.ТекущаяСтрока = Истина;
		ТекстрокаИД.Идентификатор = Элементы[ИмяДерева].ТекущаяСтрока;
	ИначеЕсли МассивТекСтр.Количество() > 1 Тогда 
		ТекстрокаИД = МассивТекСтр[0];
		ЗаполнитьЗначенияСвойств(ТекстрокаИД,ДанныеТекСтроки);
		ТекстрокаИД.ТекущаяСтрока = Истина;
		ТекстрокаИД.Идентификатор = Элементы[ИмяДерева].ТекущаяСтрока;
		Сообщить("Найдено более 1 текущей строки в таблице идентификаторов, проверить добавление текущей строки!",СтатусСообщения.Важное);
	Иначе 
		//добавим текущую строку в таблицу идентификаторов
		НоваСтрокаИД = ЭтаФорма[ИмяТаблицыИдентификаторов].Добавить();  
		ЗаполнитьЗначенияСвойств(НоваСтрокаИД, ДанныеТекСтроки);
		НоваСтрокаИД.ТекущаяСтрока = Истина;
		НоваСтрокаИД.Идентификатор = Элементы[ИмяДерева].ТекущаяСтрока;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
//БезКонтекста
Процедура ИзменитьКоличествоВСтрокеРегистра(Количество, СтрокаДанных, КоличествоИсходное, Отгрузить = Ложь, Зарезервировать = Ложь, ДопустимыйОстаток)
	НЗ = РегистрыСведений.ТТМ_АРМ_РезервированиеСписаниеМатериалов.СоздатьНаборЗаписей();
	НЗ.Отбор.Номенклатура.Установить(СтрокаДанных.Номенклатура);
	Если ЗначениеЗаполнено(СтрокаДанных.ЭтапПроизводства) Тогда 
		НЗ.Отбор.ЭтапПроизводства.Установить(СтрокаДанных.ЭтапПроизводства);
	КонецЕсли;
	//ЗаполнитьЗначенияСвойств(НЗ.Отбор,СтрокаДанных);
	НЗ.Прочитать();              
	//НЗ.Отбор.ВариантОбеспечения.Использование = Ложь;   
	Если Отгрузить Тогда 
		ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Отгрузить;
	ИначеЕсли Зарезервировать Тогда 
		ВариантОбеспечения = Перечисления.ВариантыОбеспечения.СоСклада;
	КонецЕсли;
	
	Для Каждого СтрНЗ из НЗ Цикл 
		СтрНЗ.ВариантОбеспечения = ВариантОбеспечения; 
		СтрНЗ.ОтборПоВариантамОбеспечения = УстановитьЗначениеОтбораПоВариантамОбеспеченияВРегистре(ВариантОбеспечения);
		СтрНЗ.Обособленно = Ложь; //При отгрузке и резерве обособленность не нужна (только при обеспечении!!!)
		Если ЗначениеЗаполнено(СтрНЗ.Упаковка) Тогда 
			КоэффициентПересчета = СтрНЗ.Упаковка.Числитель * СтрНЗ.Упаковка.Знаменатель;
		Иначе 
			КоэффициентПересчета = 1;
		КонецЕсли;
		Если КоэффициентПересчета = 0 Тогда 
			КоэффициентПересчета = 1;
		КонецЕсли;
		Если Количество > КоличествоИсходное Тогда 
			Если Количество <= ДопустимыйОстаток Тогда
				СтрНЗ.Количество = Количество;
				СтрНЗ.КоличествоУпаковок = Количество/КоэффициентПересчета; //СтрНЗ.Упаковка.Числитель * СтрНЗ.Упаковка.Знаменатель;
			Иначе 
				СтрНЗ.Количество = ДопустимыйОстаток;
				СтрНЗ.КоличествоУпаковок = СтрНЗ.Остаток/КоэффициентПересчета; //СтрНЗ.Упаковка.Числитель * СтрНЗ.Упаковка.Знаменатель;
				Сообщить("Нельзя " +?(Отгрузить,"отгрузить","") + ?(Зарезервировать,"зарезервировать","")+ " больше остатка!");
			КонецЕсли;
		ИначеЕсли Количество <= КоличествоИсходное Тогда 
			СтрНЗ.Количество = Количество;   
			СтрНЗ.КоличествоУпаковок = Количество/КоэффициентПересчета; //СтрНЗ.Упаковка.Числитель * СтрНЗ.Упаковка.Знаменатель;
		КонецЕсли;
	
	КонецЦикла; 
	НЗ.Записать();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция УпаковкаШтуки(Упаковка)
	
	Если Упаковка.ЕдиницаИзмерения  = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду(796) Тогда 
		Возврат  Истина;
	Иначе 
