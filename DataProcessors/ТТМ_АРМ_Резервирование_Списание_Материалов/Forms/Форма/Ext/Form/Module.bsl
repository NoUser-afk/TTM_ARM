				   |	ПредварительныеДанные.Количествоэтапов КАК КоличествоЭтапов,
	               |	ПредварительныеДанные.Норматив КАК Норматив,
	               |	ПредварительныеДанные.КоличествоВЭтапе КАК КоличествоВЭтапе,
	               |	ПредварительныеДанные.Обеспечить КАК Обеспечить,
				   //|	ПредварительныеДанные.КОбеспечению КАК КОбеспечению,
	               |	ПредварительныеДанные.Отгрузить КАК Отгрузить,
	               |	ПредварительныеДанные.Зарезервировать КАК Зарезервировать,
	               |	ПредварительныеДанные.Остаток КАК Остаток,
	               |	ПредварительныеДанные.ВариантОбеспечения КАК ВариантОбеспечения,
	               |	ПредварительныеДанные.Склад КАК Склад,
	               |	ПредварительныеДанные.Назначение КАК Назначение,
	               |	ПредварительныеДанные.Спецификация КАК Спецификация,
				   |	ПредварительныеДанные.СтатьяКалькуляции КАК СтатьяКалькуляции,
				   |	ПредварительныеДанные.ВыходноеИзделие КАК ВыходноеИзделие,
	               |	ПредварительныеДанные.Отгрузить + ПредварительныеДанные.Зарезервировать КАК Расход
	               |ИЗ
	               |	ПредварительныеДанные КАК ПредварительныеДанные
	               |ГДЕ %ТекстЗапросаУсловие
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Номенклатура, ЭтапПроизводства 
	               |ИТОГИ
				   |	СУММА(КоличествоСтрок),
	               |	МАКСИМУМ(ВидНоменклатуры),
	               |	СУММА(Норматив),
	               |	СУММА(Обеспечить),
				   //|	СУММА(КОбеспечению),
	               |	СУММА(Отгрузить),
	               |	СУММА(Зарезервировать),
	               |	СРЕДНЕЕ(Остаток),
	               |	МАКСИМУМ(Склад),
	               |	МАКСИМУМ(Назначение),
	               |	МАКСИМУМ(Спецификация),
	               |	СУММА(Расход)
	               |ПО
	               |	Номенклатура
	               |АВТОУПОРЯДОЧИВАНИЕ";

	Запрос.УстановитьПараметр("ТабЭтапы", ТаблицаЭтапов);	
	Запрос.УстановитьПараметр("ДатаОстатков",ДатаОстатков);
	Запрос.УстановитьПараметр("Свойство",Объект.ДР_КатегорияМатериала);
	
	Если ТекстЗапросаУсловие <> "" Тогда 
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"%ТекстЗапросаУсловие",ТекстЗапросаУсловие);
		Если Списание тогда 
			Запрос.УстановитьПараметр("КатегорияМатериала", ОтборКатегорияМатериала);
		Иначе 
			Запрос.УстановитьПараметр("КатегорияМатериала", ОтборКатегорияМатериалаРезервирование);
		КонецЕсли;
	Иначе 
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"ГДЕ %ТекстЗапросаУсловие","");
	КонецЕсли;
	Запрос.УстановитьПараметр("Склад", Склад);
	РезультатЗапроса = Запрос.Выполнить();
	Возврат РезультатЗапроса;
	
КонецФункции

&НаСервере
Функция СформироватьТекстУсловияДляЗапроса(ОтборПоВариантамОбеспечения, Списание)
	
	ТекстЗапросаУсловие = "";
	Если Списание и ЗначениеЗаполнено(ОтборКатегорияМатериала) Тогда 
		//ТекстЗапросаУсловие = "ГДЕ ПредварительныеДанные.КатегорияМатериала = &КатегорияМатериала ";
		Если ТекстЗапросаУсловие <> "" Тогда
			ТекстЗапросаУсловие = ТекстЗапросаУсловие + Символы.ПС + " И ";
		КонецЕсли;
		ТекстЗапросаУсловие = ТекстЗапросаУсловие + " ПредварительныеДанные.КатегорияМатериала = &КатегорияМатериала"; // + Символы.ПС;
	КонецЕсли;
	Если не Списание и ЗначениеЗаполнено(ОтборКатегорияМатериалаРезервирование) Тогда 
		Если ТекстЗапросаУсловие <> "" Тогда
			ТекстЗапросаУсловие = ТекстЗапросаУсловие + Символы.ПС + " И ";
		КонецЕсли;
		ТекстЗапросаУсловие = " ПредварительныеДанные.КатегорияМатериала = &КатегорияМатериала"; // + Символы.ПС;
	КонецЕсли;
	Если ОтборПоВариантамОбеспечения = 1 Тогда  //Необеспеченные
		Если ТекстЗапросаУсловие <> "" Тогда
			ТекстЗапросаУсловие = ТекстЗапросаУсловие + Символы.ПС + " И ";
		КонецЕсли;
		ТекстЗапросаУсловие = ТекстЗапросаУсловие + " (ПредварительныеДанные.ВариантОбеспечения = Значение(перечисление.ВариантыОбеспечения.РезервироватьПоМереПоступления) 
		| ИЛИ ПредварительныеДанные.ВариантОбеспечения = Значение(перечисление.ВариантыОбеспечения.КОбеспечению)) "; //.УдалитьОбособленно
	ИначеЕсли ОтборПоВариантамОбеспечения = 2 Тогда  //Зарезервированные /////Не обеспечивать
		Если ТекстЗапросаУсловие <> "" Тогда
			ТекстЗапросаУсловие = ТекстЗапросаУсловие + Символы.ПС + " И ";
		КонецЕсли;
		ТекстЗапросаУсловие = ТекстЗапросаУсловие + " ПредварительныеДанные.ВариантОбеспечения = Значение(перечисление.ВариантыОбеспечения.СоСклада) ";	 //.НеТребуется
	//ИначеЕсли ОтборПоВариантамОбеспечения = 3 Тогда  //К обеспечению
	//	Если ТекстЗапросаУсловие <> "" Тогда
	//		ТекстЗапросаУсловие = ТекстЗапросаУсловие + Символы.ПС + " И ";
	//	КонецЕсли;
	//	ТекстЗапросаУсловие = ТекстЗапросаУсловие + " ПредварительныеДанные.ВариантОбеспечения = Значение(перечисление.ВариантыОбеспечения.Требуется)";
	ИначеЕсли ОтборПоВариантамОбеспечения = 4 Тогда  //Не обеспечивать ////Зарезервированные
		Если ТекстЗапросаУсловие <> "" Тогда
			ТекстЗапросаУсловие = ТекстЗапросаУсловие + Символы.ПС + " И ";
		КонецЕсли;
		ТекстЗапросаУсловие = ТекстЗапросаУсловие + " ПредварительныеДанные.ВариантОбеспечения = Значение(перечисление.ВариантыОбеспечения.НеТребуется) ";
	ИначеЕсли ОтборПоВариантамОбеспечения = 5 Тогда //Отгруженные
		Если ТекстЗапросаУсловие <> "" Тогда
			ТекстЗапросаУсловие = ТекстЗапросаУсловие + Символы.ПС + " И ";
		КонецЕсли;
		ТекстЗапросаУсловие = ТекстЗапросаУсловие + " ПредварительныеДанные.ВариантОбеспечения = Значение(перечисление.ВариантыОбеспечения.Отгрузить) "; 
	КонецЕсли;
	Возврат ТекстЗапросаУсловие;
	
КонецФункции

&НаКлиенте
Процедура ВыделитьВсеЭтапы(Команда)
	
	Если Элементы.Страницы.ТекущаяСтраница.Имя = "Списание" Тогда 
		Для Каждого СтрокаТЧ из Этапы Цикл 
			СтрокаТЧ.Обрабатывать = Истина;
		КонецЦикла;
	ИначеЕсли Элементы.Страницы.ТекущаяСтраница.Имя = "Резервирование"  Тогда 
		Для Каждого СтрокаТЧ из ЭтапыРезервирование Цикл 
			СтрокаТЧ.Обрабатывать = Истина;
		КонецЦикла;
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ОтгрузитьНаСервере(ИмяДерева,ЭтоСписание, Отбор)
		
	//////////0. Отбор - значение ВариантаОбеспечения (например, ОтгрузитьЗарезервированные)
	//////////1. Получим данные регистра с учетом отборов (Категория материала, ОтборПоВариантамОбеспечения, Пользователь, ЭтоСписание, ВариантОбеспечения (исходный))
	//////////2. Изменим данные в соответствии с данными дерева (синхронизация по полю ИдентификаторСтрокиРегистра)
	//////////3. Загрузить новые данные в регистр
	
	Дерево = РеквизитФормыВЗначение(ИмяДерева,Тип("ДеревоЗначений"));
	
	ТекНоменклатура = Справочники.Номенклатура.ПустаяСсылка();
	Для Каждого СтрокаДерева из Дерево.Строки Цикл 
		Если ТекНоменклатура <> СтрокаДерева.Номенклатура Тогда // строка 1 уровня. Зафиксируем данные по номенкдатуре и остаткам на складе.
			ТекНоменклатура = СтрокаДерева.Номенклатура;
			ТекОстаток = СтрокаДерева.Остаток;
		КонецЕсли;
		//ОстатокПослеРезервированияВсехСтрокПоНоменклатуре = ТекОстаток - Строка.Обеспечить;
		Для Каждого Стр из СтрокаДерева.Строки Цикл 
			Если ЗначениеЗаполнено(Отбор) и Стр.ВариантОбеспечения <> Отбор Тогда 
				Продолжить;
			ИначеЕсли Стр.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Отгрузить Тогда 
				//или Стр.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.ОтгрузитьОбособленно Тогда 
				Продолжить;
			КонецЕсли;
			Если ТекНоменклатура = Стр.Номенклатура тогда
				ТекОстаток = ТекОстаток - Стр.Обеспечить;
			КонецЕсли;
			Если ТекОстаток >= 0 Тогда			
				НЗ = РегистрыСведений.ТТМ_АРМ_РезервированиеСписаниеМатериалов.СоздатьНаборЗаписей();
				НЗ.Отбор.Пользователь.Установить(Пользователи.АвторизованныйПользователь());
				НЗ.Отбор.ЭтоСписание.Установить(ЭтоСписание);
				НЗ.Отбор.Номенклатура.Установить(Стр.Номенклатура);
				НЗ.Отбор.ЭтапПроизводства.Установить(Стр.ЭтапПроизводства);
				Если ЗначениеЗаполнено(ОтборВариантОбеспечения) и ЭтоСписание Тогда 
					НЗ.Отбор.ОтборПоВариантамОбеспечения.Установить(ОтборВариантОбеспечения);
				ИначеЕсли ЗначениеЗаполнено(ОтборВариантОбеспеченияРезервирование) и не ЭтоСписание Тогда 
					НЗ.Отбор.ОтборПоВариантамОбеспечения.Установить(ОтборВариантОбеспеченияРезервирование);
				КонецЕсли;
				Если ЗначениеЗаполнено(ОтборКатегорияМатериала) и ЭтоСписание Тогда 
					НЗ.Отбор.КатегорияМатериала.Установить(ОтборКатегорияМатериала);
				ИначеЕсли ЗначениеЗаполнено(ОтборКатегорияМатериалаРезервирование) и не ЭтоСписание Тогда
					НЗ.Отбор.КатегорияМатериала.Установить(ОтборКатегорияМатериалаРезервирование);
				КонецЕсли;
				НЗ.Прочитать(); 
				ВариантОбеспеченияНовый = Перечисления.ВариантыОбеспечения.Отгрузить;
				Если НЗ.Количество() = 1 Тогда 
					Для Каждого СтрНЗ из НЗ Цикл 
							Если Стр.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.СоСклада Тогда 
								//или Стр.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.УдалитьИзЗаказов тогда
								Количество = Стр.Зарезервировать; 
							ИначеЕсли Стр.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.РезервироватьПоМереПоступления
								ИЛИ Стр.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.КОбеспечению Тогда 
								Количество = Стр.Обеспечить;
							//ИначеЕсли Стр.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.УдалитьОбособленно Тогда  
							//	Количество = Стр.Обеспечить;
							Иначе 
								Количество = 0;
							КонецЕсли;
							СтрНЗ.Количество = Количество;
							СтрНЗ.ВариантОбеспечения = ВариантОбеспеченияНовый;
							СтрНЗ.Обособленно = Ложь;
							СтрНЗ.Назначение = Справочники.Назначения.ПустаяСсылка();
							
							ИндексВариантаОбеспеченияНовый = Перечисления.ВариантыОбеспечения.Индекс(ВариантОбеспеченияНовый);
							ИмяПеречисления = Строка(Метаданные.Перечисления.ВариантыОбеспечения.ЗначенияПеречисления[ИндексВариантаОбеспеченияНовый]);
							
							СтрНЗ.ОтборПоВариантамОбеспечения = СоответствиеВариантовОбеспеченияОтбору[ИмяПеречисления];
							СтрНЗ.Обеспечить = ?(ЗначениеЗаполнено(СтрНЗ.Обеспечить),СтрНЗ.Обеспечить,0) - ?(ЗначениеЗаполнено(Количество),Количество,0);
						//В регистре только исходный остаток - его не изменяем!!!
					КонецЦикла;
					ЭлементОтбора = НЗ.Отбор.Найти("ОтборПоВариантамОбеспечения");
					Если не ЭлементОтбора = Неопределено Тогда 
						ЭлементОтбора.Использование = Ложь;
					КонецЕсли;
					НЗ.Записать();
				ИначеЕсли НЗ.Количество() > 1 Тогда 
					//Найти запись с нужным вариантом обеспечения
					Сообщить("Найдено более 1 строки в регистре, уточните условия поиска "+стр.Номенклатура + " " + Стр.ЭтапПроизводства,СтатусСообщения.Важное);
				Иначе 
					Сообщить("Не найдена строка регистра для корректировки данных, "+стр.Номенклатура + " " + Стр.ЭтапПроизводства,СтатусСообщения.Важное);
				КонецЕсли;
			Иначе 
				Сообщить("Отсутствует остаток для резервирования по номенклатуре "+Стр.Номенклатура + ", " + Стр.ЭтапПроизводства,СтатусСообщения.Важное);
			КонецЕсли;
		КонецЦикла;				
	КонецЦикла;
	ОбновитьДанныеПоМатериаламНаСервере(ИмяДерева,Ложь);
			
КонецПроцедуры

&НаКлиенте
Процедура ОтгрузитьЗарезервированные(Команда)
	Если ТекСтраница = "Списание" Тогда 
		Если ОтборВариантОбеспечения = 5 Тогда 
			Возврат;
			Сообщить("Материалы по отбору уже отгружены! ",СтатусСообщения.Важное);
		ИначеЕсли ОтборВариантОбеспечения = 3 Тогда 
			Возврат;
			Сообщить("Материалы по отбору отгружать не требуется! ",СтатусСообщения.Важное);
		КонецЕсли;
		ЭтоСписание = Истина;
		ИмяДерева = "ДеревоМатериалов"; 
		ИмяТаблицыИдентификаторов = "ИдентификаторыРаскрытыхСтрокДереваМатериалов";
		
	ИначеЕсли ТекСтраница = "Резервирование" Тогда 
		ЭтоСписание = Ложь;
		ИмяДерева = "ДеревоМатериаловРезервирование";
		ИмяТаблицыИдентификаторов = "ИдентификаторыРаскрытыхСтрокДереваМатериаловРезервирование";
		//Отгрузка доступна только при списании
		Возврат;
	КонецЕсли;
	//Отбор = ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.СоСклада");
	////ВариантОбеспеченияНовый = ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.Отгрузить");
	//ОтгрузитьНаСервере(ИмяДерева, ЭтоСписание, Отбор);          
	
	ВариантОбеспеченияДо = ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.СоСклада");
	ВариантОбеспеченияНовый = ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.Отгрузить");
	УстановитьВариантОбеспеченияНаСервере(ИмяДерева,ЭтоСписание,ВариантОбеспеченияДо,ВариантОбеспеченияНовый);
	
	//ТекСтрока = Элементы[ИмяДерева].ТекущиеДанные();    
	////ИДТекСтроки = Элемент.ТекущаяСтрока(); 
	//ИДТекСтроки = ТекСтрока.ПолучитьИдентификатор();   
	//
	//ОбновитьИДТекущейСтроки(ИмяДерева,ИмяТаблицыИдентификаторов,ТекСтрока.Номенклатура, ТекСтрока.ЭтапПроизводства,ИДТекСтроки);
	ВосстановитьСостояниеДерева(ИмяДерева);
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ДоступноТолькоРезервирование = ПроверитьДоступ("АРМ_Резервирование");
	Если ДоступноТолькоРезервирование Тогда 
		ТолькоРезерв = Истина;
		Элементы.Списание.Видимость = Ложь;
	Иначе 
		ТолькоРезерв = Ложь;
		Элементы.Списание.Видимость = Истина;
	КонецЕсли;
	
	ТекСтраница = "Резервирование";
	
	//СформироватьСтруктуруСтрокИсходныхДанных();
	ЕстьНесохраненныеДанныеРезервирования = Истина;
	ЕстьНесохраненныеДанныеСписания = Истина;
		
	ТабЭтапы = Этапы;
	ТабЭтапыРезервирование = ЭтапыРезервирование;
	ЗаполнитьЭтапыНаСервере(ТабЭтапы, Истина);
	ЗаполнитьЭтапыНаСервере(ТабЭтапыРезервирование, Ложь);
	
	//Списики выбора не сохраняются, если заполнять на сервере при создании формы, поэтому здесь!!!
	Если ЗначениеЗаполнено(Объект.ДР_КатегорияМатериала) Тогда 
		Элементы.КатегорияМатериала.СписокВыбора.Очистить();
		Элементы.ОтборКатегорияМатериалаРезервирование.СписокВыбора.Очистить();
		ЗаполнитьЗначенияСпискаВыбораКатегорияМатериала("КатегорияМатериала");
