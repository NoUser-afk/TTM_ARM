Процедура ОтменитьРезервВыделенныхСтрок(Команда)      
	
	Если Элементы.СтраницыРезервирования.ТекущаяСтраница.Имя = "МатериалыРезервирования" Тогда 
		//МассивСтрок = Элементы.ДеревоМатериаловРезервирование.ВыделенныеСтроки;
		ИмяДерева = "ДеревоМатериаловРезервирование";
		ЭтоСписание = Ложь;
	ИначеЕсли Элементы.СтраницыСписания.ТекущаяСтраница.Имя = "СтраницаМатериалы" Тогда 
		//МассивСтрок = Элементы.ДеревоМатериалов.ВыделенныеСтроки;
		ИмяДерева = "ДеревоМатериалов";
		ЭтоСписание = Истина;
	КонецЕсли;
	
	СписокВариантовОбеспечения = Новый СписокЗначений;
	СписокВариантовОбеспечения.Добавить(ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.СоСклада"));
	СписокВариантовОбеспечения.Добавить(ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.УдалитьИзЗаказов"));    
	
	МассивСтруктурОбрабатываемыхСтрок = ПолучитьМассивСтруктурВыбранныхСтрокДляОбработки(СписокВариантовОбеспечения, ИмяДерева, ЭтоСписание);
	
	//ВариантОбеспеченияНовый = ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.УдалитьОбособленно");
	ВариантОбеспеченияНовый = ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.КОбеспечению");    //РезервироватьПоМереПоступления");
	ОтборПоВариантуОбеспечения = 1;
	
	ЗаписатьДанныеВыделенныхСтрокВРегистр(МассивСтруктурОбрабатываемыхСтрок, ИмяДерева, ЭтоСписание, ВариантОбеспеченияНовый, ОтборПоВариантуОбеспечения);

КонецПроцедуры  

&НаКлиенте
функция ПолучитьМассивСтруктурВыбранныхСтрокДляОбработки(СписокВариантовОбеспечения, ИмяДерева, ЭтоСписание)
	
	МассивСтрок = Элементы[ИмяДерева].ВыделенныеСтроки;
	МассивОбрабатываемыхСтрок = Новый Массив;
	Для Каждого Стр из МассивСтрок Цикл  
		ОтменаРезерва = не МассивОбрабатываемыхСтрок.Найти(ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.СоСклада")) = Неопределено;
		Если ЭтаФорма[ИмяДерева].НайтиПоИдентификатору(Стр).Остаток = 0 и не ОтменаРезерва Тогда
			Продолжить;
		КонецЕсли;
		Если ЭтаФорма[ИмяДерева].НайтиПоИдентификатору(Стр) <> Неопределено Тогда 
			ДочерниеСтроки = ЭтаФорма[ИмяДерева].НайтиПоИдентификатору(Стр).ПолучитьЭлементы();
			Если ДочерниеСтроки.Количество() <> 0 Тогда 
				Для Каждого НСтр из ДочерниеСтроки Цикл 
					МассивОбрабатываемыхСтрок.Добавить(НСтр.ПолучитьИдентификатор());
				КонецЦикла;
			Иначе 
				МассивОбрабатываемыхСтрок.Добавить(Стр);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	МассивСтруктурОбрабатываемыхСтрок = Новый Массив;
	Для Каждого МСтр из МассивОбрабатываемыхСтрок Цикл 
		ТекСтрока = ЭтаФорма[ИмяДерева].НайтиПоИдентификатору(МСтр);
		ДанныеСтроки = Новый Структура("Номенклатура, ЭтапПроизводства, ВариантОбеспечения");
		Если ТекСтрока <> Неопределено Тогда        
			Если СписокВариантовОбеспечения.НайтиПоЗначению(Текстрока.ВариантОбеспечения) = Неопределено Тогда 
				Продолжить;
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(ДанныеСтроки,ТекСтрока);
			МассивСтруктурОбрабатываемыхСтрок.Добавить(ДанныеСтроки);
		КонецЕсли;
	КонецЦикла;                              
	
	Возврат МассивСтруктурОбрабатываемыхСтрок;
	
КонецФункции


