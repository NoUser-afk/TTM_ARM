&НаКлиенте
Процедура ЗарезервироватьВсе(Команда)
	Если Элементы.СтраницыРезервирования.ТекущаяСтраница.Имя = "МатериалыРезервирования" Тогда 
		ЭтоСписание = Ложь;
		ИмяДерева = "ДеревоМатериаловРезервирование";
		//ЗарезервироватьВсеНаСервере("ДеревоМатериаловРезервирование", Ложь);
	ИначеЕсли Элементы.СтраницыСписания.ТекущаяСтраница.Имя = "СтраницаМатериалы" Тогда   
		ЭтоСписание = Истина;
		ИмяДерева = "ДеревоМатериалов"
		//ЗарезервироватьВсеНаСервере("ДеревоМатериалов", Истина); 
	КонецЕсли;         
	ВариантОбеспеченияПосле = ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.СоСклада");
	УстановитьВариантОбеспеченияНаСервере(ИмяДерева,ЭтоСписание,,ВариантОбеспеченияПосле);
	//ОбновитьДанныеПоМатериаламНаСервере(ИмяДерева,Ложь);
