		Если не ЗначениеЗаполнено(Объект.ПериодОтгрузки) Тогда 
			Элементы.СтраницыСписания.ТекущаяСтраница = Элементы.СтраницаЭтапы;
			Сообщить("Заполните дату списания!");
			Возврат;                          
		КонецЕсли;                                                                              
		//УстановитьДанныеПартииПроизводства();  
		ПараметрыПоиска = Новый Структура("Обрабатывать", Истина);   
		ЭтапОбъект = Этапы.НайтиСтроки(ПараметрыПоиска)[0].ЭтапПроизводства;
		ЗаполнитьСпецификациюПоВыбраннымЭтапам("Этапы", Истина);
		ОбновитьДанныеПоМатериаламНаСервере(ИмяДерева, Истина); 
		//ОбновитьИдентификаторыСтрокДерева(ИмяДерева);
		//ОбновитьИдентификаторыСтрокДереваНовая(ИмяДерева,ИмяТаблицыИдентификаторов, Элементы[ИмяДерева].ТекущиеДанные);
		ВосстановитьСостояниеДерева(ИмяДерева);
		УстановитьУсловноеОформлениеДереваМатериалов(ИмяДерева);
	ИначеЕсли ТекущаяСтраница.Имя = "СтраницаЭтапы" Тогда
		Если ДеревоМатериалов.ПолучитьЭлементы().Количество() > 0 Тогда 
			ДопПарметры = Новый Структура("ЭтоСписание",Истина); 
			ДопПарметры.Вставить("ИмяДерева",ИмяДерева);
			ДопПарметры.Вставить("ИмяТаблицыИдентификаторов",ИмяТаблицыИдентификаторов);
			ОповещениеПриПереходеНаСтрЭтапы = Новый ОписаниеОповещения("ПереходНаСтрЭтапыПродолжение",ЭтаФорма,ДопПарметры);
			ПоказатьВопрос(ОповещениеПриПереходеНаСтрЭтапы,"Данные по корректировке материалов будут утеряны, продолжить?",РежимДиалогаВопрос.ДаНет, 300);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьСпецификациюПоВыбраннымЭтапам(ИмяТаблицыЭтапы, ЭтоСписание)
	
	ТЗ = ЭтаФорма[ИмяТаблицыЭтапы].Выгрузить(,"Спецификация"); 
	МассивСпецификаций = ТЗ.ВыгрузитьКолонку("Спецификация");
	МассивСпецификаций = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивСпецификаций); 
	Если МассивСпецификаций.Количество() = 1 Тогда
		Если ЭтоСписание Тогда 
			Спецификация = МассивСпецификаций[0];
		Иначе 
			СпецификацияРезервирование = МассивСпецификаций[0];
		КонецЕсли;
	Иначе  
		Если ЭтоСписание Тогда 
			Спецификация = Справочники.РесурсныеСпецификации.ПустаяСсылка();
		Иначе 
			СпецификацияРезервирование = Справочники.РесурсныеСпецификации.ПустаяСсылка();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

