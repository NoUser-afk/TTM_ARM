&НаСервере
Процедура ОтменитьРезервВсеСтрокиНаСервере(ИмяДерева,ЭтоСписание)
	
	Дерево = РеквизитФормыВЗначение(ИмяДерева,Тип("ДеревоЗначений"));
	ТекНоменклатура = Справочники.Номенклатура.ПустаяСсылка();
	Для Каждого Строка из Дерево.Строки Цикл 
		Если ТекНоменклатура <> Строка.Номенклатура Тогда
			ТекНоменклатура = Строка.Номенклатура;
			//ТекОстаток = Строка.Остаток;
		КонецЕсли;
		//ОстатокПослеРезервированияВсехСтрокПоНоменклатуре = ТекОстаток - Строка.Обеспечить;
		Для Каждого Стр из Строка.Строки Цикл 
			Если ТекНоменклатура = Стр.Номенклатура тогда
				//ТекОстаток = ТекОстаток + Стр.Обеспечить;
			КонецЕсли;
			//Если ТекОстаток >= 0 Тогда			
				НЗ = РегистрыСведений.ТТМ_АРМ_РезервированиеСписаниеМатериалов.СоздатьНаборЗаписей();
				НЗ.Отбор.Пользователь.Установить(Пользователи.АвторизованныйПользователь());
				НЗ.Отбор.ЭтоСписание.Установить(ЭтоСписание);
				
				//Обрабатываем только зарезервированные материалы, поэтому отбор по заререзервированным материалам устанавливаем безусловно!!!!!
				НЗ.Отбор.ОтборПоВариантамОбеспечения.Установить(2);  //(4)
				НЗ.Отбор.Номенклатура.Установить(Стр.Номенклатура);
				НЗ.Отбор.ЭтапПроизводства.Установить(Стр.ЭтапПроизводства);
				//Если ЗначениеЗаполнено(ОтборВариантОбеспечения) и ЭтоСписание Тогда 
				//	НЗ.Отбор.ОтборПоВариантамОбеспечения.Установить(ОтборВариантОбеспечения);
				//ИначеЕсли ЗначениеЗаполнено(ОтборВариантОбеспеченияРезервирование) и не ЭтоСписание Тогда 
				//	НЗ.Отбор.ОтборПоВариантамОбеспечения.Установить(ОтборВариантОбеспеченияРезервирование);
				//КонецЕсли;
				
				Если ЗначениеЗаполнено(ОтборКатегорияМатериала) и ЭтоСписание Тогда 
					НЗ.Отбор.КатегорияМатериала = ОтборКатегорияМатериала;
				ИначеЕсли ЗначениеЗаполнено(ОтборКатегорияМатериалаРезервирование) и не ЭтоСписание Тогда 
					НЗ.Отбор.КатегорияМатериала = ОтборКатегорияМатериалаРезервирование;
				КонецЕсли;
				НЗ.Прочитать();
				Если НЗ.Количество() = 1 Тогда 
					Для Каждого СтрНЗ из НЗ Цикл 
						//Если НЗ.Отбор[НЗ.Отбор.Количество()-28] = НЗ.Отбор.Найти("ОтборПоВариантамОбеспечения").Использование  = Ложь Тогда 
							//НЗ.Отбор.Удалить(НЗ.Отбор.Количество()-28);
							//НЗ.Отбор[НЗ.Отбор.Количество()-28].Использование = Ложь;
						//КонецЕсли;
						СтрНЗ.Количество = Стр.Обеспечить + Стр.Зарезервировать;
						//СтрНЗ.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.УдалитьОбособленно;
						СтрНЗ.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.РезервироватьПоМереПоступления;
						СтрНЗ.Обособленно = Истина;
						
						СтрНЗ.ОтборПоВариантамОбеспечения = 1;
						СтрНЗ.Обеспечить = Стр.Обеспечить + Стр.Зарезервировать;
						//СтрНЗ.Остаток = ОстатокПослеРезервированияВсехСтрокПоНоменклатуре;
						
						//Строки дерева не корректируем, так как дерево перерисовывается по данным регистра
						//Стр.Зарезервировать = Стр.Обеспечить;
						//Стр.Отгрузить		= 0;
						//Стр.Обеспечить		= 0;
						//Стр.КонтрольОстатка = Стр.Остаток - Стр.Зарезервировать - Стр.Отгрузить - Стр.Обеспечить - Стр.КОбеспечению;			 
					КонецЦикла;
					ЭлементОтбора = НЗ.Отбор.Найти("ОтборПоВариантамОбеспечения");
					Если не ЭлементОтбора = Неопределено Тогда 
						ЭлементОтбора.Использование = Ложь;
					КонецЕсли;
						//НЗ.Отбор.Найти("ОтборПоВариантамОбеспечения").Использование  = Ложь;
					НЗ.Записать();
				ИначеЕсли НЗ.Количество() > 1 Тогда 
					//Найти запись с нужным вариантом обеспечения
					Сообщить("Найдено более 1 строки в регистре, уточните условия поиска",СтатусСообщения.Важное);
				Иначе 
					Сообщить("Не найдена строка регистра для корректировки данных!",СтатусСообщения.Важное);
				КонецЕсли;
			//Иначе 
			//	Сообщить("Отсутствует остаток для резервирования по номенклатуре "+Стр.Номенклатура + ", " + Стр.ЭтапПроизводства + Символы.ПС,СтатусСообщения.Важное);
			//КонецЕсли;
		КонецЦикла;				
	КонецЦикла;
	ОбновитьДанныеПоМатериаламНаСервере(ИмяДерева,Ложь);
КонецПроцедуры


