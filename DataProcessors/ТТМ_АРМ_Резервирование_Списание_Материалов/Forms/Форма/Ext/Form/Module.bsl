&НаКлиенте
Процедура ЗафиксироватьКорректировки(Команда)
	
	Если ТекСтраница = "Списание" и не ЗначениеЗаполнено(Объект.ПериодОтгрузки) Тогда
		Сообщить("Заполните ""Дату отгрузки""! списание не выполнено",СтатусСообщения.Важное);
		Возврат;
	КонецЕсли;
	
	/////////////////////////////////////////////////////////////////
	ЗапроситьРазрешениеНаУстановкуПривилегированногоРежима();
	
	Оповещение = Новый ОписаниеОповещения("ПослеПредоставленияРазрешения",ЭтаФорма);
	МассивИДРазрешений = ПолучитьМассивИдентификаторовРазрешений(СписокИДЗапросовРазрешений);
	РаботаВБезопасномРежимеКлиент.ПрименитьЗапросыНаИспользованиеВнешнихРесурсов(МассивИДРазрешений, ЭтаФорма, Оповещение);
	
	//УстановитьПривилегированныйРежим(Истина);
	ЗаполнитьРеквизитыРФ_УстановитьПривилегированныйРежим(Истина);  
	
	/////////////////////////////////////////////////////////////////
	
	Сообщить("Начало обработки этапов " + Строка(ТекущаяДата()));
	
	Если ТекСтраница = "Списание" Тогда 
		ТабЭтапы = Этапы;
	ИначеЕсли ТекСтраница = "Резервирование" Тогда 
		ТабЭтапы = ЭтапыРезервирование;
	КонецЕсли;           
	ОтборСтрок = Новый Структура("Обрабатывать",Истина);
	МассивЭтаповДляОбработки = ТабЭтапы.НайтиСтроки(ОтборСтрок);
	Для Каждого СтрЭтап из МассивЭтаповДляОбработки Цикл //ТабЭтапы 
		//Если СтрЭтап.Обрабатывать Тогда 
		Этап = СтрЭтап.ЭтапПроизводства; 
		//**//
		//НачатьТранзакцию();
		ДанныеЭтапа = ПолучитьДанныеЭтапа(Этап);
		Если ТекСтраница = "Списание" Тогда 
			Если ДанныеЭтапа.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтаповПроизводства2_2.Завершен") или ДанныеЭтапа.КолСтрРасход > 0 Тогда 
				ЭтапОтменен = ОтменитьРасходМатериаловВЭтапе(Этап);  
				Если ЭтапОтменен Тогда 
					УдалитьСвязанныеПередачиМатериалов(Этап);
				КонецЕсли;
			КонецЕсли;
			//УдалитьСвязанныеПередачиМатериалов(Этап);
		КонецЕсли;
		МатериалыЗаполнили = ЗаполнитьМатериалыЭтапаПоДаннымРегистра(Этап);
		Если не МатериалыЗаполнили Тогда    
			//ОтменитьТранзакцию();
			Возврат; //Сообщение с описанием ошибки в функции
		КонецЕсли;
		Если ТекСтраница = "Списание" Тогда 
			СформировалиПередачуМатериалов = СформироватьПередачуМатериаловНаСервере(Этап);
			Если не СформировалиПередачуМатериалов Тогда
				//ОтменитьТранзакцию();
				Возврат;
			КонецЕсли;
			ЗаполнилиРасходЭтапа = ЗаполнитьРасходЭтапа(Этап);
			Если не ЗаполнилиРасходЭтапа Тогда
				//ОтменитьТранзакцию();
				Возврат;
			КонецЕсли;
		КонецЕсли;  
		//КонецЕсли;      
		//ЗафиксироватьТранзакцию();
		Сообщить("Обработка этапа завершена " + Этап);
	КонецЦикла;
	
	Сообщить("Время окончания обработки этапов "+ Строка(ТекущаяДата()));
	
	ЗаполнитьРеквизитыРФ_УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеЭтапа(Этап)
	
	ДанныеЭтапа = Новый Структура("Статус, КолСтрРАсход",Этап.Статус,Этап.РасходМатериаловИРабот.Количество());
	Возврат ДанныеЭтапа;
	
КонецФункции

&НаСервере
Функция ОтменитьРасходМатериаловВЭтапе(Этап)
	
	ОбъектЭтап = Этап.ПолучитьОбъект(); 
	ОбъектЭтап.Статус = Перечисления.СтатусыЭтаповПроизводства2_2.Начат;
	ОбъектЭтап.КоличествоУпаковокФакт = 0.5;
	ОбъектЭтап.РасходМатериаловИРабот.Очистить(); 
	
	ЗаписьУспешна = Ложь;
	Попытка
		ОбъектЭтап.Записать();
		ЗаписьУспешна = Истина;
	Исключение
		Сообщить("Не удалось отменить завершение этапа " + Этап);
		ЗаписьУспешна = Ложь;
	КонецПопытки;    
	
	Возврат ЗаписьУспешна;
	
КонецФункции

&НаСервере
Процедура УдалитьСвязанныеПередачиМатериалов(Этап)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ Разрешенные
		|	СвязанныеДокументы.Ссылка КАК Ссылка
		|ИЗ
		|	КритерийОтбора.СвязанныеДокументы(&Этап) КАК СвязанныеДокументы
		|ГДЕ
		|	СвязанныеДокументы.Ссылка.Проведен = ИСТИНА
		|	И СвязанныеДокументы.Ссылка ССЫЛКА Документ.ДвижениеПродукцииИМатериалов
		|	И СвязанныеДокументы.Ссылка.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПередачаМатериаловВПроизводство)";
	
	Запрос.УстановитьПараметр("Этап", Этап);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ОбъектПередачаМатериалов = Выборка.Ссылка.ПолучитьОбъект();
		Попытка
			ОбъектПередачаМатериалов.УстановитьПометкуУдаления(Истина);
		Исключение
			Сообщить("Не удалось пометить связанный документ "+ОбъектПередачаМатериалов + Этап);
		КонецПопытки;
	КонецЦикла;	
		
КонецПроцедуры

&НаСервере
Функция СформироватьПередачуМатериаловНаСервере(Этап)
	
	МассивСсылок = Новый Массив();
	МассивСсылок.Добавить(Этап);
	ПараметрыОткрытия = СозданиеНаОснованииУТВызовСервера.ПараметрыОткрытияФормыНакладнойНаОснованииЗаказа(МассивСсылок,
		"ДвижениеПродукцииИМатериалов", ПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.ПередачаМатериаловВПроизводство"));
	ДанныеЗаполнения = ПараметрыОткрытия.ПараметрыФормы.Основание;
	
	Документ = Документы.ДвижениеПродукцииИМатериалов.СоздатьДокумент();
	Документ.Заполнить(ДанныеЗаполнения);
	Документ.Дата = Объект.ПериодОтгрузки;
	
	Попытка
		Документ.Записать(РежимЗаписиДокумента.Проведение);
		Возврат Истина;
	Исключение
		Сообщить("Ошибка формирования Передачи материалов "+Этап+"  "+ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

&НаКлиенте
Функция ЗаполнитьРасходЭтапа(Этап)

	ПараметрыФормы = Новый Структура("Ключ",Этап);
	Форма = ПолучитьФорму("Документ.ЭтапПроизводства2_2.ФормаОбъекта",ПараметрыФормы);	
	Форма.РасходМатериаловИРабот_ЗаполнитьПоДаннымОбеспеченияЗавершение(КодВозвратаДиалога.Да, Неопределено);
	Для каждого Строка из Форма.Объект.РасходМатериаловИРабот Цикл
		Строка.ДатаРасхода = Объект.ПериодОтгрузки;
	КонецЦикла;
	Форма.Объект.РасходОднойДатой = Истина;
	Форма.Объект.ДатаРасхода = Объект.ПериодОтгрузки;
	ФактНачалоЭтапа = Форма.Объект.ФактическоеНачалоЭтапа;
	Если НачалоДня(ФактНачалоЭтапа) = Объект.ПериодОтгрузки Тогда
		Форма.Объект.ФактическоеОкончаниеЭтапа = ФактНачалоЭтапа;
	Иначе
		Форма.Объект.ФактическоеОкончаниеЭтапа = Объект.ПериодОтгрузки;
	КонецЕсли;
	Форма.Объект.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтаповПроизводства2_2.Завершен");
	Форма.Объект.КоличествоУпаковокФакт = Форма.Объект.КоличествоУпаковокПлан;
	//Форма.ОбработатьЗавершениеВыполненияЭтапа();
	Попытка
		Форма.Записать();
		Возврат Истина;
	Исключение
		Сообщить("Ошибка при заполнении расхода "+Этап+" "+ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
		
КонецФункции	

&НаКлиенте
Функция ЗаполнитьМатериалыЭтапаПоДаннымРегистра(ЭтапПроизводства)
	
	Если ТекСтраница = "Резервирование" Тогда 
		ЭтоСписание = Ложь;
		//ТабЭтапы = ЭтапыРезервирование;
		ТабМатериалы = Объект.МатериалыРезервирование;
	ИначеЕсли ТекСтраница = "Списание" Тогда 
		ЭтоСписание = Истина;
		//ТабЭтапы = Этапы;
		ТабМатериалы = Объект.МатериалыСписание;
	КонецЕсли;
	//Для Каждого Стр из ТабЭтапы Цикл 
		//Если не Стр.Обрабатывать Тогда 
		//	Продолжить;
		//КонецЕсли;
		СтруктураКлючФормы = Новый Структура("Ключ",ЭтапПроизводства);
		Форма = ПолучитьФорму("Документ.ЭтапПроизводства2_2.ФормаОбъекта",СтруктураКлючФормы);
		ТЧОбеспечение = Форма.Объект.ОбеспечениеМатериаламиИРаботами;
		ТЧОбеспечение.Очистить();
		ПереченьКолонок = ПолучитьПереченьКолонокТЧМатериалыЭтапа();   
		//ТабМатериалы = 
		ПеренестиКорректировкиВТЧ(ЭтоСписание, ЭтапПроизводства, ПереченьКолонок);
		//ТЧОбеспечение.Загрузить(ТабМатериалы.Выгрузить()); //**Метод недоступен на клиенте**//
		Для Каждого Стр из ТабМатериалы Цикл 
			НоваяСтрока = ТЧОбеспечение.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока,Стр); 
		КонецЦикла;  
		//Форма.Объект.ОбеспечениеМатериаламиИРаботами = ТЧОбеспечение;
		Форма.Объект.НеОтгружатьЧастями = Истина; 
		Если ЭтоСписание Тогда 
			Форма.Объект.ДатаОтгрузки = Объект.ПериодОтгрузки;
		//Иначе 
		//	Форма.Объект.ДатаОтгрузки = ТекущаяДатаСеанса();
		КонецЕсли;
		Попытка
			Форма.Записать();
			Возврат Истина;
		Исключение
			Сообщить("Ошибка записи "+Стр.ЭтапПроизводства+"  "+ОписаниеОшибки());
			Возврат Ложь;
		КонецПопытки;
	//КонецЦикла;
	
КонецФункции

