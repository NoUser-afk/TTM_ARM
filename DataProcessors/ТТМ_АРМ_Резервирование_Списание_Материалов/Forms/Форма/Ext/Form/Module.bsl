	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТабЭтапы.Обрабатывать КАК Обрабатывать,
	               |	ТабЭтапы.Статус КАК Статус,
	               |	ТабЭтапы.ЭтапПроизводства КАК ЭтапПроизводства,
	               |	ТабЭтапы.КоличествоУпаковокФакт КАК КоличествоУпаковокФакт,
