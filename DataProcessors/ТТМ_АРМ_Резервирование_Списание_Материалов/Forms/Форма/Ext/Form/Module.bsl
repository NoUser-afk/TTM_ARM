Процедура РазбитьСтроку(Команда)
	
	Если ТекСтраница = "Списание" Тогда 
		ИмяДерева = "ДеревоМатериалов"; 
		ЭтоСписание = Истина;
	ИначеЕсли ТекСтраница = "Резервирование" Тогда 
		ИмяДерева = "ДеревоМатериаловРезервирование";
		ЭтоСписание = Ложь;
	КонецЕсли;       
	Если Элементы[ИмяДерева].ТекущиеДанные.Уровень = 1 Тогда 
		Возврат;
	КонецЕсли;
	//ДобавитьСтрокуВТекущуюВетку(ИмяДерева, ЭтоСписание);
	РазделитьСтроку(ИмяДерева,ЭтоСписание);
	УстановитьУсловноеОформлениеДереваМатериалов(ИмяДерева);
	
КонецПроцедуры

&НаСервере 
Функция РазделитьСтроку(ИмяДерева, ЭтоСписание)
	
	//1.Добавить в Регистр строку по данным текущей строки
	//2.перерисовать дерево
	
	//РодительскаяСтрока = ЭтаФорма[ИмяДерева].НайтиПоИдентификатору(ИДТекСтроки).ПолучитьРодителя(); 
	Если ЭтоСписание Тогда 
		ИсходныеДанныеСтроки = ИсходныеДанныеСтрокиДереваМатериалов;
	Иначе 
		ИсходныеДанныеСтроки = ИсходныеДанныеСтрокиДереваМатериаловРезервирование;
	КонецЕсли;
	НЗ = РегистрыСведений.ТТМ_АРМ_РезервированиеСписаниеМатериалов.СоздатьНаборЗаписей();
	НЗ.Отбор.Пользователь.Установить(Пользователи.АвторизованныйПользователь()); 
	НЗ.Отбор.ЭтоСписание.Установить(ЭтоСписание);
	НЗ.Отбор.Номенклатура.Установить(ИсходныеДанныеСтроки.Номенклатура);    
	НЗ.Отбор.ЭтапПроизводства.Установить(ИсходныеДанныеСтроки.ЭтапПроизводства);    
	НЗ.Отбор.ВариантОбеспечения.Установить(ИсходныеДанныеСтроки.ВариантОбеспечения);  
	//НЗ.Отбор.ИсходнаяНоменклатура.Установить(ИсходныеДанныеСтроки.ИсходнаяНоменклатура);
	НЗ.Прочитать(); 
	НоваяСтрока = НЗ.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока,НЗ[0]);
	Новаястрока.ИсходнаяНоменклатура = Справочники.Номенклатура.ПустаяССылка();
	НоваяСтрока.Количество = ИсходныеДанныеСтроки.Норматив - ИсходныеДанныеСтроки.Количество;
	НоваяСтрока.Обеспечить = НоваяСтрока.Количество;
	//НЗ[0].Количество = НЗ[0].Количество - 1;
	//НЗ[0].Обеспечить = НЗ[0].Обеспечить - 1;
	НоваяСтрока.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.КОбеспечению;   //.УдалитьОбособленно;
	НоваяСтрока.Обособленно = Истина;
	НоваяСтрока.ОтборПоВариантамОбеспечения = 1;
	
	НЗ.Отбор.ВариантОбеспечения.Использование = Ложь;
	НЗ.Записать();
	ОбновитьДанныеПоМатериаламНаСервере(ИмяДерева,Ложь); 
	УстановитьУсловноеОформлениеДереваМатериалов(ИмяДерева);
		
КонецФункции

