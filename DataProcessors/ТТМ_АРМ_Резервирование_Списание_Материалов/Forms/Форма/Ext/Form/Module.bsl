//Процедура записывает в регистр данные по обеспечению материалами по данным Этапов производста.
//устанавливает каждой строке регистра Уникальный идентификатор для связи со строками дерева знрачений.
//Параметры: Период = период среза остатков по материалам;
&НаСервере
Процедура ЗаписатьДанныеРезервированиеСписаниеМатериаловВРегистрСведений(РезультатЗапроса, Период, ЭтоСписание, ДатаОтгрузкиМатериалов)
		
	ТабДанныеРегистра = РезультатЗапроса.Выгрузить();
	Если ТабДанныеРегистра.Количество() > 0 Тогда 
		НЗ = РегистрыСведений.ТТМ_АРМ_РезервированиеСписаниеМатериалов.СоздатьНаборЗаписей();
		ТекПользователь = Пользователи.АвторизованныйПользователь(); 
		НЗ.Отбор.Пользователь.Установить(ТекПользователь);
		НЗ.Отбор.ЭтоСписание.Установить(ЭтоСписание);
		НЗ.Прочитать();   	
		НЗ.Загрузить(ТабДанныеРегистра);  
		
		//Установим для каждой строки регистра УникальныйИдентификатор 
		Этап = Неопределено; 
		МассивНоменклатурыБезНормативов = Новый Массив;
		Для Каждого СтрНЗ из НЗ Цикл 
			
			СтрНЗ.ДатаОтгрузки = ДатаОтгрузкиМатериалов; 
			СтрНЗ.ИдентификаторСтрокиРегистра = Новый УникальныйИдентификатор;
			
			//Получим нормативы
			Если Этап <> СтрНЗ.ЭтапПроизводства Тогда 
				Этап = СтрНЗ.ЭтапПроизводства;
				УстановитьДанныеПартииПроизводства(Этап);  
				Нормативы = ПолучитьНормативыИзВременногоХранилища(Этап);
			КонецЕсли;    
			
			//Запишем нормативы в регистр 
			
			//Если Нормативы.ОбеспечениеМатериаламиИРаботами.Количество() > 0 Тогда 
			СтруктураПоиска = Новый Структура("Номенклатура",СтрНЗ.Номенклатура); //,КлючСвязиСпецификация,СтрНЗ.КлючСвязиСпецификация
			МассивНайденныхСтрок = Нормативы.ОбеспечениеМатериаламиИРаботами.НайтиСтроки(СтруктураПоиска);
			Если МассивНайденныхСтрок.Количество() > 1 Тогда 
				Сообщить("Норматив: найдено более 1 строки! " + СтрНЗ.Номенклатура);
			ИначеЕсли МассивНайденныхСтрок.Количество() = 1 Тогда 
				СтрНЗ.Норматив = МассивНайденныхСтрок[0].КоличествоУпаковок;
				//СтрНЗ.Норматив = МассивНайденныхСтрок[0].Количество;
				//СтрНЗ.Норматив = МассивНайденныхСтрок[0].КоличествоУпаковокНаЕдиницуПартииВыпуска;
			Иначе   
				Если МассивНоменклатурыБезНормативов.Найти(СтрНЗ.Номенклатура) = Неопределено Тогда 
					МассивНоменклатурыБезНормативов.Добавить(СтрНЗ.Номенклатура);
				КонецЕсли;
				
			КонецЕсли; 
			//КонецЕсли;
				
		КонецЦикла; 
		НЗ.Записать(); 
		ТекстНачалаСообщения = "Данная позиция отсутствует в спецификации, норматив не найден ";
		ТекстСообщения = "";
		Для Каждого СтрНоменклатура из МассивНоменклатурыБезНормативов Цикл 
			ТекстСообщения = ТекстСообщения + ТекстНачалаСообщения + СтрНоменклатура + Символы.ПС;
		КонецЦикла;  
		Если не ТекстСообщения = "" Тогда 
			Сообщить(ТекстСообщения);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры  

//Сейчас не нужно, эти функции нужны для расчета количества по формуле, когда мы имеем формулу
