		  
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)    
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ЭтоСписание = Параметры.ЭтоСписание;
	ИмяДерева = Параметры.ИмяДерева;
	ВыбраннаяНоменклатура = Параметры.Номенклатура;
	ЗакрытьФорму = Ложь;
	ЗаписатьСтрокиВРегистр = Ложь;
	ТабНоменклатуры = РеквизитФормыВЗначение("ТабНовойНоменклатуры",Тип("ТаблицаЗначений"));
	Если Параметры.Свойство("МассивЭтапов") Тогда 
		Для Каждого СтрЭтап из Параметры.МассивЭтапов Цикл 
			НоваяСтрока = ТабНоменклатуры.Добавить();
			НоваяСтрока.Номенклатура = ?(Параметры.Свойство("Номенклатура"),Параметры.Номенклатура,Справочники.Номенклатура.ПустаяСсылка());
			НоваяСтрока.Упаковка = Параметры.Номенклатура.ЕдиницаИзмерения;
			НоваяСтрока.ЭтапПроизводства = СтрЭтап;
			НоваяСтрока.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.КОбеспечению;
			НоваяСтрока.Обособленно = Истина;
			НоваяСтрока.ОтборПоВариантамОбеспечения = 1;
			НоваяСтрока.КоличествоУпаковок = 1;
			НоваяСтрока.Количество = 1;
			НоваяСтрока.КатегорияМатериала = ПолучитьКатегориюМатериала(НоваяСтрока.Номенклатура, Параметры.ДР_КатегорияМатериала);
			НоваяСтрока.Остаток = ОбработкаОбъект.ПолучитьОстаток_2_5(НоваяСтрока.Номенклатура, Параметры.Склад);
			НоваяСтрока.Склад = Параметры.Склад; ////?(Параметры.Свойство("Склад"),Параметры.Склад,Справочники.Склады.ПустаяСсылка());
			НоваяСтрока.Назначение = ПолучитьНазначение(НоваяСтрока.ЭтапПроизводства);
			НоваяСтрока.СтатьяКалькуляции = Справочники.СтатьиКалькуляции.НайтиПоНаименованию("Покупные материалы");
			НоваяСтрока.ДатаОтгрузки = Параметры.ДатаОтгрузки;
			НоваяСтрока.КлючСвязиСпецификация = Параметры.КлючСвязиСпецификация;
			НоваяСтрока.Подразделение = Параметры.Склад.Подразделение;  
			//НоваяСтрока.Спецификация = СтрЭтап.Спецификация;
		КонецЦикла;
	КонецЕсли;  
	ЗначениеВРеквизитФормы(ТабНоменклатуры,"ТабНовойНоменклатуры");
	
КонецПроцедуры

&НаСервере
Функция ПолучитьКатегориюМатериала(Номенклатура, ДопСвойство) 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗначенияСвойствОбъектов.Владелец КАК Свойство,
	               |	ЗначенияСвойствОбъектов.Ссылка КАК КатегорияМатериала,
	               |	НоменклатураДополнительныеРеквизиты.Ссылка КАК Номенклатура,
	               |	НоменклатураДополнительныеРеквизиты.Значение КАК Значение
	               |ИЗ
	               |	Справочник.Номенклатура.ДополнительныеРеквизиты КАК НоменклатураДополнительныеРеквизиты
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
	               |		ПО НоменклатураДополнительныеРеквизиты.Свойство = ЗначенияСвойствОбъектов.Владелец
	               |			И НоменклатураДополнительныеРеквизиты.Значение = ЗначенияСвойствОбъектов.Ссылка
	               |ГДЕ
	               |	НоменклатураДополнительныеРеквизиты.Свойство = &Свойство
	               |	И НоменклатураДополнительныеРеквизиты.Ссылка = &Номенклатура";
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Свойство",ДопСвойство);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		Возврат Выборка.КатегорияМатериала;
	Иначе 
		Возврат Справочники.ЗначенияСвойствОбъектов.ПустаяСсылка();
	КонецЕсли;
	
КонецФункции

